# Protein AI Platform — Environment Variables
# Copy this file to .env and fill in your values

# General
DEBUG=true
SECRET_KEY=change-this-to-a-real-secret-key-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:4200
OUTLINE_PUBLIC_URL=${PUBLIC_BASE_URL}/wiki

# Auth / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=protein_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is computed from the above; override if needed:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/protein_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM — Primary
LLM_PROVIDER=kuaPao
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM — Fallback
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_V4RO_MODEL=DeepSeek-v4ro

# DashScope / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-max

# KuaPao
KUAPAO_API_KEY=
KUAPAO_BASE_URL=https://kuaipao.pro/v1
KUAPAO_MODEL=gpt-5.5
KUAPAO_GPT56_MODEL=gpt-5.6-terra
KUAPAO_SOL_MODEL=gpt-5.6-sol

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=protein-files
MINIO_SECURE=false
MINIO_REGION=
DEPLOY_DATA_ROOT=../deploy_data
LIPASE_DB_PATH=../deploy_data/lipase/lipase.db
LOCAL_ANNOTATION_FIXTURE_PATH=
STRUCTURE_SMOKE_PDB_FILE=

# Ops monitoring / alerting
OPS_SLOW_REQUEST_THRESHOLD_SECONDS=2.0
OPS_ALERT_WEBHOOK_ENABLED=false
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_KIND=webhook
OPS_ALERT_WEBHOOK_TIMEOUT_SECONDS=3
OPS_ALERT_WEBHOOK_RETRY_ATTEMPTS=2
OPS_ALERT_SILENCE_SECONDS=900
OPS_ALERT_ESCALATE_AFTER_COUNT=3

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0

# Agent strategy governance
# Optional JSON object. Leave empty to use conservative defaults.
# Example keys: continuation_tokens, new_task_tokens, followup_synthesis_tokens,
# execution_tokens, confirmation_tokens, raw_sequence_history_requires_continuation.
AGENT_STRATEGY_POLICY_JSON=

# Celery worker sizing
CELERY_DEFAULT_WORKER_CONCURRENCY=4
CELERY_MD_WORKER_CONCURRENCY=1

# Computational biology external APIs
NCBI_API_KEY=
UNIPROT_BASE_URL=https://rest.uniprot.org
ESMFOLD_API_URL=https://api.esmatlas.com
DIFFDOCK_API_URL=
PROTEINMPNN_API_URL=https://huggingface.co/api
FOLDSEEK_API_URL=
FOLDSEEK_BINARY=
FOLDSEEK_DATABASE_ROOT=
FOLDSEEK_DATABASE_PDB=
FOLDSEEK_DATABASE_ALPHAFOLD=
FOLDSEEK_DATABASE_CUSTOM=
ROSETTA_CARTESIAN_DDG=
ROSETTA_DDG_BINARY=
GROMACS_BIN=gmx
# Optional professional pocket runtimes. Set to mounted executable paths.
# Unavailable runtimes are reported as RUNTIME_UNAVAILABLE; no sites are invented.
P2RANK_BINARY=
FPOCKET_BINARY=
SIFTS_MAPPING_PATH=
SIFTS_SMOKE_USE_DEMO=
SIFTS_SMOKE_PDB_ID=
SIFTS_SMOKE_CHAIN=
SIFTS_SMOKE_UNIPROT_ID=
FOLDSEEK_SMOKE_USE_DEMO=
FOLDSEEK_SMOKE_DATABASE=pdb
FOLDSEEK_SMOKE_MAX_RESULTS=5
STRUCTURE_SMOKE_PDB_FILE=
BLAST_API_URL=https://blast.ncbi.nlm.nih.gov/Blast.cgi
BLAST_POLL_INTERVAL=5.0
BLAST_MAX_POLL_ATTEMPTS=60
