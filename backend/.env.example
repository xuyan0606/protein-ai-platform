# Protein AI Platform — Environment Variables
# Copy this file to .env and fill in your values

# General
DEBUG=true
SECRET_KEY=change-this-to-a-real-secret-key-at-least-32-chars

# Auth / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=protein_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is computed from the above; override if needed:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/protein_ai

REDIS_URL=redis://localhost:6379/0

# LLM — Primary (OpenAI)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=

# LLM — Fallback
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=protein-files

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0

# Computational biology external APIs
NCBI_API_KEY=
UNIPROT_BASE_URL=https://rest.uniprot.org
ESMFOLD_API_URL=https://api.esmatlas.com
DIFFDOCK_API_URL=
PROTEINMPNN_API_URL=https://huggingface.co/api
BLAST_API_URL=https://blast.ncbi.nlm.nih.gov/Blast.cgi
BLAST_POLL_INTERVAL=5.0
BLAST_MAX_POLL_ATTEMPTS=60
