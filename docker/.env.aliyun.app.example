# =============================================================================
# Protein AI Platform — Alibaba Cloud App Node Example
# =============================================================================
# Copy this file to `.env.aliyun.app` on ECS-App-01 and ECS-App-02.
# It is intended for the managed topology:
#   RDS PostgreSQL + Cloud Redis + OSS + local Outline/ChromaDB
# =============================================================================

# ---- Public entry ------------------------------------------------------------
PUBLIC_BASE_URL=https://proteinai.example.com
OUTLINE_PUBLIC_URL=https://proteinai.example.com/wiki
OUTLINE_FORCE_HTTPS=true
CORS_ORIGINS=["https://proteinai.example.com"]
DEBUG=false

# ---- Application secrets ----------------------------------------------------
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_PRIVATE_KEY_HOST_PATH=/opt/protein-ai-platform/shared/secrets/oidc_private_key.pem
OIDC_PUBLIC_KEY_HOST_PATH=/opt/protein-ai-platform/shared/secrets/oidc_public_key.pem
OUTLINE_SECRET_KEY=change-me-64-char-hex-outline-secret-key
OUTLINE_UTILS_SECRET=change-me-64-char-hex-outline-utils-secret
# Create this in Outline and keep it secret; backend Wiki publish/list APIs require it.
OUTLINE_API_TOKEN=
OUTLINE_API_URL=http://outline:3001/api

# ---- LLM providers ----------------------------------------------------------
LLM_PROVIDER=kuaPao
LLM_MODEL=gpt-5.5
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
KUAPAO_API_KEY=
KUAPAO_BASE_URL=https://kuaipao.pro/v1

# ---- Managed PostgreSQL (RDS) -----------------------------------------------
# FastAPI / worker use SQLAlchemy asyncpg DSN.
ALIYUN_APP_DATABASE_URL=postgresql+asyncpg://protein_ai:change-me@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/protein_ai
# Outline expects a postgres:// style DSN.
ALIYUN_OUTLINE_DATABASE_URL=postgres://protein_ai:change-me@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/outline
ALIYUN_OUTLINE_DATABASE_URL_TEST=postgres://protein_ai:change-me@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/outline_test
ALIYUN_OUTLINE_PGSSLMODE=prefer

# ---- Managed Redis ----------------------------------------------------------
ALIYUN_REDIS_HOST=r-bpxxxxxxxx.redis.rds.aliyuncs.com
ALIYUN_REDIS_PORT=6379
ALIYUN_REDIS_APP_DB=0
ALIYUN_REDIS_OUTLINE_DB=1
ALIYUN_REDIS_USERNAME=
ALIYUN_REDIS_PASSWORD=
# Optional full URLs override host/user/password fields. Use these when Redis ACL format requires it.
ALIYUN_REDIS_APP_URL=
ALIYUN_REDIS_OUTLINE_URL=

# ---- OSS object storage -----------------------------------------------------
# Backend still uses MINIO_* env names, but points to OSS here.
# Use an internal OSS endpoint when ECS and OSS are in the same region.
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_SECURE=true
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=protein-ai-files
ALIYUN_OSS_OUTLINE_BUCKET=protein-ai-outline
# Outline uses these S3-compatible settings directly.
ALIYUN_OSS_OUTLINE_BUCKET_URL=https://oss-cn-hangzhou-internal.aliyuncs.com
ALIYUN_OSS_FORCE_PATH_STYLE=false

# ---- Local state on app nodes -----------------------------------------------
DEPLOY_DATA_HOST_PATH=../deploy_data
LIPASE_DB_PATH=/app/deploy_data/lipase/lipase.db
ML_MODEL_CACHE_DIR=/app/.model_cache
CELERY_DEFAULT_WORKER_CONCURRENCY=4
GROMACS_BIN=gmx
ROSETTA_CARTESIAN_DDG=
ROSETTA_DDG_BINARY=
FOLDSEEK_API_URL=
FOLDSEEK_BINARY=
KUAPAO_MODEL=gpt-5.5
KUAPAO_GPT56_MODEL=gpt-5.6-terra
KUAPAO_SOL_MODEL=gpt-5.6-sol
