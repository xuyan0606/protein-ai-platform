ALIYUN_REDIS_APP_DB=0
ALIYUN_REDIS_OUTLINE_DB=1

# ---- OSS object storage -----------------------------------------------------
# Backend still uses MINIO_* env names, but points to OSS here.
# Use an internal OSS endpoint when ECS and OSS are in the same region.
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_SECURE=true
ALIYUN_OSS_ACCESS_KEY_ID=REDACTED
ALIYUN_OSS_ACCESS_KEY_SECRET=REDACTED
ALIYUN_OSS_BUCKET=crvab
ALIYUN_OSS_OUTLINE_BUCKET=crvab
# Outline uses these S3-compatible settings directly.
ALIYUN_OSS_OUTLINE_BUCKET_URL=https://crvab.oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_FORCE_PATH_STYLE=false

