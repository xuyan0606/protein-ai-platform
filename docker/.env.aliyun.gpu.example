# =============================================================================
# Protein AI Platform — Alibaba Cloud GPU Worker Example
# =============================================================================
# Copy this file to `.env.aliyun.gpu` on ECS-GPU-01.
# This node only runs the dedicated MD/GPU worker and uses managed services.
# =============================================================================

# ---- Shared secrets / providers ---------------------------------------------
DEBUG=false
SECRET_KEY=change-me-to-the-same-secret-as-app-node
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.7-max
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
KUAPAO_API_KEY=

# ---- Managed PostgreSQL (RDS) -----------------------------------------------
ALIYUN_APP_DATABASE_URL=postgresql+asyncpg://protein_ai:change-me@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/protein_ai

# ---- Managed Redis ----------------------------------------------------------
ALIYUN_REDIS_HOST=r-bpxxxxxxxx.redis.rds.aliyuncs.com
ALIYUN_REDIS_PORT=6379
ALIYUN_REDIS_APP_DB=0

# ---- OSS object storage -----------------------------------------------------
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_SECURE=true
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
REDACTEDALIYUN_OSS_BUCKET=protein-ai-files

# ---- Deploy data / worker sizing --------------------------------------------
DEPLOY_DATA_HOST_PATH=../deploy_data
CELERY_MD_WORKER_CONCURRENCY=1
CELERY_LIGAND_WORKER_CONCURRENCY=1
FOLDSEEK_BINARY=/usr/local/bin/foldseek
GROMACS_BIN=gmx
ROSETTA_CARTESIAN_DDG=
ROSETTA_DDG_BINARY=

# If this host has NVIDIA Container Toolkit installed, keep `all`.
GPU_DEVICE_REQUEST=all
