# =============================================================================
# Protein AI Platform — Docker environment variables
# =============================================================================
# Copy this file to .env and fill in your secrets / overrides:
#   cp .env.example .env
#
# docker compose reads .env automatically for variable substitution inside
# docker-compose.yml.  Services with `env_file: .env` also receive these
# variables as container environment.
# =============================================================================

# ---- General ----------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DEBUG=false
DEPLOY_DATA_HOST_PATH=../deploy_data

# ---- PostgreSQL (pgvector) --------------------------------------------------
POSTGRES_USER=protein_ai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=protein_ai

# ---- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# ---- LLM Providers -----------------------------------------------------------
# Primary
LLM_PROVIDER=kuaPao
LLM_MODEL=gpt-5.5
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_V4RO_MODEL=DeepSeek-v4ro

# Fallback (optional, used when primary fails)
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat

# ---- Object Storage (MinIO / S3-compatible) ---------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_SECURE=false
MINIO_REGION=

# Ops monitoring / alerting
OPS_SLOW_REQUEST_THRESHOLD_SECONDS=2.0
OPS_ALERT_WEBHOOK_ENABLED=false
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_KIND=webhook
OPS_ALERT_WEBHOOK_TIMEOUT_SECONDS=3
OPS_ALERT_WEBHOOK_RETRY_ATTEMPTS=2
OPS_ALERT_SILENCE_SECONDS=900
OPS_ALERT_ESCALATE_AFTER_COUNT=3

# ---- ChromaDB ---------------------------------------------------------------
# IS_PERSISTENT=TRUE set in compose; no extra vars required.

# ---- ML Model ---------------------------------------------------------------
ML_MODEL_CACHE_DIR=/app/.model_cache
ML_NUM_THREADS=4
CELERY_DEFAULT_WORKER_CONCURRENCY=4
CELERY_MD_WORKER_CONCURRENCY=1
CELERY_LIGAND_WORKER_CONCURRENCY=1
GROMACS_BIN=gmx
ROSETTA_CARTESIAN_DDG=
ROSETTA_DDG_BINARY=
# Professional pocket geometry runtimes (optional but required for real
# pocket-residue output). Mount the binaries into the container and set the
# absolute paths; if unset/unavailable, the API returns RUNTIME_UNAVAILABLE.
P2RANK_BINARY=
FPOCKET_BINARY=

# ---- Local curated / structure data -----------------------------------------
# Mounted into backend / workers at /app/deploy_data
# Suggested host layout:
#   deploy_data/
#     annotations/
#     sifts/
#     foldseek/
#     smoke/
# Optional explicit overrides when auto-discovery is not enough:
# LOCAL_ANNOTATION_FIXTURE_PATH=/app/deploy_data/annotations
# SIFTS_MAPPING_PATH=/app/deploy_data/sifts
# FOLDSEEK_DATABASE_ROOT=/app/deploy_data/foldseek
# FOLDSEEK_BINARY=/usr/local/bin/foldseek
# FOLDSEEK_API_URL=
# STRUCTURE_SMOKE_PDB_FILE=/app/deploy_data/smoke/query.pdb
KUAPAO_MODEL=gpt-5.5
KUAPAO_GPT56_MODEL=gpt-5.6-terra
KUAPAO_SOL_MODEL=gpt-5.6-sol
