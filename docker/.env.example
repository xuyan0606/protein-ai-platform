# =============================================================================
# Protein AI Platform — Docker environment variables
# =============================================================================
# Copy this file to .env and fill in your secrets / overrides:
#   cp .env.example .env
#
# docker compose reads .env automatically for variable substitution inside
# docker-compose.yml.  Services with `env_file: .env` also receive these
# variables as container environment.
# =============================================================================

# ---- General ----------------------------------------------------------------
SECRET_KEY=change-this-to-a-real-random-secret-key
DEBUG=false

# ---- PostgreSQL (pgvector) --------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=protein_ai

# ---- Redis ------------------------------------------------------------------
# Set REDIS_HOST=redis in compose; port remains the default.
REDIS_PORT=6379

# ---- LLM Provider -----------------------------------------------------------
# Supported: openai / anthropic / deepseek / ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=

# ---- Object Storage (MinIO / S3-compatible) ---------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- ChromaDB ---------------------------------------------------------------
# Set IS_PERSISTENT=TRUE in compose; no extra vars required.
