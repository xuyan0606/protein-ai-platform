{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KWB enzyme agent execution receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "created_at",
    "local_only",
    "trace_id",
    "plan_id",
    "action_id",
    "tool_contract_id",
    "execution_mode",
    "human_confirmation_ref",
    "input_artifacts",
    "output_artifacts",
    "validator_artifacts",
    "return_status",
    "writes_formal_decision",
    "writes_training_rows",
    "safe_for_training_import",
    "safe_for_model_claim",
    "release_ready"
  ],
  "properties": {
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string"},
    "local_only": {"const": true},
    "trace_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "action_id": {"type": "string"},
    "tool_contract_id": {"type": "string"},
    "execution_mode": {"enum": ["read_only", "local_script", "manual_only"]},
    "human_confirmation_ref": {"type": ["string", "null"]},
    "input_artifacts": {"type": "array", "items": {"type": "string"}},
    "output_artifacts": {"type": "array", "items": {"type": "string"}},
    "validator_artifacts": {"type": "array", "items": {"type": "string"}},
    "return_status": {"enum": ["not_executed", "executed_passed", "executed_failed", "blocked"]},
    "writes_formal_decision": {"type": "boolean"},
    "writes_training_rows": {"type": "boolean"},
    "safe_for_training_import": {"const": false},
    "safe_for_model_claim": {"const": false},
    "release_ready": {"const": false}
  }
}
