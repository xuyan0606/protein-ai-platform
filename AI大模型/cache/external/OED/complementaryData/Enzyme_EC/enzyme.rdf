<citation rdf:resource="http://purl.uniprot.org/citations/19439403"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23930021"/>
<rdfs:subClassOf rdf:resource="2.7.8.-"/>
<skos:broaderTransitive rdf:resource="2.7.8.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.41#SIP163CF6D41520DED8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol) + a CDP-1,2-diacyl-sn-glycerol = a cardiolipin + CMP + H(+).</rdfs:label>
</rdf:Description>
