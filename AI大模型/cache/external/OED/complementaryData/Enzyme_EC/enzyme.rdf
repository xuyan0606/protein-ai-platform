<rdf:Description rdf:about="2.5.1.65">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>O-phosphoserine sulfhydrylase</skos:prefLabel>
<skos:altLabel>O-phosphoserine(thiol)-lyase</skos:altLabel>
<activity rdf:resource="2.5.1.65#SIPF2E586DA9254B635"/>
<rdfs:comment>The enzyme from Aeropyrum pernix acts on both O-phospho-L-serine and O(3)-acetyl-L-serine, in contrast with EC 2.5.1.47, which acts only on O(3)-acetyl-L-serine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12554945"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12644499"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12965218"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.65#SIPF2E586DA9254B635">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + hydrogen sulfide + O-phospho-L-serine = L-cysteine + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12554945">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
