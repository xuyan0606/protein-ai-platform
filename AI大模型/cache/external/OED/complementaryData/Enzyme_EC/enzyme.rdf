<skos:altLabel>small neutral protease</skos:altLabel>
<activity rdf:resource="3.4.24.77#SIP1C7689EF64D6EE0C"/>
<rdfs:comment>Belongs to peptidase family M7.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11132632"/>
