<rdf:Description rdf:about="2.7.1.173">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.1.n4"/>
<skos:prefLabel>nicotinate riboside kinase</skos:prefLabel>
<skos:altLabel>ribosylnicotinic acid kinase</skos:altLabel>
<activity rdf:resource="2.7.1.173#SIP76261AE7A6605B82"/>
<rdfs:comment>The enzyme from yeast and human also has the activity of EC 2.7.1.22.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17914902"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
