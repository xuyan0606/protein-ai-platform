<rdf:Description rdf:about="3.4.24.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>interstitial collagenase</skos:prefLabel>
<skos:altLabel>matrix metalloproteinase 1</skos:altLabel>
<skos:altLabel>vertebrate collagenase</skos:altLabel>
<activity rdf:resource="3.4.24.7#SIP1B2A0EA8F418D713"/>
<rdfs:comment>The enzyme takes its name from substrates of the interstitial collagen group - types I, II and III, all of which are cleaved in the helical domain.</rdfs:comment>
<rdfs:comment>alpha-macroglobulins are cleaved much more rapidly.</rdfs:comment>
<rdfs:comment>The enzyme is widely distributed in vertebrate animals.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M10B.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2462561"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3009463"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3032960"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3041177"/>
<rdfs:subClassOf rdf:resource="3.4.24.-"/>
<skos:broaderTransitive rdf:resource="3.4.24.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.24.7#SIP1B2A0EA8F418D713">
