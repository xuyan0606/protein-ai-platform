<activity rdf:resource="1.1.1.359#SIP0B0832D01DAC8F7C"/>
<activity rdf:resource="1.1.1.359#SIPA8FD677859758569"/>
<activity rdf:resource="1.1.1.359#SIP573AF37EBE72B77E"/>
