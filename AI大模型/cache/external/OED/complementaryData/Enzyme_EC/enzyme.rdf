<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an acyl-CoA + pseudotropine = CoA + H(+) + O-acylpseudotropine.</rdfs:label>
</rdf:Description>
