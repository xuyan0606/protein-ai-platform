<rdf:Description rdf:about="2.4.1.158">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>13-hydroxydocosanoate 13-beta-glucosyltransferase</skos:prefLabel>
<skos:altLabel>13-glucosyloxydocosanoate 2'-beta-glucosyltransferase</skos:altLabel>
<skos:altLabel>UDP-glucose-13-hydroxydocosanoate glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.158#SIP0A19EEDDDABC8FE0"/>
<rdfs:comment>13-beta-D-Glucosyloxydocosanoate can also act as acceptor, leading to the formation by Candida bogoriensis of the extracellular glycolipid, hydroxydocosanoate sophoroside diacetate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6213610"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
