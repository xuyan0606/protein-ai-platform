<rdf:Description rdf:about="3.2.1.201">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>exo-chitinase (reducing end)</skos:prefLabel>
<activity rdf:resource="3.2.1.201#SIP514710184CDC96F4"/>
<rdfs:comment>The enzyme hydrolyzes the second glycosidic (1->4) linkage from reducing ends of chitin and chitodextrin molecules, liberating N,N'-diacetylchitobiose disaccharides. cf. EC 3.2.1.200.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8757722"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15717865"/>
