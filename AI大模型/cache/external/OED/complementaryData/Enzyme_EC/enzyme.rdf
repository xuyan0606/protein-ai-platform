<rdf:Description rdf:about="1.13.11.62">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>linoleate 10R-lipoxygenase</skos:prefLabel>
<skos:altLabel>(10R)-dioxygenase</skos:altLabel>
<skos:altLabel>10R-dioxygenase</skos:altLabel>
<skos:altLabel>10R-DOX</skos:altLabel>
<activity rdf:resource="1.13.11.62#SIP6BCB7CC6A6011C19"/>
<rdfs:comment>The enzyme is involved in biosynthesis of oxylipins, which affect sporulation, development, and pathogenicity of Aspergillus spp.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19289462"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20045744"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
