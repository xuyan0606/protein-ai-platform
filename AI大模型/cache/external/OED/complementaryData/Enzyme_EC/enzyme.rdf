<rdf:Description rdf:about="2.4.2.59">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfide-dependent adenosine diphosphate thiazole synthase</skos:prefLabel>
<activity rdf:resource="2.4.2.59#SIP755B360C1C46FDED"/>
<rdfs:comment>This iron dependent enzyme, found in most archaea, is involved in the biosynthesis of thiamine phosphate.</rdfs:comment>
<rdfs:comment>The homologous enzyme from plants and fungi (EC 2.4.2.60) uses an intrinsic cysteine as sulfur donor and, unlike the archaeal enzyme, is a single turn-over enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26919468"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26928142"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.59#SIP755B360C1C46FDED">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycine + hydrogen sulfide + NAD(+) = ADP-5-ethyl-4-methylthiazole-2-carboxylate + H(+) + 3 H2O + nicotinamide.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26919468">
