<skos:prefLabel>acrylate reductase</skos:prefLabel>
<activity rdf:resource="1.3.1.125#SIP117195EFAFF1D2F9"/>
<rdfs:comment>The enzyme, characterized from the marine bacterium Vibrio harveyi, enables the organism to utilize acrylate as the terminal electron acceptor for NADH regeneration under anaerobic conditions.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/35612301"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.125#SIP117195EFAFF1D2F9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acrylate + H(+) + NADH = NAD(+) + propanoate.</rdfs:label>
</rdf:Description>
