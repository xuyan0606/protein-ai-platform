<rdf:Description rdf:about="2.3.1.226">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carboxymethylproline synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.226#SIP403643F940BCDE76"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of the carbapenem beta-lactam antibiotic (5R)-carbapen-2-em-3-carboxylate in the bacterium Pectobacterium carotovorum.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14625287"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15595850"/>
