<skos:prefLabel>UDP-2,4-diacetamido-2,4,6-trideoxy-beta-L-altropyranose hydrolase</skos:prefLabel>
<skos:altLabel>UDP-6-deoxy-AltdiNAc hydrolase</skos:altLabel>
<activity rdf:resource="3.6.1.57#SIP2EF33065C2A21E9C"/>
<rdfs:comment>The enzyme is involved in biosynthesis of pseudaminic acid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16728396"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16751642"/>
