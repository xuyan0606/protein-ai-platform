<rdf:Description rdf:about="3.1.1.71">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylalkylglycerol acetylhydrolase</skos:prefLabel>
<skos:altLabel>alkylacetylglycerol acetylhydrolase</skos:altLabel>
<activity rdf:resource="3.1.1.71#SIP5AA931F49A07D43C"/>
<rdfs:comment>Hydrolysis of the acetyl group from the 1-alkyl-2-acetyl and 1-alkyl-3-acetyl substrates occurs at apparently identical rates.</rdfs:comment>
<rdfs:comment>Differs from EC 3.1.1.34 since 1,2-diacetyl-sn-glycerols are not substrates.</rdfs:comment>
<rdfs:comment>It also differs from EC 3.1.1.47.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2302414"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
