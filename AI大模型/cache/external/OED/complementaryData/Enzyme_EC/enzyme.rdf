<activity rdf:resource="5.5.1.10#SIPC277751C00974685"/>
<rdfs:comment>Both rings of pinene are cleaved in the reaction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3667522"/>
<rdfs:subClassOf rdf:resource="5.5.1.-"/>
<skos:broaderTransitive rdf:resource="5.5.1.-"/>
</rdf:Description>
