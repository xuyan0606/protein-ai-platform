<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + 3 H(+) + 3 malonyl-CoA + NADPH = 6-methylsalicylate + 3 CO2 + 4 CoA + H2O + NADP(+).</rdfs:label>
</rdf:Description>
