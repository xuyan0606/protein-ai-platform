<rdf:Description rdf:about="1.3.8.17">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dehydro coenzyme F420 reductase</skos:prefLabel>
<activity rdf:resource="1.3.8.17#SIPFE5868B35027C7FF"/>
<rdfs:comment>This enzyme is involved in the biosynthesis of coenzyme F420, a redox-active cofactor found in all methanogenic archaea, as well as some eubacteria.</rdfs:comment>
<rdfs:comment>In some eubacteria the enzyme is multifunctional, also catalyzing the activities of EC 6.3.2.31, and EC 6.3.2.34.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30952857"/>
