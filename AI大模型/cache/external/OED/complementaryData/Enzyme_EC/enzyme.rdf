<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-6a-hydroxymaackiain + S-adenosyl-L-methionine = (+)-pisatin + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
