<rdf:Description rdf:about="1.13.11.70">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.99.n5"/>
<skos:prefLabel>all-trans-10'-apo-beta-carotenal 13,14-cleaving dioxygenase</skos:prefLabel>
<skos:altLabel>carotenoid cleavage dioxygenase 8</skos:altLabel>
<activity rdf:resource="1.13.11.70#SIP5C01202E3743ED5E"/>
<rdfs:comment>The enzyme from the plant Arabidopsis thaliana also catalyzes EC 1.13.11.69, 10-fold faster.</rdfs:comment>
