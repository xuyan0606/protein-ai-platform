<rdf:Description rdf:about="1.19.6.-">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>With dinitrogen as acceptor</skos:prefLabel>
<rdfs:subClassOf rdf:resource="1.19.-.-"/>
