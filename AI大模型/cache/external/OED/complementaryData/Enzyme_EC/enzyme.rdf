<rdf:Description rdf:about="6.3.5.9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hydrogenobyrinic acid a,c-diamide synthase (glutamine-hydrolyzing)</skos:prefLabel>
<activity rdf:resource="6.3.5.9#SIP49E73CF1218D998F"/>
<rdfs:comment>This enzyme, which participates in the aerobic (late cobalt insertion) cobalamin biosynthesis pathway, generates hydrogenobyrinate a,c-diamide, the substrate required by EC 6.6.1.2 which adds cobalt to the macrocycle.</rdfs:comment>
<rdfs:comment>The equivalent reaction in the anaerobic cobalamin biosynthesis pathway is catalyzed by EC 6.3.5.11.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2172209"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12195810"/>
<rdfs:subClassOf rdf:resource="6.3.5.-"/>
<skos:broaderTransitive rdf:resource="6.3.5.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.3.5.9#SIP49E73CF1218D998F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 ATP + 2 H2O + hydrogenobyrinate + 2 L-glutamine = 2 ADP + 2 H(+) + hydrogenobyrinate a,c-diamide + 2 L-glutamate + 2 phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2172209">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2172209"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/2172209"/>
</rdf:Description>
