<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-dehydro-L-gulonate-6-phosphate decarboxylase</skos:prefLabel>
<skos:altLabel>3-dehydro-L-gulonate-6-phosphate carboxy-lyase</skos:altLabel>
<skos:altLabel>3-keto-L-gulonate 6-phosphate decarboxylase</skos:altLabel>
<skos:altLabel>KGPDC</skos:altLabel>
<activity rdf:resource="4.1.1.85#SIP097367EEA05EFBBB"/>
<rdfs:comment>Along with EC 5.1.3.22, this enzyme is involved in a pathway for the utilization of L-ascorbate by Escherichia coli.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11741871"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11900527"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
