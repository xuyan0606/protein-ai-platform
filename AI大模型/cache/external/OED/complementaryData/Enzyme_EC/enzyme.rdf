<rdf:Description rdf:about="3.1.1.104">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-phospho-D-xylono-1,4-lactonase</skos:prefLabel>
<activity rdf:resource="3.1.1.104#SIPD8206E25484C3BC3"/>
<activity rdf:resource="3.1.1.104#SIP43D7D5C661348C88"/>
<rdfs:comment>The enzyme, characterized from Mycoplasma spp., contains a binuclear metal center with two zinc cations.</rdfs:comment>
<rdfs:comment>The enzyme is specific for the phosphorylated forms, and is unable to hydrolyze non-phosphorylated 1,4-lactones.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24955762"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
