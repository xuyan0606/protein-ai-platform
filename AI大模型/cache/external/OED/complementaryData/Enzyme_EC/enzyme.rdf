<rdf:Description rdf:about="1.14.19.62">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.3.3.9"/>
<skos:prefLabel>secologanin synthase</skos:prefLabel>
<activity rdf:resource="1.14.19.62#SIP3B70794208F26E50"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein.</rdfs:comment>
<rdfs:comment>Secologanin is the precursor of the monoterpenoid indole alkaloids and ipecac alkaloids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10656401"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11135113"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
