<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>coproporphyrin ferrochelatase</skos:prefLabel>
<activity rdf:resource="4.99.1.9#SIPC0A67C93F094AA86"/>
<rdfs:comment>The enzyme, present in Gram-positive bacteria, participates in heme biosynthesis.</rdfs:comment>
<rdfs:comment>It can also catalyze the reaction of EC 4.99.1.1 at a much lower level.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8119288"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9384565"/>
