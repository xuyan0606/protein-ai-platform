<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>benzoyl-CoA + 3 H(+) + 3 malonyl-CoA = biphenyl-3,5-diol + 4 CO2 + 4 CoA.</rdfs:label>
</rdf:Description>
