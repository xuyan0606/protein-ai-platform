<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/21562561"/>
<dcterms:identifier>doi:10.1038/nature10078</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24443527">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24443527"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24443527"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.45">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="6.3.2.19"/>
<replaces rdf:resource="6.3.2.21"/>
<skos:prefLabel>E1 ubiquitin-activating enzyme</skos:prefLabel>
<skos:altLabel>ubiquitin-activating enzyme E1</skos:altLabel>
<activity rdf:resource="6.2.1.45#SIP39916D5434BE870D"/>
<rdfs:comment>Catalyzes the ATP-dependent activation of ubiquitin through the formation of a thioester bond between the C-terminal glycine of ubiquitin and the sulfhydryl side group of a cysteine residue in the E1 protein.</rdfs:comment>
<rdfs:comment>The two-step reaction consists of the ATP-dependent formation of an E1-ubiquitin adenylate intermediate in which the C-terminal glycine of ubiquitin is bound to AMP via an acyl-phosphate linkage, then followed by the conversion to an E1-ubiquitin thioester bond via the cysteine residue on E1 in the second step.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6277905"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17951259"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19343538"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22012022"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.45#SIP39916D5434BE870D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + ubiquitin + [E1 ubiquitin-activating enzyme]-L-cysteine = AMP + diphosphate + S-ubiquitinyl-[E1 ubiquitin-activating enzyme]-L-cysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6277905">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/6277905"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/6277905"/>
</rdf:Description>
