<rdf:Description rdf:about="1.1.99.38">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-deoxy-scyllo-inosamine dehydrogenase (AdoMet-dependent)</skos:prefLabel>
<activity rdf:resource="1.1.99.38#SIPF568E0C0511ACAAE"/>
<rdfs:comment>Involved in the biosynthetic pathway of the aminoglycoside antibiotics of the butirosin family.</rdfs:comment>
<rdfs:comment>The enzyme from Bacillus circulans was shown to be a radical S-adenosyl-L-methionine (SAM) enzyme. cf. EC 1.1.1.329.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18001019"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18672902"/>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.38#SIPF568E0C0511ACAAE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-deoxy-scyllo-inosamine + S-adenosyl-L-methionine = 3-amino-2,3-dideoxy-scyllo-inosose + 5'-deoxyadenosine + H(+) + L-methionine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18001019">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
