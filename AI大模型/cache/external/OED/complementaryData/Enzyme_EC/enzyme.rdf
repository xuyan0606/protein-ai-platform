<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8555230"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/8555230"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11329257">
