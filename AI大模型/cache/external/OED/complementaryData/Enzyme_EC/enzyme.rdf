<rdf:Description rdf:about="3.5.4.34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA(Ala)(adenine(37)) deaminase</skos:prefLabel>
<activity rdf:resource="3.5.4.34#SIP4F8DB7777C916333"/>
<rdfs:comment>The enzyme deaminates adenosine(37) to inosine in eukaryotic tRNA(Ala).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9707437"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10430867"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10629039"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.4.34#SIP4F8DB7777C916333">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine(37) in tRNA(Ala) + H(+) + H2O = inosine(37) in tRNA(Ala) + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9707437">
