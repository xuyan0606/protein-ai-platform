<rdfs:label>dolabradiene + O2 + reduced [NADPH--hemoprotein reductase] = 15,16-epoxydolabrene + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.159#SIP8AE220B935F3C2E6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
