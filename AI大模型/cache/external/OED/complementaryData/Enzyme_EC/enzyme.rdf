<rdf:Description rdf:about="2.7.8.39">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>archaetidylinositol phosphate synthase</skos:prefLabel>
<skos:altLabel>AIP synthase</skos:altLabel>
<activity rdf:resource="2.7.8.39#SIP0ABC85102971EE6A"/>
<rdfs:comment>The enzyme is involved in biosynthesis of archaetidyl-myo-inositol, a compound essential for glycolipid biosynthesis in archaea.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19740749"/>
<rdfs:subClassOf rdf:resource="2.7.8.-"/>
<skos:broaderTransitive rdf:resource="2.7.8.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.39#SIP0ABC85102971EE6A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1D-myo-inositol 3-phosphate + CDP-2,3-bis-O-(phytanyl)-sn-glycerol = CMP + H(+) + saturated 1-archaetidyl-1D-myo-inositol 3-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19740749">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
