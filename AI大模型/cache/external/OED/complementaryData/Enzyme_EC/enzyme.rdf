<rdfs:label>4-O-beta-D-mannopyranosyl-D-glucopyranose + phosphate = alpha-D-mannose 1-phosphate + D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21539815">
