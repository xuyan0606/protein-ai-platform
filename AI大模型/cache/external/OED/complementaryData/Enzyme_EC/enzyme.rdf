<rdf:Description rdf:about="1.8.5.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thiosulfate dehydrogenase (quinone)</skos:prefLabel>
<skos:altLabel>thiosulfate:quinone oxidoreductase</skos:altLabel>
<skos:altLabel>thiosulfate oxidoreductase, tetrathionate-forming</skos:altLabel>
<skos:altLabel>TQO</skos:altLabel>
<activity rdf:resource="1.8.5.2#SIP04398D62172DB9E5"/>
<rdfs:comment>The reaction can also proceed with ferricyanide as the electron acceptor, but more slowly.</rdfs:comment>
<rdfs:comment>Unlike EC 1.8.2.2, this enzyme cannot utilize cytochrome c as an acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15306018"/>
<rdfs:subClassOf rdf:resource="1.8.5.-"/>
<skos:broaderTransitive rdf:resource="1.8.5.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.5.2#SIP04398D62172DB9E5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-decylubiquinone + 2 thiosulfate = 6-decylubiquinol + tetrathionate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15306018">
