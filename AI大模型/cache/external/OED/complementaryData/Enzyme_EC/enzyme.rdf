<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endonucleolytic cleavage of DNA to give specific double-stranded fragments with terminal 5'-phosphates.</rdfs:label>
</rdf:Description>
