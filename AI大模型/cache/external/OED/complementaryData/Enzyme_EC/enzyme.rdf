<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>naringenin 7-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.232#SIP311CACB6DFD288F8"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of the sakuranetin, an inducible defense mechanism of Oryza sativa against pathogen attack.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10814825"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
