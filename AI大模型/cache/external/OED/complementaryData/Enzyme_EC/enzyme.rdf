<rdf:Description rdf:about="4.2.1.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carbonic anhydrase</skos:prefLabel>
<skos:altLabel>carbonate dehydratase</skos:altLabel>
<skos:altLabel>carbonate hydro-lyase</skos:altLabel>
<skos:altLabel>carbonic dehydratase</skos:altLabel>
<activity rdf:resource="4.2.1.1#SIP73B926857673080E"/>
<rdfs:comment>The enzyme catalyzes the reversible hydration of dissolved CO2 to carbonic acid, which dissociates to give hydrogencarbonate above neutral pH.</rdfs:comment>
<rdfs:comment>It is widespread and found in archaea, bacteria, and eukaryotes.</rdfs:comment>
<rdfs:comment>Three distinct classes exist, and appear to have evolved independently.</rdfs:comment>
<rdfs:comment>Contains zinc.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2433278"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6430186"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10924115"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10978542"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11316870"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14563877"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.1#SIP73B926857673080E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + hydrogencarbonate = CO2 + H2O.</rdfs:label>
</rdf:Description>
