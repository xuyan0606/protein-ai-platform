</rdf:Description>
<rdf:Description rdf:about="1.14.13.232">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>6-methylpretetramide 4-monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.13.232#SIP4EF7D0166AC8AF09"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces rimosus, participates in the biosynthesis of tetracycline antibiotics.</rdfs:comment>
<rdfs:comment>That bacterium possesses two enzymes that can catalyze the reaction - OxyE is the main isozyme, while OxyL has a lower activity.</rdfs:comment>
<rdfs:comment>OxyL is bifunctional, and its main function is EC 1.14.13.233.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18422316"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19472250"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.232#SIP4EF7D0166AC8AF09">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-methylpretetramide + 2 H(+) + NADPH + O2 = 4-hydroxy-6-methylpretetramide + H2O + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18422316">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18422316"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18422316"/>
</rdf:Description>
