<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hexadecanoate + O2 + reduced [NADPH--hemoprotein reductase] = 16-hydroxyhexadecanoate + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
