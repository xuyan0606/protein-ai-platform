<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4 Fe(II)-[cytochrome c] + 8 H(+)(in) + O2 = 4 Fe(III)-[cytochrome c] + 4 H(+)(out) + 2 H2O.</rdfs:label>
</rdf:Description>
