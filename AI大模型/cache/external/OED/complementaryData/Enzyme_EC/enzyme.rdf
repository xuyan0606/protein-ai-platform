<rdfs:label>(E)-caffeoyl-CoA + S-adenosyl-L-methionine = (E)-feruloyl-CoA + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.105">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-benzoyl-4-hydroxyanthranilate 4-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.105#SIPA02F95ACCAB1EE1B"/>
