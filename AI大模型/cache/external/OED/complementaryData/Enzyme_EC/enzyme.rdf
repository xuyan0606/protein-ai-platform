<rdf:Description rdf:about="2.4.1.123">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>inositol 3-alpha-galactosyltransferase</skos:prefLabel>
<skos:altLabel>galactinol synthase</skos:altLabel>
<skos:altLabel>inositol 1-alpha-galactosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.123#SIP970313C7015C06B7"/>
<rdfs:comment>An enzyme from plants involved in the formation of raffinose and stachyose (cf. EC 2.4.1.67 and EC 2.4.1.82).</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
