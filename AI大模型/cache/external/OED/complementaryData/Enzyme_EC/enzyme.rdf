<skos:altLabel>phosphoribosylformylglycinamidine synthetase</skos:altLabel>
<activity rdf:resource="6.3.5.3#SIPAFC1836110B187D5"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13416226"/>
