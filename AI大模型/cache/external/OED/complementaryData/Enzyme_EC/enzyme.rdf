<rdf:Description rdf:about="3.1.3.57">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>inositol-1,4-bisphosphate 1-phosphatase</skos:prefLabel>
<skos:altLabel>inositol polyphosphate 1-phosphatase</skos:altLabel>
<activity rdf:resource="3.1.3.57#SIP8375F4985D3E0BEB"/>
<rdfs:comment>Acts on inositol 1,4-bisphosphate and inositol 1,3,4-trisphosphate (forming inositol 3,4-bisphosphate) with similar Vmax for both substrates, but with a 5 times higher affinity for the bisphosphate.</rdfs:comment>
<rdfs:comment>Does not act on inositol 1-phosphate, inositol 1,4,5-trisphosphate or inositol 1,3,4,5-tetrakisphosphate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2824473"/>
