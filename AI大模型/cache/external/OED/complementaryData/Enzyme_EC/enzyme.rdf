<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,6-dihydroxypseudooxynicotine + H2O = 2,6-dihydroxypyridine + 4-(methylamino)butanoate + H(+).</rdfs:label>
</rdf:Description>
