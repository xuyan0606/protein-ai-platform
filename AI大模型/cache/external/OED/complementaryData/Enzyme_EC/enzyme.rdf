<skos:prefLabel>3-oxoisoapionate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.120#SIP45EB5826EE5B016C"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29867142"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.120#SIP45EB5826EE5B016C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-oxoisoapionate + H(+) = CO2 + L-erythrulose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/29867142">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/29867142"/>
