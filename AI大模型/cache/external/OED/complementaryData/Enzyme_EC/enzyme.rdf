<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-5,6,7,8-tetrahydrofolate + vanillate = (6S)-5-methyl-5,6,7,8-tetrahydrofolate + 3,4-dihydroxybenzoate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.341#SIPEB1F835B9038CAEA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-5,6,7,8-tetrahydrofolate + 3-O-methylgallate = (6S)-5-methyl-5,6,7,8-tetrahydrofolate + 3,4,5-trihydroxybenzoate.</rdfs:label>
</rdf:Description>
