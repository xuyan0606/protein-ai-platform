<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolyzes polypeptides on the amino-side of Asp in -Xaa-|-Asp-. Acts very slowly on -Xaa-|-Glu.</rdfs:label>
</rdf:Description>
