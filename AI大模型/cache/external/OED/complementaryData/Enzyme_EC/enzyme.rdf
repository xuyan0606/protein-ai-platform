</rdf:Description>
<rdf:Description rdf:about="3.4.23.52">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>preflagellin peptidase</skos:prefLabel>
<activity rdf:resource="3.4.23.52#SIP6B345AD5538E9159"/>
<rdfs:comment>An aspartic peptidase from Archaea but not bacteria.</rdfs:comment>
<rdfs:comment>In peptidase family A24 (type IV prepilin peptidase family).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11934494"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19717585"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21765428"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.52#SIP6B345AD5538E9159">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Cleaves the signal peptide of 3 to 12 amino acids from the N-terminal of preflagellin, usually at Arg-Gly-|- or Lys-Gly-|-, to release flagellin.</rdfs:label>
</rdf:Description>
