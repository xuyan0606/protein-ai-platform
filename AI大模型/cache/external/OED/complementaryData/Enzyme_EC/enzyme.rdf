<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H(+) + H2O + O-ureido-D-serine = ADP + CO2 + D-cycloserine + NH4(+) + phosphate.</rdfs:label>
</rdf:Description>
