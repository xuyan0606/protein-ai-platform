<rdf:Description rdf:about="6.3.1.10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>adenosylcobinamide-phosphate synthase</skos:prefLabel>
<activity rdf:resource="6.3.1.10#SIP7B33CBFEA5B065B1"/>
<activity rdf:resource="6.3.1.10#SIP7762895A31C06412"/>
<rdfs:comment>This enzyme forms part of the anaerobic cobalamin biosynthesis pathway.</rdfs:comment>
<rdfs:comment>One of the substrates for this reaction, (R)-1-aminopropan-2-yl phosphate, is produced by CobD (EC 4.1.1.81).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11939774"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12195810"/>
