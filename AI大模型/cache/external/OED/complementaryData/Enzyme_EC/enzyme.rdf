<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>calcitriol + 2 H(+) + O2 + 2 reduced [adrenodoxin] = calcitetrol + H2O + 2 oxidized [adrenodoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.16#SIPC14CEE5FD37779EB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>calcidiol + 2 H(+) + O2 + 2 reduced [adrenodoxin] = H2O + 2 oxidized [adrenodoxin] + secalciferol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.16#SIPE3B72BBB1ACC46A2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>calcitetrol + 2 H(+) + O2 + 2 reduced [adrenodoxin] = (1S)-1,25-dihydroxy-24-oxocalciol + 2 H2O + 2 oxidized [adrenodoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.16#SIP4A531D06BFCF533B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(1S)-1,25-dihydroxy-24-oxocalciol + 2 H(+) + O2 + 2 reduced [adrenodoxin] = (1S)-1,23,25-trihydroxy-24-oxocalciol + H2O + 2 oxidized [adrenodoxin].</rdfs:label>
</rdf:Description>
