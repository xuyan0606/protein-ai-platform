<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-hydroxycyclohex-1-ene-1-carbonyl-CoA + NAD(+) = 6-oxocyclohex-1-ene-1-carbonyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
