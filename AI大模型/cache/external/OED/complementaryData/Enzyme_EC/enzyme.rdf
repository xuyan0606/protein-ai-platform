<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4alpha-methyl-5alpha-cholest-7-en-3beta-ol + NADP(+) = 4alpha-methyl-5alpha-cholest-7-en-3-one + H(+) + NADPH.</rdfs:label>
</rdf:Description>
