<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-homocysteine + O-acetyl-L-serine = acetate + H(+) + L,L-cystathionine.</rdfs:label>
</rdf:Description>
