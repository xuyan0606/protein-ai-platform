<replaces rdf:resource="3.6.1.n1"/>
<skos:prefLabel>D-aminoacyl-tRNA deacylase</skos:prefLabel>
<skos:altLabel>D-tyrosyl-tRNA(Tyr) aminoacylhydrolase</skos:altLabel>
<skos:altLabel>D-Tyr-tRNA(Tyr) deacylase</skos:altLabel>
<activity rdf:resource="3.1.1.96#SIP40F5C2F1F6206219"/>
<activity rdf:resource="3.1.1.96#SIPCB9A87FB45FA74B6"/>
<activity rdf:resource="3.1.1.96#SIPA2E6DADF127B79FE"/>
<activity rdf:resource="3.1.1.96#SIP3A0C9F29BB0878C7"/>
<activity rdf:resource="3.1.1.96#SIPFBF8FD54B41A0890"/>
<activity rdf:resource="3.1.1.96#SIP5845604792162200"/>
<rdfs:comment>The enzyme, found in all domains of life, can cleave mischarged glycyl-tRNA(Ala).</rdfs:comment>
<rdfs:comment>The enzyme from Escherichia coli can cleave D-tyrosyl-tRNA(Tyr), D-aspartyl-tRNA(Asp) and D-tryptophanyl-tRNA(Trp).</rdfs:comment>
<rdfs:comment>Whereas the enzyme from the archaeon Pyrococcus abyssi is a zinc protein, the enzyme from Escherichia coli does not carry any zinc.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10918062"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11568181"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16844682"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17251192"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28362257"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIP40F5C2F1F6206219">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a D-aminoacyl-tRNA + H2O = a D-alpha-amino acid + a tRNA + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIPCB9A87FB45FA74B6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycyl-tRNA(Ala) + H2O = glycine + H(+) + tRNA(Ala).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIPA2E6DADF127B79FE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-phenylalanyl-tRNA(Phe) + H2O = D-phenylalanine + H(+) + tRNA(Phe).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIP3A0C9F29BB0878C7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-aspartyl-tRNA(Asp) + H2O = D-aspartate + H(+) + tRNA(Asp).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIPFBF8FD54B41A0890">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-tryptophanyl-tRNA(Trp) + H2O = D-tryptophan + tRNA(Trp).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.96#SIP5845604792162200">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-tyrosyl-tRNA(Tyr) + H2O = D-tyrosine + tRNA(Tyr).</rdfs:label>
</rdf:Description>
