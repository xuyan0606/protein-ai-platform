<rdf:Description rdf:about="2.1.3.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-hydroxymethylcephem carbamoyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.3.7#SIP66F9B70E9B18B8C2"/>
<rdfs:comment>Acts on a wide range of 3-hydroxymethylcephems (a subclass of the cephalosporin antibiotics).</rdfs:comment>
<rdfs:comment>Activated by ATP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6248024"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.7#SIP66F9B70E9B18B8C2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + a 3-hydroxymethylceph-3-em-4-carboxylate = phosphate + a 3-carbamoyloxymethylcephem.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6248024">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
