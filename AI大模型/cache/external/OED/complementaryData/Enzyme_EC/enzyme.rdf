<skos:prefLabel>5'-deoxyadenosine deaminase</skos:prefLabel>
<activity rdf:resource="3.5.4.41#SIPDA320823B403C068"/>
<rdfs:comment>The enzyme from the archaeon Methanocaldococcus jannaschii is involved in the recycling of 5'-deoxyadenosine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24375099"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.4.41#SIPDA320823B403C068">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5'-deoxyadenosine + H(+) + H2O = 5'-deoxyinosine + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24375099">
