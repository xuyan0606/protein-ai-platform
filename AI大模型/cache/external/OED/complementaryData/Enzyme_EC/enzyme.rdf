<activity rdf:resource="3.1.1.28#SIPFBB4FAC1C4DEC7B5"/>
<rdfs:comment>Acts on higher fatty acid (C6 to C18) esters of L-carnitine.</rdfs:comment>
<rdfs:comment>Highest activity is with O-decanoyl-L-carnitine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4026306"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5806585"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
