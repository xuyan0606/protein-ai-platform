<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CoA + NADP(+) + succinate semialdehyde = H(+) + NADPH + succinyl-CoA.</rdfs:label>
</rdf:Description>
