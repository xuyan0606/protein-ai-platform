<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>methylazoxymethanol + UDP-alpha-D-glucose = cycasin + H(+) + UDP.</rdfs:label>
</rdf:Description>
