<skos:broaderTransitive rdf:resource="3.4.22.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.22.55#SIPA6F8F616DB178885">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Strict requirement for an Asp residue at P1, with 316-Asp being essential for proteolytic activity and has a preferred cleavage sequence of Val-Asp-Val-Ala-Asp-|-.</rdfs:label>
</rdf:Description>
