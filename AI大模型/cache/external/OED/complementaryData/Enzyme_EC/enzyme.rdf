<rdf:Description rdf:about="1.14.19.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sn-2 palmitoyl-lipid 9-desaturase</skos:prefLabel>
<activity rdf:resource="1.14.19.27#SIP4C3CE5D7BAF5A4EA"/>
<rdfs:comment>The enzyme, characterized from the cyanobacterium Nostoc sp. 36, introduces a cis double bond at carbon 9 of palmitoyl groups (16:0) attached to the sn-2 position of glycerolipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16689682"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.27#SIP4C3CE5D7BAF5A4EA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1-acyl-2-hexadecanoyl-glycerolipid + 2 H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] = a 1-acyl-2-[(9Z)-hexadecenoyl]-glycerolipid + 2 H2O + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16689682">
