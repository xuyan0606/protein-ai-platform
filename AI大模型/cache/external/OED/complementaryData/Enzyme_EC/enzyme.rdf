<rdf:Description rdf:about="3.13.2.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.3.1.1"/>
<skos:prefLabel>adenosylhomocysteinase</skos:prefLabel>
<skos:altLabel>adenosylhomocysteine hydrolase</skos:altLabel>
<skos:altLabel>AdoHcyase</skos:altLabel>
<skos:altLabel>S-adenosylhomocysteinase</skos:altLabel>
<skos:altLabel>S-adenosylhomocysteine hydrolase</skos:altLabel>
<skos:altLabel>S-adenosylhomocysteine synthase</skos:altLabel>
<skos:altLabel>SAHase</skos:altLabel>
<activity rdf:resource="3.13.2.1#SIPA183A20C7E0364F1"/>
<rdfs:comment>The enzyme contains one tightly bound NAD(+) per subunit.</rdfs:comment>
<rdfs:comment>This appears to bring about a transient oxidation at C-3' of the 5'-deoxyadenosine residue, thus labilizing the thioether bond, cf. EC 5.5.1.4.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/762125"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13641268"/>
<rdfs:subClassOf rdf:resource="3.13.2.-"/>
<skos:broaderTransitive rdf:resource="3.13.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.13.2.1#SIPA183A20C7E0364F1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + S-adenosyl-L-homocysteine = adenosine + L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/762125">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
