<rdfs:label>1-O-(trans-sinapoyl)-beta-D-glucose + choline = D-glucose + O-sinapoylcholine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.92">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sinapoylglucose--malate O-sinapoyltransferase</skos:prefLabel>
