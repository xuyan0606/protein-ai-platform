<rdfs:label>13,14-dihydro-15-oxo-prostaglandin E2 + NADP(+) = 15-oxoprostaglandin E2 + H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.48#SIPD0106584EBF84EB5">
