<rdf:Description rdf:about="4.2.3.154">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>demethyl-4-deoxygadusol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.154#SIPA0916EA1F510F2D2"/>
<rdfs:comment>The enzyme, characterized from the cyanobacterium Nostoc punctiforme PCC 73102, is involved in the biosynthesis of the sunscreen compound shinorine. cf. EC 4.2.3.152 and EC 4.2.3.155.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20813918"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22741921"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.154#SIPA0916EA1F510F2D2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-sedoheptulose 7-phosphate = (R)-demethyl-4-deoxygadusol + H(+) + H2O + phosphate.</rdfs:label>
</rdf:Description>
