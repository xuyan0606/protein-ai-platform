<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>N-demethylindolmycin + S-adenosyl-L-methionine = H(+) + indolmycin + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
