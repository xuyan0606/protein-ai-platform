<rdf:Description rdf:about="2.1.1.161">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dimethylglycine N-methyltransferase</skos:prefLabel>
<skos:altLabel>DMT</skos:altLabel>
<activity rdf:resource="2.1.1.161#SIP26E3EF851CEF1284"/>
<rdfs:comment>This enzyme, from the marine cyanobacterium Synechococcus sp. strain WH8102, differs from EC 2.1.1.157 in that it cannot use sarcosine as an alternative substrate.</rdfs:comment>
<rdfs:comment>Betaine is a 'compatible solute' that enables cyanobacteria to cope with osmotic stress by maintaining a positive cellular turgor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17019606"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.161#SIP26E3EF851CEF1284">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>N,N-dimethylglycine + S-adenosyl-L-methionine = glycine betaine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17019606">
