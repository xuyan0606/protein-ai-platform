<skos:prefLabel>pentalenolactone synthase</skos:prefLabel>
<activity rdf:resource="1.14.19.8#SIPD0275DFBD11F0D04"/>
<rdfs:comment>Isolated from the bacteria Streptomyces exfoliatus and Streptomyces arenae.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21284395"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.8#SIPD0275DFBD11F0D04">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + O2 + pentalenolactone F + 2 reduced [2Fe-2S]-[ferredoxin] = 2 H2O + 2 oxidized [2Fe-2S]-[ferredoxin] + pentalenolactone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21284395">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
