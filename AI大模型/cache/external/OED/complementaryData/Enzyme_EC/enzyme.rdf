<rdfs:comment>Will also use as acceptor aspulvinone G, a hydroxylated derivative of the complex phenolic pigment aspulvinone E.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/678538"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
