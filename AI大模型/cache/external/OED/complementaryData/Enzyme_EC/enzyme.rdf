<rdf:Description rdf:about="2.3.1.270">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lyso-ornithine lipid O-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.270#SIP4FCAA9E68C4AB683"/>
<rdfs:comment>This bacterial enzyme catalyzes the second step in the formation of ornithine lipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12139618"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17921310"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21535098"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.270#SIP4FCAA9E68C4AB683">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a fatty acyl-[ACP] + a lyso-ornithine lipid = an N(2)-[(3R)-3-(acyloxy)acyl]-L-ornithine lipid + holo-[ACP].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12139618">
