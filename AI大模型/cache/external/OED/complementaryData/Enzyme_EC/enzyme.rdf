<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-tetrahydrocolumbamine + O2 + reduced [NADPH--hemoprotein reductase] = (S)-canadine + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
