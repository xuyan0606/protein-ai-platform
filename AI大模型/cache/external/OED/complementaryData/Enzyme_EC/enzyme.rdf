<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Fe-coproporphyrin III + 2 H(+) + 2 H2O2 = 2 CO2 + 4 H2O + heme b.</rdfs:label>
</rdf:Description>
