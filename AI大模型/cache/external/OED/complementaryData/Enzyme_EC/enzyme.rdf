<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[pyruvate, water dikinase] + ADP = [pyruvate, water dikinase]-phosphate + AMP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20044937">
