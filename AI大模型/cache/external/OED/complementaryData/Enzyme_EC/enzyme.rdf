<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-glutamate + tyramine = ADP + gamma-L-glutamyltyramine + H(+) + phosphate.</rdfs:label>
</rdf:Description>
