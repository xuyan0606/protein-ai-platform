<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O + mitochondrial-proteinSide 1 = ADP + phosphate + mitochondrial-proteinSide 2.</rdfs:label>
</rdf:Description>
