<rdf:Description rdf:about="2.7.1.237">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GTP-dependent dephospho-CoA kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.237#SIP9401544E3D0AA0BF"/>
<rdfs:comment>The enzyme, characterized from the archaeon Thermococcus kodakarensis, participates in a coenzyme A biosynthesis pathway. cf. EC 2.7.1.24.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/31337720"/>
