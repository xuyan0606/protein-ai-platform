<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>butanoyl-CoA + phosphate = butanoyl phosphate + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diacylglycerol O-acyltransferase</skos:prefLabel>
<skos:altLabel>diglyceride acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.20#SIP9B116C131B110185"/>
<rdfs:comment>Palmitoyl-CoA and other long-chain acyl-CoAs can act as donors.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/947894"/>
