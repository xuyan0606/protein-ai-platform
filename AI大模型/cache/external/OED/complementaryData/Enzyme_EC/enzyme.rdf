<rdf:Description rdf:about="1.3.1.100">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>chanoclavine-I aldehyde reductase</skos:prefLabel>
<activity rdf:resource="1.3.1.100#SIPE8E1600F37AED7CE"/>
<rdfs:comment>The enzyme participates in the biosynthesis of fumigaclavine C, an ergot alkaloid produced by some fungi of the Trichocomaceae family.</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the reduction of chanoclavine-I aldehyde to dihydrochanoclavine-I aldehyde.</rdfs:comment>
<rdfs:comment>This hydrolyzes spontaneously to form 6,8-dimethyl-6,7-didehydroergoline, which is converted to festuclavine by EC 1.5.1.44.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20102147"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20435769"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20526482"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21898587"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.100#SIPE8E1600F37AED7CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dihydrochanoclavine-I aldehyde + NADP(+) = chanoclavine-I aldehyde + H(+) + NADPH.</rdfs:label>
</rdf:Description>
