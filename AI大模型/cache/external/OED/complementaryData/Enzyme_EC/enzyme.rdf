<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>demethylphylloquinol + S-adenosyl-L-methionine = H(+) + phylloquinol + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
