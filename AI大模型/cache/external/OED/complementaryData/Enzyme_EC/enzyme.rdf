<rdf:Description rdf:about="4.2.1.139">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.1.1.246"/>
<skos:prefLabel>pterocarpan synthase</skos:prefLabel>
<skos:altLabel>2',7-dihydroxy-4'-methoxyisoflavanol dehydratase</skos:altLabel>
<skos:altLabel>2'-hydroxyisoflavanol 4,2'-dehydratase</skos:altLabel>
<skos:altLabel>7,2'-dihydroxy-4'-methoxyisoflavanol dehydratase</skos:altLabel>
<skos:altLabel>medicarpan synthase</skos:altLabel>
<skos:altLabel>medicarpin synthase</skos:altLabel>
<activity rdf:resource="4.2.1.139#SIP7D538737F57526A7"/>
<activity rdf:resource="4.2.1.139#SIPD0D96C97E91C38D8"/>
<activity rdf:resource="4.2.1.139#SIPC99355624F57398F"/>
<activity rdf:resource="4.2.1.139#SIPA8B1FDE00A68D0F5"/>
<activity rdf:resource="4.2.1.139#SIPCDEFCB2655022337"/>
<rdfs:comment>The enzyme catalyzes the formation of the additional ring in pterocarpan, the basic structure of phytoalexins produced by leguminous plants, including (-)-medicarpin, (+)-medicarpin, (-)-maackiain and (+)-maackiain.</rdfs:comment>
<rdfs:comment>The enzyme requires that the hydroxyl group at C-4 of the substrate is in the (4R) configuration.</rdfs:comment>
<rdfs:comment>The configuration of the hydrogen atom at C-3 determines whether the pterocarpan is the (+)- or (-)-enantiomer.</rdfs:comment>
<rdfs:comment>The enzyme contains amino acid motifs characteristic of dirigent proteins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7805842"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8071365"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28394400"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.139#SIP7D538737F57526A7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (4R)-4,2'-dihydroxyisoflavan = a pterocarpan + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.139#SIPD0D96C97E91C38D8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R,4R)-7,2'-dihydroxy-4'-methoxyisoflavanol = (-)-medicarpin + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.139#SIPC99355624F57398F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3S,4R)-7,2'-dihydroxy-4'-methoxyisoflavanol = (+)-medicarpin + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.139#SIPA8B1FDE00A68D0F5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R,4R)-3-(6-hydroxy-1,3-benzodioxol-5-yl)-3,4-dihydro-2H-chromene-4,7-diol = (-)-maackiain + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.139#SIPCDEFCB2655022337">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R,4R)-7,2',4'-trihydroxyisoflavanol = (6aR,11aR)-3,9-dihydroxypterocarpan + H2O.</rdfs:label>
</rdf:Description>
