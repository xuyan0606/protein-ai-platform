<rdf:Description rdf:about="2.4.1.116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyanidin 3-O-rutinoside 5-O-glucosyltransferase</skos:prefLabel>
<skos:altLabel>cyanidin-3-rhamnosylglucoside 5-O-glucosyltransferase</skos:altLabel>
<skos:altLabel>uridine diphosphoglucose-cyanidin 3-rhamnosylglucoside 5-O-glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.116#SIP926617CA5BAC0B75"/>
<activity rdf:resource="2.4.1.116#SIPF908EEF9036167F2"/>
<rdfs:comment>Isolated from the plants Silene dioica (red campion), Iris ensata (Japanese iris) and Iris hollandica (Dutch iris).</rdfs:comment>
<rdfs:comment>Also acts on the 3-O-rutinosides of pelargonidin, delphinidin and malvidin, but not the corresponding glucosides or 6-acylglucosides.</rdfs:comment>
<rdfs:comment>The enzyme does not catalyze the glucosylation of the 5-hydroxy group of cyanidin 3-glucoside.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/751641"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.116#SIP926617CA5BAC0B75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyanidin 3-O-rutinoside + UDP-alpha-D-glucose = cyanidin 3-O-rutinoside 5-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.116#SIPF908EEF9036167F2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>pelargonidin 3-O-rutinoside + UDP-alpha-D-glucose = H(+) + pelargonidin 3-O-rutinoside 5-O-beta-D-glucoside + UDP.</rdfs:label>
</rdf:Description>
