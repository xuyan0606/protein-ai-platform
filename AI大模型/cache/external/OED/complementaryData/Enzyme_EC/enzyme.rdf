<activity rdf:resource="2.3.1.100#SIP7878EC9A0243D288"/>
<rdfs:comment>The enzyme in brain transfers long-chain acyl residues to the endogenous myelin proteolipid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3818589"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
