<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-arginyl-[protein] + S-adenosyl-L-methionine = H(+) + N(5)-methyl-L-arginyl-[protein] + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
