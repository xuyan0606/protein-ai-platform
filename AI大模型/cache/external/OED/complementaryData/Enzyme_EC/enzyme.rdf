<skos:prefLabel>N-feruloylglycine deacylase</skos:prefLabel>
<activity rdf:resource="3.5.1.71#SIPD78053856AF281B5"/>
<rdfs:comment>Hydrolyzes a range of L-amino acids from the cinnamoyl and substituted cinnamoyl series.</rdfs:comment>
<rdfs:comment>Not identical with EC 3.5.1.14.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
