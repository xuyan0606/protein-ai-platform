<rdf:Description rdf:about="2.7.7.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pantetheine-phosphate adenylyltransferase</skos:prefLabel>
<skos:altLabel>3'-dephospho-CoA pyrophosphorylase</skos:altLabel>
<skos:altLabel>dephospho-CoA diphosphorylase</skos:altLabel>
<skos:altLabel>dephospho-CoA pyrophosphorylase</skos:altLabel>
<skos:altLabel>dephospho-coenzyme A pyrophosphorylase</skos:altLabel>
<skos:altLabel>phosphopantetheine adenylyltransferase</skos:altLabel>
<skos:altLabel>PPAT</skos:altLabel>
<activity rdf:resource="2.7.7.3#SIP86E4EBB1A6C765B2"/>
<rdfs:comment>The enzyme from several bacteria (e.g. Escherichia coli, Bacillus subtilis and Haemophilus influenzae) has been shown to be bifunctional and also to possess the activity of EC 2.3.1.157.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8389542"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10329792"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10480925"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.3#SIP86E4EBB1A6C765B2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-4'-phosphopantetheine + ATP + H(+) = 3'-dephospho-CoA + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8389542">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8389542"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/8389542"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10329792">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/10329792"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/10329792"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10480925">
