<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>geraniol isomerase</skos:prefLabel>
<activity rdf:resource="5.4.4.4#SIPC639D8E932F815A4"/>
<rdfs:comment>In absence of oxygen the bifunctional linalool dehydratase-isomerase can catalyze in vitro two reactions, the isomerization of (3S)-linalool to geraniol and the hydration of myrcene to (3S)-linalool, the latter activity being classified as EC 4.2.1.127.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20663876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21950166"/>
<rdfs:subClassOf rdf:resource="5.4.4.-"/>
<skos:broaderTransitive rdf:resource="5.4.4.-"/>
</rdf:Description>
