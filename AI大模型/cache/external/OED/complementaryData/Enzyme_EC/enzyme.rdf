</rdf:Description>
<rdf:Description rdf:about="2.1.1.348">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>mRNA m(6)A methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.348#SIP2112DDA7B67DC7CA"/>
<rdfs:comment>This enzyme, found in eukaryotes, methylates adenines in mRNA with the consensus sequence RRACH.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24316715"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28121234"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.348#SIP2112DDA7B67DC7CA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an adenosine in mRNA + S-adenosyl-L-methionine = an N(6)-methyladenosine in mRNA + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24316715">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24316715"/>
