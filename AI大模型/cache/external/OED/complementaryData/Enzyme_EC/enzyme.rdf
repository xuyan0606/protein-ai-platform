<rdf:Description rdf:about="1.8.4.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>enzyme-thiol transhydrogenase (glutathione-disulfide)</skos:prefLabel>
<skos:altLabel>[xanthine-dehydrogenase]:oxidized-glutathione S-oxidoreductase</skos:altLabel>
<skos:altLabel>enzyme-thiol transhydrogenase (oxidized-glutathione)</skos:altLabel>
<skos:altLabel>glutathione-dependent thiol:disulfide oxidoreductase</skos:altLabel>
<skos:altLabel>thiol:disulfide oxidoreductase</skos:altLabel>
<activity rdf:resource="1.8.4.7#SIP02F4E7E66A26F961"/>
<rdfs:comment>Converts EC 1.17.1.4 into EC 1.17.3.2 in the presence of glutathione disulfide.</rdfs:comment>
<rdfs:comment>Also reduces the disulfide bond of ricin.</rdfs:comment>
<rdfs:comment>Not inhibited by Cu(2+) or thiol reagents.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6960894"/>
<rdfs:subClassOf rdf:resource="1.8.4.-"/>
<skos:broaderTransitive rdf:resource="1.8.4.-"/>
</rdf:Description>
