<skos:prefLabel>holocytochrome-c synthase</skos:prefLabel>
<skos:altLabel>cytochrome c heme-lyase</skos:altLabel>
<skos:altLabel>cytochrome c synthase</skos:altLabel>
<activity rdf:resource="4.4.1.17#SIPB4DB0E73DDC61F96"/>
<rdfs:comment>In the reverse direction, the enzyme catalyzes the attachment of heme to two cysteine residues in the protein, forming thioether links.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3034577"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
