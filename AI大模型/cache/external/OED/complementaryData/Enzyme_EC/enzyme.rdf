<rdf:Description rdf:about="1.5.1.42">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>FMN reductase (NADH)</skos:prefLabel>
<skos:altLabel>NADH-dependent FMN reductase</skos:altLabel>
<activity rdf:resource="1.5.1.42#SIPA179038050CDCA67"/>
<rdfs:comment>The enzyme often forms a two-component system with monooxygenases.</rdfs:comment>
<rdfs:comment>Unlike EC 1.5.1.38 and EC 1.5.1.39, this enzyme has a strong preference for NADH over NADPH, although some activity with the latter is observed.</rdfs:comment>
<rdfs:comment>While FMN is the preferred substrate, FAD can also be used with much lower activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/47604"/>
<citation rdf:resource="http://purl.uniprot.org/citations/1175652"/>
<citation rdf:resource="http://purl.uniprot.org/citations/1735711"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8167139"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.1.42#SIPA179038050CDCA67">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + NAD(+) = FMN + 2 H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/47604">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/47604"/>
