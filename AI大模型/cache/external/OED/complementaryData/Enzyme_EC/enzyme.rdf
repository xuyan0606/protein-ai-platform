<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an ultra-long-chain di-unsaturated fatty acyl-[ACP] + H(+) + malonyl-[ACP] = a 3-oxo-ultra-long-chain di-unsaturated fatty acyl-[ACP] + CO2 + holo-[ACP].</rdfs:label>
</rdf:Description>
