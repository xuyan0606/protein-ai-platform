<activity rdf:resource="2.3.1.107#SIP71793A78B794D1DF"/>
<rdfs:comment>Catalyzes the final step in the biosynthesis of vindoline from tabersonine in the Madagascar periwinkle, Catharanthus roseus.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
