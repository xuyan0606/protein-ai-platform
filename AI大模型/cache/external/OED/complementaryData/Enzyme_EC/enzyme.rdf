</rdf:Description>
<rdf:Description rdf:about="4.2.99.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tuliposide A-converting enzyme</skos:prefLabel>
<skos:altLabel>6-O-(4 -hydroxy-2 -methylenebutyryl)-D-glucose acyltransferase (lactone-forming)</skos:altLabel>
<skos:altLabel>tuliposide-converting enzyme</skos:altLabel>
<activity rdf:resource="4.2.99.22#SIP4735B5D5C8A91071"/>
<rdfs:comment>Isolated from the plant Tulipa gesneriana (tulip).</rdfs:comment>
<rdfs:comment>The reaction is an intramolecular transesterification producing the lactone.</rdfs:comment>
<rdfs:comment>The enzyme also has a weak activity with 6-tuliposide B and 6-O-benzoyl-D-glucose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19661715"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22474185"/>
<rdfs:subClassOf rdf:resource="4.2.99.-"/>
<skos:broaderTransitive rdf:resource="4.2.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.22#SIP4735B5D5C8A91071">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-tuliposide A = D-glucose + tulipalin A.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19661715">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19661715"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/19661715"/>
</rdf:Description>
