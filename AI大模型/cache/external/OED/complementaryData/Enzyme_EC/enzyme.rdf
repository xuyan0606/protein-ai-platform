<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + pyridoxal 5'-phosphate = phosphate + pyridoxal.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.3.74#SIPD6BCCE349F27A0CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>phosphate + pyridoxamine = H2O + pyridoxamine 5'-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.3.74#SIPE42B0EFF5CCC194B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + pyridoxine 5'-phosphate = phosphate + pyridoxine.</rdfs:label>
</rdf:Description>
