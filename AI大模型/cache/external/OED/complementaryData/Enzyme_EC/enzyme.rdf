<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O-acyl-(R)-carnitine = (R)-carnitine + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
