<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-cyclopenine = H(+) + methyl isocyanate + viridicatin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.99.27#SIPD8F10548037C5108">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-4'-methoxycyclopenine = 4'-methoxyviridicatin + H(+) + methyl isocyanate.</rdfs:label>
</rdf:Description>
