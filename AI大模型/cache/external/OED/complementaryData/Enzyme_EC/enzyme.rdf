<rdf:Description rdf:about="4.2.99.21">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isochorismate lyase</skos:prefLabel>
<skos:altLabel>isochorismate pyruvate lyase</skos:altLabel>
<activity rdf:resource="4.2.99.21#SIP6BCEF69AA745093B"/>
<rdfs:comment>This enzyme is part of the pathway of salicylate formation from chorismate, and forms an integral part of pathways that produce salicylate-derived siderophores, such as pyochelin and yersiniabactin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7500944"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16030197"/>
<rdfs:subClassOf rdf:resource="4.2.99.-"/>
<skos:broaderTransitive rdf:resource="4.2.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.21#SIP6BCEF69AA745093B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>isochorismate = pyruvate + salicylate.</rdfs:label>
</rdf:Description>
