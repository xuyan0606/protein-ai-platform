<skos:altLabel>mogrol C-3 hydroxyl glycosyltransferase</skos:altLabel>
<skos:altLabel>UGT74AC1</skos:altLabel>
<activity rdf:resource="2.4.1.350#SIPA05FE6A1878EBDD9"/>
<rdfs:comment>Isolated from the plant Siraitia grosvenorii (monk fruit).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25759326"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
