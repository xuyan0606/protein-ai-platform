<rdf:Description rdf:about="2.7.7.67">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.7.n2"/>
<skos:prefLabel>CDP-2,3-bis-(O-geranylgeranyl)-sn-glycerol synthase</skos:prefLabel>
<skos:altLabel>CDP-2,3-bis-O-(geranylgeranyl)-sn-glycerol synthase</skos:altLabel>
<skos:altLabel>CDP-archaeol synthase</skos:altLabel>
<skos:altLabel>CDP-unsaturated archaeol synthase</skos:altLabel>
<activity rdf:resource="2.7.7.67#SIP78FA7AF034809596"/>
<rdfs:comment>Catalyzes one of the steps in the biosynthesis of polar lipids in archaea, which are characterized by having an sn-glycero-1-phosphate backbone rather than an sn-glycero-3-phosphate backbone as is found in bacteria and eukaryotes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10960477"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12562787"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25219966"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.67#SIP78FA7AF034809596">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-bis-O-(geranylgeranyl)-sn-glycerol 1-phosphate + CTP + H(+) = CDP-2,3-bis-O-(geranylgeranyl)-sn-glycerol + diphosphate.</rdfs:label>
</rdf:Description>
