<rdf:Description rdf:about="2.7.7.101">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>DNA primase DnaG</skos:prefLabel>
<activity rdf:resource="2.7.7.101#SIP54FF01CBB7A7C918"/>
<rdfs:comment>The enzyme catalyzes the synthesis of short RNA sequences that are used as primers for EC 2.7.7.7, DNA-directed DNA polymerase.</rdfs:comment>
<rdfs:comment>It is found in bacteria and archaea.</rdfs:comment>
<rdfs:comment>The latter also have a second primase system (EC 2.7.7.102).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/340457"/>
<citation rdf:resource="http://purl.uniprot.org/citations/1569588"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11395402"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20122937"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
