<rdf:Description rdf:about="2.3.1.80">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cysteine-S-conjugate N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.80#SIP0CBD72A1121885ED"/>
<rdfs:comment>S-benzyl-L-cysteine and, in decreasing order of activity, S-butyl-L-cysteine, S-propyl-L-cysteine, O-benzyl-L-serine and S-ethyl-L-cysteine, can act as acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6892478"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
