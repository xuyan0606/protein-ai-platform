<rdf:Description rdf:about="2.5.1.113">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.5.1.n5"/>
<skos:prefLabel>[CysO sulfur-carrier protein]-thiocarboxylate-dependent cysteine synthase</skos:prefLabel>
<skos:altLabel>CysO-thiocarboxylate-dependent cysteine synthase</skos:altLabel>
<activity rdf:resource="2.5.1.113#SIP3306E5E2C0279E1D"/>
<rdfs:comment>The enzyme participates in an alternative pathway for L-cysteine biosynthesis that involves a protein-bound thiocarboxylate as the sulfide donor.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Mycobacterium tuberculosis also has very low activity with O(3)-acetyl-L-serine (cf. EC 2.5.1.65).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18771296"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18799456"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18842002"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19101553"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.113#SIP3306E5E2C0279E1D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[CysO sulfur-carrier protein]-Gly-NH-CH2-C(O)SH + O-phospho-L-serine = [CysO sulfur-carrier protein]-Gly-NH-CH2-C(O)-S-L-Cys + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18771296">
