<rdf:Description rdf:about="2.1.1.166">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>23S rRNA (uridine(2552)-2'-O)-methyltransferase</skos:prefLabel>
<skos:altLabel>FTSJ</skos:altLabel>
<skos:altLabel>Um(2552) 23S ribosomal RNA methyltransferase</skos:altLabel>
<skos:altLabel>Um2552 methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.166#SIP75923A5FAC56E77F"/>
<rdfs:comment>The enzyme catalyzes the 2'-O-methylation of the universally conserved U2552 in the A loop of 23S rRNA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10748051"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10983982"/>
