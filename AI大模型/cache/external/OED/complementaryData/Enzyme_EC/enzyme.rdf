<replaces rdf:resource="4.2.1.102"/>
<skos:prefLabel>cyclohexa-1,5-dienecarbonyl-CoA hydratase</skos:prefLabel>
<skos:altLabel>cyclohexa-1,5-diene-1-carbonyl-CoA hydratase</skos:altLabel>
<skos:altLabel>cyclohexa-1,5-diene-1-carboxyl-CoA hydratase</skos:altLabel>
<skos:altLabel>dienoyl-CoA hydratase</skos:altLabel>
<activity rdf:resource="4.2.1.100#SIP42AEF0CF312FD162"/>
<rdfs:comment>Forms part of the anaerobic benzoate degradation pathway, which also includes EC 1.3.8.6, EC 1.3.7.8 and EC 4.2.1.55.</rdfs:comment>
