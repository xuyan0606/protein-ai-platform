<skos:prefLabel>fumonisin B1 esterase</skos:prefLabel>
<activity rdf:resource="3.1.1.87#SIPE6A29C9EDD997430"/>
<rdfs:comment>The enzyme is involved in degradation of fumonisin B1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19922747"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
