<rdf:Description rdf:about="1.14.14.18">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.99.3"/>
<skos:prefLabel>heme oxygenase (biliverdin-producing)</skos:prefLabel>
<skos:altLabel>heme oxidase</skos:altLabel>
<skos:altLabel>heme oxygenase</skos:altLabel>
<skos:altLabel>heme oxygenase (decyclizing)</skos:altLabel>
<activity rdf:resource="1.14.14.18#SIP6A065A02A7DA17D5"/>
<rdfs:comment>This mammalian enzyme participates in the degradation of heme.</rdfs:comment>
<rdfs:comment>The terminal oxygen atoms that are incorporated into the carbonyl groups of pyrrole rings A and B of biliverdin are derived from two separate oxygen molecules.</rdfs:comment>
<rdfs:comment>The third oxygen molecule provides the oxygen atom that converts the alpha-carbon to CO.</rdfs:comment>
<rdfs:comment>The enzyme requires NAD(P)H and EC 1.6.2.4. cf. EC 1.14.15.20.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18477"/>
<citation rdf:resource="http://purl.uniprot.org/citations/105935"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4370250"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6897023"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12500973"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.18#SIP6A065A02A7DA17D5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>heme b + 3 O2 + 3 reduced [NADPH--hemoprotein reductase] = biliverdin IXalpha + CO + Fe(2+) + H(+) + 3 H2O + 3 oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
