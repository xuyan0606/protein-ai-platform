</rdf:Description>
<rdf:Description rdf:about="5.4.99.57">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>baruol synthase</skos:prefLabel>
<skos:altLabel>BARS1</skos:altLabel>
<activity rdf:resource="5.4.99.57#SIP7EE12138CF64BD21"/>
<rdfs:comment>The enzyme from Arabidopsis thaliana also produces traces of 22 other triterpenoids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17705488"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
</rdf:Description>
