<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-deoxy-6-sulfo-D-fructose + D-glyceraldehyde 3-phosphate = (2S)-3-sulfolactaldehyde + D-fructose 6-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.2.1.14#SIP7ED5211A3704D37A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-deoxy-6-sulfo-D-fructose + D-erythrose 4-phosphate = (2S)-3-sulfolactaldehyde + D-sedoheptulose 7-phosphate.</rdfs:label>
</rdf:Description>
