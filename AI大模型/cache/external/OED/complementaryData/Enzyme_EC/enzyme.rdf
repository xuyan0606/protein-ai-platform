<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-tryptophan + O2 = alpha,beta-didehydrotryptophan + H2O2.</rdfs:label>
</rdf:Description>
