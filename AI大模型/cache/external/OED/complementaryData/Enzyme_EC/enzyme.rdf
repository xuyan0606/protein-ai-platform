<rdf:Description rdf:about="3.6.1.56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-hydroxy-dATP diphosphatase</skos:prefLabel>
<skos:altLabel>(2'-deoxy) ribonucleoside 5'-triphosphate pyrophosphohydrolase</skos:altLabel>
<skos:altLabel>oxidized purine nucleoside triphosphatase</skos:altLabel>
<activity rdf:resource="3.6.1.56#SIP6A21AB71C05E0AE6"/>
<rdfs:comment>The enzyme hydrolyzes oxidized purine nucleoside triphosphates such as 2-hydroxy-dATP, thereby preventing their misincorporation into DNA.</rdfs:comment>
<rdfs:comment>It can also recognize 8-oxo-dGTP and 8-oxo-dATP, but with lower efficiency (cf. EC 3.6.1.55).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7592783"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8226881"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10373420"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11139615"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11756418"/>
<rdfs:subClassOf rdf:resource="3.6.1.-"/>
<skos:broaderTransitive rdf:resource="3.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.56#SIP6A21AB71C05E0AE6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxo-dATP + H2O = 2-oxo-dAMP + diphosphate + H(+).</rdfs:label>
</rdf:Description>
