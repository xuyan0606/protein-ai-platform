<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a carotenoid psi-end group = a carotenoid epsilon-end group.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="5.5.1.18#SIP9896254F8D35D99E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>delta-carotene = epsilon-carotene.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="5.5.1.18#SIP468FC6E1F541962A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>all-trans-lycopene = delta-carotene.</rdfs:label>
</rdf:Description>
