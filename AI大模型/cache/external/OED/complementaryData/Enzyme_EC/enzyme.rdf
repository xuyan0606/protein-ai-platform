<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>bergaptol + S-adenosyl-L-methionine = bergapten + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
