<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine(34) in tRNA + H(+) + H2O = inosine(34) in tRNA + NH4(+).</rdfs:label>
</rdf:Description>
