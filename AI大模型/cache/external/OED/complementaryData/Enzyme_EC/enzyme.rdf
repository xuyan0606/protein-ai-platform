<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + decyl sulfate + O2 = CO2 + decanal + H(+) + succinate + sulfate.</rdfs:label>
</rdf:Description>
