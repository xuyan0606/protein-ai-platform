<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cytidine(32) in tRNA(Thr) + S-adenosyl-L-methionine = H(+) + N(3)-methylcytidine(32) in tRNA(Thr) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.268#SIP6C5F50A6A0FEEA35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cytidine(32) in tRNA(Ser) + S-adenosyl-L-methionine = H(+) + N(3)-methylcytidine(32) in tRNA(Ser) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
