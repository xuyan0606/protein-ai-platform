<skos:altLabel>PMGL</skos:altLabel>
<skos:altLabel>PNL</skos:altLabel>
<skos:altLabel>polymethylgalacturonic transeliminase</skos:altLabel>
<activity rdf:resource="4.2.2.10#SIP6E7508D0B3DE471D"/>
<rdfs:comment>Favors pectin, the methyl ester, over pectate, the anion (which is the preferred substrate of EC 4.2.2.2).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9195887"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12110197"/>
<rdfs:subClassOf rdf:resource="4.2.2.-"/>
<skos:broaderTransitive rdf:resource="4.2.2.-"/>
</rdf:Description>
