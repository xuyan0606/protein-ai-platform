<citation rdf:resource="http://purl.uniprot.org/citations/22738258"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.7#SIPBB221F7E7F63AAE0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl diphosphate = diphosphate + pentalenene.</rdfs:label>
</rdf:Description>
