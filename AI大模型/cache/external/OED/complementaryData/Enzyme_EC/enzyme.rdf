<rdf:Description rdf:about="2.3.1.192">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycine N-phenylacetyltransferase</skos:prefLabel>
<skos:altLabel>arylacetyl-CoA N-acyltransferase</skos:altLabel>
<skos:altLabel>arylacetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.192#SIP36C25449476B0B83"/>
<rdfs:comment>Not identical with EC 2.3.1.13.</rdfs:comment>
<rdfs:comment>This enzyme was purified from bovine liver mitochondria.</rdfs:comment>
<rdfs:comment>L-asparagine, L-glutamine and L-arginine are alternative substrates to glycine, but have higher Km values.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/283662"/>
<citation rdf:resource="http://purl.uniprot.org/citations/457678"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9664233"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.192#SIP36C25449476B0B83">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycine + phenylacetyl-CoA = CoA + H(+) + phenylacetylglycine.</rdfs:label>
</rdf:Description>
