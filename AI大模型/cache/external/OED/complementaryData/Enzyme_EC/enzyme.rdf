<skos:broaderTransitive rdf:resource="1.14.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.99.50#SIPD4283A4F2B6A8CBD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>gamma-L-glutamyl-L-cysteine + hercynine + O2 = gamma-L-glutamyl-hercynylcysteine S-oxide + H2O.</rdfs:label>
</rdf:Description>
