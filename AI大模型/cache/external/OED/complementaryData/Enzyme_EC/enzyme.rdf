<rdf:Description rdf:about="2.3.1.227">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GDP-perosamine N-acetyltransferase</skos:prefLabel>
<skos:altLabel>GDP-alpha-D-perosamine N-acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.227#SIP8EF22D3320F325BF"/>
<rdfs:comment>D-Perosamine is one of several dideoxy sugars found in the O-antigen component of the outer membrane lipopolysaccharides of Gram-negative bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18201574"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.227#SIP8EF22D3320F325BF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + GDP-alpha-D-perosamine = CoA + GDP-N-acetyl-alpha-D-perosamine + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18201574">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18201574"/>
