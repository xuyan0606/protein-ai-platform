<rdf:Description rdf:about="1.13.11.50">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylacetone-cleaving enzyme</skos:prefLabel>
<skos:altLabel>acetylacetone dioxygenase</skos:altLabel>
<skos:altLabel>diketone cleaving dioxygenase</skos:altLabel>
<skos:altLabel>diketone cleaving enzyme</skos:altLabel>
<activity rdf:resource="1.13.11.50#SIP078DED7DE7F76CCA"/>
<rdfs:comment>Forms the first step in the acetylacetone degradation pathway of Acinetobacter johnsonii.</rdfs:comment>
<rdfs:comment>While acetylacetone is by far the best substrate, heptane-3,5-dione, octane-2,4-dione, 2-acetylcyclohexanone and ethyl acetoacetate can also act as substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12379146"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.13.11.50#SIP078DED7DE7F76CCA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetylacetone + O2 = acetate + H(+) + methylglyoxal.</rdfs:label>
</rdf:Description>
