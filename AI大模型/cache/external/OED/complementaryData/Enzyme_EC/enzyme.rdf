<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2,3-saturated acyl-CoA + O2 = a (2E)-enoyl-CoA + H2O2.</rdfs:label>
</rdf:Description>
