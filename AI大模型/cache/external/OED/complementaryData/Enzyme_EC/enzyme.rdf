<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>DNA-formamidopyrimidine glycosylase</skos:prefLabel>
<skos:altLabel>Fapy-DNA glycosylase</skos:altLabel>
<skos:altLabel>formamidopyrimidine-DNA glycosylase</skos:altLabel>
<activity rdf:resource="3.2.2.23#SIP7CED996E5955BB0C"/>
<rdfs:comment>May play a significant role in processes leading to recovery from mutagenesis and/or cell death by alkylating agents.</rdfs:comment>
<rdfs:comment>Also involved in the GO system responsible for removing an oxidatively damaged form of guanine (7,8-dihydro-8-oxoguanine) from DNA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3319582"/>
<rdfs:subClassOf rdf:resource="3.2.2.-"/>
<skos:broaderTransitive rdf:resource="3.2.2.-"/>
</rdf:Description>
