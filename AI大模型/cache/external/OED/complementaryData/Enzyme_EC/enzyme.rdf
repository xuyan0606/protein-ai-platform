<rdf:Description rdf:about="2.1.1.380">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-amino-4-hydroxybenzoate 4-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.380#SIPD9D73FB47993250B"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces cremeus, is involved in cremeomycin biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26278892"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.380#SIPD9D73FB47993250B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-amino-2,4-dihydroxybenzoate + S-adenosyl-L-methionine = 3-amino-2-hydroxy-4-methoxybenzoate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
