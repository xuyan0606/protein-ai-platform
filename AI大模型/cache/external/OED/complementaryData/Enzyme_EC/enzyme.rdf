<rdf:Description rdf:about="1.2.1.81">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfoacetaldehyde dehydrogenase (acylating)</skos:prefLabel>
<activity rdf:resource="1.2.1.81#SIP1C68E75C97822962"/>
<rdfs:comment>The enzyme is involved in degradation of sulfoacetate.</rdfs:comment>
<rdfs:comment>In this pathway the reaction is catalyzed in the reverse direction.</rdfs:comment>
<rdfs:comment>The enzyme is specific for sulfoacetaldehyde and NADP(+).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20693281"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
