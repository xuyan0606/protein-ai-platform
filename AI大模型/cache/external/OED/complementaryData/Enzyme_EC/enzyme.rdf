<rdf:Description rdf:about="2.6.1.82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>putrescine--2-oxoglutarate transaminase</skos:prefLabel>
<skos:altLabel>PAT</skos:altLabel>
<skos:altLabel>putrescine-alpha-ketoglutarate transaminase</skos:altLabel>
<skos:altLabel>putrescine aminotransferase</skos:altLabel>
<skos:altLabel>putrescine transaminase</skos:altLabel>
<activity rdf:resource="2.6.1.82#SIPAA26F62053079678"/>
<activity rdf:resource="2.6.1.82#SIP34F90E9F76B76286"/>
<rdfs:comment>The enzymatic part of the reaction produces 4-aminobutanal that spontaneously cyclizes to form 1-pyrroline, which is a substrate for EC 1.2.1.19.</rdfs:comment>
<rdfs:comment>Cadaverine and spermidine can also act as substrates.</rdfs:comment>
<rdfs:comment>Forms part of the arginine catabolism pathway. cf. EC 2.6.1.113.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3510672"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12617754"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16023116"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.82#SIPAA26F62053079678">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + putrescine = 4-aminobutanal + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.82#SIP34F90E9F76B76286">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + putrescine = 1-pyrroline + H2O + L-glutamate.</rdfs:label>
</rdf:Description>
