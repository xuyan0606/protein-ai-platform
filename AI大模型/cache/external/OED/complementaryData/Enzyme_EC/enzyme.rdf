<rdf:Description rdf:about="1.14.13.209">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>salicyloyl-CoA 5-hydroxylase</skos:prefLabel>
<activity rdf:resource="1.14.13.209#SIP675D2DA798A0C6FE"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces sp. WA46, participates in a pathway for salicylate degradation. cf. EC 1.14.13.172.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15006746"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.209#SIP675D2DA798A0C6FE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-hydroxybenzoyl-CoA + H(+) + NADH + O2 = 2,5-dihydroxybenzoyl-CoA + H2O + NAD(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15006746">
