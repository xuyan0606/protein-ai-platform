<rdf:Description rdf:about="1.17.99.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-oxo-Delta(1)-steroid hydratase/dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.17.99.11#SIP02753E32719C9082"/>
<activity rdf:resource="1.17.99.11#SIPFA9B61D536C1DB09"/>
<activity rdf:resource="1.17.99.11#SIPEDB685020EC1290C"/>
<rdfs:comment>A molybdenum enzyme.</rdfs:comment>
<rdfs:comment>The enzyme, characterized from the bacterium Steroidobacter denitrificans, is involved in the anaetrobic degradation of steroids.</rdfs:comment>
<rdfs:comment>It is specific to 3-oxo-Delta(1)-steroids such as androsta-1-ene-3,17-dione and Delta(1)-dihydrotestosterone and does not act on 3-oxo-Delta(4)-steroids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26872041"/>
<rdfs:subClassOf rdf:resource="1.17.99.-"/>
<skos:broaderTransitive rdf:resource="1.17.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.11#SIP02753E32719C9082">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + a 3-oxo-Delta(1)-steroid + H2O = a steroid 1,3-dione + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.11#SIPFA9B61D536C1DB09">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + Delta(1)-dihydrotestosterone + H2O = 17beta-hydroxyandrostan-1,3-dione + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.11#SIPEDB685020EC1290C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5alpha-androst-1-ene-3,17-dione + A + H2O = 5alpha-androstan-1,3,17-trione + AH2.</rdfs:label>
</rdf:Description>
