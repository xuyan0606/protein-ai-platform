<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA (cytidine(56)-2'-O)-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.206#SIPBF9E20EFC422AF9C"/>
<rdfs:comment>The archaeal enzyme specifically catalyzes the S-adenosyl-L-methionine dependent 2'-O-ribose methylation of cytidine at position 56 in tRNA transcripts.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15987815"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18068186"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
