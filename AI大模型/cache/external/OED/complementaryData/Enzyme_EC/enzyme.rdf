<rdf:Description rdf:about="2.5.1.100">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>fumigaclavine A dimethylallyltransferase</skos:prefLabel>
<activity rdf:resource="2.5.1.100#SIP65121B1BBD90A536"/>
<rdfs:comment>Fumigaclavine C is an ergot alkaloid produced by some fungi of the Trichocomaceae family.</rdfs:comment>
<rdfs:comment>Activity does not require any metal ions.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16397874"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.100#SIP65121B1BBD90A536">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dimethylallyl diphosphate + fumigaclavine A = diphosphate + fumigaclavine C.</rdfs:label>
</rdf:Description>
