<rdf:Description rdf:about="1.3.99.17">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>quinoline 2-oxidoreductase</skos:prefLabel>
<activity rdf:resource="1.3.99.17#SIP104FCADC6D4AE58D"/>
<activity rdf:resource="1.3.99.17#SIP7AAC4B6A329FEC24"/>
<activity rdf:resource="1.3.99.17#SIPE401BBB1294B53EB"/>
<activity rdf:resource="1.3.99.17#SIP85048C6970604789"/>
<activity rdf:resource="1.3.99.17#SIP31F6B53190738849"/>
<activity rdf:resource="1.3.99.17#SIPAD70288760CAFFB7"/>
<activity rdf:resource="1.3.99.17#SIPCE786FD367182E94"/>
<activity rdf:resource="1.3.99.17#SIP9018D986CCA2D1F0"/>
<activity rdf:resource="1.3.99.17#SIP25B52D606D9CF097"/>
<rdfs:comment>In addition to quinoline, quinolin-2-ol, quinolin-7-ol, quinolin-8-ol, 3-, 4- and 8-methylquinolines and 8-chloroquinoline are substrates.</rdfs:comment>
<rdfs:comment>Iodonitrotetrazolium chloride (INT) can act as an electron acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1789933"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2090161"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7556204"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8251516"/>
<rdfs:subClassOf rdf:resource="1.3.99.-"/>
<skos:broaderTransitive rdf:resource="1.3.99.-"/>
</rdf:Description>
