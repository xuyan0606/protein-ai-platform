<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>di-trans,poly-cis-dolichol + NADP(+) = di-trans,cis-polyprenol + H(+) + NADPH.</rdfs:label>
</rdf:Description>
