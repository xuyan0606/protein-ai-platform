<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-idonate + NAD(+) = 5-dehydro-D-gluconate + H(+) + NADH.</rdfs:label>
</rdf:Description>
