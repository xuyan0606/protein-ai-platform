<skos:prefLabel>protoporphyrin ferrochelatase</skos:prefLabel>
<skos:altLabel>ferrochelatase</skos:altLabel>
<skos:altLabel>ferro-protoporphyrin chelatase</skos:altLabel>
<skos:altLabel>heme synthase</skos:altLabel>
<skos:altLabel>iron chelatase</skos:altLabel>
<skos:altLabel>protoheme ferro-lyase</skos:altLabel>
<activity rdf:resource="4.98.1.1#SIP492F96245D9CB819"/>
<rdfs:comment>The enzyme catalyzes the terminal step in the heme biosynthesis pathways of eukaryotes and Gram-negative bacteria.</rdfs:comment>
<rdfs:comment>The reaction is catalyzed only in the reverse direction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3805002"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13972328"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13972329"/>
<rdfs:subClassOf rdf:resource="4.98.1.-"/>
<skos:broaderTransitive rdf:resource="4.98.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.98.1.1#SIP492F96245D9CB819">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + heme b = Fe(2+) + protoporphyrin IX.</rdfs:label>
</rdf:Description>
