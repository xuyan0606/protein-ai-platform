<skos:prefLabel>6-diazo-5-oxo-L-norleucine N(alpha)-acetyltranferase</skos:prefLabel>
<activity rdf:resource="2.3.1.307#SIP7DE338CA9A8BA3E8"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptacidiphilus griseoplanus, participates in the biosynthesis of the tripeptide alazopeptin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/33624374"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
