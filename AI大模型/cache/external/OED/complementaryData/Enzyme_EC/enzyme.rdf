<skos:narrowerTransitive rdf:resource="1.4.5.1"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.5.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-amino acid dehydrogenase (quinone)</skos:prefLabel>
<skos:altLabel>DadA</skos:altLabel>
<activity rdf:resource="1.4.5.1#SIP94273A923F48E195"/>
<rdfs:comment>The enzyme from the bacterium Helicobacter pylori is highly specific for D-proline, while the enzyme from the bacterium Escherichia coli B is most active with D-alanine, D-phenylalanine and D-methionine.</rdfs:comment>
<rdfs:comment>This enzyme may be the same as EC 1.4.99.6.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6102989"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19212808"/>
<rdfs:subClassOf rdf:resource="1.4.5.-"/>
<skos:broaderTransitive rdf:resource="1.4.5.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.5.1#SIP94273A923F48E195">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a D-alpha-amino acid + a quinone + H2O = a 2-oxocarboxylate + a quinol + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6102989">
