<rdf:Description rdf:about="4.1.1.83">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-hydroxyphenylacetate decarboxylase</skos:prefLabel>
<skos:altLabel>4-Hpd</skos:altLabel>
<skos:altLabel>4-hydroxyphenylacetate carboxy-lyase</skos:altLabel>
<skos:altLabel>p-Hpd</skos:altLabel>
<skos:altLabel>p-hydroxyphenylacetate decarboxylase</skos:altLabel>
<activity rdf:resource="4.1.1.83#SIP9BC6323D44CE7C94"/>
<activity rdf:resource="4.1.1.83#SIPDE0D18F41AFD05BB"/>
<rdfs:comment>The enzyme, from the strict anaerobe Clostridium difficile, can also use (3,4-dihydroxyphenyl)acetate as a substrate, yielding 4-methylcatechol as a product.</rdfs:comment>
<rdfs:comment>The enzyme is a glycyl radical enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3938267"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11231288"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15153112"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.83#SIP9BC6323D44CE7C94">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-hydroxyphenylacetate + H(+) = 4-methylphenol + CO2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.83#SIPDE0D18F41AFD05BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3,4-dihydroxyphenylacetate + H(+) = 4-methylcatechol + CO2.</rdfs:label>
</rdf:Description>
