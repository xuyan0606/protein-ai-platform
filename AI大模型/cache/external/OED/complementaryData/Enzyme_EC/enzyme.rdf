</rdf:Description>
<rdf:Description rdf:about="2.6.1.124">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[amino-group carrier protein]-gamma-(L-ornithyl)-L-glutamate aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.124#SIP1E144965189A9B4B"/>
<rdfs:comment>The enzyme participates in an L-arginine biosynthetic pathway that operates in certain species of archaea.</rdfs:comment>
<rdfs:comment>In some cases the enzyme also catalyzes the activity of EC 2.6.1.118.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27566549"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.124#SIP1E144965189A9B4B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + [amino-group carrier protein]-C-terminal-gamma-(L-ornithyl)-L-glutamate = [amino-group carrier protein]-C-terminal-gamma-(L-glutamyl-5-semialdehyde)-L-glutamate + L-glutamate.</rdfs:label>
</rdf:Description>
