</rdf:Description>
<rdf:Description rdf:about="3.4.22.57#SIP8866875A17D199D9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Strict requirement for Asp at the P1 position. It has a preferred cleavage sequence of Tyr-Val-Ala-Asp-|- but also cleaves at Asp-Glu-Val-Asp-|-.</rdfs:label>
</rdf:Description>
