<skos:prefLabel>molybdenum cofactor guanylyltransferase</skos:prefLabel>
<skos:altLabel>MoCo guanylyltransferase</skos:altLabel>
<activity rdf:resource="2.7.7.77#SIP907574296DD113FF"/>
<rdfs:comment>Catalyzes the guanylation of the molybdenum cofactor.</rdfs:comment>
<rdfs:comment>This modification occurs only in prokaryotes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10978347"/>
