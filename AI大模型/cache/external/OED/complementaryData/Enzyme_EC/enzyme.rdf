<rdf:Description rdf:about="4.2.3.159">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tsukubadiene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.159#SIP8908DC19AAE2C1FA"/>
<rdfs:comment>The synthesis of the diterpene tsukubadiene has been shown to occur in the Actinobacterium Streptomyces tsukubaensis.</rdfs:comment>
