<rdf:Description rdf:about="2.4.1.323">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>7-deoxyloganetic acid glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.323#SIPC6F299C80E2923E9"/>
<rdfs:comment>Isolated from the plant Catharanthus roseus (Madagascar periwinkle).</rdfs:comment>
<rdfs:comment>Involved in loganin and secologanin biosynthesis.</rdfs:comment>
<rdfs:comment>Does not react with 7-deoxyloganetin. cf. EC 2.4.1.324.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24104568"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.323#SIPC6F299C80E2923E9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7-deoxyloganetate + UDP-alpha-D-glucose = 7-deoxyloganate + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24104568">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24104568"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24104568"/>
<dcterms:identifier>doi:10.1105/tpc.113.115154</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.324">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>7-deoxyloganetin glucosyltransferase</skos:prefLabel>
<skos:altLabel>UGT85A24</skos:altLabel>
<activity rdf:resource="2.4.1.324#SIPA50F2443E2B7A028"/>
<rdfs:comment>Isolated from the plants Catharanthus roseus (Madagascar periwinkle) and Gardenia jasminoides (cape jasmine).</rdfs:comment>
<rdfs:comment>With Gardenia it also acts on genipin.</rdfs:comment>
<rdfs:comment>Involved in loganin and secologanin biosynthesis.</rdfs:comment>
<rdfs:comment>Does not react with 7-deoxyloganetate. cf. EC 2.4.1.323.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21799001"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24104568"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.324#SIPA50F2443E2B7A028">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7-deoxyloganetin + UDP-alpha-D-glucose = 7-deoxyloganin + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21799001">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
