<rdf:Description rdf:about="2.1.1.268">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA(Thr) (cytosine(32)-N(3))-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.268#SIPEF8F0D36EF95BA05"/>
<activity rdf:resource="2.1.1.268#SIP6C5F50A6A0FEEA35"/>
<rdfs:comment>The enzyme from Saccharomyces cerevisiae specifically methylates cytosine(32) in tRNA(Thr) and in tRNA(Ser).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21518804"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21518805"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
