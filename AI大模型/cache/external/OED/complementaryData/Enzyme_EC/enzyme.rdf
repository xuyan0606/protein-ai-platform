<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(9Z)-hexadecenoyl-[ACP] + alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid IVA (E. coli) = (9Z)-hexadecenoyl-(Kdo)2-lipid IVA (E. coli) + holo-[ACP].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.242#SIP0EBA7015B98926D9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a fatty acyl-[ACP] + an alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid IVA = an acyl-alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid IVA + holo-[ACP].</rdfs:label>
</rdf:Description>
