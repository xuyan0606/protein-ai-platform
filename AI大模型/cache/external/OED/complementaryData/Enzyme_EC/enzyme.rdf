<rdf:Description rdf:about="3.2.1.68">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoamylase</skos:prefLabel>
<skos:altLabel>debranching enzyme</skos:altLabel>
<activity rdf:resource="3.2.1.68#SIPDC299632E8DE535F"/>
<rdfs:comment>Also readily hydrolyzes amylopectin.</rdfs:comment>
<rdfs:comment>Differs from EC 3.2.1.41 and EC 3.2.1.142 by its inability to hydrolyze pullulan, and by limited action on alpha-limit dextrins.</rdfs:comment>
<rdfs:comment>Maltose is the smallest sugar it can release from an alpha-(1->6)-linkage.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5456995"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
