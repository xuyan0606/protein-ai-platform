<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-lysyl-[protein] + O2 = (S)-2-amino-6-oxohexanoyl-[protein] + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
