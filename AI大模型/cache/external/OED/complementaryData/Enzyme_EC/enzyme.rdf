<rdf:Description rdf:about="2.8.3.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>propionate CoA-transferase</skos:prefLabel>
<activity rdf:resource="2.8.3.1#SIPEE05E183CED3DD3D"/>
<rdfs:comment>Butanoate and lactate can also act as acceptors.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.1#SIPEE05E183CED3DD3D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + propanoate = acetate + propanoyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>oxalate CoA-transferase</skos:prefLabel>
<skos:altLabel>succinyl--beta-ketoacyl-CoA transferase</skos:altLabel>
<activity rdf:resource="2.8.3.2#SIP3EC8B766FD9F1355"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16748872"/>
