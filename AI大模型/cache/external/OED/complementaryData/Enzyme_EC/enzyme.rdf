<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 AH2 + all-trans-beta-carotene + 2 O2 = 2 A + echinenone + 3 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.99.63#SIPF33BE0984CDBF4E8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 AH2 + echinenone + 2 O2 = 2 A + canthaxanthin + 3 H2O.</rdfs:label>
</rdf:Description>
