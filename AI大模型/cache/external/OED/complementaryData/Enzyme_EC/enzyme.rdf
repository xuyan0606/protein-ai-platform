<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-homoserine + NAD(+) = H(+) + L-aspartate 4-semialdehyde + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.3#SIP8871D40C4AE199A9">
