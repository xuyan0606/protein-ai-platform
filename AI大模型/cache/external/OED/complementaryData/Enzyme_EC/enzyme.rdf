<rdf:Description rdf:about="2.8.3.16">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>formyl-CoA transferase</skos:prefLabel>
<skos:altLabel>formyl-CoA oxalate CoA-transferase</skos:altLabel>
<skos:altLabel>formyl-coenzyme A transferase</skos:altLabel>
<activity rdf:resource="2.8.3.16#SIP55B7608EB61FAE54"/>
<activity rdf:resource="2.8.3.16#SIP83AFA0975B59DA79"/>
<rdfs:comment>The enzyme from Oxalobacter formigenes can also catalyze the transfer of CoA from formyl-CoA to succinate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2361939"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9150242"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.16#SIP55B7608EB61FAE54">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>formyl-CoA + oxalate = formate + oxalyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.16#SIP83AFA0975B59DA79">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>formyl-CoA + succinate = formate + succinyl-CoA.</rdfs:label>
</rdf:Description>
