<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-alanine + L-anticapsin = ADP + bacilysin + H(+) + phosphate.</rdfs:label>
</rdf:Description>
