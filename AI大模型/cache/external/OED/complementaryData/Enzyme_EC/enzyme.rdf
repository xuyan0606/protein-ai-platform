<rdf:Description rdf:about="2.1.1.98">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diphthine synthase</skos:prefLabel>
<activity rdf:resource="2.1.1.98#SIP46A701B6593F95EC"/>
<rdfs:comment>This archaeal enzyme produces the trimethylated product diphthine, which is converted into diphthamide by EC 6.3.1.14.</rdfs:comment>
<rdfs:comment>Different from the eukaryotic enzyme, which produces diphthine methyl ester (cf. EC 2.1.1.314).</rdfs:comment>
<rdfs:comment>In the archaeon Pyrococcus horikoshii the enzyme acts on His(600) of elongation factor 2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20873788"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.98#SIP46A701B6593F95EC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-[(3S)-amino-3-carboxypropyl]-L-histidyl-[translation elongation factor 2] + 3 S-adenosyl-L-methionine = diphthine-[translation elongation factor 2] + 3 H(+) + 3 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
