<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18266698"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18266698"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.7.95"/>
<skos:prefLabel>long-chain fatty acid adenylyltransferase FadD28</skos:prefLabel>
<activity rdf:resource="6.2.1.49#SIP24625B8C2F76E8D6"/>
<rdfs:comment>The enzyme, found in certain mycobacteria, activates long-chain fatty acids by adenylation and transfers them to EC 2.3.1.111.</rdfs:comment>
<rdfs:comment>The enzyme participates in the biosynthesis of the virulent lipids dimycocerosates (DIM) and dimycocerosyl triglycosyl phenolphthiocerol (PGL).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9098059"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16582482"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19182784"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24831705"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25561717"/>
