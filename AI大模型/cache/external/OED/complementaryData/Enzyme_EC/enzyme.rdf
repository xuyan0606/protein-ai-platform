<rdfs:comment>Unlike EC 2.1.2.1 does not use glycine as a substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12404452"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12738270"/>
