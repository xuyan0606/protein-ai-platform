</rdf:Description>
<rdf:Description rdf:about="2.3.1.221">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>noranthrone synthase</skos:prefLabel>
<skos:altLabel>norsolorinic acid anthrone synthase</skos:altLabel>
<skos:altLabel>polyketide synthase A</skos:altLabel>
<activity rdf:resource="2.3.1.221#SIPCE9205801E972EB2"/>
<rdfs:comment>A multi-domain polyketide synthase involved in the synthesis of aflatoxins in the fungus Aspergillus parasiticus.</rdfs:comment>
<rdfs:comment>The hexanoyl starter unit is provided to the acyl-carrier protein (ACP) domain by a dedicated fungal fatty acid synthase.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18403714"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19847268"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20332208"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.221#SIPCE9205801E972EB2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6 H(+) + hexanoyl-[ACP] + 7 malonyl-CoA = 7 CO2 + 7 CoA + 2 H2O + holo-[ACP] + noranthrone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18403714">
