<skos:altLabel>glycyl-glycine endopeptidase</skos:altLabel>
<activity rdf:resource="3.4.24.75#SIP478FFDA62C211220"/>
<rdfs:comment>Lyses cells of Staphylococcus aureus in particular, by its action on the cross-bridge of the cell wall.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M23.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9106216"/>
<rdfs:subClassOf rdf:resource="3.4.24.-"/>
