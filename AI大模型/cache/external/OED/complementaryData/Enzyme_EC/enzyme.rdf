<rdf:Description rdf:about="3.2.1.133">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucan 1,4-alpha-maltohydrolase</skos:prefLabel>
<skos:altLabel>maltogenic alpha-amylase</skos:altLabel>
<activity rdf:resource="3.2.1.133#SIP4F31F66D8B661EAB"/>
<rdfs:comment>Acts on starch and related polysaccharides and oligosaccharides.</rdfs:comment>
<rdfs:comment>The product is alpha-maltose; cf. EC 3.2.1.2.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.133#SIP4F31F66D8B661EAB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hydrolysis of (1->4)-alpha-D-glucosidic linkages in polysaccharides so as to remove successive alpha-maltose residues from the non-reducing ends of the chains.</rdfs:label>
</rdf:Description>
