<activity rdf:resource="4.2.1.133#SIPC655582908C5DDCF"/>
<rdfs:comment>The enzyme was characterized from the plant Cistus creticus subsp. creticus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20595348"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
