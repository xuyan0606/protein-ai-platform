<citation rdf:resource="http://purl.uniprot.org/citations/23627491"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25697423"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25941396"/>
<rdfs:subClassOf rdf:resource="4.1.99.-"/>
<skos:broaderTransitive rdf:resource="4.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.99.22#SIPB646A7AD3A2943A6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>AH2 + GTP + S-adenosyl-L-methionine = (8S)-3',8-cyclo-7,8-dihydroguanosine 5'-triphosphate + 5'-deoxyadenosine + A + H(+) + L-methionine.</rdfs:label>
</rdf:Description>
