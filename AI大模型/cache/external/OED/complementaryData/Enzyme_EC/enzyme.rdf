<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27890582"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/27890582"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.53">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.80"/>
<skos:prefLabel>(R)-limonene 6-monooxygenase</skos:prefLabel>
<skos:altLabel>(+)-limonene-6-hydroxylase</skos:altLabel>
<skos:altLabel>(+)-limonene 6-monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.53#SIPB56468E9FEF01A19"/>
<rdfs:comment>The reaction is stereospecific with over 95% yield of (+)-trans-carveol from (R)-limonene.</rdfs:comment>
<rdfs:comment>(S)-Limonene, the substrate for EC 1.14.14.51 is not a substrate.</rdfs:comment>
<rdfs:comment>Forms part of the carvone biosynthesis pathway in Carum carvi (caraway) seeds.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9662532"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.53#SIPB56468E9FEF01A19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(4R)-limonene + O2 + reduced [NADPH--hemoprotein reductase] = (1R,5S)-carveol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
