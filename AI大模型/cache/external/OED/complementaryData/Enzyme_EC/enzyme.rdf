</rdf:Description>
<rdf:Description rdf:about="2.4.2.54">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-ribofuranosylphenol 5'-phosphate synthase</skos:prefLabel>
<skos:altLabel>4-(beta-D-ribofuranosyl)aminobenzene 5'-phosphate synthase</skos:altLabel>
<skos:altLabel>beta-RFAP synthase</skos:altLabel>
<skos:altLabel>beta-RFA-P synthase</skos:altLabel>
<skos:altLabel>beta-ribofuranosylaminobenzene 5'-phosphate synthase</skos:altLabel>
<activity rdf:resource="2.4.2.54#SIP945A726EA8BC6A8A"/>
<rdfs:comment>The enzyme is involved in biosynthesis of tetrahydromethanopterin in archaea.</rdfs:comment>
<rdfs:comment>It can utilize both 4-hydroxybenzoate and 4-aminobenzoate as substrates, but only the former is known to be produced by methanogenic archaea.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9698382"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12142414"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15262968"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21634403"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31663056"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.54#SIP945A726EA8BC6A8A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-hydroxybenzoate + 5-phospho-alpha-D-ribose 1-diphosphate + H(+) = 4-(beta-D-ribofuranosyl)phenol 5'-phosphate + CO2 + diphosphate.</rdfs:label>
</rdf:Description>
