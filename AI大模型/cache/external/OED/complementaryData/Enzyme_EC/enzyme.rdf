<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 7-hydroxyisoflavone + UDP-alpha-D-glucose = a 7-hydroxyisoflavone 7-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.170#SIPDE9A2A528BB29659">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>formononetin + UDP-alpha-D-glucose = ononin + UDP.</rdfs:label>
</rdf:Description>
