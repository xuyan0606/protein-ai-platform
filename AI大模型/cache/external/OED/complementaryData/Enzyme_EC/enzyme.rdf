<replaces rdf:resource="2.1.1.66"/>
<skos:prefLabel>23S rRNA (adenosine(1067)-2'-O)-methyltransferase</skos:prefLabel>
<skos:altLabel>23S rRNA A(1067) 2'-methyltransferase</skos:altLabel>
<skos:altLabel>nosiheptide-resistance methyltransferase</skos:altLabel>
<skos:altLabel>thiostrepton-resistance methylase</skos:altLabel>
<activity rdf:resource="2.1.1.230#SIP0B47AF8359CC8E8D"/>
<rdfs:comment>The methylase that is responsible for autoimmunity in the thiostrepton producer Streptomyces azureus, renders ribosomes completely resistant to thiostrepton.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6806287"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7925357"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20550164"/>
