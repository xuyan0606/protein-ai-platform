<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-acetyl-D-muramate 6-phosphate = (R)-lactate + N-acetyl-D-glucosamine 6-phosphate.</rdfs:label>
</rdf:Description>
