<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.206#SIP5592A38546A15B8A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + oleuropein = D-glucose + oleuropein aglycone.</rdfs:label>
</rdf:Description>
