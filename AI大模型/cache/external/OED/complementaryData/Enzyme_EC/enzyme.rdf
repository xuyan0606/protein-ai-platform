<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-lysyl(20)-[histone H4] + S-adenosyl-L-methionine = H(+) + N(6)-methyl-L-lysyl(20)-[histone H4] + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
