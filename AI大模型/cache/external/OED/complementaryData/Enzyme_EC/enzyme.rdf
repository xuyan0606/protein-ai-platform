<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADP(+) + reduced coenzyme F420-(gamma-L-Glu)(n) = 2 H(+) + NADPH + oxidized coenzyme F420-(gamma-L-Glu)(n).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2492438">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2492438"/>
