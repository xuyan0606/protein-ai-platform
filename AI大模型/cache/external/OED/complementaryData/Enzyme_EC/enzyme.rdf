</rdf:Description>
<rdf:Description rdf:about="3.4.23.51">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>HycI peptidase</skos:prefLabel>
<activity rdf:resource="3.4.23.51#SIP72AEF318C5B38381"/>
<rdfs:comment>The reaction requires nickel to be bound to the precursor of the large subunit of hydrogenase 3.</rdfs:comment>
<rdfs:comment>The endopeptidase uses the metal in the large subunit of [NiFe]-hydrogenases as a recognition motif.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family A31.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10727938"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17150961"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.51#SIP72AEF318C5B38381">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>This enzyme specifically removes a 32-amino acid peptide from the C-terminus of the precursor of the large subunit of E.coli hydrogenase 3 by cleavage at the C-terminal side of Arg-537.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10727938">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
