<activity rdf:resource="2.3.1.11#SIP110422BF0177236E"/>
<rdfs:comment>2-sulfanylethan-1-ol (2-mercaptoethanol) can act as a substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/13221570"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
