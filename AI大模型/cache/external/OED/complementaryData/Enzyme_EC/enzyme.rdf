<rdf:Description rdf:about="5.4.99.61">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="5.4.1.2"/>
<skos:prefLabel>precorrin-8X methylmutase</skos:prefLabel>
<skos:altLabel>HBA synthase</skos:altLabel>
<skos:altLabel>hydrogenobyrinic acid-binding protein</skos:altLabel>
<skos:altLabel>precorrin isomerase</skos:altLabel>
<activity rdf:resource="5.4.99.61#SIPF69E1BA16B7E5FEB"/>
<rdfs:comment>The enzyme, which participates in the aerobic (late cobalt insertion) adenosylcobalamin biosynthesis pathway, catalyzes the conversion of precorrin-8X to hydrogenobyrinate by methyl rearrangement.</rdfs:comment>
<rdfs:comment>The equivalent enzyme in the anaerobic pathway is EC 5.4.99.60.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1732194"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2211521"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11470433"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
</rdf:Description>
