<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(9Z,12Z,15Z)-octadecatrienoate + O2 = (9R,10E,12Z,15Z)-9-hydroperoxyoctadeca-10,12,15-trienoate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.13.11.61#SIP4B98E22C7F10D775">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(9Z,12Z)-octadecadienoate + O2 = (9R)-hydroperoxy-(10E,12Z)-octadecadienoate.</rdfs:label>
</rdf:Description>
