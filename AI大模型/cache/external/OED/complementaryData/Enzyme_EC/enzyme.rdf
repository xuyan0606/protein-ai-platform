<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8-chloroquinoline + A + H2O = 8-chloroquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIPE401BBB1294B53EB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8-methylquinoline + A + H2O = 8-methylquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIP85048C6970604789">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-methylquinoline + A + H2O = 4-methylquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIP31F6B53190738849">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-methylquinoline + A + H2O = 3-methylquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIPAD70288760CAFFB7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + quinolin-8-ol = 8-hydroxyquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIPCE786FD367182E94">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + quinolin-7-ol = 7-hydroxyquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.17#SIP9018D986CCA2D1F0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + quinolin-6-ol = 6-hydroxyquinolin-2(1H)-one + AH2.</rdfs:label>
</rdf:Description>
