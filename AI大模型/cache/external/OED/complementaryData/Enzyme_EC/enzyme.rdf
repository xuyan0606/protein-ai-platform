<rdf:Description rdf:about="1.14.12.16">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-hydroxyquinoline 5,6-dioxygenase</skos:prefLabel>
<skos:altLabel>2-oxo-1,2-dihydroquinoline 5,6-dioxygenase</skos:altLabel>
<skos:altLabel>quinolin-2(1H)-one 5,6-dioxygenase</skos:altLabel>
<skos:altLabel>quinolin-2-ol 5,6-dioxygenase</skos:altLabel>
<activity rdf:resource="1.14.12.16#SIP0EEAF9AC2BEADDB8"/>
<rdfs:comment>3-Methylquinolin-2-ol, quinolin-8-ol and quinolin-2,8-diol are also substrates.</rdfs:comment>
<rdfs:comment>Quinolin-2-ols exist largely as their quinolin-2(1H)-one tautomers.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7556204"/>
<rdfs:subClassOf rdf:resource="1.14.12.-"/>
<skos:broaderTransitive rdf:resource="1.14.12.-"/>
</rdf:Description>
