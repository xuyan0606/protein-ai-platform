<rdf:Description rdf:about="1.3.99.33">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>urocanate reductase</skos:prefLabel>
<activity rdf:resource="1.3.99.33#SIP23190659190FAF55"/>
<rdfs:comment>The enzyme functions as part of an anaerobic electron transfer chain that utilizes urocanate as the terminal electron acceptor.</rdfs:comment>
<rdfs:comment>The activity has been demonstrated with the artificial donor reduced methyl viologen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23078170"/>
<rdfs:subClassOf rdf:resource="1.3.99.-"/>
<skos:broaderTransitive rdf:resource="1.3.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.33#SIP23190659190FAF55">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + dihydrourocanate = AH2 + urocanate.</rdfs:label>
</rdf:Description>
