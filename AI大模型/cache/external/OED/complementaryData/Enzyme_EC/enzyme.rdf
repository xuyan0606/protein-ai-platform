<rdf:Description rdf:about="1.13.11.89">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(hydroxymethyl)phosphonate dioxygenase</skos:prefLabel>
<activity rdf:resource="1.13.11.89#SIP19CF6FF202F7FFB6"/>
<rdfs:comment>Requires iron(II).</rdfs:comment>
<rdfs:comment>The enzyme, characterized from the marine bacterium Gimesia maris, participates in a (methyl)phosphonate degradation pathway.</rdfs:comment>
<rdfs:comment>It also has the activity of EC 1.13.11.78.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30810303"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.13.11.89#SIP19CF6FF202F7FFB6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hydroxymethylphosphonate + O2 = formate + 2 H(+) + phosphate.</rdfs:label>
</rdf:Description>
