<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl diphosphate + 8 isopentenyl diphosphate = di-trans,octa-cis-undecaprenyl diphosphate + 8 diphosphate.</rdfs:label>
</rdf:Description>
