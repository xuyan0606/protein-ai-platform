<rdf:Description rdf:about="1.1.1.325">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sepiapterin reductase (L-threo-7,8-dihydrobiopterin forming)</skos:prefLabel>
<activity rdf:resource="1.1.1.325#SIPA81FBB56934AFFC2"/>
<activity rdf:resource="1.1.1.325#SIP4E40B6A6F8B08880"/>
<rdfs:comment>This enzyme, isolated from the bacterium Chlorobium tepidum, catalyzes the final step in the de novo synthesis of tetrahydrobiopterin from GTP. cf. EC 1.1.1.153.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10333495"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16510994"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
