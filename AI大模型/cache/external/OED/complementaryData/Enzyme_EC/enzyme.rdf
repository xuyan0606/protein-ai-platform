<rdfs:comment>It also has the activity of EC 3.1.3.64.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11676921"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12045210"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19901554"/>
