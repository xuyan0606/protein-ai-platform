<rdf:Description rdf:about="1.5.1.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>1-piperideine-2-carboxylate/1-pyrroline-2-carboxylate reductase [NAD(P)H]</skos:prefLabel>
<skos:altLabel>pyrroline-2-carboxylate reductase</skos:altLabel>
<activity rdf:resource="1.5.1.1#SIP337B5D39E60A81C8"/>
<activity rdf:resource="1.5.1.1#SIP5BC03E108259F1A9"/>
<activity rdf:resource="1.5.1.1#SIPB4BADBED83C62A16"/>
<activity rdf:resource="1.5.1.1#SIP8E73DF0BDEEEE9CB"/>
<rdfs:comment>The enzymes, characterized from the bacterium Azospirillum brasilense, is involved in trans-3-hydroxy-L-proline metabolism.</rdfs:comment>
<rdfs:comment>In contrast to EC 1.5.1.21, which is specific for NADPH, this enzyme shows similar activity with NADPH and NADH.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/13502341"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24649405"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
