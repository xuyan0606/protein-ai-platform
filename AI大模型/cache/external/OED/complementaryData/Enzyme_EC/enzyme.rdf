<rdf:Description rdf:about="2.4.1.338">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>validoxylamine A glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.338#SIPD3DD65BF19FA21BD"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces hygroscopicus subsp. limoneus, catalyzes the ultimate step in the biosynthesis of the antifungal agent validamycin A.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16632251"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18563934"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.338#SIPD3DD65BF19FA21BD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>UDP-alpha-D-glucose + validoxylamine A = H(+) + UDP + validamycin A.</rdfs:label>
</rdf:Description>
