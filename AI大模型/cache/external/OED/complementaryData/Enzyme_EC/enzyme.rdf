<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-kolavelool + S-adenosyl-L-methionine = (+)-O-methylkolavelool + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
