<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(9Z,12Z,15Z)-octadecatrienoate + O2 = (R)-2-hydroperoxy-(9Z,12Z,15Z)-octadecatrienoate.</rdfs:label>
</rdf:Description>
