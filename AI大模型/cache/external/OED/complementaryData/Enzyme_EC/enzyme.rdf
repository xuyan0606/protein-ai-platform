<rdf:Description rdf:about="3.5.1.102">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-amino-5-formylamino-6-ribosylaminopyrimidin-4(3H)-one 5'-monophosphate deformylase</skos:prefLabel>
<activity rdf:resource="3.5.1.102#SIPB741CEC3F7A14455"/>
<rdfs:comment>The enzyme catalyzes the second step in archaeal riboflavin and 7,8-didemethyl-8-hydroxy-5-deazariboflavin biosynthesis.</rdfs:comment>
<rdfs:comment>The first step is catalyzed by EC 3.5.4.29.</rdfs:comment>
<rdfs:comment>The bacterial enzyme, EC 3.5.4.25 catalyzes both reactions.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19309161"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
