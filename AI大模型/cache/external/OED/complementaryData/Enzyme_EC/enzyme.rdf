<rdf:Description rdf:about="2.1.1.102">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>demethylmacrocin O-methyltransferase</skos:prefLabel>
<skos:altLabel>DMOMT</skos:altLabel>
<activity rdf:resource="2.1.1.102#SIP383C11BEC1B78F07"/>
<rdfs:comment>The 2-hydroxyl group of a 6-deoxy-D-allose residue in demethylmacrocin acts as methyl acceptor.</rdfs:comment>
<rdfs:comment>Isolated from Streptomyces fradiae.</rdfs:comment>
<rdfs:comment>Also acts on demethyllactenocin giving lactenocin.</rdfs:comment>
<rdfs:comment>Involved in the biosynthesis of the macrolide antibiotic tylosin.</rdfs:comment>
<rdfs:comment>Not identical with EC 2.1.1.101.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3170602"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
