<rdf:Description rdf:about="3.5.99.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-nitroanthranilic acid aminohydrolase</skos:prefLabel>
<skos:altLabel>5NAA deaminase</skos:altLabel>
<activity rdf:resource="3.5.99.8#SIPF8E75695B07C7505"/>
<rdfs:comment>The enzyme catalyzes the initial step in biodegradation of 5-nitroanthranilic acid by Bradyrhizobium sp. strain JS329.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20081004"/>
<rdfs:subClassOf rdf:resource="3.5.99.-"/>
<skos:broaderTransitive rdf:resource="3.5.99.-"/>
</rdf:Description>
