<skos:altLabel>7-cyano-7-carbaguanine synthase</skos:altLabel>
<skos:altLabel>preQ0 synthase</skos:altLabel>
<activity rdf:resource="6.3.4.20#SIPB2D8A418B4F4F23F"/>
<rdfs:comment>The reaction is part of the biosynthesis pathway of queuosine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18491386"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19354300"/>
