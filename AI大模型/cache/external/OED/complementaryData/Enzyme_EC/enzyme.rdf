<rdf:Description rdf:about="2.3.1.251">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lipid IVA palmitoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.251#SIP3FD4C92A2134249B"/>
<activity rdf:resource="2.3.1.251#SIP4F0042A511BA60DE"/>
<activity rdf:resource="2.3.1.251#SIPBBCAB8D052915C50"/>
<activity rdf:resource="2.3.1.251#SIP19B717D500ABBCD3"/>
<activity rdf:resource="2.3.1.251#SIP4ABA433DF488F299"/>
<activity rdf:resource="2.3.1.251#SIPC8D5AF57D5D3CB6D"/>
<rdfs:comment>Isolated from the bacteria Escherichia coli and Salmonella typhimurium.</rdfs:comment>
<rdfs:comment>The enzyme prefers phosphatidylcholine with a palmitoyl group at the sn-1 position and palmitoyl or stearoyl groups at the sn-2 position.</rdfs:comment>
<rdfs:comment>There is some activity with corresponding phosphatidylserines but only weak activity with other diacylphosphatidyl compounds.</rdfs:comment>
<rdfs:comment>The enzyme also acts on Kdo-(2->4)-Kdo-(2->6)-lipid IVA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11013210"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20826347"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIP3FD4C92A2134249B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-hexadecanoyl-2-acyl-sn-glycero-3-phosphocholine + lipid A (E. coli) = a 2-acyl-sn-glycero-3-phosphocholine + hepta-acyl lipid A.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIP4F0042A511BA60DE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-hexadecanoyl-2-acyl-sn-glycero-3-phosphocholine + lipid IIA = a 2-acyl-sn-glycero-3-phosphocholine + lipid IIB.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIPBBCAB8D052915C50">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-hexadecanoyl-2-acyl-sn-glycero-3-phosphocholine + lipid IVA (E. coli) = a 2-acyl-sn-glycero-3-phosphocholine + lipid IVB (E. coli).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIP19B717D500ABBCD3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphocholine + a lipid A = a 2-acyl-sn-glycero-3-phosphocholine + a hepta-acyl lipid A.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIP4ABA433DF488F299">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphocholine + a lipid IVA = a 2-acyl-sn-glycero-3-phosphocholine + a lipid IVB.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.251#SIPC8D5AF57D5D3CB6D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphocholine + a lipid IIA = a 2-acyl-sn-glycero-3-phosphocholine + a lipid IIB.</rdfs:label>
</rdf:Description>
