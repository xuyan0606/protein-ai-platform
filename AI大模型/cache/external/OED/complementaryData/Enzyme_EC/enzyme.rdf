<rdf:Description rdf:about="2.4.1.287">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>rhamnopyranosyl-N-acetylglucosaminyl-diphospho-decaprenol beta-1,4/1,5-galactofuranosyltransferase</skos:prefLabel>
<skos:altLabel>arabinogalactan galactofuranosyl transferase 1</skos:altLabel>
<activity rdf:resource="2.4.1.287#SIP376CCC977E172DA8"/>
<rdfs:comment>Isolated from Mycobacterium tuberculosis and M.smegmatis, the enzyme has dual beta-(1->4) and beta-(1->5) transferase action.</rdfs:comment>
<rdfs:comment>Involved in the formation of the cell wall in mycobacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16952951"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18055597"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.287#SIP376CCC977E172DA8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-L-rhamnosyl-(1->3)-N-acetyl-alpha-D-glucosaminyl-diphospho-trans,octa-cis-decaprenol + 2 UDP-alpha-D-galactofuranose = beta-D-galactofuranosyl-(1->5)-beta-D-galactofuranosyl-(1->4)-alpha-L-rhamnosyl-(1->3)-N-acetyl-alpha-D-glucosaminyl-diphospho-trans,octa-cis-decaprenol + 2 H(+) + 2 UDP.</rdfs:label>
</rdf:Description>
