<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycine + H2O + O2 = glyoxylate + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.19#SIPFD87257234548AAF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-alanine + H2O + O2 = H2O2 + NH4(+) + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.19#SIPCDD7A91CD67364FE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O2 + sarcosine = glyoxylate + H2O2 + methylamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.19#SIP07DDC99B5D067A72">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-ethylglycine + O2 = ethylamine + glyoxylate + H2O2.</rdfs:label>
</rdf:Description>
