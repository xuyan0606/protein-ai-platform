<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-pantolactone + NADP(+) = 2-dehydropantolactone + H(+) + NADPH.</rdfs:label>
</rdf:Description>
