<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a nucleoside 5'-phosphate + ATP = a 5'-phosphonucleoside 3'-diphosphate + AMP + H(+).</rdfs:label>
</rdf:Description>
