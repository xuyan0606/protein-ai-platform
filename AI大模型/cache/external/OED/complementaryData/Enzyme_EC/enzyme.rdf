<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>guanosine(34) in tRNA + queuine = guanine + queuosine(34) in tRNA.</rdfs:label>
</rdf:Description>
