<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>betaine aldehyde + H2O + NAD(+) = glycine betaine + 2 H(+) + NADH.</rdfs:label>
</rdf:Description>
