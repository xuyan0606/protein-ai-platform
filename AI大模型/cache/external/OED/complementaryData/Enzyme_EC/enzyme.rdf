<skos:prefLabel>diaminopropionate ammonia-lyase</skos:prefLabel>
<skos:altLabel>2,3-diaminopropanoate ammonia-lyase</skos:altLabel>
<skos:altLabel>alpha,beta-diaminopropionate ammonia-lyase</skos:altLabel>
<skos:altLabel>diaminopropionatase</skos:altLabel>
<activity rdf:resource="4.3.1.15#SIP92476670EF8D4E32"/>
<activity rdf:resource="4.3.1.15#SIP7754A751EFA2D606"/>
<rdfs:comment>Active toward both D- and L-diaminopropionate.</rdfs:comment>
<rdfs:comment>D- and L-serine are poor substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3275662"/>
<rdfs:subClassOf rdf:resource="4.3.1.-"/>
<skos:broaderTransitive rdf:resource="4.3.1.-"/>
</rdf:Description>
