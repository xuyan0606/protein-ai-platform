<skos:prefLabel>3-hydroxy-3-isohexenylglutaryl-CoA lyase</skos:prefLabel>
<skos:altLabel>3-hydroxy-3-(4-methylpent-3-en-1-yl)glutaryl-CoA acetate-lyase</skos:altLabel>
<activity rdf:resource="4.1.3.26#SIP6ACE7834300F24BE"/>
<rdfs:comment>Also acts on the hydroxy derivative of farnesoyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14339651"/>
<rdfs:subClassOf rdf:resource="4.1.3.-"/>
<skos:broaderTransitive rdf:resource="4.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.3.26#SIP6ACE7834300F24BE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-hydroxy-3-(4-methylpent-3-en-1-yl)glutaryl-CoA = 7-methyl-3-oxooct-6-enoyl-CoA + acetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/14339651">
