<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.7.n5"/>
<skos:prefLabel>molybdopterin adenylyltransferase</skos:prefLabel>
<activity rdf:resource="2.7.7.75#SIP265A15AEB4D342A9"/>
<rdfs:comment>Catalyzes the activation of molybdopterin for molybdenum insertion.</rdfs:comment>
<rdfs:comment>In eukaryotes, this reaction is catalyzed by the C-terminal domain of a fusion protein that also includes EC 2.10.1.1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10823911"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15504727"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15632135"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
