</rdf:Description>
<rdf:Description rdf:about="2.4.1.367">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ginsenoside 6-O-glucosyltransferase</skos:prefLabel>
<skos:altLabel>UGTPg100</skos:altLabel>
<activity rdf:resource="2.4.1.367#SIPDC02810868020B3D"/>
<activity rdf:resource="2.4.1.367#SIP3545F9A3F38CE7D1"/>
<rdfs:comment>The enzyme, characterized from the plant Panax ginseng, glucosylates the C-6 position of protopanaxatriol and ginsenoside F1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26032089"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
