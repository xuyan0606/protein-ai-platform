<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>arsenite(in) + ATP + H2O = ADP + arsenite(out) + H(+) + phosphate.</rdfs:label>
</rdf:Description>
