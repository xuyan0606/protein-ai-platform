<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2'-hydroxy-2,3-dihydrodaidzein + NADP(+) = 2'-hydroxydaidzein + 2 H(+) + NADPH.</rdfs:label>
</rdf:Description>
