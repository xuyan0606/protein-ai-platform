<rdf:Description rdf:about="3.5.1.135">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N(4)-acetylcytidine amidohydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.135#SIP9FEC59D3C99055C7"/>
<activity rdf:resource="3.5.1.135#SIPABC94E0BD2FE8014"/>
<activity rdf:resource="3.5.1.135#SIP39FA80FEC849A5D7"/>
<rdfs:comment>The enzyme from the bacterium Escherichia coli is one of the smallest known monomeric amidohydrolases (103-amino acids).</rdfs:comment>
<rdfs:comment>The enzyme is active toward a wide range of N(4)-acylcytosines/cytidines, but is by far most active against N(4)-acetylcytidine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15969587"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31964920"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.135#SIP9FEC59D3C99055C7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(4)-acetylcytidine = acetate + cytidine + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.135#SIPABC94E0BD2FE8014">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(4)-acetyl-2'-deoxycytidine = 2'-deoxycytidine + acetate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.135#SIP39FA80FEC849A5D7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(4)-acetylcytosine = acetate + cytosine + H(+).</rdfs:label>
</rdf:Description>
