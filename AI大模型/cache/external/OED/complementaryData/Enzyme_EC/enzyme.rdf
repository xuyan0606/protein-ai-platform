</rdf:Description>
<rdf:Description rdf:about="2.1.1.345">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>psilocybin synthase</skos:prefLabel>
<activity rdf:resource="2.1.1.345#SIP91F1123615973D36"/>
<rdfs:comment>Isolated from the fungus Psilocybe cubensis.</rdfs:comment>
<rdfs:comment>The product, psilocybin, is a psychoactive compound.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28763571"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.345#SIP91F1123615973D36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-hydoxytryptamine 4-phosphate + 2 S-adenosyl-L-methionine = 2 H(+) + psilocybin + 2 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/28763571">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
