<rdf:Description rdf:about="2.7.7.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-N-acetylglucosamine diphosphorylase</skos:prefLabel>
