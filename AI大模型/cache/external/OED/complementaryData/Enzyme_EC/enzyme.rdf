<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-dehydro-6-demethoxy-6-hydroxyfumagillol + S-adenosyl-L-methionine = 5-dehydrofumagillol + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
