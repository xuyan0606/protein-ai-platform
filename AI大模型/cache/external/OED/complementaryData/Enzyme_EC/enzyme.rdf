<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->2)-alpha-D- and (1->6)-alpha-D- linkages in yeast mannan, releasing D-mannose.</rdfs:label>
</rdf:Description>
