<skos:prefLabel>phenylacetaldehyde oxime monooxygenase</skos:prefLabel>
<skos:altLabel>CYP71AN24</skos:altLabel>
<activity rdf:resource="1.14.14.44#SIPF0A839E284F268B4"/>
<rdfs:comment>Involved in the biosynthesis of the cyanogenic glucosides (R)-prunasin and (R)-amygdalin.</rdfs:comment>
<rdfs:comment>It catalyzes three different activities - isomerization of the (E) isomer to the (Z) isomer, dehydration, and C-hydroxylation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25015725"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
