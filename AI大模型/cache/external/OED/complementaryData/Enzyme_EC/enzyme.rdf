<skos:prefLabel>geranylgeraniol 18-hydroxylase</skos:prefLabel>
<skos:altLabel>GGOH-18-hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.14.146#SIP328B1ABE334080BB"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein isolated from the plant Croton sublyratus.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
