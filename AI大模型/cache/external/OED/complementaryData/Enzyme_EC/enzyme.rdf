<rdf:Description rdf:about="4.2.2.25">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>gellan lyase</skos:prefLabel>
<activity rdf:resource="4.2.2.25#SIPB12B50DC78EEA95F"/>
<rdfs:comment>The enzyme is highly specific to gellan, especially deacetylated gellan.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9056228"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9633595"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14759609"/>
<rdfs:subClassOf rdf:resource="4.2.2.-"/>
<skos:broaderTransitive rdf:resource="4.2.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.2.25#SIPB12B50DC78EEA95F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Eliminative cleavage of beta-D-glucopyranosyl-(1->4)-beta-D-glucopyranosyluronate bonds of gellan backbone releasing tetrasaccharides containing a 4-deoxy-4,5-unsaturated D-glucopyranosyluronic acid at the non-reducing end. The tetrasaccharide produced from deacetylated gellan is beta-D-4-deoxy-Delta(4)-GlcAp-(1->4)-beta-D-Glcp-(1->4)-alpha-L-Rhap-(1->3)-beta-D-Glcp.</rdfs:label>
</rdf:Description>
