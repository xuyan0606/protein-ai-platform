</rdf:Description>
<rdf:Description rdf:about="3.1.1.98">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[Wnt protein] O-palmitoleoyl-L-serine hydrolase</skos:prefLabel>
<skos:altLabel>Notum</skos:altLabel>
<activity rdf:resource="3.1.1.98#SIP63C4E2865D64B9C4"/>
<rdfs:comment>The enzyme removes the palmitoleate modification that is introduced to specific L-serine residues in Wnt proteins by EC 2.3.1.250.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25731175"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.98#SIP63C4E2865D64B9C4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[Wnt protein]-O-(9Z)-hexadecenoyl-L-serine + H2O = (9Z)-hexadecenoate + [Wnt protein]-L-serine + H(+).</rdfs:label>
</rdf:Description>
