</rdf:Description>
<rdf:Description rdf:about="2.6.1.76">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diaminobutyrate--2-oxoglutarate transaminase</skos:prefLabel>
<skos:altLabel>2,4-diaminobutyrate 4-aminotransferase</skos:altLabel>
<skos:altLabel>DABA aminotransferase</skos:altLabel>
<skos:altLabel>DAB aminotransferase</skos:altLabel>
<skos:altLabel>diaminibutyric acid aminotransferase</skos:altLabel>
<skos:altLabel>diaminobutyrate--2-oxoglutarate aminotransferase</skos:altLabel>
<skos:altLabel>diaminobutyrate transaminase</skos:altLabel>
<activity rdf:resource="2.6.1.76#SIP0EF7C33810A92CE5"/>
<rdfs:comment>Differs from EC 2.6.1.46, which has pyruvate as the amino-group acceptor.</rdfs:comment>
<rdfs:comment>This is the first enzyme in the ectoine biosynthesis pathway, the other enzymes involved being EC 2.3.1.178 and EC 4.2.1.108.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9141677"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9260954"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9514614"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9864317"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11823218"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.76#SIP0EF7C33810A92CE5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-2,4-diaminobutanoate = L-aspartate 4-semialdehyde + L-glutamate.</rdfs:label>
</rdf:Description>
