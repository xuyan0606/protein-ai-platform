</rdf:Description>
<rdf:Description rdf:about="3.5.1.132">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[amino group carrier protein]-ornithine hydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.132#SIPC1259A128F53F69E"/>
<rdfs:comment>The enzyme participates in an L-arginine biosynthetic pathways in certain species of archaea and bacteria.</rdfs:comment>
<rdfs:comment>In all cases known so far the enzyme also catalyzes the activity of EC 3.5.1.130.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23434852"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27566549"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
