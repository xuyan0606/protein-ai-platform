<rdfs:label>delphinidin 3,5-bis-O-beta-D-glucoside + UDP-alpha-D-glucose = delphinidin 3,3',5-tri-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
