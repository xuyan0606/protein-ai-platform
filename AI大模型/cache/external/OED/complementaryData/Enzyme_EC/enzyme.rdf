<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + phloretin = 1,3,5-trihydroxybenzene + H(+) + phloretate.</rdfs:label>
</rdf:Description>
