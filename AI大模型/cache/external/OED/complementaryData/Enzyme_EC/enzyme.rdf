<citation rdf:resource="http://purl.uniprot.org/citations/15746370"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20093741"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30621365"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
