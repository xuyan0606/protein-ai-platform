<rdf:Description rdf:about="1.14.14.50">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tabersonine 3-oxygenase</skos:prefLabel>
<skos:altLabel>CYP71D1V2</skos:altLabel>
<skos:altLabel>T3O</skos:altLabel>
<activity rdf:resource="1.14.14.50#SIPCAA28C82FE0D2F96"/>
<activity rdf:resource="1.14.14.50#SIP2DFEB6BB5F020D06"/>
<rdfs:comment>This cytochrome P450 enzyme acts on 16-methoxytabersonine, leading to biosynthesis of vindoline in the plant Catharanthus roseus (Madagascar periwinkle).</rdfs:comment>
<rdfs:comment>It can also act on tabersonine, resulting in the production of small amounts of vindorosine.</rdfs:comment>
<rdfs:comment>The products are unstable and, in the absence of EC 1.1.99.41 will convert into 3-epoxylated compounds.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25918424"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.50#SIPCAA28C82FE0D2F96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>16-methoxytabersonine + O2 + reduced [NADPH--hemoprotein reductase] = (3R)-1,2-didehydro-3-hydroxy-16-methoxy-2,3-dihydrotabersonine + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.50#SIP2DFEB6BB5F020D06">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-tabersonine + O2 + reduced [NADPH--hemoprotein reductase] = (3R)-1,2-didehydro-3-hydroxy-2,3-dihydrotabersonine + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25918424">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/25918424"/>
