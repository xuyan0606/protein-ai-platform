<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>purine imidazole-ring cyclase</skos:prefLabel>
<activity rdf:resource="4.3.2.4#SIP344617E807B6CA56"/>
<rdfs:comment>Also acts on 2,6-diamino-5-formamido-3,4-dihydro-4-oxopyrimidine residues.</rdfs:comment>
<rdfs:comment>Brings about the reclosure of the imidazole rings of purine residues damaged by gamma-rays.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3856219"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
