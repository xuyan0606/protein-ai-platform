<skos:prefLabel>carbonyl sulfide hydrolase</skos:prefLabel>
<skos:altLabel>COSase</skos:altLabel>
<skos:altLabel>COS hydrolase</skos:altLabel>
<activity rdf:resource="3.13.1.7#SIP5B73C96F905E942A"/>
<rdfs:comment>The enzyme, characterized from the bacterium Thiobacillus thioparus, catalyzes a step in the degradation pathway of thiocyanate.</rdfs:comment>
<rdfs:comment>This activity is also catalyzed by the archaeal EC 3.13.1.5.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23406161"/>
<rdfs:subClassOf rdf:resource="3.13.1.-"/>
<skos:broaderTransitive rdf:resource="3.13.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.13.1.7#SIP5B73C96F905E942A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbonyl sulfide + H2O = CO2 + H(+) + hydrogen sulfide.</rdfs:label>
</rdf:Description>
