<rdf:Description rdf:about="1.14.13.235">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>indole-3-acetate monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.13.235#SIP1CCB9C0C27DB3CAC"/>
<rdfs:comment>The enzyme, characterized from Pseudomonas putida strains, catalyzes the first step in a pathway for degradation of the plant hormone indole-3-acetate.</rdfs:comment>
<rdfs:comment>When acting on indole, the enzyme forms indoxyl, which reacts spontaneously with oxygen to form the blue dye indigo.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15870323"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23881445"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.235#SIP1CCB9C0C27DB3CAC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(indol-3-yl)acetate + H(+) + NADH + O2 = 2-hydroxy-(1H-indol-3-yl)acetate + H2O + NAD(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15870323">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/15870323"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/15870323"/>
</rdf:Description>
