<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3 H(+) + 3 malonyl-CoA + N-methylanthraniloyl-CoA = 1,3-dihydroxy-N-methylacridone + 3 CO2 + 4 CoA + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8148006">
