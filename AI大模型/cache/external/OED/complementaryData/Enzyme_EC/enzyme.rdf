<rdf:Description rdf:about="2.4.1.209">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cis-p-coumarate glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.209#SIP76A9B20E3B428766"/>
<rdfs:comment>cis-Caffeic acid also serves as a glucosyl acceptor with the enzyme from Sphagnum fallax kinggr.</rdfs:comment>
<rdfs:comment>The corresponding trans-isomers are not substrates.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.209#SIP76A9B20E3B428766">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cis-4-coumarate + UDP-alpha-D-glucose = 4'-O-beta-D-glucosyl-cis-4-coumarate + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.210">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>limonoid glucosyltransferase</skos:prefLabel>
<skos:altLabel>LGTase</skos:altLabel>
<skos:altLabel>limonoid UDP-glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.210#SIP8202316ED481241A"/>
<rdfs:comment>The enzyme purified from navel orange albedo tissue also acts on the related tetranortriterpenoid nomilin.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.210#SIP8202316ED481241A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + limonin + UDP-alpha-D-glucose = glucosyl-limonin + 2 H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.211">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>1,3-beta-galactosyl-N-acetylhexosamine phosphorylase</skos:prefLabel>
<skos:altLabel>galacto-N-biose phosphorylase</skos:altLabel>
<skos:altLabel>lacto-N-biose phosphorylase</skos:altLabel>
<skos:altLabel>LNBP</skos:altLabel>
<activity rdf:resource="2.4.1.211#SIP0A1AEA34CD93E316"/>
<rdfs:comment>Reaction also occurs with beta-D-galactopyranosyl-(1->3)-N-acetyl-D-galactosamine as the substrate, giving N-acetyl-D-galactosamine as the product.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9889079"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.211#SIP0A1AEA34CD93E316">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-D-galactosyl-(1->3)-N-acetyl-D-glucosamine + phosphate = alpha-D-galactose 1-phosphate + N-acetyl-D-glucosamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9889079">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9889079"/>
