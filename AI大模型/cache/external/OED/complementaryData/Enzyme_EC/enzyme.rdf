</rdf:Description>
<rdf:Description rdf:about="2.1.1.352">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-O-acetyl-4'-O-demethylpapaveroxine 4'-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.352#SIP88E26793A4F98680"/>
<rdfs:comment>This activity is part of the noscapine biosynthesis pathway, as characterized in the plant Papaver somniferum (opium poppy).</rdfs:comment>
<rdfs:comment>It is catalyzed by heterodimeric complexes of the OMT2 gene product and the product of either OMT3 or 6OMT.</rdfs:comment>
<rdfs:comment>OMT2 is the catalytic subunit in both complexes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27378283"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29723437"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.352#SIP88E26793A4F98680">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-S-adenosyl-L-methionine + 3-O-acetyl-4'-O-demethylpapaveroxine = 3-O-acetylpapaveroxine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/27378283">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27378283"/>
