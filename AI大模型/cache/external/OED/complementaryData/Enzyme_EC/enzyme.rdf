<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + N(tele)-phospho-L-histidyl/O-phospho-L-threonyl-[pyruvate, phosphate dikinase] + phosphate = diphosphate + N(tele)-phospho-L-histidyl/L-threonyl-[pyruvate, phosphate dikinase].</rdfs:label>
</rdf:Description>
