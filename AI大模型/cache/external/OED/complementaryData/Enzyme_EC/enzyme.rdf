<rdfs:label>(S)-3-hydroxybutanoate + 2-oxoglutarate = (R)-2-hydroxyglutarate + acetoacetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.24#SIP6094D223480F5AA9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + 4-hydroxybutanoate = (R)-2-hydroxyglutarate + succinate semialdehyde.</rdfs:label>
</rdf:Description>
