<rdf:Description rdf:about="2.7.4.26">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isopentenyl phosphate kinase</skos:prefLabel>
<activity rdf:resource="2.7.4.26#SIP6E81CA35CEDB45EF"/>
<rdfs:comment>The enzyme is involved in the mevalonate pathway in Archaea.</rdfs:comment>
<rdfs:comment>The activity has also been identified in the plant Mentha piperita (peppermint).</rdfs:comment>
<rdfs:comment>It is strictly specific for ATP but can use other phosphate acceptors such as prenyl phosphate, geranyl phosphate, or fosfomycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10570138"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16621811"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19928876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20402538"/>
<rdfs:subClassOf rdf:resource="2.7.4.-"/>
<skos:broaderTransitive rdf:resource="2.7.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.4.26#SIP6E81CA35CEDB45EF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + isopentenyl phosphate = ADP + isopentenyl diphosphate.</rdfs:label>
</rdf:Description>
