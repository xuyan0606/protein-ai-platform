<rdf:Description rdf:about="3.5.1.62">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylputrescine deacetylase</skos:prefLabel>
<activity rdf:resource="3.5.1.62#SIPD40880F4A2C1D9AF"/>
<rdfs:comment>The enzyme from Micrococcus luteus also acts on N(8)-acetylspermidine and acetylcadaverine, but more slowly.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.62#SIPD40880F4A2C1D9AF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-acetylputrescine = acetate + putrescine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.63">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-acetamidobutyrate deacetylase</skos:prefLabel>
<activity rdf:resource="3.5.1.63#SIP8B4347F56D3E9647"/>
<activity rdf:resource="3.5.1.63#SIP7BC422065FC94398"/>
<rdfs:comment>Also acts on N-acetyl-beta-alanine and 5-acetamidopentanoate.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.63#SIP8B4347F56D3E9647">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-acetamidobutanoate + H2O = 4-aminobutanoate + acetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.63#SIP7BC422065FC94398">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-acetamidopentanoate + H2O = 5-aminopentanoate + acetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.64">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N(alpha)-benzyloxycarbonylleucine hydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.64#SIP690B15FC9ED35D67"/>
<rdfs:comment>Also acts on N(alpha)-t-butoxycarbonyl-L-leucine, and, more slowly, on the corresponding derivatives of L-aspartate, L-methionine, L-glutamate and L-alanine (cf. EC 3.5.1.58).</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.64#SIP690B15FC9ED35D67">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + H2O + N-benzyloxycarbonyl-L-leucine = benzyl alcohol + CO2 + L-leucine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.65">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>theanine hydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.65#SIPF9E5FE5D3033E972"/>
<rdfs:comment>Also acts on other N-alkyl-L-glutamines.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.65#SIPF9E5FE5D3033E972">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(5)-ethyl-L-glutamine = ethylamine + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.66">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-(hydroxymethyl)-3-(acetamidomethylene)succinate hydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.66#SIPE2E655930862964F"/>
<rdfs:comment>Involved in the degradation of pyridoxine by Pseudomonas and Arthrobacter.</rdfs:comment>
