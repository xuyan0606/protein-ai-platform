<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-hydroxy-5-methyl-1-naphthoate + S-adenosyl-L-methionine = 3-methoxy-5-methyl-1-naphthoate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
