<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-acylglycerol + an acyl-CoA = a 1,2-diacylglycerol + CoA.</rdfs:label>
</rdf:Description>
