<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-phospho-L-lactate guanylyltransferase</skos:prefLabel>
<activity rdf:resource="2.7.7.68#SIP5F8112171770D602"/>
<rdfs:comment>This enzyme is involved in the biosynthesis of coenzyme F420, a redox-active cofactor, in all methanogenic archaea. cf. EC 2.7.7.105 and EC 2.7.7.106.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18260642"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31469543"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.68#SIP5F8112171770D602">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2S)-2-phospholactate + GTP + H(+) = (2S)-lactyl-2-diphospho-5'-guanosine + diphosphate.</rdfs:label>
</rdf:Description>
