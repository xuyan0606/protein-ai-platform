<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24837359"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[amino group carrier protein]-gamma-(L-lysyl)-L-glutamate aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.118#SIPCC63F1731369463A"/>
<rdfs:comment>The enzyme participates in an L-lysine biosynthesis pathway in certain species of archaea and bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11489859"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19620981"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.118#SIPCC63F1731369463A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + [amino-group carrier protein]-C-terminal-gamma-(L-lysyl)-L-glutamate = [amino-group carrier protein]-C-terminal-N-(1-carboxy-5-oxopentan-1-yl)-L-glutamine + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11489859">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11489859"/>
