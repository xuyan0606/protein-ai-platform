<rdf:Description rdf:about="6.2.1.53">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-proline--[L-prolyl-carrier protein] ligase</skos:prefLabel>
<activity rdf:resource="6.2.1.53#SIP2DF87E5D1B28B049"/>
<rdfs:comment>The enzyme participates in the biosynthesis of several pyrrole-containing compounds, such as undecylprodigiosin, prodigiosin, pyoluteorin, and coumermycin A1.</rdfs:comment>
<rdfs:comment>It catalyzes the activation of L-proline to an adenylate form, followed by its transfer to the 4'-phosphopantheine moiety of an L-prolyl-carrier protein.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11880032"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15528645"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15853884"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
