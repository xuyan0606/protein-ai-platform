<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(1->4)-alpha-D-glucosyl](n) + sucrose = [(1->4)-alpha-D-glucosyl](n+1) + D-fructose.</rdfs:label>
</rdf:Description>
