<rdf:Description rdf:about="1.13.11.90">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[1-hydroxy-2-(trimethylamino)ethyl]phosphonate dioxygenase (glycine-betaine-forming)</skos:prefLabel>
<activity rdf:resource="1.13.11.90#SIP404197FE05F3339B"/>
<rdfs:comment>Requires Fe(2+).</rdfs:comment>
<rdfs:comment>This bacterial enzyme is involved in a degradation pathway for [(2-trimethylamino)ethyl]phosphonate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30789718"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.13.11.90#SIP404197FE05F3339B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(1R)-1-hydroxy-2-(trimethylamino)ethyl]phosphonate + O2 = glycine betaine + 2 H(+) + phosphate.</rdfs:label>
</rdf:Description>
