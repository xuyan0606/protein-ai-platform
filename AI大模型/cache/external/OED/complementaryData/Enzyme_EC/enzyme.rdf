<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,4-didehydro-3-deoxy-L-rhamnonate + H2O = (S)-lactate + H(+) + pyruvate.</rdfs:label>
</rdf:Description>
