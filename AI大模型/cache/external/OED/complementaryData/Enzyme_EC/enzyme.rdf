<activity rdf:resource="2.1.1.287#SIP4C839C4D8B970D6D"/>
<rdfs:comment>The enzyme is found in eukaryotes.</rdfs:comment>
<rdfs:comment>The adenine position refers to tRNA the yeast Saccharomyces cerevisiae, in which the enzyme is important for ribosome biogenesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23180764"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
