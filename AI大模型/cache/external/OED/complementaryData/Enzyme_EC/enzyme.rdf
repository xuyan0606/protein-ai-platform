<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6E,10E)-geranyllinalool + O2 + reduced [NADPH--hemoprotein reductase] = (3E,7E)-4,8,12-trimethyltrideca 1,3,7,11-tetraene + but-3-en-2-one + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
