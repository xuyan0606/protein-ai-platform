<rdf:Description rdf:about="2.6.1.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-aminobutyrate--pyruvate transaminase</skos:prefLabel>
<skos:altLabel>4-aminobutyrate aminotransferase</skos:altLabel>
<skos:altLabel>GABA transaminase</skos:altLabel>
<skos:altLabel>gamma-aminobutyrate aminotransaminase</skos:altLabel>
<skos:altLabel>gamma-aminobutyric acid pyruvate transaminase</skos:altLabel>
<activity rdf:resource="2.6.1.96#SIP0A413406D89169A5"/>
<activity rdf:resource="2.6.1.96#SIP450F51BA85DD4495"/>
<rdfs:comment>The enzyme is found in plants that do not have the 2-oxoglutarate dependent enzyme (cf. EC 2.6.1.19).</rdfs:comment>
<rdfs:comment>The reaction with pyruvate is reversible while the reaction with glyoxylate only takes place in the forward direction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12859897"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19264755"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19470656"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.96#SIP0A413406D89169A5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-aminobutanoate + pyruvate = L-alanine + succinate semialdehyde.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.96#SIP450F51BA85DD4495">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-aminobutanoate + glyoxylate = glycine + succinate semialdehyde.</rdfs:label>
</rdf:Description>
