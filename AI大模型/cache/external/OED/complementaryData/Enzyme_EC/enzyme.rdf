<rdf:Description rdf:about="3.1.3.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.1.3.n6"/>
<skos:prefLabel>pseudouridine 5'-phosphatase</skos:prefLabel>
<skos:altLabel>5'-PsiMPase</skos:altLabel>
<skos:altLabel>pseudouridine 5'-monophosphatase</skos:altLabel>
<activity rdf:resource="3.1.3.96#SIP379C29E29B5038C1"/>
<rdfs:comment>The enzyme, isolated from animals, dephosphorylates pseudouridine 5'-phosphate, a potential intermediate in rRNA degradation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20722631"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
