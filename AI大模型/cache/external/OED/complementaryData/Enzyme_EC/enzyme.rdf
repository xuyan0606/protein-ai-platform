<skos:prefLabel>2-amino-2'-deoxyadenylo-succinate synthase</skos:prefLabel>
<activity rdf:resource="6.3.4.25#SIP07795D940FAC17A8"/>
<rdfs:comment>The enzyme, characterized from a number of bacteriophages, participates in the biosynthesis of dZTP, which replaces dATP in the genome of these phages.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/33926954"/>
<citation rdf:resource="http://purl.uniprot.org/citations/33926955"/>
<rdfs:subClassOf rdf:resource="6.3.4.-"/>
<skos:broaderTransitive rdf:resource="6.3.4.-"/>
</rdf:Description>
