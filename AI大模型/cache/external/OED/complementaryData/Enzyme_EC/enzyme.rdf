<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3 2,3-dihydroxybenzoate + 6 ATP + 3 L-serine = 6 AMP + 6 diphosphate + enterobactin + 4 H(+).</rdfs:label>
</rdf:Description>
