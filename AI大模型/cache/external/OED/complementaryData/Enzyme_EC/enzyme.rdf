<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + hydrogencarbonate + N(6)-biotinyl-L-lysyl-[protein] = ADP + H(+) + N(6)-carboxybiotinyl-L-lysyl-[protein] + phosphate.</rdfs:label>
</rdf:Description>
