<rdf:Description rdf:about="1.21.3.10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.99.51"/>
<skos:prefLabel>hercynylcysteine S-oxide synthase</skos:prefLabel>
<activity rdf:resource="1.21.3.10#SIP009AEF261C6628FC"/>
<rdfs:comment>Requires Fe(2+) for activity.</rdfs:comment>
<rdfs:comment>The enzyme, found in fungal species, is part of a fusion protein that also has the the activity of EC 2.1.1.44.</rdfs:comment>
<rdfs:comment>It is part of the biosynthesis pathway of ergothioneine.</rdfs:comment>
<rdfs:comment>The enzyme can also use L-selenocysteine to produce hercynylselenocysteine, which can be converted to selenoneine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24828577"/>
<rdfs:subClassOf rdf:resource="1.21.3.-"/>
<skos:broaderTransitive rdf:resource="1.21.3.-"/>
</rdf:Description>
