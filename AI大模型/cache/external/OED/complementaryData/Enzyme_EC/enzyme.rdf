<skos:prefLabel>aromatic-amino-acid--glyoxylate transaminase</skos:prefLabel>
<skos:altLabel>aromatic-amino-acid--glyoxylate aminotransferase</skos:altLabel>
<activity rdf:resource="2.6.1.60#SIP8A699329E8FAED08"/>
<rdfs:comment>Phenylalanine, kynurenine, tyrosine and histidine can act as amino donors.</rdfs:comment>
<rdfs:comment>Glyoxylate, pyruvate and hydroxypyruvate can act as amino acceptors.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25837"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.60#SIP8A699329E8FAED08">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an aromatic L-alpha-amino acid + glyoxylate = an aromatic oxo-acid + glycine.</rdfs:label>
</rdf:Description>
