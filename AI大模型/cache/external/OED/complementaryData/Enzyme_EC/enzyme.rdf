<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3',5'-cyclic AMP + H(+) + H2O = 3',5'-cyclic IMP + NH4(+).</rdfs:label>
</rdf:Description>
