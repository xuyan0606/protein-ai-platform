<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19429610"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/19429610"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.117">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-methylcitrate dehydratase (2-methyl-trans-aconitate forming)</skos:prefLabel>
<activity rdf:resource="4.2.1.117#SIP750F01DC05ED316F"/>
<rdfs:comment>Catalyzes the dehydration of (2S,3S)-2-methylcitrate, forming the trans isomer of 2-methyl-aconitate (unlike EC 4.2.1.79, which forms only the cis isomer).</rdfs:comment>
<rdfs:comment>Part of a propanoate degradation pathway.</rdfs:comment>
<rdfs:comment>The enzyme from Shewanella oneidensis can also accept citrate and cis-aconitate, but activity with (2S,3S)-2-methylcitrate was approximately 2.5-fold higher.</rdfs:comment>
<rdfs:comment>2-methylisocitrate and isocitrate were not substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14702315"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.117#SIP750F01DC05ED316F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2S,3S)-2-methylcitrate = 2-methyl-trans-aconitate + H2O.</rdfs:label>
</rdf:Description>
