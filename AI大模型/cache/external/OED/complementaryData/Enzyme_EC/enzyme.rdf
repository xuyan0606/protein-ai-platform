<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/28045510"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28045510"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.343">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>8-amino-8-demethylriboflavin N,N-dimethyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.343#SIPB7DBD7EE13A4ADF8"/>
<rdfs:comment>The enzyme, characterized from the soil bacterium Streptomyces davawensis, catalyzes the last two steps in the biosynthesis of the antibiotic roseoflavin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21911488"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26913589"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.343#SIPB7DBD7EE13A4ADF8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8-amino-8-demethylriboflavin + 2 S-adenosyl-L-methionine = 2 H(+) + roseoflavin + 2 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21911488">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21911488"/>
