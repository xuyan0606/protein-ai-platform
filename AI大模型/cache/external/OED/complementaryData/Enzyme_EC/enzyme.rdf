<rdf:Description rdf:about="4.2.1.93">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ATP-dependent NAD(P)H-hydrate dehydratase</skos:prefLabel>
<skos:altLabel>ATP-dependent H4NAD(P)OH dehydratase</skos:altLabel>
<activity rdf:resource="4.2.1.93#SIP00E4022EBDD31F6A"/>
<activity rdf:resource="4.2.1.93#SIP685C3B3733066055"/>
<rdfs:comment>Acts equally well on hydrated NADH and hydrated NADPH.</rdfs:comment>
<rdfs:comment>NAD(P)H spontaneously hydrates to both the (6S)- and (6R)- isomers, and these are interconverted by EC 5.1.99.6, to a 60:40 ratio.</rdfs:comment>
<rdfs:comment>Hence EC 4.2.1.93 together with EC 5.1.99.6 can restore the mixture of hydrates into NAD(P)H.</rdfs:comment>
<rdfs:comment>The enzyme from eukaryotes has no activity with ADP, contrary to the enzyme from bacteria (cf. EC 4.2.1.136).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3061454"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13331940"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21994945"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.93#SIP00E4022EBDD31F6A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-NADHX + ATP = ADP + H(+) + NADH + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.93#SIP685C3B3733066055">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-NADPHX + ATP = ADP + H(+) + NADPH + phosphate.</rdfs:label>
</rdf:Description>
