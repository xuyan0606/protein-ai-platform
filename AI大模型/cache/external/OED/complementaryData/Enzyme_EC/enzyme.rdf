<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 4'-hydroxyflavanone + S-adenosyl-L-methionine = a 4'-methoxyflavanone + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
