<rdfs:label>2-O-sulfo-alpha,alpha-trehalose + octadecanoyl-CoA = 2-O-sulfo-2'-O-octadecanoyl-alpha,alpha-trehalose + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.288#SIP5DC946CFD7521DC0">
