<rdf:Description rdf:about="4.1.2.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-allo-threonine aldolase</skos:prefLabel>
<activity rdf:resource="4.1.2.49#SIP193FF28F6871B67D"/>
<rdfs:comment>This enzyme, characterized from the bacterium Aeromonas jandaei, is specific for L-allo-threonine and can not act on either L-threonine or L-serine.</rdfs:comment>
<rdfs:comment>Different from EC 4.1.2.5 and EC 4.1.2.48.</rdfs:comment>
<rdfs:comment>A previously listed enzyme with this name, EC 4.1.2.6, was deleted in 1971 after it was found to be identical to EC 2.1.2.1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9228760"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
