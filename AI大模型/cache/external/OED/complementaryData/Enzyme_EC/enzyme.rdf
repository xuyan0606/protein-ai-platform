<rdf:Description rdf:about="3.6.1.55">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>8-oxo-dGTP diphosphatase</skos:prefLabel>
<skos:altLabel>7,8-dihydro-8-oxo-dGTP pyrophosphohydrolase</skos:altLabel>
<skos:altLabel>7,8-dihydro-8-oxoguanine triphosphatase</skos:altLabel>
<skos:altLabel>8-oxo-dGTPase</skos:altLabel>
<activity rdf:resource="3.6.1.55#SIP4204F32A46CF93AB"/>
<rdfs:comment>This enzyme hydrolyzes the phosphoanhydride bond between the alpha and beta phosphate of 8-oxoguanine-containing nucleoside di- and triphosphates thereby preventing misincorporation of the oxidized purine nucleoside triphosphates into DNA.</rdfs:comment>
<rdfs:comment>It does not hydrolyze 2-hydroxy-dATP (cf. EC 3.6.1.56).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15850400"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17804481"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19864691"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21178309"/>
<rdfs:subClassOf rdf:resource="3.6.1.-"/>
<skos:broaderTransitive rdf:resource="3.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.55#SIP4204F32A46CF93AB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8-oxo-dGTP + H2O = 8-oxo-dGMP + diphosphate + H(+).</rdfs:label>
</rdf:Description>
