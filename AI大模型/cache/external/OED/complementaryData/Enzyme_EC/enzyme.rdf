<rdf:Description rdf:about="2.7.7.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ADP-D-ribose pyrophosphorylase</skos:prefLabel>
<skos:altLabel>diphosphate adenylyltransferase</skos:altLabel>
<skos:altLabel>diphosphate--ADP-D-ribose adenylyltransferase</skos:altLabel>
<skos:altLabel>NUDIX5</skos:altLabel>
<activity rdf:resource="2.7.7.96#SIP076D00401AB9DA96"/>
<rdfs:comment>The human enzyme produces ATP in nuclei in situations of high energy demand, such as chromatin remodeling.</rdfs:comment>
<rdfs:comment>The reaction is dependent on the presence of diphosphate.</rdfs:comment>
<rdfs:comment>In its absence the enzyme catalyzes the reaction of EC 3.6.1.13. cf. EC 2.7.7.35.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27257257"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.96#SIP076D00401AB9DA96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + D-ribose 5-phosphate + H(+) = ADP-D-ribose + diphosphate.</rdfs:label>
</rdf:Description>
