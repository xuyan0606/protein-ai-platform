<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an S-substituted glutathione + H2O = glycine + S-substituted gamma-glutamyl-L-cysteine.</rdfs:label>
</rdf:Description>
