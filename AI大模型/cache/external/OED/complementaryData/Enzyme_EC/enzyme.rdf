<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co(I)-[trimethylamine-specific corrinoid protein] + H(+) + trimethylamine = dimethylamine + methyl-Co(III)-[trimethylamine-specific corrinoid protein].</rdfs:label>
</rdf:Description>
