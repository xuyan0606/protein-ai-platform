<rdf:Description rdf:about="1.14.14.21">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dibenzothiophene monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.14.21#SIPD70928FD10F3C4B2"/>
<rdfs:comment>This bacterial enzyme catalyzes the first two steps in the desulfurization pathway of dibenzothiophenes, the oxidation of dibenzothiophene into dibenzothiophene sulfone via dibenzothiophene-5-oxide.</rdfs:comment>
<rdfs:comment>The enzyme forms a two-component system with EC 1.5.1.42, which also interacts with EC 1.14.14.22.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9634856"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24470304"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25627402"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.21#SIPD70928FD10F3C4B2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dibenzothiophene + 2 FMNH2 + 2 O2 = dibenzothiophene 5,5-dioxide + 2 FMN + 2 H(+) + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9634856">
