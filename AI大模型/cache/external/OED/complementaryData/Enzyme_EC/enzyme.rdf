<skos:altLabel>glucan 1,4-alpha-maltotetrahydrolase</skos:altLabel>
<skos:altLabel>maltotetraose-forming amylase</skos:altLabel>
<activity rdf:resource="3.2.1.60#SIPEF04F7735FBD50C4"/>
