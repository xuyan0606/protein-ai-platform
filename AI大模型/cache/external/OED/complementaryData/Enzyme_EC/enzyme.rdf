<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12354116"/>
<dcterms:identifier>doi:10.1046/j.1432-1033.2002.03184.x</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12464604">
