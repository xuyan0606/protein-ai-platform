<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O + levoglucosan = ADP + D-glucose 6-phosphate + H(+).</rdfs:label>
</rdf:Description>
