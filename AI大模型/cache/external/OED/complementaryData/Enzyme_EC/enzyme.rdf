</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18775708">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18775708"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18775708"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20364820">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/20364820"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/20364820"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.53">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.1.2.n3"/>
<skos:prefLabel>2-keto-3-deoxy-L-rhamnonate aldolase</skos:prefLabel>
<skos:altLabel>2-dehydro-3-deoxyrhamnonate aldolase</skos:altLabel>
<skos:altLabel>2-keto-3-deoxy acid sugar aldolase</skos:altLabel>
<skos:altLabel>KDR aldolase</skos:altLabel>
<activity rdf:resource="4.1.2.53#SIP42B0B508923C2943"/>
<rdfs:comment>The enzyme can also use 2-oxo-3-deoxy-L-mannonate, 2-oxo-3-deoxy-L-lyxonate and 4-hydroxy-2-ketoheptane-1,7-dioate (HKHD) as substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18754683"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18754693"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.53#SIP42B0B508923C2943">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-dehydro-3-deoxy-L-rhamnonate = (S)-lactaldehyde + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18754683">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18754683"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18754683"/>
</rdf:Description>
