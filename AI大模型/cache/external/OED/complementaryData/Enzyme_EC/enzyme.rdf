<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + beta-alanine + L-histidine = ADP + carnosine + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.11#SIPA13D683863D7077C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-aminobutanoate + ATP + L-histidine = ADP + H(+) + L-homocarnosine + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.11#SIPBC55BF170F99058C">
