<skos:altLabel>glucolipid epimerase</skos:altLabel>
<activity rdf:resource="5.1.3.34#SIP501E4592FF350B2C"/>
<rdfs:comment>The enzyme, characterized from cyanobacteria, is involves in the biosynthesis of galactolipids found in their photosynthetic membranes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25197079"/>
<rdfs:subClassOf rdf:resource="5.1.3.-"/>
<skos:broaderTransitive rdf:resource="5.1.3.-"/>
</rdf:Description>
