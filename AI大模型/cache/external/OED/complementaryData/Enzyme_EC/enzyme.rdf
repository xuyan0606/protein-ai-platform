</rdf:Description>
<rdf:Description rdf:about="1.2.1.84">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alcohol-forming fatty acyl-CoA reductase</skos:prefLabel>
<activity rdf:resource="1.2.1.84#SIPC54EFB792D549439"/>
<activity rdf:resource="1.2.1.84#SIP4ECBFF89133468B4"/>
<activity rdf:resource="1.2.1.84#SIPEF426C96CBCAF005"/>
<rdfs:comment>The enzyme has been characterized from the plant Simmondsia chinensis (jojoba).</rdfs:comment>
<rdfs:comment>The alcohol is formed by a four-electron reduction of fatty acyl-CoA.</rdfs:comment>
<rdfs:comment>Although the reaction proceeds through an aldehyde intermediate, a free aldehyde is not released.</rdfs:comment>
<rdfs:comment>The recombinant enzyme was shown to accept saturated and mono-unsaturated fatty acyl-CoAs of 16 to 22 carbons.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10712526"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
