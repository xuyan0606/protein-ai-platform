<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + holo-[peptidyl-carrier protein] + L-proline = AMP + diphosphate + L-prolyl-[peptidyl-carrier protein].</rdfs:label>
</rdf:Description>
