<rdf:Description rdf:about="1.14.14.10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nitrilotriacetate monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.14.10#SIP6D4517D802E6DFA7"/>
<rdfs:comment>The enzyme from Aminobacter aminovorans (previously Chelatobacter heintzii) is part of a two component system that also includes EC 1.5.1.42 (FMN reductase), which provides reduced flavin mononucleotide for this enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1735711"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8892809"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9023192"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.10#SIP6D4517D802E6DFA7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + nitrilotriacetate + O2 = aminodiacetate + FMN + glyoxylate + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1735711">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/1735711"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/1735711"/>
</rdf:Description>
