<skos:altLabel>coenzyme F420-dependent formate dehydrogenase</skos:altLabel>
<skos:altLabel>coenzyme F420 reducing formate dehydrogenase</skos:altLabel>
<activity rdf:resource="1.17.98.3#SIP3B5DCF2260C35923"/>
<rdfs:comment>The enzyme from methanogenic archaea is a involved in formate-dependent H2 production.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3944055"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6874636"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18791018"/>
<rdfs:subClassOf rdf:resource="1.17.98.-"/>
<skos:broaderTransitive rdf:resource="1.17.98.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.98.3#SIP3B5DCF2260C35923">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>formate + 2 H(+) + oxidized coenzyme F420-(gamma-L-Glu)(n) = CO2 + reduced coenzyme F420-(gamma-L-Glu)(n).</rdfs:label>
</rdf:Description>
