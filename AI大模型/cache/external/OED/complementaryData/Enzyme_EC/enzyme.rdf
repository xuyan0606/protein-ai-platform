<skos:prefLabel>salicyl-alcohol beta-D-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.172#SIP5324972C9FB852A0"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
