<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-carnitinamide + H2O = (R)-carnitine + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.74">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>chenodeoxycholoyltaurine hydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.74#SIP2ECCBA7BAE707C16"/>
<rdfs:comment>Some other taurine conjugates are hydrolyzed, but not glycine conjugates of bile acids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2628421"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
