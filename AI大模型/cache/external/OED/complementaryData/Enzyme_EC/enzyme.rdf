<rdf:Description rdf:about="6.3.1.17">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-citrylglutamate synthase</skos:prefLabel>
<skos:altLabel>NAAGS-I</skos:altLabel>
<skos:altLabel>NAAG synthetase I</skos:altLabel>
<activity rdf:resource="6.3.1.17#SIP3142733A7ABAF8E7"/>
<rdfs:comment>The enzyme, found in animals, also has the activity of EC 6.3.2.41.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20657015"/>
<rdfs:subClassOf rdf:resource="6.3.1.-"/>
<skos:broaderTransitive rdf:resource="6.3.1.-"/>
