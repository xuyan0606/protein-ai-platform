<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23061549"/>
<dcterms:identifier>doi:10.1111/febs.12027</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="3.1.6.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>S-sulfosulfanyl-L-cysteine sulfohydrolase</skos:prefLabel>
<activity rdf:resource="3.1.6.20#SIP60854025799A75B9"/>
<activity rdf:resource="3.1.6.20#SIPF528556DE1AFE480"/>
<rdfs:comment>The enzyme is part of the Sox enzyme system, which participates in a bacterial thiosulfate oxidation pathway that produces sulfate.</rdfs:comment>
<rdfs:comment>It catalyzes two reactions in the pathway.</rdfs:comment>
<rdfs:comment>In both cases the enzyme hydrolyzes a sulfonate moiety that is bound (either directly or via a sulfane) to a cysteine residue of a SoxY protein, releasing sulfate.</rdfs:comment>
<rdfs:comment>The enzyme from Paracoccus pantotrophus contains a pyroglutamate (cycloglutamate) at its N-terminus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11425697"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11513876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14651972"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16133204"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16995898"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28257465"/>
<rdfs:subClassOf rdf:resource="3.1.6.-"/>
<skos:broaderTransitive rdf:resource="3.1.6.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.6.20#SIP60854025799A75B9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + S-sulfosulfanyl-L-cysteinyl-[SoxY protein] = H(+) + S-sulfanyl-L-cysteinyl-[SoxY protein] + sulfate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.6.20#SIPF528556DE1AFE480">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + S-(2-sulfodisulfanyl)-L-cysteinyl-[SoxY protein] = H(+) + S-disulfanyl-L-cysteinyl-[SoxY protein] + sulfate.</rdfs:label>
</rdf:Description>
