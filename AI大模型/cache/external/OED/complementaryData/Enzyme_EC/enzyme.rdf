<rdf:Description rdf:about="1.2.7.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-oxoacid oxidoreductase (ferredoxin)</skos:prefLabel>
<skos:altLabel>OFOR</skos:altLabel>
<activity rdf:resource="1.2.7.11#SIPD82AF831E277E3B5"/>
<rdfs:comment>This enzyme is a member of the 2-oxoacid oxidoreductases, a family of enzymes that oxidatively decarboxylate different 2-oxoacids to form their CoA derivatives, and are differentiated based on their substrate specificity.</rdfs:comment>
<rdfs:comment>For example, see EC 1.2.7.3 and EC 1.2.7.7.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6266826"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8902625"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11683888"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12009405"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15848165"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16466637"/>
<rdfs:subClassOf rdf:resource="1.2.7.-"/>
<skos:broaderTransitive rdf:resource="1.2.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.7.11#SIPD82AF831E277E3B5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-oxocarboxylate + CoA + 2 oxidized [2Fe-2S]-[ferredoxin] = an acyl-CoA + CO2 + H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
