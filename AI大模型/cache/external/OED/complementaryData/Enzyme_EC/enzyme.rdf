<rdf:Description rdf:about="3.1.13.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ribonuclease D</skos:prefLabel>
<skos:altLabel>RNase D</skos:altLabel>
<activity rdf:resource="3.1.13.5#SIP35D08A90895D1A3C"/>
<rdfs:comment>Alteration of the 3'-terminal base has no effect on the rate of hydrolysis whereas modification of the 3'-terminal sugar has a major effect.</rdfs:comment>
<rdfs:comment>tRNA terminating with a 3'-phosphate is completely inactive.</rdfs:comment>
<rdfs:comment>This enzyme can convert a tRNA precursor into a mature tRNA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/342522"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2828310"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6263885"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6263886"/>
