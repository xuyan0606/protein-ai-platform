<rdf:Description rdf:about="3.2.1.136">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucuronoarabinoxylan endo-1,4-beta-xylanase</skos:prefLabel>
<skos:altLabel>feraxan endoxylanase</skos:altLabel>
<activity rdf:resource="3.2.1.136#SIPDD40C605CF0E2E82"/>
<rdfs:comment>High activity toward feruloylated arabinoxylans from cereal plant cell walls.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16666240"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.136#SIPDD40C605CF0E2E82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endohydrolysis of (1->4)-beta-D-xylosyl links in some glucuronoarabinoxylans.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16666240">
