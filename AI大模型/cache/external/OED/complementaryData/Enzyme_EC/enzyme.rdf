<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(24S)-hydroxycholesterol + O2 + reduced [NADPH--hemoprotein reductase] = (24S)-7alpha-dihydroxycholesterol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
