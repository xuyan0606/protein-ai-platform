<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27302067"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/27302067"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.205">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isomaltose glucohydrolase</skos:prefLabel>
<activity rdf:resource="3.2.1.205#SIP33A0DCECDD1089B0"/>
<rdfs:comment>The enzyme catalyzes the hydrolysis of alpha-1,6-glucosidic linkages from the non-reducing end of its substrate.</rdfs:comment>
<rdfs:comment>Unlike EC 3.2.1.10 the enzyme inverts the anomeric configuration of the released residue.</rdfs:comment>
<rdfs:comment>The enzyme can also act on panose and maltotriose at a lower rate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27302067"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.205#SIP33A0DCECDD1089B0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + isomaltose = beta-D-glucose + D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/27302067">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27302067"/>
