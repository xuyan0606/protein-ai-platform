<rdf:Description rdf:about="3.2.1.180">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>unsaturated chondroitin disaccharide hydrolase</skos:prefLabel>
<skos:altLabel>unsaturated glucuronyl hydrolase</skos:altLabel>
<activity rdf:resource="3.2.1.180#SIP417A891CD01FF114"/>
<rdfs:comment>The enzyme releases 4-deoxy-4,5-didehydro D-glucuronic acid or 4-deoxy-4,5-didehydro L-iduronic acid from chondroitin disaccharides, hyaluronan disaccharides and heparin disaccharides and cleaves both glycosidic (1->3) and (1->4) bonds.</rdfs:comment>
<rdfs:comment>It prefers the sulfated disaccharides to the unsulfated disaccharides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19416976"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21147778"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.180#SIP417A891CD01FF114">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-D-4-deoxy-Delta(4)-GlcpA-(1->3)-beta-D-GalpNAc6S + H2O = 5-dehydro-4-deoxy-D-glucuronate + N-acetyl-beta-D-galactosamine 6-sulfate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19416976">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19416976"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/19416976"/>
</rdf:Description>
