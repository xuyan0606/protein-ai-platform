<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-aminobutyryl-CoA ammonia-lyase</skos:prefLabel>
<skos:altLabel>L-3-aminobutyryl-CoA deaminase</skos:altLabel>
<activity rdf:resource="4.3.1.14#SIPA747BEE1C79313CC"/>
<rdfs:comment>Hydroxylamine can replace ammonia as a substrate.</rdfs:comment>
<rdfs:comment>Crotonoyl-pantetheine can replace crotonoyl-CoA but it is a poorer substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4420467"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7410315"/>
<rdfs:subClassOf rdf:resource="4.3.1.-"/>
<skos:broaderTransitive rdf:resource="4.3.1.-"/>
</rdf:Description>
