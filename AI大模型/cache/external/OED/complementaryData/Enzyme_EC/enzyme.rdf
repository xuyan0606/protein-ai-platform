<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17085687"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17085687"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17273867">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17273867"/>
