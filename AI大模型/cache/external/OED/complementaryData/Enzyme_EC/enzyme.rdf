<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-threonine + NAD(+) = (2S)-2-amino-3-oxobutanoate + H(+) + NADH.</rdfs:label>
</rdf:Description>
