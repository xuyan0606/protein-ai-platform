<skos:altLabel>2-carboxybenzaldehyde dehydrogenase</skos:altLabel>
<activity rdf:resource="1.2.1.78#SIP9C17E7B68F663796"/>
<rdfs:comment>The enzyme is involved in phenanthrene degradation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9335300"/>
