</rdf:Description>
<rdf:Description rdf:about="2.1.1.255">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.1.1.n6"/>
<skos:prefLabel>geranyl diphosphate 2-C-methyltransferase</skos:prefLabel>
<skos:altLabel>2-methyl-GPP synthase</skos:altLabel>
<skos:altLabel>geranyl pyrophosphate methyltransferase</skos:altLabel>
<skos:altLabel>GPP methyltransferase</skos:altLabel>
<skos:altLabel>GPPMT</skos:altLabel>
<skos:altLabel>MGPPS</skos:altLabel>
<activity rdf:resource="2.1.1.255#SIPE597DF28BC1D99D6"/>
<rdfs:comment>This enzyme, along with EC 4.2.3.118, produces 2-methylisoborneol, an odiferous compound produced by soil microorganisms with a strong earthy/musty odor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18492804"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18563898"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21174459"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21393856"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.255#SIPE597DF28BC1D99D6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E)-geranyl diphosphate + S-adenosyl-L-methionine = (E)-2-methylgeranyl diphosphate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
