<rdf:Description rdf:about="1.14.14.82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.21"/>
<skos:prefLabel>flavonoid 3'-monooxygenase</skos:prefLabel>
<skos:altLabel>CYP75B1</skos:altLabel>
<skos:altLabel>flavonoid 3'-hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.14.82#SIPA34E98B9316A52F1"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein found in plants.</rdfs:comment>
<rdfs:comment>Acts on a number of flavonoids, including the flavanone naringenin and the flavone apigenin.</rdfs:comment>
<rdfs:comment>Does not act on 4-coumarate or 4-coumaroyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10504566"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11030432"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
