<dcterms:identifier>doi:10.1021/ja3041866</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.156">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hydroxysqualene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.156#SIPD2270BBCF5978B25"/>
<rdfs:comment>This enzyme, isolated from the bacteria Rhodopseudomonas palustris and Zymomonas mobilis, participates, along with EC 2.5.1.103 and EC 1.17.18.1, in the conversion of all-trans-farnesyl diphosphate to squalene.</rdfs:comment>
<rdfs:comment>Eukaryotes achieve the same goal in a single step, catalyzed by EC 2.5.1.21.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26258173"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.156#SIPD2270BBCF5978B25">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + presqualene diphosphate = diphosphate + hydroxysqualene.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26258173">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
