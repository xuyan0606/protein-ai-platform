<rdf:Description rdf:about="2.6.1.78">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aspartate--prephenate aminotransferase</skos:prefLabel>
<skos:altLabel>L-aspartate:prephenate aminotransferase</skos:altLabel>
<skos:altLabel>PAT</skos:altLabel>
<skos:altLabel>prephenate aspartate aminotransferase</skos:altLabel>
<skos:altLabel>prephenate transaminase</skos:altLabel>
<activity rdf:resource="2.6.1.78#SIP892B23CFD1EC2CA0"/>
<rdfs:comment>Glutamate can also act as the amino donor, but more slowly (cf. EC 2.6.1.79).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3196038"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.78#SIP892B23CFD1EC2CA0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-arogenate + oxaloacetate = L-aspartate + prephenate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3196038">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3196038"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3196038"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.79">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glutamate--prephenate aminotransferase</skos:prefLabel>
<skos:altLabel>L-glutamate:prephenate aminotransferase</skos:altLabel>
<skos:altLabel>PAT</skos:altLabel>
<skos:altLabel>prephenate transaminase</skos:altLabel>
<activity rdf:resource="2.6.1.79#SIPFE94053D15706A8D"/>
<rdfs:comment>Aspartate can also act as the amino donor, but more slowly (cf. EC 2.6.1.78).</rdfs:comment>
<rdfs:comment>The enzyme from higher plants shows a marked preference for prephenate as substrate compared to pyruvate, phenylpyruvate or 4-hydroxyphenylpyruvate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2939644"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3298985"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3985619"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.79#SIPFE94053D15706A8D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-arogenate = L-glutamate + prephenate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2939644">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2939644"/>
