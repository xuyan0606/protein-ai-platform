<skos:prefLabel>salutaridine synthase</skos:prefLabel>
<skos:altLabel>(R)-reticuline oxidase (C-C phenol-coupling)</skos:altLabel>
<activity rdf:resource="1.14.19.67#SIP01C23ACB00053D74"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein found in plants.</rdfs:comment>
<rdfs:comment>Forms the morphinan alkaloid salutaridine by intramolecular phenol oxidation of reticuline without the incorporation of oxygen into the product.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
