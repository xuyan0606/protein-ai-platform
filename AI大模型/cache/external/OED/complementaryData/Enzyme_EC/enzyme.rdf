<rdf:Description rdf:about="1.14.20.10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tyrosine isonitrile desaturase/decarboxylase</skos:prefLabel>
<activity rdf:resource="1.14.20.10#SIP948159AD73C6CA9C"/>
<rdfs:comment>The enzyme, characterized from the bacterium Xenorhabdus nematophila, is involved in rhabduscin biosynthesis.</rdfs:comment>
<rdfs:comment>The enzyme is a member of the Fe(2+), 2-oxoglutarate-dependent oxygenases.</rdfs:comment>
<rdfs:comment>It is similar to EC 1.14.20.9; however, the latter does not catalyze a decarboxylation of the substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22711807"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25866990"/>
<rdfs:subClassOf rdf:resource="1.14.20.-"/>
<skos:broaderTransitive rdf:resource="1.14.20.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.10#SIP948159AD73C6CA9C">
