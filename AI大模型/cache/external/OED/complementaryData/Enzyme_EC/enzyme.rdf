<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-amino-4-dedimethylamino-anhydrotetracycline + S-adenosyl-L-methionine = 4-methylamino-4-dedimethylamino-anhydrotetracycline + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.335#SIP71B496C784460840">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-methylamino-4-dedimethylamino-anhydrotetracycline + S-adenosyl-L-methionine = anhydrotetracycline + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
