<skos:prefLabel>beta-mannosylphosphodecaprenol--mannooligosaccharide 6-mannosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.199#SIP28B263EF237F65E4"/>
<rdfs:comment>Involved in the formation of mannooligosaccharides in the membrane of Mycobacterium smegmatis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2480954"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
