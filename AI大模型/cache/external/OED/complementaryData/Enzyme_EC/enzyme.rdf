<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>all-trans-retinol + NADP(+) = all-trans-retinal + H(+) + NADPH.</rdfs:label>
</rdf:Description>
