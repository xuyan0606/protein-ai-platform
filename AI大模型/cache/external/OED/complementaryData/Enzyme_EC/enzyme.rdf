<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22474185"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22474185"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tuliposide B-converting enzyme</skos:prefLabel>
<activity rdf:resource="4.2.99.23#SIPA3E10C50793A9F18"/>
<rdfs:comment>The enzyme, characterized from pollen of the plant Tulipa gesneriana (tulip), catalyzes the intramolecular transesterification of 6-tuliposide B to form the antibiotic aglycon tulipalin B as a sole product.</rdfs:comment>
<rdfs:comment>It does not catalyze the hydrolysis of 6-tuliposide B to form a hydroxy acid.</rdfs:comment>
<rdfs:comment>The enzyme has marginal activity with 6-tuliposide A. cf. EC 4.2.99.22.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25997073"/>
<rdfs:subClassOf rdf:resource="4.2.99.-"/>
<skos:broaderTransitive rdf:resource="4.2.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.23#SIPA3E10C50793A9F18">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-tuliposide B = D-glucose + tulipalin B.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25997073">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/25997073"/>
