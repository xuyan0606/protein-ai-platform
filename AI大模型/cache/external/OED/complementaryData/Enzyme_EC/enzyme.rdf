<rdf:Description rdf:about="4.2.1.130">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-lactate dehydratase</skos:prefLabel>
<skos:altLabel>glyoxylase III</skos:altLabel>
<activity rdf:resource="4.2.1.130#SIPF94BB81C252EB535"/>
<rdfs:comment>The enzyme, described from the fungi Candida albicans and Schizosaccharomyces pombe, converts 2-oxopropanal to (R)-lactate in a single glutathione (GSH)-independent step.</rdfs:comment>
<rdfs:comment>The other known route for this conversion is the two-step GSH-dependent pathway catalyzed by EC 4.4.1.5 and EC 3.1.2.6.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24302734"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24758716"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.130#SIPF94BB81C252EB535">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + methylglyoxal = (R)-lactate + H(+).</rdfs:label>
</rdf:Description>
