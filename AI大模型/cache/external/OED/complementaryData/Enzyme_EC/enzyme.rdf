<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-asparagine + O2 = (2S,3S)-3-hydroxyasparagine + CO2 + succinate.</rdfs:label>
</rdf:Description>
