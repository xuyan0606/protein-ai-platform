<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + 2 O2 + thiamine = H(+) + 2 H2O2 + thiamine acetate.</rdfs:label>
</rdf:Description>
