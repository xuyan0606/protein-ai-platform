<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + NADP(+) + succinate semialdehyde = 2 H(+) + NADPH + succinate.</rdfs:label>
</rdf:Description>
