<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>chlorobenzene + H(+) + NADH + O2 = (1R,2R)-3-chlorocyclohexa-3,5-diene-1,2-diol + NAD(+).</rdfs:label>
</rdf:Description>
