<rdf:Description rdf:about="2.5.1.86">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>trans,polycis-decaprenyl diphosphate synthase</skos:prefLabel>
<skos:altLabel>(2Z,6Z,10Z,14Z,18Z,22Z,26Z,30Z,34E)-decaprenyl diphosphate synthase</skos:altLabel>
<activity rdf:resource="2.5.1.86#SIPABB673D7B615CDEF"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of decaprenyl phosphate, which plays a central role in the biosynthesis of essential mycobacterial cell wall components, such as the mycolyl-arabinogalactan-peptidoglycan complex and lipoarabinomannan.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11004176"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15516568"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18597781"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
