<rdf:Description rdf:about="1.8.98.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dihydromethanophenazine:CoB--CoM heterodisulfide reductase</skos:prefLabel>
<skos:altLabel>CoB--CoM heterodisulfide reductase</skos:altLabel>
<skos:altLabel>heterodisulfide reductase</skos:altLabel>
<activity rdf:resource="1.8.98.1#SIP06E7538974662006"/>
<rdfs:comment>This enzyme, found in methanogenic archaea that belong to the Methanosarcinales order, regenerates CoM and CoB after the action of EC 2.8.4.1.</rdfs:comment>
<rdfs:comment>It is a membrane-bound enzyme that contains (per heterodimeric unit) two distinct b-type hemes and two [4Fe-4S] clusters. cf. EC 1.8.7.3, EC 1.8.98.5, EC 1.8.98.6 and EC 1.8.98.4.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2121478"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9555882"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9665708"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11034998"/>
<rdfs:subClassOf rdf:resource="1.8.98.-"/>
<skos:broaderTransitive rdf:resource="1.8.98.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.98.1#SIP06E7538974662006">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>coenzyme B + coenzyme M + methanophenazine = coenzyme M-coenzyme B heterodisulfide + dihydromethanophenazine.</rdfs:label>
</rdf:Description>
