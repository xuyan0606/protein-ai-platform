<citation rdf:resource="http://purl.uniprot.org/citations/15383679"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15769464"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16963086"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18441014"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22985415"/>
<rdfs:subClassOf rdf:resource="3.6.1.-"/>
<skos:broaderTransitive rdf:resource="3.6.1.-"/>
</rdf:Description>
