<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>coenzyme B + coenzyme M + fumarate = coenzyme M-coenzyme B heterodisulfide + succinate.</rdfs:label>
</rdf:Description>
