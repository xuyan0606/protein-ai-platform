<skos:prefLabel>cathepsin B</skos:prefLabel>
<skos:altLabel>cathepsin B1</skos:altLabel>
<activity rdf:resource="3.4.22.1#SIPC838790E65DD9F80"/>
<rdfs:comment>An intracellular (lysosomal) enzyme.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family C1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3312190"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3342870"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7043200"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7458901"/>
