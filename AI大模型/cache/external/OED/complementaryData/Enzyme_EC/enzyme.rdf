<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12835921"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.3.42">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(4S)-4-hydroxy-2-oxoglutarate aldolase</skos:prefLabel>
<skos:altLabel>2-keto-4-hydroxyglutaric aldolase</skos:altLabel>
<skos:altLabel>4-hydroxy-2-ketoglutaric aldolase</skos:altLabel>
<skos:altLabel>hydroxyketoglutaric aldolase</skos:altLabel>
<activity rdf:resource="4.1.3.42#SIP87734CB7DB9B74CF"/>
<rdfs:comment>The enzyme from the bacterium Escherichia coli is specific for the (S) enantiomer.</rdfs:comment>
<rdfs:comment>That enzyme is trifunctional, and also catalyzes the reactions of EC 4.1.1.3 and EC 4.1.2.14. cf. EC 4.1.3.16.</rdfs:comment>
