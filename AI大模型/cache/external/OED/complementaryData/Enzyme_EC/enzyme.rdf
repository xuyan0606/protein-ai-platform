<rdf:Description rdf:about="4.1.2.61">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.1.2.41"/>
<replaces rdf:resource="4.2.1.101"/>
<skos:prefLabel>feruloyl-CoA hydratase/lyase</skos:prefLabel>
<activity rdf:resource="4.1.2.61#SIPB2EC4F58A50E2531"/>
<activity rdf:resource="4.1.2.61#SIPCC5C280C52B9EE52"/>
<activity rdf:resource="4.1.2.61#SIP40656A3FF50F755E"/>
<activity rdf:resource="4.1.2.61#SIP867A73240CD0C34A"/>
<rdfs:comment>The enzyme is a member of the enoyl-CoA hydratase/isomerase superfamily.</rdfs:comment>
<rdfs:comment>It catalyzes a two-step process involving first the hydration of the double bond of feruloyl-CoA and then the cleavage of the resultant beta-hydroxy thioester by retro-aldol reaction.</rdfs:comment>
<rdfs:comment>(E)-caffeoyl-CoA and (E)-4-coumaroyl-CoA are also substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6870241"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9461612"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9611814"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10543794"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18479250"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22328668"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23840666"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.61#SIPB2EC4F58A50E2531">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-feruloyl-CoA + H2O = acetyl-CoA + vanillin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.61#SIPCC5C280C52B9EE52">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-4-coumaroyl-CoA + H2O = 4-hydroxybenzaldehyde + acetyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.61#SIP40656A3FF50F755E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-caffeoyl-CoA + H2O = 3,4-dihydroxybenzaldehyde + acetyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.61#SIP867A73240CD0C34A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-feruloyl-CoA + H2O = 3-hydroxy-3-(4-hydroxy-3-methoxyphenyl)propanoyl-CoA.</rdfs:label>
</rdf:Description>
