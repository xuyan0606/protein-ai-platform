</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/30912640">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/30912640"/>
