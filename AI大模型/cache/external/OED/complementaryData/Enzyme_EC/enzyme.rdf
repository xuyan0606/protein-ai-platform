<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(+)-6a-hydroxymaackiain 3-O-methyltransferase</skos:prefLabel>
<skos:altLabel>HM3OMT</skos:altLabel>
<activity rdf:resource="2.1.1.270#SIP246CD5A6CEB5CBBD"/>
<rdfs:comment>The protein from the plant Pisum sativum (garden pea) methylates (+)-6a-hydroxymaackiain at the 3-position.</rdfs:comment>
<rdfs:comment>It also methylates 2,7,4'-trihydroxyisoflavanone on the 4'-position (cf. EC 2.1.1.212).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9349277"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16667069"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17067644"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17172354"/>
