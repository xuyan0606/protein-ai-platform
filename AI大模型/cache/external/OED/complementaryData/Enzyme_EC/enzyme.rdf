<activity rdf:resource="3.4.11.20#SIPB369BEEE228EECF2"/>
<rdfs:comment>From the plasma fraction of chicken egg yolk.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7684960"/>
