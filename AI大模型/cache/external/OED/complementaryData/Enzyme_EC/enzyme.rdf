<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + N(6)-carboxybiotinyl-L-lysyl-[protein] + n Na(+)(in) = CO2 + N(6)-biotinyl-L-lysyl-[protein] + n Na(+)(out).</rdfs:label>
</rdf:Description>
