<rdf:Description rdf:about="1.14.14.41">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.n8"/>
<skos:prefLabel>(E)-2-methylbutanal oxime monooxygenase</skos:prefLabel>
<skos:altLabel>CYP71E7</skos:altLabel>
<activity rdf:resource="1.14.14.41#SIPD177FED2C986DB24"/>
<activity rdf:resource="1.14.14.41#SIP58935FA66F5CAD26"/>
<rdfs:comment>Involved in the biosynthesis of the cyanogenic glucosides lotaustralin and linamarin.</rdfs:comment>
<rdfs:comment>It catalyzes three different activities - isomerization of its substrate the (E) isomer to the (Z) isomer, dehydration, and C-hydroxylation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21045121"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.41#SIPD177FED2C986DB24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(1E,2S)-2-methylbutanal oxime + O2 + reduced [NADPH--hemoprotein reductase] = 2-hydroxy-2-methylbutanenitrile + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.41#SIP58935FA66F5CAD26">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-2-methylpropanal oxime + O2 + reduced [NADPH--hemoprotein reductase] = 2-hydroxy-2-methylpropanenitrile + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21045121">
