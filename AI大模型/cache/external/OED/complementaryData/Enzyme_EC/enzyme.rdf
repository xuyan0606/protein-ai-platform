<rdf:Description rdf:about="2.4.1.215">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cis-zeatin O-beta-D-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.215#SIP5B0346950C241961"/>
<rdfs:comment>The enzyme from maize can use cis-zeatin and UDPglucose as substrates, but not cis-ribosylzeatin, trans-zeatin or trans-ribosylzeatin.</rdfs:comment>
<rdfs:comment>Unlike EC 2.4.1.203 UDP-xylose cannot act as a donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11331778"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.215#SIP5B0346950C241961">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cis-zeatin + UDP-alpha-D-glucose = H(+) + O-beta-D-glucosyl-cis-zeatin + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11331778">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
