<rdf:Description rdf:about="2.1.1.233">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[phosphatase 2A protein]-leucine-carboxy methyltransferase</skos:prefLabel>
<skos:altLabel>leucine carboxy methyltransferase-1</skos:altLabel>
<activity rdf:resource="2.1.1.233#SIPA09C16E8336E4B81"/>
<rdfs:comment>Methylates the C-terminal leucine of phosphatase 2A.</rdfs:comment>
<rdfs:comment>A key regulator of protein phosphatase 2A.</rdfs:comment>
<rdfs:comment>The methyl ester is hydrolyzed by EC 3.1.1.89.</rdfs:comment>
<rdfs:comment>Occurs mainly in the cytoplasm, Golgi region and late endosomes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10600115"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21206058"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.233#SIPA09C16E8336E4B81">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[phosphatase 2A protein]-C-terminal L-leucine + S-adenosyl-L-methionine = [phosphatase 2A protein]-C-terminal L-leucine methyl ester + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
