<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + taxa-4(20),11-dien-5alpha-ol = CoA + taxa-4(20),11-dien-5alpha-yl acetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10190984">
