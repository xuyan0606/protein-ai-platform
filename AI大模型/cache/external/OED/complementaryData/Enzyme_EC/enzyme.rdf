<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + an omega-(methylsulfanyl)-2-oxoalkanoate + H2O = a 2-(omega-methylsulfanyl)alkylmalate + CoA + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.3.17#SIPB3FACC00801AD873">
