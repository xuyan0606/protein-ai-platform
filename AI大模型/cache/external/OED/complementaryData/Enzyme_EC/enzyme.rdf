<rdf:Description rdf:about="1.2.7.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glyceraldehyde-3-phosphate dehydrogenase (ferredoxin)</skos:prefLabel>
<skos:altLabel>GAPOR</skos:altLabel>
<skos:altLabel>glyceraldehyde-3-phosphate Fd oxidoreductase</skos:altLabel>
<skos:altLabel>glyceraldehyde-3-phosphate ferredoxin reductase</skos:altLabel>
<activity rdf:resource="1.2.7.6#SIP41EC4A9FBB6FC7D3"/>
<rdfs:comment>Thought to function in place of glyceraldehyde-3-phosphate dehydrogenase and possibly phosphoglycerate kinase in the novel Embden-Meyerhof-type glycolytic pathway found in Pyrococcus furiosus.</rdfs:comment>
<rdfs:comment>Specific for glyceraldehyde-3-phosphate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7721730"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11265456"/>
<rdfs:subClassOf rdf:resource="1.2.7.-"/>
<skos:broaderTransitive rdf:resource="1.2.7.-"/>
</rdf:Description>
