<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(R)-3-hydroxyalkanoate](n) + a (3R)-3-hydroxyacyl-CoA = [(R)-3-hydroxyalkanoate](n+1) + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.304#SIPF895555B9BD16696">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R)-3-hydroxybutanoyl-CoA + [(3R)-hydroxybutanoate](n) = [(3R)-hydroxybutanoate](n+1) + CoA.</rdfs:label>
</rdf:Description>
