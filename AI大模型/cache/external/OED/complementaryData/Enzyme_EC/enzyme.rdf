</rdf:Description>
<rdf:Description rdf:about="5.1.3.31#SIPB6EF57DB5C7CE952">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-ribulose = L-xylulose.</rdfs:label>
</rdf:Description>
