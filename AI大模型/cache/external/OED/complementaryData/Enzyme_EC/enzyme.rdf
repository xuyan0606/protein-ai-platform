<rdf:Description rdf:about="2.4.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cytokinin 7-beta-glucosyltransferase</skos:prefLabel>
<skos:altLabel>cytokinin 7-glucosyltransferase</skos:altLabel>
<skos:altLabel>UDP-glucose-zeatin 7-glucosyltransferase</skos:altLabel>
<skos:altLabel>uridine diphosphoglucose-zeatin 7-glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.118#SIP7025ECB8244D9608"/>
<rdfs:comment>Acts on a range of N(6)-substituted adenines, including zeatin and N(6)-benzylaminopurine, but not N(6)-benzyladenine.</rdfs:comment>
<rdfs:comment>With some acceptors, 9-beta-D-glucosides are also formed.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/486500"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
