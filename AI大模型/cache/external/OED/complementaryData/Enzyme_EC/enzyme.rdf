<replaces rdf:resource="1.13.99.5"/>
<skos:prefLabel>3-hydroxy-4-oxoquinoline 2,4-dioxygenase</skos:prefLabel>
<skos:altLabel>(1H)-3-hydroxy-4-oxoquinoline 2,4-dioxygenase</skos:altLabel>
<skos:altLabel>3-hydroxy-4(1H)-one, 2,4-dioxygenase</skos:altLabel>
<skos:altLabel>3-hydroxy-4-oxo-1,4-dihydroquinoline 2,4-dioxygenase</skos:altLabel>
<skos:altLabel>quinoline-3,4-diol 2,4-dioxygenase</skos:altLabel>
<activity rdf:resource="1.13.11.47#SIP1CB3BD5E7919D790"/>
<rdfs:comment>Does not contain a metal center or organic cofactor.</rdfs:comment>
<rdfs:comment>Fission of two C-C bonds: 2,4-dioxygenolytic cleavage with concomitant release of carbon monoxide.</rdfs:comment>
<rdfs:comment>The enzyme from Pseudomonas putida is highly specific for this substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8856057"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10482514"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
