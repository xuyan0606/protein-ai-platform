<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O2 + torulene = 3-methyl-2-butenal + 4'-apo-beta-carotenal.</rdfs:label>
</rdf:Description>
