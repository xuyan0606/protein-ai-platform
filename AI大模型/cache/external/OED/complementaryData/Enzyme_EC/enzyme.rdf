<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ubiquinone + 5 H(+)(in) + NADH = a ubiquinol + 4 H(+)(out) + NAD(+).</rdfs:label>
</rdf:Description>
