</rdf:Description>
<rdf:Description rdf:about="5.4.2.9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phosphoenolpyruvate mutase</skos:prefLabel>
<skos:altLabel>PEP mutase</skos:altLabel>
<skos:altLabel>PEP phosphomutase</skos:altLabel>
<skos:altLabel>phosphoenolpyruvate phosphomutase</skos:altLabel>
<activity rdf:resource="5.4.2.9#SIP256E62EDB6CB0272"/>
<rdfs:comment>Involved in the biosynthesis of the C-P bond, although the equilibrium greatly favors phosphoenolpyruvate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2160937"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3138545"/>
