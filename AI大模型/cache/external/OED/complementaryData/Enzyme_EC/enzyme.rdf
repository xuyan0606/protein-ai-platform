<skos:altLabel>cyclic adenylate deaminase</skos:altLabel>
<activity rdf:resource="3.5.4.46#SIP327E15407F83CA13"/>
<rdfs:comment>The enzyme, isolated from the bacterium Leptospira interrogans, is specific for cAMP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24074367"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
