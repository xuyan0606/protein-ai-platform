<rdf:Description rdf:about="2.7.4.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UMP kinase</skos:prefLabel>
<skos:altLabel>UMPK</skos:altLabel>
<skos:altLabel>UMP-kinase</skos:altLabel>
<skos:altLabel>uridine monophosphate kinase</skos:altLabel>
<skos:altLabel>uridylate kinase</skos:altLabel>
<activity rdf:resource="2.7.4.22#SIP7AA47DF756B30F6C"/>
<rdfs:comment>Strictly specific for UMP as substrate and is used by prokaryotes in the de novo synthesis of pyrimidines, in contrast to eukaryotes, which use the dual-specificity enzyme EC 2.7.4.14 for the same purpose.</rdfs:comment>
<rdfs:comment>Subject of feedback regulation, being inhibited by UTP and activated by GTP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7711027"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16095620"/>
<rdfs:subClassOf rdf:resource="2.7.4.-"/>
<skos:broaderTransitive rdf:resource="2.7.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.4.22#SIP7AA47DF756B30F6C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + UMP = ADP + UDP.</rdfs:label>
</rdf:Description>
