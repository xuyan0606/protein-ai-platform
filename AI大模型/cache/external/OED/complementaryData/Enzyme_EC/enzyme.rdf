<rdf:Description rdf:about="2.3.1.217">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>curcumin synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.217#SIP07A6881DE638D54B"/>
<rdfs:comment>A polyketide synthase from the plant Curcuma longa (turmeric).</rdfs:comment>
<rdfs:comment>Three isoforms exist, CURS1, CURS2 and CURS3.</rdfs:comment>
<rdfs:comment>While CURS1 and CURS2 prefer feruloyl-CoA as a starter substrate, CURS3 can accept 4-coumaroyl-CoA equally well (see EC 2.3.1.219).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19258320"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19622354"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21148316"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.217#SIP07A6881DE638D54B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-feruloyl-CoA + (E)-feruloylacetyl-CoA + H2O = CO2 + 2 CoA + curcumin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19258320">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19258320"/>
