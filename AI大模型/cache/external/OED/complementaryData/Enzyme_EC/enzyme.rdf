<rdf:Description rdf:about="3.1.1.90">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>all-trans-retinyl ester 13-cis isomerohydrolase</skos:prefLabel>
<activity rdf:resource="3.1.1.90#SIPDE0890FF06D0C569"/>
<rdfs:comment>all-trans-retinyl esters, which are a storage form of vitamin A, are generated by the activity of EC 2.3.1.135.</rdfs:comment>
<rdfs:comment>They can be hydrolyzed to 11-cis-retinol by EC 3.1.1.64, or to 13-cis-retinol by this enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21235714"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.90#SIPDE0890FF06D0C569">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an all-trans-retinyl ester + H2O = 13-cis-retinol + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
