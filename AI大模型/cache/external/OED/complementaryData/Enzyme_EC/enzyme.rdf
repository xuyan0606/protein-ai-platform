<rdf:Description rdf:about="3.2.1.161">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-apiosyl-beta-glucosidase</skos:prefLabel>
<skos:altLabel>furcatin hydrolase</skos:altLabel>
<skos:altLabel>isoflavonoid-7-O-beta[D-apiosyl-(1->6)-beta-D-glucoside] disaccharidase</skos:altLabel>
<skos:altLabel>isoflavonoid 7-O-beta-apiosyl-glucoside beta-glucosidase</skos:altLabel>
<activity rdf:resource="3.2.1.161#SIP7258CF8383DC7B43"/>
<activity rdf:resource="3.2.1.161#SIP5D2CAF1E5D8109F4"/>
<activity rdf:resource="3.2.1.161#SIPA00F27C45136ABA0"/>
<rdfs:comment>Removes disaccharides from the natural substrates dalpatein 7-O-beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranoside and 7-hydroxy-2',4',5',6-tetramethoxy-7-O-beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranoside (dalnigrein 7-O-beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranoside) although it can also remove a single glucose residue from isoflavonoid 7-O-glucosides.</rdfs:comment>
<rdfs:comment>Daidzin and genistin are also substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/240725"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14976214"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16098548"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.161#SIP7258CF8383DC7B43">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7-[beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranosyloxy]isoflavonoid + H2O = a 7-hydroxyisoflavonoid + beta-D-apiofuranosyl-(1->6)-D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.161#SIP5D2CAF1E5D8109F4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dalnigrein beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranoside + H2O = beta-D-apiofuranosyl-(1->6)-D-glucopyranose + dalnigrein + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.161#SIPA00F27C45136ABA0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dalpatein beta-D-apiofuranosyl-(1->6)-beta-D-glucopyranoside + H2O = beta-D-apiofuranosyl-(1->6)-D-glucopyranose + dalpatein + H(+).</rdfs:label>
</rdf:Description>
