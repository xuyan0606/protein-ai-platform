<rdf:Description rdf:about="1.11.1.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>prostamide/prostaglandin F2alpha synthase</skos:prefLabel>
<skos:altLabel>prostamide/PGF synthase</skos:altLabel>
<skos:altLabel>prostamide/prostaglandin F synthase</skos:altLabel>
<skos:altLabel>prostamide F synthase</skos:altLabel>
<skos:altLabel>TPGF synthase</skos:altLabel>
<activity rdf:resource="1.11.1.20#SIP894738A927ABD112"/>
<activity rdf:resource="1.11.1.20#SIPE7CAC13FAC1B46C1"/>
<rdfs:comment>The enzyme contains a thioredoxin-type disulfide as a catalytic group.</rdfs:comment>
<rdfs:comment>Prostamide H2 and prostaglandin H2 are the best substrates; the latter is converted to prostaglandin F2alpha.</rdfs:comment>
<rdfs:comment>The enzyme also reduces tert-butyl hydroperoxide, cumene hydroperoxide and H2O2, but not prostaglandin D2 or prostaglandin E2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18006499"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20950588"/>
<rdfs:subClassOf rdf:resource="1.11.1.-"/>
<skos:broaderTransitive rdf:resource="1.11.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.20#SIP894738A927ABD112">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thioredoxin]-dithiol + prostaglandin H2 = [thioredoxin]-disulfide + prostaglandin F2alpha.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.20#SIPE7CAC13FAC1B46C1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thioredoxin]-disulfide + prostamide F2alpha = [thioredoxin]-dithiol + prostamide H2.</rdfs:label>
</rdf:Description>
