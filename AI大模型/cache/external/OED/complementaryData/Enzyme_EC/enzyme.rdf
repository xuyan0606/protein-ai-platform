<rdf:Description rdf:about="2.3.1.244">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-methylbutanoate polyketide synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.244#SIP054C43DEB776C3FF"/>
<rdfs:comment>This polyketide synthase enzyme forms the (S)-2-methylbutanoate side chain during lovastatin biosynthesis by the filamentous fungus Aspergillus terreus.</rdfs:comment>
<rdfs:comment>The overall reaction comprises a single condensation reaction followed by alpha-methylation, beta-ketoreduction, dehydration, and alpha,beta enoyl reduction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10334994"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21069965"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
