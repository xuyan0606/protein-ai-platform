<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-glutamate + oxidized coenzyme F420-2 = ADP + H(+) + oxidized coenzyme alpha-F420-3 + phosphate.</rdfs:label>
</rdf:Description>
