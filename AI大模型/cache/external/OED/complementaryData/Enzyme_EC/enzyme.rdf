<replaces rdf:resource="2.4.1.n5"/>
<skos:prefLabel>starch synthase (maltosyl-transferring)</skos:prefLabel>
<skos:altLabel>alpha1,4-glucan:maltose-1-P maltosyltransferase</skos:altLabel>
<skos:altLabel>GMPMT</skos:altLabel>
<activity rdf:resource="2.4.99.16#SIP04DB07C28950B6C0"/>
<rdfs:comment>The enzyme from from the bacterium Mycobacterium smegmatis is specific for maltose.</rdfs:comment>
<rdfs:comment>It has no activity with alpha-D-glucose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20118231"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21914799"/>
<rdfs:subClassOf rdf:resource="2.4.99.-"/>
