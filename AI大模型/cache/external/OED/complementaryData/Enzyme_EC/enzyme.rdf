<rdf:Description rdf:about="6.3.1.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glutathionylspermidine synthase</skos:prefLabel>
<skos:altLabel>gamma-L-glutamyl-L-cysteinyl-glycine:spermidine ligase (ADP-forming)</skos:altLabel>
<skos:altLabel>glutathione:spermidine ligase (ADP-forming)</skos:altLabel>
<skos:altLabel>glutathionylspermidine synthetase</skos:altLabel>
<skos:altLabel>GSP synthetase</skos:altLabel>
<activity rdf:resource="6.3.1.8#SIPDFF56B0103FBD0BB"/>
<rdfs:comment>Involved in the synthesis of trypanothione in trypanosomatids.</rdfs:comment>
<rdfs:comment>The enzyme from Escherichia coli is bifunctional and also catalyzes the EC 3.5.1.78 reaction, resulting in a net hydrolysis of ATP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1304372"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7775463"/>
<rdfs:subClassOf rdf:resource="6.3.1.-"/>
<skos:broaderTransitive rdf:resource="6.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.3.1.8#SIPDFF56B0103FBD0BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + glutathione + spermidine = ADP + glutathionylspermidine + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1304372">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/1304372"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/1304372"/>
</rdf:Description>
