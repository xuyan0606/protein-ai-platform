<rdf:Description rdf:about="1.14.99.52">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-cysteinyl-L-histidinylsulfoxide synthase</skos:prefLabel>
<activity rdf:resource="1.14.99.52#SIP2F5B35C4CE2C1902"/>
<rdfs:comment>The enzyme participates in ovothiol biosynthesis.</rdfs:comment>
<rdfs:comment>It also has some activity as EC 1.13.11.20, and can perform the reaction of EC 1.14.99.50.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21247153"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23877651"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24016264"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24684381"/>
