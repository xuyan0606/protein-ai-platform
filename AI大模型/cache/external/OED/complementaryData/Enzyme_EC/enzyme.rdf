<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-tyrosine + O2 = H2O + L-dopaquinone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.18.1#SIPCDA64C93ED61E2F1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 L-dopa + O2 = 2 H2O + 2 L-dopaquinone.</rdfs:label>
</rdf:Description>
