<rdf:Description rdf:about="1.14.13.210">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-methyl-5-nitrocatechol 5-monooxygenase</skos:prefLabel>
<skos:altLabel>4-methyl-5-nitrocatechol oxygenase</skos:altLabel>
<skos:altLabel>MNC monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.13.210#SIPAD8B95A67482688E"/>
<activity rdf:resource="1.14.13.210#SIP0BC809BFB59CD5CE"/>
<rdfs:comment>The enzyme, isolated from the bacterium Burkholderia sp. DNT, can use both NADH and NADPH, but prefers NADPH.</rdfs:comment>
<rdfs:comment>It has a narrow substrate range, but can also act on 4-nitrocatechol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8830701"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16751499"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.210#SIPAD8B95A67482688E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-methyl-5-nitrocatechol + NADPH + O2 = 2-hydroxy-5-methylquinone + H(+) + H2O + NADP(+) + nitrite.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.210#SIP0BC809BFB59CD5CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-methyl-5-nitrocatechol + NADH + O2 = 2-hydroxy-5-methylquinone + H(+) + H2O + NAD(+) + nitrite.</rdfs:label>
</rdf:Description>
