<rdf:Description rdf:about="2.3.1.66">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>leucine N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.66#SIP7B021EF413A35912"/>
<rdfs:comment>Propanoyl-CoA can act, more slowly, as donor.</rdfs:comment>
<rdfs:comment>L-arginine, L-valine, L-phenylalanine and peptides containing L-leucine can act as acceptor.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.66#SIP7B021EF413A35912">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + L-leucine = CoA + H(+) + N-acetyl-L-leucine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.67">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>1-alkylglycerophosphocholine O-acetyltransferase</skos:prefLabel>
<skos:altLabel>1-alkyl-2-lysolecithin acetyltransferase</skos:altLabel>
<skos:altLabel>1-alkyl-2-lyso-sn-glycero-3-phosphocholine acetyltransferase</skos:altLabel>
