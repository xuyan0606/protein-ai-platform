<rdf:Description rdf:about="2.8.5.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>S-sulfo-L-cysteine synthase (3-phospho-L-serine-dependent)</skos:prefLabel>
<activity rdf:resource="2.8.5.1#SIPA67AEDD2C502F5B7"/>
<rdfs:comment>The enzyme, which has been characterized from the bacterium Mycobacterium tuberculosis, has no activity with O-acetyl-L-serine. cf. EC 2.5.1.144.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25022854"/>
<rdfs:subClassOf rdf:resource="2.8.5.-"/>
<skos:broaderTransitive rdf:resource="2.8.5.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.5.1#SIPA67AEDD2C502F5B7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O-phospho-L-serine + thiosulfate = phosphate + S-sulfo-L-cysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25022854">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
