<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-synephrine = (4-hydroxyphenyl)acetaldehyde + methylamine.</rdfs:label>
</rdf:Description>
