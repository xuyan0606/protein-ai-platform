<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 7-hydroxyisoflavone + S-adenosyl-L-methionine = a 7-methoxyisoflavone + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
