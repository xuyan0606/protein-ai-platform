<skos:altLabel>uridine diphosphoglucose-zeatin O-glucosyltransferase</skos:altLabel>
<skos:altLabel>zeatin O-beta-D-glucosyltransferase</skos:altLabel>
<skos:altLabel>zeatin O-glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.203#SIPBB765A3F0F538A63"/>
<rdfs:comment>Unlike EC 2.4.1.215, UDP-xylose can also act as donor (cf. EC 2.4.2.40).</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
