<skos:prefLabel>galactoside O-acetyltransferase</skos:prefLabel>
<skos:altLabel>thiogalactoside acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.18#SIP4E56494434C566F8"/>
<rdfs:comment>Acts on thiogalactosides and phenylgalactoside.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.18#SIP4E56494434C566F8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a beta-D-galactoside + acetyl-CoA = a 6-acetyl-beta-D-galactoside + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phosphate butyryltransferase</skos:prefLabel>
<skos:altLabel>phosphotransbutyrylase</skos:altLabel>
