<citation rdf:resource="http://purl.uniprot.org/citations/14769870"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15788389"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
