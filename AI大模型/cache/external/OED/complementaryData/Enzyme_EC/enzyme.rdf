<skos:prefLabel>flavonoid 4'-O-methyltransferase</skos:prefLabel>
<skos:altLabel>4'-hydroxyisoflavone methyltransferase</skos:altLabel>
<skos:altLabel>isoflavone O-methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.231#SIP090010883A5E037B"/>
<rdfs:comment>The enzyme catalyzes the 4'-methylation of naringenin.</rdfs:comment>
<rdfs:comment>In vitro it catalyzes the 4'-methylation of apigenin, quercetin, daidzein and genistein.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15961179"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
