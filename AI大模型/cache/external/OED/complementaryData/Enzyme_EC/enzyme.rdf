<rdf:Description rdf:about="2.3.1.68">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glutamine N-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.68#SIP948D5F491ADECC57"/>
<rdfs:comment>Phenylacetyl-CoA and (indol-3-yl)acetyl-CoA, but not benzoyl-CoA, can act as acyl donor.</rdfs:comment>
<rdfs:comment>Not identical with EC 2.3.1.13 or EC 2.3.1.71.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/931988"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.68#SIP948D5F491ADECC57">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an acyl-CoA + L-glutamine = an N(2)-acyl-L-glutamine + CoA + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/931988">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/931988"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/931988"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.69">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>monoterpenol O-acetyltransferase</skos:prefLabel>
<skos:altLabel>menthol transacetylase</skos:altLabel>
<activity rdf:resource="2.3.1.69#SIP10DA7C6F008094CE"/>
<rdfs:comment>(-)-menthol, (+)-neomenthol, borneol, cyclohexanol and N-decanol can be acetylated.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.69#SIP10DA7C6F008094CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + a monoterpenol = CoA + a monoterpenol acetate ester.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.70">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obsolete>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.71">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycine N-benzoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.71#SIP6A11871F9A9E44CF"/>
<rdfs:comment>Not identical with EC 2.3.1.13 or EC 2.3.1.68.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/457678"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.71#SIP6A11871F9A9E44CF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>benzoyl-CoA + glycine = CoA + H(+) + N-benzoylglycine.</rdfs:label>
</rdf:Description>
