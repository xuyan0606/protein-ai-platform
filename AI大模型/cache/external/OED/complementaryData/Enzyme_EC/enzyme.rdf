</rdf:Description>
<rdf:Description rdf:about="6.3.2.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="6.3.2.28"/>
<skos:prefLabel>L-alanine--L-anticapsin ligase</skos:prefLabel>
<skos:altLabel>alanine-anticapsin ligase</skos:altLabel>
<skos:altLabel>L-Ala-L-anticapsin ligase</skos:altLabel>
<activity rdf:resource="6.3.2.49#SIP269B4F492C16C17D"/>
<rdfs:comment>The enzyme, characterized from the bacterium Bacillus subtilis, is involved in the biosynthesis of the nonribosomally synthesized dipeptide antibiotic bacilysin, composed of L-alanine and L-anticapsin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16030213"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22298000"/>
