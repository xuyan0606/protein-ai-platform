<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + Ni-sirohydrochlorin = Ni(2+) + sirohydrochlorin.</rdfs:label>
</rdf:Description>
