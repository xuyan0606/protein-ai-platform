<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2,3-saturated acyl-[ACP] + NADP(+) = a (2E)-enoyl-[ACP] + H(+) + NADPH.</rdfs:label>
</rdf:Description>
