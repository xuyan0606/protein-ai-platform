<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[sulfur carrier]-H + L-cysteine = [sulfur carrier]-SH + L-alanine.</rdfs:label>
</rdf:Description>
