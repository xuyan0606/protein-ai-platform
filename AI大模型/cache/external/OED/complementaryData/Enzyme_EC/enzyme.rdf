<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>13-hydroxydocosanoate + UDP-alpha-D-glucose = 13-(beta-D-glucosyloxy)docosanoate + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6213610">
