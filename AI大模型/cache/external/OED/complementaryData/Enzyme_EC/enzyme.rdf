<rdf:Description rdf:about="2.4.1.356">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucosyl-dolichyl phosphate glucuronosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.356#SIP9016BDD09B6A88AF"/>
<rdfs:comment>The enzyme, characterized from the halophilic archaeon Haloferax volcanii, participates in the protein N-glycosylation pathway.</rdfs:comment>
<rdfs:comment>Dolichol used by archaea is different from that used by eukaryotes.</rdfs:comment>
<rdfs:comment>It is much shorter (C55-C60) and is alpha,omega-saturated.</rdfs:comment>
<rdfs:comment>However, in vitro the enzyme was also able to act on a substrate with an unsaturated end.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18631242"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28809486"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.356#SIP9016BDD09B6A88AF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an archaeal dolichyl alpha-D-glucosyl phosphate + UDP-alpha-D-glucuronate = an archaeal dolichyl beta-D-glucuronosyl-(1->4)-alpha-D-glucosyl phosphate + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18631242">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18631242"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18631242"/>
</rdf:Description>
