<rdf:Description rdf:about="4.2.3.141">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.1.7.4"/>
<skos:prefLabel>sclareol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.141#SIPE01E7AFAD8269772"/>
<rdfs:comment>Isolated from the plant Salvia sclarea (clary sage).</rdfs:comment>
<rdfs:comment>Originally thought to be synthesized in one step from geranylgeranyl diphosphate it is now known to require two enzymes, EC 4.2.1.133 and EC 4.2.3.141.</rdfs:comment>
<rdfs:comment>Sclareol is used in perfumery.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22834731"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.141#SIPE01E7AFAD8269772">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8-hydroxycopalyl diphosphate + H2O = diphosphate + sclareol.</rdfs:label>
</rdf:Description>
