<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/15311930"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/15311930"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-sorbose 1-dehydrogenase</skos:prefLabel>
<skos:altLabel>SDH</skos:altLabel>
<activity rdf:resource="1.1.99.32#SIPE2CE362B2A3D8E92"/>
<rdfs:comment>The product, 1-dehydro-L-sorbose, is an intermediate in bacterial 2-keto-L-gulonic-acid formation.</rdfs:comment>
<rdfs:comment>The activity of this membrane-bound enzyme is stimulated by Fe(III) or Co(2+) but is inhibited by Cu(2+).</rdfs:comment>
<rdfs:comment>Highly specific for L-sorbose as other sugars, such as glucose, mannitol and sorbitol, are not substrates.</rdfs:comment>
<rdfs:comment>Phenazine methosulfate and DCIP can act as artificial acceptors.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.32#SIPE2CE362B2A3D8E92">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + L-sorbopyranose = 1-dehydro-L-sorbose + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.33">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obsolete>
<replacedBy rdf:resource="1.17.98.4"/>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.34">
