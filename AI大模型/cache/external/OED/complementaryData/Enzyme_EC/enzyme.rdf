<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/19392660"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.94">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>adenosyl-chloride synthase</skos:prefLabel>
<skos:altLabel>5'-chloro-5'-deoxyadenosine synthase</skos:altLabel>
<skos:altLabel>chlorinase</skos:altLabel>
<activity rdf:resource="2.5.1.94#SIPDB9226D8A22912BE"/>
<rdfs:comment>This enzyme, isolated from the marine bacterium Salinispora tropica, catalyzes an early step in the pathway leading to biosynthesis of the proteosome inhibitor salinosporamide A.</rdfs:comment>
<rdfs:comment>The enzyme is very similar to EC 2.5.1.63 but does not accept fluoride.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18059261"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.94#SIPDB9226D8A22912BE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>chloride + S-adenosyl-L-methionine = 5'-chloro-5'-deoxyadenosine + L-methionine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18059261">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
