<rdf:Description rdf:about="2.4.1.126">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hydroxycinnamate 4-beta-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.126#SIPC083CAB91A525A48"/>
<rdfs:comment>Acts on 4-coumarate, ferulate, caffeate and sinapate, forming a mixture of 4-glucosides and glucose esters (cf. EC 2.4.1.120).</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
