<rdf:Description rdf:about="1.14.13.113">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>FAD-dependent urate hydroxylase</skos:prefLabel>
<skos:altLabel>FAD-dependent urate oxidase</skos:altLabel>
<skos:altLabel>urate hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.13.113#SIP757CF13BD0CB40DA"/>
<rdfs:comment>The reaction is part of the purine catabolic pathway in the bacterium Klebsiella pneumoniae.</rdfs:comment>
<rdfs:comment>The enzyme is different from EC 1.7.3.3, found in most plants, which produces hydrogen peroxide.</rdfs:comment>
<rdfs:comment>The product of the enzyme is a substrate for EC 3.5.2.17.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19260710"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.113#SIP757CF13BD0CB40DA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADH + O2 + urate = 5-hydroxyisourate + H2O + NAD(+).</rdfs:label>
</rdf:Description>
