<rdf:Description rdf:about="2.1.1.139">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3'-demethylstaurosporine O-methyltransferase</skos:prefLabel>
<skos:altLabel>3'-demethoxy-3'-hydroxystaurosporine O-methyltransferase</skos:altLabel>
<skos:altLabel>staurosporine synthase</skos:altLabel>
<activity rdf:resource="2.1.1.139#SIP3C7F41A487B39D1D"/>
<rdfs:comment>Catalyzes the final step in the biosynthesis of staurosporine, an alkaloidal antibiotic that is a potent inhibitor of protein kinases, especially protein kinase C.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9727395"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.139#SIP3C7F41A487B39D1D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3'-demethylstaurosporine + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + staurosporine.</rdfs:label>
</rdf:Description>
