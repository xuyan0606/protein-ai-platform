<activity rdf:resource="3.4.24.89#SIP156E73B655BF5CD3"/>
<rdfs:comment>This metalloprotease is secreted by the bacterium Peptoclostridium difficile.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24303041"/>
