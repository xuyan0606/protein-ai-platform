<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R)-3-phosphoglycerate + ATP = (2R)-3-phospho-glyceroyl phosphate + ADP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.2.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aspartate kinase</skos:prefLabel>
<skos:altLabel>aspartokinase</skos:altLabel>
<activity rdf:resource="2.7.2.4#SIP15E8AB1C38A102FB"/>
<rdfs:comment>The enzyme from Escherichia coli is a multifunctional protein, which also catalyzes the reaction of EC 1.1.1.3.</rdfs:comment>
<rdfs:comment>This is also the case for two of the four isoenzymes in Arabidopsis thaliana.</rdfs:comment>
<rdfs:comment>The equilibrium constant strongly favors the reaction from right to left, i.e. the non-physiological direction of reaction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4551091"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4562990"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6058940"/>
<rdfs:subClassOf rdf:resource="2.7.2.-"/>
<skos:broaderTransitive rdf:resource="2.7.2.-"/>
</rdf:Description>
