<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclo(L-tyrosyl-L-tyrosyl) synthase</skos:prefLabel>
<skos:altLabel>cyclodityrosine synthase</skos:altLabel>
<activity rdf:resource="2.3.2.21#SIP2629452E1EC8BB2B"/>
<rdfs:comment>The reaction proceeds following a ping-pong mechanism forming a covalent intermediate between an active site serine and the first L-tyrosine residue.</rdfs:comment>
<rdfs:comment>The protein, from the bacterium Mycobacterium tuberculosis, also forms small amounts of cyclo(L-tyrosyl-L-phenylalanyl).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19430487"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20852636"/>
<rdfs:subClassOf rdf:resource="2.3.2.-"/>
<skos:broaderTransitive rdf:resource="2.3.2.-"/>
</rdf:Description>
