<skos:altLabel>ChEH</skos:altLabel>
<skos:altLabel>cholesterol-epoxide hydrolase</skos:altLabel>
<activity rdf:resource="3.3.2.11#SIPDD209EAFF070704E"/>
<activity rdf:resource="3.3.2.11#SIP626782BCC1821757"/>
<rdfs:comment>The enzyme appears to work equally well with both diastereoisomers of cholesterol 5,6-epoxide.</rdfs:comment>
<rdfs:comment>The product is a competitive inhibitor of the reaction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3941086"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6401984"/>
