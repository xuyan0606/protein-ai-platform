<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.257#SIPEE2232DCD92C0D6D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>pseudouridine(54) in tRNA + S-adenosyl-L-methionine = H(+) + N(1)-methylpseudouridine(54) in tRNA + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
