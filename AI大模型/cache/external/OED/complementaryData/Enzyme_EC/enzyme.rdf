<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADPH + presqualene diphosphate = diphosphate + NADP(+) + squalene.</rdfs:label>
</rdf:Description>
