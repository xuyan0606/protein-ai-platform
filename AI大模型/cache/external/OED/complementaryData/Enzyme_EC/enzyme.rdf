<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>isopyridoxal + NAD(+) = 5-pyridoxolactone + H(+) + NADH.</rdfs:label>
</rdf:Description>
