<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>butanoyl-CoA + NADP(+) = (2E)-butenoyl-CoA + H(+) + NADPH.</rdfs:label>
</rdf:Description>
