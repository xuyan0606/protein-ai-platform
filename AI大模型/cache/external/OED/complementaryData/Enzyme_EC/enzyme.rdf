<skos:prefLabel>apigenin 4'-O-methyltransferase</skos:prefLabel>
<skos:altLabel>flavonoid O-methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.75#SIPB6C329485E3CEEDD"/>
<rdfs:comment>Converts apigenin into acacetin.</rdfs:comment>
<rdfs:comment>Naringenin (5,7,4'-trihydroxyflavanone) can also act as an acceptor, but more slowly.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
