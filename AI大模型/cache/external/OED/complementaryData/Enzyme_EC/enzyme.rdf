<skos:prefLabel>deacetylisoipecoside synthase</skos:prefLabel>
<activity rdf:resource="4.3.3.3#SIPA5E5E4158543F7E4"/>
<rdfs:comment>The enzyme from the leaves of Alangium lamarckii differs in enantiomeric specificity from EC 4.3.3.4.</rdfs:comment>
<rdfs:comment>The product is rapidly converted to demethylisoalangiside.</rdfs:comment>
<rdfs:subClassOf rdf:resource="4.3.3.-"/>
<skos:broaderTransitive rdf:resource="4.3.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.3.3#SIPA5E5E4158543F7E4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>deacetylisoipecoside + H2O = dopamine + secologanin.</rdfs:label>
</rdf:Description>
