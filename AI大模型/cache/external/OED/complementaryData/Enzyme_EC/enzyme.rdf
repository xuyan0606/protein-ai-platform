</rdf:Description>
<rdf:Description rdf:about="2.3.1.219">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>demethoxycurcumin synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.219#SIPCB5979FC2C99623E"/>
<activity rdf:resource="2.3.1.219#SIPF69D3FA91B67B4B5"/>
<rdfs:comment>A polyketide synthase from the plant Curcuma longa (turmeric).</rdfs:comment>
<rdfs:comment>Three isoforms exist, CURS1, CURS2 and CURS3.</rdfs:comment>
<rdfs:comment>While CURS1 and CURS2 prefer feruloyl-CoA as a starter substrate (cf. EC 2.3.1.217), CURS3 can accept 4-coumaroyl-CoA equally well.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19622354"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.219#SIPCB5979FC2C99623E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-4-coumaroyl-CoA + (E)-feruloylacetyl-CoA + H2O = CO2 + 2 CoA + demethoxycurcumin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.219#SIPF69D3FA91B67B4B5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(4-coumaroyl)acetyl-CoA + 4-coumaroyl-CoA + H2O = bisdemethoxycurcumin + CO2 + 2 CoA.</rdfs:label>
</rdf:Description>
