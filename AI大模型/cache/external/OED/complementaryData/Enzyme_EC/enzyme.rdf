<rdf:Description rdf:about="6.2.1.35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetate--[acyl-carrier protein] ligase</skos:prefLabel>
<skos:altLabel>[acyl-carrier protein]:acetate ligase</skos:altLabel>
<skos:altLabel>ACP-SH:acetate ligase</skos:altLabel>
<activity rdf:resource="6.2.1.35#SIP0D00A4D594C4C73D"/>
<rdfs:comment>This enzyme, from the anaerobic bacterium Malonomonas rubra, is a component of the multienzyme complex EC 7.2.4.4.</rdfs:comment>
<rdfs:comment>The enzyme uses the energy from hydrolysis of ATP to convert the thiol group of the acyl-carrier-protein-bound 2'-(5-phosphoribosyl)-3'-dephospho-CoA cofactor into its acetyl thioester.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1628643"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8664258"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9128730"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11902724"/>
