<skos:prefLabel>fumarate reductase (CoM/CoB)</skos:prefLabel>
<skos:altLabel>thiol:fumarate reductase</skos:altLabel>
<activity rdf:resource="1.3.4.1#SIPCE114611F6EFB6A0"/>
<rdfs:comment>The enzyme, isolated from the archaeon Methanobacterium thermoautotrophicum, is very oxygen sensitive.</rdfs:comment>
<rdfs:comment>It cannot use reduced flavins, reduced coenzyme F420, or NAD(P)H as an electron donor.</rdfs:comment>
<rdfs:comment>Distinct from EC 1.3.1.6, EC 1.3.5.1 and EC 1.3.5.4.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2499256"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9578488"/>
<rdfs:subClassOf rdf:resource="1.3.4.-"/>
<skos:broaderTransitive rdf:resource="1.3.4.-"/>
</rdf:Description>
