<rdf:Description rdf:about="2.3.1.222">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.3.1.n10"/>
<skos:prefLabel>phosphate propanoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.222#SIP1A6E20D2E3C9BCB0"/>
<rdfs:comment>Part of the degradation pathway for 1,2-propanediol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17158662"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.222#SIP1A6E20D2E3C9BCB0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>phosphate + propanoyl-CoA = CoA + propanoyl phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17158662">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17158662"/>
