<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>secondary-alcohol dehydrogenase (coenzyme-F420)</skos:prefLabel>
<skos:altLabel>F420-dependent alcohol dehydrogenase</skos:altLabel>
<skos:altLabel>F420-dependent secondary alcohol dehydrogenase</skos:altLabel>
<activity rdf:resource="1.1.98.5#SIP69AD5DA4DEF5A114"/>
<rdfs:comment>The enzyme isolated from the methanogenic archaea Methanogenium liminatans catalyzes the reversible oxidation of various secondary and cyclic alcohols to the corresponding ketones.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1879431"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15016352"/>
