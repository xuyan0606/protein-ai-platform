<skos:broaderTransitive rdf:resource="6.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.1.2.1#SIP9C59E33210A927F7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-lactate + ATP + D-alanine = ADP + D-alanyl-(R)-lactate + phosphate.</rdfs:label>
</rdf:Description>
