</rdf:Description>
<rdf:Description rdf:about="1.14.14.51">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.48"/>
<skos:prefLabel>(S)-limonene 6-monooxygenase</skos:prefLabel>
<skos:altLabel>(-)-limonene 6-hydroxylase</skos:altLabel>
<skos:altLabel>(-)-limonene 6-monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.51#SIP0FC2C8BEFB456AFE"/>
<rdfs:comment>The enzyme participates in the biosynthesis of (-)-carvone, which is responsible for the aroma of spearmint.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2297225"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.51#SIP0FC2C8BEFB456AFE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(4S)-limonene + O2 + reduced [NADPH--hemoprotein reductase] = (1S,5R)-carveol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2297225">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2297225"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/2297225"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.52">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.49"/>
<skos:prefLabel>(S)-limonene 7-monooxygenase</skos:prefLabel>
<skos:altLabel>(-)-limonene 7-monooxygenase</skos:altLabel>
<skos:altLabel>(-)-limonene hydroxylase</skos:altLabel>
<skos:altLabel>(-)-limonene monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.52#SIPF160C8AA93E51521"/>
<rdfs:comment>The enzyme, characterized from the plant Perilla frutescens, participates in the biosynthesis of perillyl aldehyde, the major constituent of the essential oil that accumulates in the glandular trichomes of this plant.</rdfs:comment>
<rdfs:comment>Some forms of the enzyme also catalyze the oxidation of (-)-perillyl alcohol to (-)-perillyl aldehyde.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2297225"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20079506"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27890582"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.52#SIPF160C8AA93E51521">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(4S)-limonene + O2 + reduced [NADPH--hemoprotein reductase] = (4S)-perillyl alcohol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2297225">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2297225"/>
