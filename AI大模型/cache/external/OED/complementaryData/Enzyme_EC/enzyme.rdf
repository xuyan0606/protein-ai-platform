</rdf:Description>
<rdf:Description rdf:about="3.5.4.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methenyltetrahydromethanopterin cyclohydrolase</skos:prefLabel>
<skos:altLabel>methenyl-H(4)MPT cyclohydrolase</skos:altLabel>
<activity rdf:resource="3.5.4.27#SIPE8F7B5ABBC26B222"/>
<rdfs:comment>Methanopterin is a pterin analog.</rdfs:comment>
<rdfs:comment>Involved in the formation of methane from CO2 in Methanobacterium thermoautotrophicum.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4062290"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.4.27#SIPE8F7B5ABBC26B222">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,10-methenyl-5,6,7,8-tetrahydromethanopterin + H2O = H(+) + N(5)-formyl-5,6,7,8-tetrahydromethanopterin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4062290">
