<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(8)-acetylspermidine + O2 = 4-acetamidobutanal + H2O2 + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
