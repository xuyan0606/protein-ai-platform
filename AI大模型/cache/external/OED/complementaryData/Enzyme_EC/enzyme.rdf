<skos:altLabel>monoglyceride acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.22#SIP00E52A481F212F33"/>
<rdfs:comment>Various 2-acylglycerols can act as acceptor.</rdfs:comment>
<rdfs:comment>Palmitoyl-CoA and other long-chain acyl-CoAs can act as donors.</rdfs:comment>
<rdfs:comment>The sn-1 position and the sn-3 position are both acylated, at about the same rate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4016575"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
