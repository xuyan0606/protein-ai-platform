<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>amicoumacin A + ATP = ADP + amicoumacin A 2-phosphate + H(+).</rdfs:label>
</rdf:Description>
