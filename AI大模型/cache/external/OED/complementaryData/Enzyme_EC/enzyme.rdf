<skos:altLabel>aminopeptidase B</skos:altLabel>
<skos:altLabel>peptidase B</skos:altLabel>
<activity rdf:resource="3.4.11.23#SIPD66C60D17229AF9F"/>
<rdfs:comment>A 270-kDa protein composed of six 46.3-kDa subunits.</rdfs:comment>
<rdfs:comment>The pH optimum is in the alkaline range and activity is stimulated by KCl.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M17.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10852868"/>
<rdfs:subClassOf rdf:resource="3.4.11.-"/>
<skos:broaderTransitive rdf:resource="3.4.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.11.23#SIPD66C60D17229AF9F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Release of an N-terminal amino acid, Xaa, from a peptide or arylamide. Xaa is preferably Glu or Asp but may be other amino acids, including Leu, Met, His, Cys and Gln.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10852868">
