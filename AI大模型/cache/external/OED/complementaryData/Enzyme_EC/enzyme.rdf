<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-arginine oxidase</skos:prefLabel>
<activity rdf:resource="1.4.3.25#SIP52224DA1C108007C"/>
<rdfs:comment>The enzyme from cyanobacteria can also act on other basic amino acids with lower activity.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Pseudomonas sp. TPU 7192 is highly specific.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5570437"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6766743"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17542496"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26672462"/>
