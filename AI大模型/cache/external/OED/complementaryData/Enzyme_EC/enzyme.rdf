<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-ribose 2,5-bisphosphate + H2O = D-ribose 5-phosphate + phosphate.</rdfs:label>
</rdf:Description>
