<rdf:Description rdf:about="2.3.1.264">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-lysine N(6)-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.264#SIP89C5C76377AFD9A8"/>
<rdfs:comment>The enzyme is found in some methanogenic archaea and bacteria.</rdfs:comment>
<rdfs:comment>In archaea it is induced under salt stress.</rdfs:comment>
<rdfs:comment>The product, N(6)-acetyl-beta-L-lysine, serves as a compatible solute, conferring high salt resistance on the producing organisms.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14532061"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21538109"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.264#SIP89C5C76377AFD9A8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3S)-3,6-diaminohexanoate + acetyl-CoA = (3S)-6-acetamido-3-aminohexanoate + CoA + H(+).</rdfs:label>
</rdf:Description>
