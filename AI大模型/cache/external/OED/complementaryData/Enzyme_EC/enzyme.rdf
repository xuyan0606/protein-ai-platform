<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>mycinamicin VI + S-adenosyl-L-methionine = H(+) + mycinamicin III + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
