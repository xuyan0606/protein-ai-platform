<citation rdf:resource="http://purl.uniprot.org/citations/19376919"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23306642"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25524738"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
