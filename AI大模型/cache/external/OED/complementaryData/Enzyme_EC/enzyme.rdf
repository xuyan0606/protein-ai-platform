<rdf:Description rdf:about="2.5.1.134">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cystathionine beta-synthase (O-acetyl-L-serine)</skos:prefLabel>
<skos:altLabel>O-acetylserine dependent cystathionine beta-synthase</skos:altLabel>
<activity rdf:resource="2.5.1.134#SIP3B43D8AF5507F9B3"/>
<rdfs:comment>The enzyme, purified from the bacterium Bacillus subtilis, also has a low activity with L-serine (cf. EC 4.2.1.22).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17056751"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
