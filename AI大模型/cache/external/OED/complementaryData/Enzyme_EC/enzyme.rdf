</rdf:Description>
<rdf:Description rdf:about="2.4.99.23#SIP8B443AEC78DC2F26">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ADP-L-glycero-beta-D-manno-heptose + an alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid A = ADP + an L-alpha-D-Hep-(1->5)-[alpha-Kdo-(2->4)]-alpha-Kdo-(2->6)-lipid A + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.99.23#SIP3E7BF46EAEF729FA">
