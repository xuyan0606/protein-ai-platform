<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>kunzeaol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.143#SIP41DBA72D92DC161D"/>
<rdfs:comment>Isolated from the root of the plant Thapsia garganica.</rdfs:comment>
<rdfs:comment>The enzyme also produces germacrene D, bicyclogermacrene and traces of other sesquiterpenoids.</rdfs:comment>
<rdfs:comment>See EC 4.2.3.77 and EC 4.2.3.100.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22938155"/>
