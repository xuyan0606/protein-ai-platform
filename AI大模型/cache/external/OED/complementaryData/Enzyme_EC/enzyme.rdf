<rdf:Description rdf:about="1.14.11.31">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thebaine 6-O-demethylase</skos:prefLabel>
<activity rdf:resource="1.14.11.31#SIP6EB5A40F34F0DEA3"/>
<rdfs:comment>Requires Fe(2+).</rdfs:comment>
<rdfs:comment>Catalyzes a step in morphine biosynthesis.</rdfs:comment>
<rdfs:comment>The product neopinione spontaneously rearranges to the more stable codeinone.</rdfs:comment>
<rdfs:comment>The enzyme also catalyzes the 6-O-demethylation of oripavine to morphinone, with lower efficiency.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20228795"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
<skos:broaderTransitive rdf:resource="1.14.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.31#SIP6EB5A40F34F0DEA3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + O2 + thebaine = CO2 + formaldehyde + neopinone + succinate.</rdfs:label>
</rdf:Description>
