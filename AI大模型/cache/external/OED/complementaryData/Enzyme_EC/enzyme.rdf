<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co-precorrin-6B + S-adenosyl-L-methionine = Co-precorrin-7 + CO2 + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
