<rdf:Description rdf:about="2.1.1.299">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>protein N-terminal monomethyltransferase</skos:prefLabel>
<skos:altLabel>N-terminal monomethylase</skos:altLabel>
<activity rdf:resource="2.1.1.299#SIPA3122F61592B0708"/>
<activity rdf:resource="2.1.1.299#SIP173EC9C927320AAF"/>
<activity rdf:resource="2.1.1.299#SIPCB0EEA57841C4FD1"/>
<rdfs:comment>This enzyme methylates the N-terminus of target proteins containing the N-terminal motif [Ala/Pro/Ser]-Pro-Lys after the initiator L-methionine is cleaved.</rdfs:comment>
<rdfs:comment>In contrast to EC 2.1.1.244, the protein only adds one methyl group to the N-terminal.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24090352"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
