<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/14702315"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-dehydroshikimate dehydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.118#SIP6DEE098DD7E1417D"/>
<rdfs:comment>Catalyzes an early step in the biosynthesis of petrobactin, a siderophore produced by many bacteria, including the human pathogen Bacillus anthracis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18955706"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18975921"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.118#SIP6DEE098DD7E1417D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-dehydroshikimate = 3,4-dihydroxybenzoate + H2O.</rdfs:label>
</rdf:Description>
