<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a long-chain fatty acid + ATP + holo-[mycocerosate synthase] = AMP + diphosphate + long-chain fatty acyl-[mycocerosate synthase].</rdfs:label>
</rdf:Description>
