<skos:altLabel>monoglucosyl diacylglycerol (1->2) glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.208#SIPA152652895849F25"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8756472"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
