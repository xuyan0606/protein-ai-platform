<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.167#SIPCD86676E0E21F875">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-2-hydroxyglutaryl-CoA = (2E)-glutaconyl-CoA + H2O.</rdfs:label>
</rdf:Description>
