<rdf:Description rdf:about="1.14.15.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>steroid 15beta-monooxygenase</skos:prefLabel>
<skos:altLabel>CYP106A2</skos:altLabel>
<skos:altLabel>steroid 15beta-hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.15.8#SIPFB83C9721F20CB09"/>
<rdfs:comment>The enzyme from Bacillus megaterium hydroxylates a variety of 3-oxo-Delta4-steroids in position 15beta.</rdfs:comment>
<rdfs:comment>Ring A-reduced, aromatic, and 3beta-hydroxy-Delta4-steroids do not serve as substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/109432"/>
<citation rdf:resource="http://purl.uniprot.org/citations/177422"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15178459"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18481342"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19635596"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.8#SIPFB83C9721F20CB09">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + O2 + progesterone + reduced 2[4Fe-4S]-[ferredoxin] = 15beta-hydroxyprogesterone + H2O + oxidized 2[4Fe-4S]-[ferredoxin].</rdfs:label>
</rdf:Description>
