<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,6-dihydrouracil + NAD(+) = H(+) + NADH + uracil.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.1#SIP8B218850B0914D33">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,6-dihydrothymine + NAD(+) = H(+) + NADH + thymine.</rdfs:label>
</rdf:Description>
