<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-lysine cyclodeaminase</skos:prefLabel>
<activity rdf:resource="4.3.1.28#SIP49605329205D4984"/>
<rdfs:comment>The enzyme produces the non-proteinogenic amino acid L-pipecolate, which is incorporated into multiple secondary metabolite products, including rapamycin, tobulysin, virginiamycin and pristinamycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9473033"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16536560"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17291665"/>
