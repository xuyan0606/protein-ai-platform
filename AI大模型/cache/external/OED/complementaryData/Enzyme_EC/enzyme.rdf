<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-deoxyoctulosonyl-[lipopolysaccharide] + H2O = 3-deoxyoctulosonate + [lipopolysaccharide].</rdfs:label>
</rdf:Description>
