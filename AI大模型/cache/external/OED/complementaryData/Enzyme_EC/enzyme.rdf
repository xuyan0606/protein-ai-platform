<rdf:Description rdf:about="4.99.1.12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pyridinium-3,5-bisthiocarboxylic acid mononucleotide nickel chelatase</skos:prefLabel>
<skos:altLabel>P2TMN nickel chelatase</skos:altLabel>
<activity rdf:resource="4.99.1.12#SIPFF341B148AB32169"/>
<rdfs:comment>This enzyme, found in Lactobacillus plantarum, is involved in the biosynthesis of a nickel-pincer cofactor.</rdfs:comment>
<rdfs:comment>It catalyzes the insertion of Ni(2+) into the cofactor forming a covalent bond between a carbon atom and the nickel atom.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24710389"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27114550"/>
<rdfs:subClassOf rdf:resource="4.99.1.-"/>
<skos:broaderTransitive rdf:resource="4.99.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.99.1.12#SIPFF341B148AB32169">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Ni(II)-pyridinium-3,5-bisthiocarboxylate mononucleotide = Ni(2+) + pyridinium-3,5-bisthiocarboxylate mononucleotide.</rdfs:label>
</rdf:Description>
