<rdf:Description rdf:about="2.3.1.234">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.6.99.4"/>
<skos:prefLabel>N(6)-L-threonylcarbamoyladenine synthase</skos:prefLabel>
<skos:altLabel>t6A synthase</skos:altLabel>
<activity rdf:resource="2.3.1.234#SIP4685B6949A9FF87B"/>
<rdfs:comment>The enzyme is involved in the synthesis of N(6)-threonylcarbamoyladenosine(37) in tRNAs, which is found in tRNAs with the anticodon NNU, i.e. tRNA(Ile), tRNA(Thr), tRNA(Asn), tRNA(Lys), tRNA(Ser) and tRNA(Arg).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22378793"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23072323"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23258706"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23620299"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.234#SIP4685B6949A9FF87B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine(37) in tRNA + L-threonylcarbamoyladenylate = AMP + H(+) + N(6)-L-threonylcarbamoyladenosine(37) in tRNA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22378793">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22378793"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22378793"/>
</rdf:Description>
