<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-anol + acetate + NADP(+) = (E)-coumaryl acetate + NADPH.</rdfs:label>
</rdf:Description>
