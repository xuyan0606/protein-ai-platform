<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-glyceraldehyde 3-phosphate + H2O + 2 oxidized [2Fe-2S]-[ferredoxin] = (2R)-3-phosphoglycerate + 3 H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
