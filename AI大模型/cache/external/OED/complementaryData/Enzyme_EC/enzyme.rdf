<rdfs:label>(R)-mandelonitrile + UDP-alpha-D-glucose = (R)-prunasin + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.355">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>poly(ribitol-phosphate) beta-N-acetylglucosaminyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.355#SIP2659DDFAE17C3472"/>
<rdfs:comment>Involved in the biosynthesis of poly(ribitol-phosphate) teichoic acids in the cell wall of the bacterium Staphylococcus aureus.</rdfs:comment>
<rdfs:comment>This enzyme adds an N-acetyl-beta-D-glucosamine to the OH group at the 2 position of the ribitol phosphate units. cf. EC 2.4.1.70.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14085356"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23027967"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27973583"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.355#SIP2659DDFAE17C3472">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-O-[(D-ribitylphospho)(n)-di{(2R)-glycerylphospho}]-N-acetyl-beta-D-mannosaminyl-(1->4)-N-acetyl-alpha-D-glucosaminyl di-trans,octa-cis-undecaprenyl diphosphate + n UDP-N-acetyl-alpha-D-glucosamine = 4-O-([2-N-acetyl-beta-D-glucosaminyl-1-D-ribitylphospho](n)-di{[2R]-1-glycerylphospho})-N-acetyl-beta-D-mannosaminyl-(1->4)-N-acetyl-alpha-D-glucosaminyl di-trans,octa-cis-undecaprenyl diphosphate + n H(+) + n UDP.</rdfs:label>
</rdf:Description>
