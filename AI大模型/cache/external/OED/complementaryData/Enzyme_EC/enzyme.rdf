<rdf:Description rdf:about="4.2.3.55">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(S)-beta-bisabolene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.55#SIP0B5726761A2A8B49"/>
<rdfs:comment>The synthesis of (S)-beta-macrocarpene from (2E,6E)-farnesyl diphosphate proceeds in two steps.</rdfs:comment>
<rdfs:comment>The first step is the cyclization to (S)-beta-bisabolene.</rdfs:comment>
<rdfs:comment>The second step is the isomerization to (S)-beta-macrocarpene (cf. EC 5.5.1.17, (S)-beta-macrocarpene synthase).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20229191"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
