<rdf:Description rdf:about="5.4.99.60">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-8 methylmutase</skos:prefLabel>
<activity rdf:resource="5.4.99.60#SIPF34619535DB23670"/>
<rdfs:comment>The enzyme, which participates in the anaerobic (early cobalt insertion) adenosylcobalamin biosynthesis pathway, catalyzes the conversion of cobalt-precorrin-8 to cobyrinate by methyl rearrangement.</rdfs:comment>
<rdfs:comment>The equivalent enzyme in the aerobic pathway is EC 5.4.99.61.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1451790"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8501034"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16427313"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23922391"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
</rdf:Description>
