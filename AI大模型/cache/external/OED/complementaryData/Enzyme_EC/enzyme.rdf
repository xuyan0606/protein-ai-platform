<skos:altLabel>cholesterol 20-22-desmolase</skos:altLabel>
<skos:altLabel>cholesterol C20-22 desmolase</skos:altLabel>
<skos:altLabel>cholesterol desmolase</skos:altLabel>
<skos:altLabel>cholesterol side-chain cleavage enzyme</skos:altLabel>
<skos:altLabel>cholesterol side-chain-cleaving enzyme</skos:altLabel>
