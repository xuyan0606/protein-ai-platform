<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfide dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.8.1.19#SIP7A1AFADF19FE9558"/>
<rdfs:comment>In the archaeon Pyrococcus furiosus the enzyme is involved in the oxidation of NADPH which is produced in peptide degradation.</rdfs:comment>
<rdfs:comment>The enzyme also catalyzes the reduction of sulfur with lower activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7961401"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10968624"/>
