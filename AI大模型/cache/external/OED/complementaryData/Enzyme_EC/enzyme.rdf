<citation rdf:resource="http://purl.uniprot.org/citations/15647264"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15774882"/>
<rdfs:subClassOf rdf:resource="2.7.2.-"/>
<skos:broaderTransitive rdf:resource="2.7.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.2.1#SIPED8CCF57889088BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetate + ATP = acetyl phosphate + ADP.</rdfs:label>
</rdf:Description>
