<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>kanosamine kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.179#SIP27B9924E3A68AC54"/>
<rdfs:comment>The enzyme from the bacterium Amycolatopsis mediterranei is specific for kanosamine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12207505"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
