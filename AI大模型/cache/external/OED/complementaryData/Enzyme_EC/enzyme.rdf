<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23386483"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23386483"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.150">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cembrene A synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.150#SIPE73F2184EE67C556"/>
<rdfs:comment>Isolated from the bacterium Streptomyces sp. SANK 60404.</rdfs:comment>
<rdfs:comment>This trifunctional enzyme also produces (R)-nephthenol and (1S,4E,8E,12E)-2,2,5,9,13-pentamethylcyclopentadeca-4,8,12-trien-1-ol (cf. EC 4.2.3.149 and EC 4.2.3.151).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23386483"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
