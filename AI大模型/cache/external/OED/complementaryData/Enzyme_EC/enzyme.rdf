<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-sinapate + UDP-alpha-D-glucose = 1-O-(trans-sinapoyl)-beta-D-glucose + UDP.</rdfs:label>
</rdf:Description>
