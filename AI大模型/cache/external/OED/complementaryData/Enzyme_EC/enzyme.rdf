<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/6381490"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.7.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>coenzyme F420 oxidoreductase (ferredoxin)</skos:prefLabel>
<activity rdf:resource="1.5.7.2#SIP3EEB3DE3A7559785"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21306561"/>
<rdfs:subClassOf rdf:resource="1.5.7.-"/>
<skos:broaderTransitive rdf:resource="1.5.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.7.2#SIP3EEB3DE3A7559785">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 oxidized [2Fe-2S]-[ferredoxin] + reduced coenzyme F420-(gamma-L-Glu)(n) = 3 H(+) + oxidized coenzyme F420-(gamma-L-Glu)(n) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21306561">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21306561"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/21306561"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.7.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N,N-dimethylglycine/sarcosine dehydrogenase (ferredoxin)</skos:prefLabel>
<activity rdf:resource="1.5.7.3#SIPCCFCD69E87C4C845"/>
<activity rdf:resource="1.5.7.3#SIPF06DB378BBB06EDA"/>
<rdfs:comment>This bacterial enzyme is involved in degradation of glycine betaine.</rdfs:comment>
<rdfs:comment>The enzyme contains non-covalently bound FAD and NAD(P) cofactors, and catalyzes the demethylation of both N,N-dimethylglycine and sarcosine, releasing formaldehyde and forming glycine as the final product.</rdfs:comment>
<rdfs:comment>The enzyme can utilize both NAD(+) and NADP(+), but the catalytic efficiency with NAD(+) is ~5-fold higher.</rdfs:comment>
<rdfs:comment>The native electron acceptor of the enzyme is a membrane-bound clostridial-type ferredoxin, which transfers the electrons to an electron-transfer flavoprotein (ETF).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17951379"/>
<citation rdf:resource="http://purl.uniprot.org/citations/32631860"/>
<rdfs:subClassOf rdf:resource="1.5.7.-"/>
<skos:broaderTransitive rdf:resource="1.5.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.7.3#SIPCCFCD69E87C4C845">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N,N-dimethylglycine + oxidized 2[4Fe-4S]-[ferredoxin] = formaldehyde + 2 H(+) + reduced 2[4Fe-4S]-[ferredoxin] + sarcosine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.7.3#SIPF06DB378BBB06EDA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + oxidized 2[4Fe-4S]-[ferredoxin] + sarcosine = formaldehyde + glycine + 2 H(+) + reduced 2[4Fe-4S]-[ferredoxin].</rdfs:label>
</rdf:Description>
