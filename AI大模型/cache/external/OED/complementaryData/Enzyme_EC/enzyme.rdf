<rdf:Description rdf:about="1.5.99.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methylglutamate dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.5.99.5#SIP4F0CDAD0A8FDADAB"/>
<rdfs:comment>A number of N-methyl-substituted amino acids can act as donors.</rdfs:comment>
<rdfs:comment>2,6-dichloroindophenol is the best acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5028076"/>
<rdfs:subClassOf rdf:resource="1.5.99.-"/>
<skos:broaderTransitive rdf:resource="1.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.5#SIP4F0CDAD0A8FDADAB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + N-methyl-L-glutamate = AH2 + formaldehyde + L-glutamate.</rdfs:label>
</rdf:Description>
