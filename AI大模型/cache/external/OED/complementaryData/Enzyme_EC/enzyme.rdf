<citation rdf:resource="http://purl.uniprot.org/citations/11278886"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16040662"/>
<rdfs:subClassOf rdf:resource="5.3.3.-"/>
<skos:broaderTransitive rdf:resource="5.3.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="5.3.3.21#SIP96743F001BB5420A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (3E,5Z)-dienoyl-CoA = a (2E,4E)-(5,6-saturated)-dienoyl-CoA.</rdfs:label>
</rdf:Description>
