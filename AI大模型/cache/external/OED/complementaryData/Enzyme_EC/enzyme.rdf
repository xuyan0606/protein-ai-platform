<rdf:Description rdf:about="5.4.99.63">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ethylmalonyl-CoA mutase</skos:prefLabel>
<activity rdf:resource="5.4.99.63#SIP2B9EE5966DA3E85A"/>
<rdfs:comment>The enzyme, characterized from the bacterium Rhodobacter sphaeroides, is involved in the ethylmalonyl-CoA pathway for acetyl-CoA assimilation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18819910"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
</rdf:Description>
