<rdf:Description rdf:about="2.6.1.119">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>vanillin aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.119#SIP5F25947002E20E2B"/>
<rdfs:comment>The enzyme participates in the biosynthesis of capsaicinoids in pungent cultivars of Capsicum sp.</rdfs:comment>
<rdfs:comment>In vivo it has only been assayed in the reverse direction, where the preferred amino group acceptors were found to be pyruvate and oxaloacetate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17999078"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19473323"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22921003"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24712445"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.119#SIP5F25947002E20E2B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-alanine + vanillin = pyruvate + vanillylamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17999078">
