<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2S)-3-(1H-indol-3-yl)-2-isocyanopropanoate + 2-oxoglutarate + H(+) + O2 = 3-[(Z)-2-isocyanoethenyl]-1H-indole + 2 CO2 + H2O + succinate.</rdfs:label>
</rdf:Description>
