<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R)-ethylmalonyl-CoA = (2S)-methylsuccinyl-CoA.</rdfs:label>
</rdf:Description>
