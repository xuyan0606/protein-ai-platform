<skos:altLabel>(d)CTP diphosphohydrolase</skos:altLabel>
<skos:altLabel>(d)CTP pyrophosphohydrolase</skos:altLabel>
<activity rdf:resource="3.6.1.65#SIPECC8AEF530CDA701"/>
<activity rdf:resource="3.6.1.65#SIP285E0145ED0C4380"/>
<rdfs:comment>The enzyme, characterized from the bacterium Escherichia coli, is specific for the pyrimidine nucleotides CTP and dCTP.</rdfs:comment>
<rdfs:comment>It also acts on 5-methyl-dCTP, 5-hydroxy-dCTP and 8-hydroxy-dGTP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11053429"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12509230"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15381107"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15823026"/>
<rdfs:subClassOf rdf:resource="3.6.1.-"/>
<skos:broaderTransitive rdf:resource="3.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.65#SIPECC8AEF530CDA701">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CTP + H2O = CMP + diphosphate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.65#SIP285E0145ED0C4380">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dCTP + H2O = dCMP + diphosphate + H(+).</rdfs:label>
</rdf:Description>
