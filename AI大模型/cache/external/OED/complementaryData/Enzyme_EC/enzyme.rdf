<rdf:Description rdf:about="3.7.1.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2,6-dihydroxypseudooxynicotine hydrolase</skos:prefLabel>
<activity rdf:resource="3.7.1.19#SIP3355638756EA518C"/>
<rdfs:comment>The enzyme, characterized from the soil bacterium Arthrobacter nicotinovorans, participates in nicotine degradation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5835946"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16321959"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
