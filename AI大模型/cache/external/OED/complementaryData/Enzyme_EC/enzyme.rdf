<rdf:Description rdf:about="2.3.1.242">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>Kdo2-lipid IVA palmitoleoyltransferase</skos:prefLabel>
<skos:altLabel>(Kdo)2-lipid IVA palmitoleoyltransferase</skos:altLabel>
<skos:altLabel>alpha-Kdo-(2->4)-alpha-(2->6)-lipid IVA palmitoleoyltransferase</skos:altLabel>
<skos:altLabel>cold-induced palmitoleoyl transferase</skos:altLabel>
<skos:altLabel>palmitoleoyl-acyl carrier protein-dependent acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.242#SIPDE322054248BF3B8"/>
<activity rdf:resource="2.3.1.242#SIP0EBA7015B98926D9"/>
<rdfs:comment>The enzyme, characterized from the bacterium Escherichia coli, is induced upon cold shock and is involved in the formation of a cold-adapted variant of the outer membrane glycolipid lipid A.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10092655"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11830594"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
