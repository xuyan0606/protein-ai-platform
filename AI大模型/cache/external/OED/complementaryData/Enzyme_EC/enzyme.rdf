<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<dcterms:identifier>doi:10.1271/bbb1961.43.2283</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/37033117">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/37033117"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/37033117"/>
<dcterms:identifier>doi:10.5458/jag.jag.jag-2022_0013</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucan 1,4-alpha-maltotriohydrolase</skos:prefLabel>
<skos:altLabel>exo-maltotriohydrolase</skos:altLabel>
<activity rdf:resource="3.2.1.116#SIPF5658B7D930FC16B"/>
<rdfs:comment>cf. EC 3.2.1.2, EC 3.2.1.60 and EC 3.2.1.98.</rdfs:comment>
<rdfs:comment>The products of all these enzymes have the alpha-configuration.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.116#SIPF5658B7D930FC16B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->4)-alpha-D-glucosidic linkages in amylaceous polysaccharides, to remove successive maltotriose residues from the non-reducing chain ends.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.117">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>amygdalin beta-glucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.117#SIP6175BB0F5A4CB45E"/>
<rdfs:comment>Highly specific; does not act on prunasin, linamarin, gentiobiose or cellobiose (cf. EC 3.2.1.21).</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.117#SIP6175BB0F5A4CB45E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-amygdalin + H2O = (R)-prunasin + D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>prunasin beta-glucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.118#SIPE3904A725E076BAD"/>
<rdfs:comment>Highly specific; does not act on amygdalin, linamarin or gentiobiose (cf. EC 3.2.1.21).</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.118#SIPE3904A725E076BAD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-prunasin + H2O = D-glucose + mandelonitrile.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.119">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>vicianin beta-glucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.119#SIPC7BD94573769AA35"/>
<rdfs:comment>Also hydrolyzes, more slowly, (R)-amygdalin and (R)-prunasin, but not gentiobiose, linamarin or cellobiose.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.119#SIPC7BD94573769AA35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-vicianin + H2O = mandelonitrile + vicianose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.120">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>oligoxyloglucan beta-glycosidase</skos:prefLabel>
<skos:altLabel>isoprimeverose-producing oligoxyloglucan hydrolase</skos:altLabel>
<activity rdf:resource="3.2.1.120#SIP6E8F5EC8A761E78F"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4019436"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.120#SIP6E8F5EC8A761E78F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->4)-beta-D-glucosidic links in oligoxyloglucans so as to remove successive isoprimeverose [i.e. alpha-xylo-(1->6)-beta-D-glucosyl-] residues from the non-reducing chain ends.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4019436">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/4019436"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/4019436"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.121">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>polymannuronate hydrolase</skos:prefLabel>
<activity rdf:resource="3.2.1.121#SIPF459CB2FC10AF672"/>
<rdfs:comment>Does not act on alginic acid, which is a copolymer of polymannuronate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3935048"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.121#SIPF459CB2FC10AF672">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endohydrolysis of the D-mannuronide linkages of polymannuronate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3935048">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3935048"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3935048"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.122">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>maltose-6'-phosphate glucosidase</skos:prefLabel>
<skos:altLabel>phospho-alpha-glucosidase</skos:altLabel>
<activity rdf:resource="3.2.1.122#SIP4F7843D4333A683E"/>
<rdfs:comment>Hydrolyzes a variety of 6-phospho-alpha-D-glucosides, including alpha-maltose 6-phosphate, alpha,alpha-trehalose 6-phosphate, sucrose 6-phosphate and p-nitrophenyl-alpha-D-glucopyranoside 6-phosphate (as a chromogenic substrate).</rdfs:comment>
<rdfs:comment>The enzyme is activated by Fe(2+), Mn(2+), Co(2+) and Ni(2+).</rdfs:comment>
<rdfs:comment>It is rapidly inactivated in air.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7730284"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.122#SIP4F7843D4333A683E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-maltose 6'-phosphate + H2O = D-glucose + D-glucose 6-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7730284">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7730284"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/7730284"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.123">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>endoglycosylceramidase</skos:prefLabel>
<skos:altLabel>endo-glucosylceramidase</skos:altLabel>
<skos:altLabel>endoglycoceramidase</skos:altLabel>
<skos:altLabel>oligoglycosylglucosylceramide glycohydrolase</skos:altLabel>
<activity rdf:resource="3.2.1.123#SIP82E1D5A3B444BECE"/>
<rdfs:comment>An enzyme from Rhodococcus sp. which degrades various acidic and neutral glycosphingolipids to oligosaccharides and ceramides, by cleaving a glucosyl bond.</rdfs:comment>
<rdfs:comment>Does not act on monoglycosylceramides (cf. EC 3.2.1.62).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3771534"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.123#SIP82E1D5A3B444BECE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an oligoglycosyl-(1->4)-beta-D-glucosyl-(1&lt;->1)-ceramide + H2O = an N-acyl-sphingoid base + an oligoglycosyl-(1->4)-D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3771534">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3771534"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3771534"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.124">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-deoxy-2-octulosonidase</skos:prefLabel>
<activity rdf:resource="3.2.1.124#SIPEF3A7CB192D5CDDC"/>
<rdfs:comment>The enzyme from a bacteriophage catalyzes the depolymerization of capsular polysaccharides containing 3-deoxy-2-octulosonide in the cell wall of Escherichia coli.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3707579"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.124#SIPEF3A7CB192D5CDDC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endohydrolysis of the beta-ketopyranosidic linkages of 3-deoxy-D-manno-2-octulosonate in capsular polysaccharides.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3707579">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3707579"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3707579"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.125">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>raucaffricine beta-glucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.125#SIP7F09508277E886E1"/>
<rdfs:comment>Highly specific; some other ajmalan glucoside alkaloids are hydrolyzed, more slowly.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.125#SIP7F09508277E886E1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + raucaffricine = D-glucose + vomilenine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.126">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>coniferin beta-glucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.126#SIP1E2E1A8C23F22D6F"/>
<rdfs:comment>Also hydrolyzes syringin, 4-cinnamyl alcohol beta-glucoside and, more slowly, some other aryl beta-glycosides.</rdfs:comment>
<rdfs:comment>A plant cell-wall enzyme involved in the biosynthesis of lignin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25181"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27355"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.126#SIP1E2E1A8C23F22D6F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-O-(beta-D-glucosyl)-(E)-coniferol + H2O = (E)-coniferol + D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25181">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/25181"/>
