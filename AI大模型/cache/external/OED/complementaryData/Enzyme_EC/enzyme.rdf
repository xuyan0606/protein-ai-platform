<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-deoxystreptamine antibiotic + acetyl-CoA = an N(3')-acetyl-2-deoxystreptamine antibiotic + CoA + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/356726">
