<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,4-diacetamido-2,4,6-trideoxy-alpha-D-mannopyranose + H2O + phosphoenolpyruvate = N,N-diacetyllegionaminate + phosphate.</rdfs:label>
</rdf:Description>
