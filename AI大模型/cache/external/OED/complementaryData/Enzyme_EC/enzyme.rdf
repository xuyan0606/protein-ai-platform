<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21768091"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/21768091"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.201">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-2-acetamido-3-amino-2,3-dideoxy-glucuronate N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.201#SIPB039C14C4B2AB240"/>
<rdfs:comment>This enzyme participates in the biosynthetic pathway for UDP-alpha-D-ManNAc3NAcA (UDP-2,3-diacetamido-2,3-dideoxy-alpha-D-mannuronic acid), an important precursor of B-band lipopolysaccharide.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19282284"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19348502"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.201#SIPB039C14C4B2AB240">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + UDP-2-acetamido-3-amino-2,3-dideoxy-alpha-D-glucuronate = CoA + H(+) + UDP-2,3-diacetamido-2,3-dideoxy-alpha-D-glucuronate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19282284">
