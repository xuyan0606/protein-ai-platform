<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid A (E. coli) + di-trans,octa-cis-undecaprenyl diphosphate = (Kdo)2-lipid A 1-diphosphate + di-trans,octa-cis-undecaprenyl phosphate.</rdfs:label>
</rdf:Description>
