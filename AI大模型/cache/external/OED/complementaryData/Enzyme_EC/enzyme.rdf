<rdf:Description rdf:about="1.2.7.12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.2.99.5"/>
<skos:prefLabel>formylmethanofuran dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.2.7.12#SIP8DA5E7922155C188"/>
<rdfs:comment>The enzyme catalyzes a reversible reaction in methanogenic archaea, and is involved in methanogenesis from CO2 as well as the oxidation of coenzyme M to CO2.</rdfs:comment>
<rdfs:comment>The reaction is endergonic, and is driven by coupling with the soluble CoB-CoM heterodisulfide reductase via electron bifurcation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2125267"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8125106"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8161283"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9342247"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11929975"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21262829"/>
<rdfs:subClassOf rdf:resource="1.2.7.-"/>
<skos:broaderTransitive rdf:resource="1.2.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.7.12#SIP8DA5E7922155C188">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-formylmethanofuran + 2 oxidized [2Fe-2S]-[ferredoxin] = CO2 + H(+) + methanofuran + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
