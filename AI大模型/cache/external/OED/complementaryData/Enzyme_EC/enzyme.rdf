<skos:prefLabel>5-dehydro-6-demethoxy-6-hydroxyfumagillol O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.387#SIP3447EE68D78B9433"/>
<rdfs:comment>The enzyme, characterized from the mold Aspergillus fumigatus, participates in the biosynthesis of the meroterpenoid fumagillin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24568283"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
