</rdf:Description>
<rdf:Description rdf:about="2.4.1.127#SIP3DCFD7DB3A531CD7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-menthol + UDP-alpha-D-glucose = (-)-menthyl beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
