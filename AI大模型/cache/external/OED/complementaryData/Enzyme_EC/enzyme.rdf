<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADPH + UDP-2-acetamido-2,6-dideoxy-beta-L-arabino-hex-4-ulose = NADP(+) + UDP-2-acetamido-2,6-dideoxy-beta-L-talose.</rdfs:label>
</rdf:Description>
