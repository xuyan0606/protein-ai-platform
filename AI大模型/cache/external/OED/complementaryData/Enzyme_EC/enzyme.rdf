<rdf:Description rdf:about="4.1.1.91">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>salicylate decarboxylase</skos:prefLabel>
<skos:altLabel>salicylic acid decarboxylase</skos:altLabel>
<activity rdf:resource="4.1.1.91#SIP8B5EE6828AA09356"/>
<rdfs:comment>In the reverse direction the enzyme catalyzes the regioselective carboxylation of phenol into stoichiometric amounts of salicylate.</rdfs:comment>
<rdfs:comment>The enzyme also catalyzes the reversible decarboxylation of 2,4-dihydroxybenzoate, 2,6-dihydroxybenzoate, 2,3-dihydroxybenzoate and 4-aminosalicylate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20188702"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.91#SIP8B5EE6828AA09356">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + salicylate = CO2 + phenol.</rdfs:label>
</rdf:Description>
