<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>benzoyl-CoA + H(+) + NADPH + O2 = 2,3-epoxy-2,3-dihydrobenzoyl-CoA + H2O + NADP(+).</rdfs:label>
</rdf:Description>
