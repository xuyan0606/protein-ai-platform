</rdf:Description>
<rdf:Description rdf:about="6.2.1.41">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-[(3aS,4S,7aS)-7a-methyl-1,5-dioxo-octahydro-1H-inden-4-yl]propanoate--CoA ligase</skos:prefLabel>
<skos:altLabel>HIP--CoA ligase</skos:altLabel>
<activity rdf:resource="6.2.1.41#SIP8A9CB14693A58287"/>
<rdfs:comment>The enzyme, characterized from actinobacterium Mycobacterium tuberculosis, catalyzes a step in the degradation of cholesterol and cholate.</rdfs:comment>
<rdfs:comment>The enzyme is very specific for its substrate, and requires that the side chain at C17 is completely removed.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16891113"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23146019"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.41#SIP8A9CB14693A58287">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-[(3aS,4S,7aS)-7a-methyl-1,5-dioxo-octahydro-1H-inden-4-yl]propanoate + ATP + CoA = 3-[(3aS,4S,7aS)-7a-methyl-1,5-dioxo-octahydro-1H-inden-4-yl]propanoyl-CoA + AMP + diphosphate.</rdfs:label>
</rdf:Description>
