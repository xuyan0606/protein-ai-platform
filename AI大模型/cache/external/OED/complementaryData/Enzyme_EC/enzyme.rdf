<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dolichyl-phosphate beta-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.117#SIP309480A55715CDDA"/>
<rdfs:comment>Solanesyl phosphate and ficaprenyl phosphate can act as acceptors, more slowly.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/438216"/>
