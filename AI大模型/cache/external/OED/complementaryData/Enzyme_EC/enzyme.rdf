<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclohexyl-isocyanide hydratase</skos:prefLabel>
<skos:altLabel>isonitrile hydratase</skos:altLabel>
<activity rdf:resource="4.2.1.103#SIP578A12B4AF3B1443"/>
<rdfs:comment>The enzyme from Pseudomonas putida strain N19-2 can also catalyze the hydration of other isonitriles to the corresponding N-substituted formamides.</rdfs:comment>
<rdfs:comment>The enzyme has no metal requirements.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11306561"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
