<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + Co(2+) + H2O + hydrogenobyrinate a,c-diamide = ADP + cob(II)yrinate a,c diamide + 5 H(+) + phosphate.</rdfs:label>
</rdf:Description>
