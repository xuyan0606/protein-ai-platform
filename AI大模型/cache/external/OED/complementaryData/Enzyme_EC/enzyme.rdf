<rdf:Description rdf:about="4.1.99.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclopenase</skos:prefLabel>
<activity rdf:resource="4.1.99.27#SIPF508B4680F3D5295"/>
<activity rdf:resource="4.1.99.27#SIPD8F10548037C5108"/>
<rdfs:comment>This fungal enzyme catalyzes a key reaction in the biosynthesis of quinolone compounds, converting the benzodiazepine structure into a quinolone structure.</rdfs:comment>
<rdfs:comment>The enzyme is also active with (-)-4'-methoxycyclopenine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30026518"/>
<rdfs:subClassOf rdf:resource="4.1.99.-"/>
<skos:broaderTransitive rdf:resource="4.1.99.-"/>
</rdf:Description>
