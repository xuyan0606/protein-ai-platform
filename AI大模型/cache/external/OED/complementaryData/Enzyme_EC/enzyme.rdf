<rdf:Description rdf:about="1.17.98.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.1.99.33"/>
<replaces rdf:resource="1.17.99.7"/>
<skos:prefLabel>formate dehydrogenase (acceptor)</skos:prefLabel>
<skos:altLabel>formate dehydrogenase H</skos:altLabel>
<skos:altLabel>formate dehydrogenase O</skos:altLabel>
<activity rdf:resource="1.17.98.4#SIP642AAC36DF0BA237"/>
<rdfs:comment>Formate dehydrogenase H is a cytoplasmic enzyme that oxidizes formate without oxygen transfer, transferring electrons to a hydrogenase.</rdfs:comment>
<rdfs:comment>The two enzymes form the formate-hydrogen lyase complex.</rdfs:comment>
<rdfs:comment>The enzyme contains a selenocysteine residue.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2211698"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8626495"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9521673"/>
<rdfs:subClassOf rdf:resource="1.17.98.-"/>
<skos:broaderTransitive rdf:resource="1.17.98.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.98.4#SIP642AAC36DF0BA237">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + formate + H(+) = AH2 + CO2.</rdfs:label>
</rdf:Description>
