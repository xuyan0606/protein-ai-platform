<rdf:Description rdf:about="2.1.1.154">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoliquiritigenin 2'-O-methyltransferase</skos:prefLabel>
<skos:altLabel>chalcone OMT</skos:altLabel>
<skos:altLabel>CHMT</skos:altLabel>
<activity rdf:resource="2.1.1.154#SIP369BA9FD814C99E8"/>
<rdfs:comment>Not identical to EC 2.1.1.65.</rdfs:comment>
<rdfs:comment>While EC 2.1.1.154 can use licodione as a substrate, EC 2.1.1.65 cannot use isoliquiritigenin as a substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1731632"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9055445"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.154#SIP369BA9FD814C99E8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>isoliquiritigenin + S-adenosyl-L-methionine = 2'-O-methylisoliquiritigenin + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1731632">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
