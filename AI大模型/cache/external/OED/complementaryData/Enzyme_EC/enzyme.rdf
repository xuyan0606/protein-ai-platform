<rdf:Description rdf:about="1.3.1.104">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>enoyl-[acyl-carrier-protein] reductase</skos:prefLabel>
<skos:altLabel>acyl-ACP dehydrogenase</skos:altLabel>
<skos:altLabel>enoyl-ACP reductase</skos:altLabel>
<activity rdf:resource="1.3.1.104#SIP82189B2540381C03"/>
<rdfs:comment>The enzyme completes each cycle of fatty acid elongation by catalyzing the stereospecific reduction of the double bond at position 2 of a growing fatty acid chain, while linked to the acyl-carrier protein, in an NADPH-dependent manner.</rdfs:comment>
<rdfs:comment>This entry stands for enzymes whose stereo-specificity with respect to NADP(+) is not known (cf. EC 1.3.1.39, EC 1.3.1.10 and EC 1.3.1.9).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11007778"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17329825"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21185310"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.104#SIP82189B2540381C03">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2,3-saturated acyl-[ACP] + NADP(+) = a (2E)-enoyl-[ACP] + H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11007778">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11007778"/>
