<rdf:Description rdf:about="2.4.1.371">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>polymannosyl GlcNAc-diphospho-ditrans,octacis-undecaprenol 2,3-alpha-mannosylpolymerase</skos:prefLabel>
<activity rdf:resource="2.4.1.371#SIPAAC02DF049517275"/>
<activity rdf:resource="2.4.1.371#SIP3C6787B88F340DC0"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of polymannose O-polysaccharide in the outer leaflet of the membrane of Escherichia coli serotype O9a.</rdfs:comment>
<rdfs:comment>The enzymes consists of two domains that are responsible for the 1->2 and 1->3 linkages, respectively.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22875852"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22989876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25422321"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.371#SIPAAC02DF049517275">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->2)-alpha-D-Man-(1->2)](n)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-GlcNAc-di-trans,octa-cis-undecaprenyl diphosphate + 2 GDP-alpha-D-mannose = alpha-D-Man-(1->2)-alpha-D-Man-(1->2)-[alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->2)-alpha-D-Man-(1->2)](n)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-GlcNAc-di-trans,octa-cis-undecaprenyl diphosphate + 2 GDP + 2 H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.371#SIP3C6787B88F340DC0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-Man-(1->2)-alpha-D-Man-(1->2)-[alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->2)-alpha-D-Man-(1->2)](n)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-GlcNAc-di-trans,octa-cis-undecaprenyl diphosphate + 2 GDP-alpha-D-mannose = [alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->2)-alpha-D-Man-(1->2)](n+1)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-Man-(1->3)-alpha-D-GlcNAc-di-trans,octa-cis-undecaprenyl diphosphate + 2 GDP + 2 H(+).</rdfs:label>
</rdf:Description>
