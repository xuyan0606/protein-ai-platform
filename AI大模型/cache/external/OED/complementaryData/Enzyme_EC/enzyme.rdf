<replaces rdf:resource="3.4.17.n1"/>
<skos:prefLabel>[CysO sulfur-carrier protein]-S-L-cysteine hydrolase</skos:prefLabel>
<skos:altLabel>[CysO]-cysteine peptidase</skos:altLabel>
<skos:altLabel>metallocarboxypeptidase Mec</skos:altLabel>
<activity rdf:resource="3.13.1.6#SIP8EE8402153E6018B"/>
<rdfs:comment>The enzyme, characterized from the bacterium Mycobacterium tuberculosis, participates in an L-cysteine biosynthesis pathway.</rdfs:comment>
<rdfs:comment>It acts on the product of EC 2.5.1.113.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16104727"/>
<rdfs:subClassOf rdf:resource="3.13.1.-"/>
<skos:broaderTransitive rdf:resource="3.13.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.13.1.6#SIP8EE8402153E6018B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[CysO sulfur-carrier protein]-Gly-NH-CH2-C(O)-S-L-Cys + H2O = [CysO sulfur-carrier protein]-C-terminal Gly-Gly + H(+) + L-cysteine.</rdfs:label>
</rdf:Description>
