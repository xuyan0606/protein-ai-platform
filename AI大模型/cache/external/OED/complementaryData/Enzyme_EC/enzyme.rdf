<skos:prefLabel>citramalate lyase</skos:prefLabel>
<skos:altLabel>(3S)-citramalate pyruvate-lyase</skos:altLabel>
<activity rdf:resource="4.1.3.22#SIP9F4B2C1708D09E37"/>
