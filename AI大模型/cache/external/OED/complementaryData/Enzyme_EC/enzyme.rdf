<skos:prefLabel>7-epizingiberene synthase [(2Z,6Z)-farnesyl diphosphate cyclizing]</skos:prefLabel>
<activity rdf:resource="4.2.3.142#SIP7A4C5F226F03FE17"/>
<rdfs:comment>Isolated from the plant Solanum habrochaites.</rdfs:comment>
<rdfs:comment>7-epizingiberene is a whitefly repellant.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23169639"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
