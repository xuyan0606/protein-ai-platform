<rdfs:label>(2E,6E,10E)-geranylgeraniol + O2 + reduced [NADPH--hemoprotein reductase] = H(+) + H2O + oxidized [NADPH--hemoprotein reductase] + plaunotol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.147">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.112"/>
<skos:prefLabel>22alpha-hydroxysteroid 23-monooxygenase</skos:prefLabel>
