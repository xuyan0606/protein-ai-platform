<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a sphingomyelin + H2O = a carboxylate + sphing-4-enine-phosphocholine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.109#SIP4BDF60C95F07E386">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a beta-D-glucosyl-(1&lt;->1')-N-acylsphing-4-enine + H2O = a fatty acid + beta-D-glucosyl-(1&lt;->1)-sphing-4-enine.</rdfs:label>
</rdf:Description>
