<rdf:Description rdf:about="5.6.1.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.6.4.5"/>
<skos:prefLabel>minus-end-directed kinesin ATPase</skos:prefLabel>
<skos:altLabel>non-claret disjunctional</skos:altLabel>
<activity rdf:resource="5.6.1.4#SIP74C4EB9AF86583AA"/>
<rdfs:comment>Kinesins are a family of motor proteins that move unidirectionally along microtubules as they hydrolyze ATP and are involved in organelle movement.</rdfs:comment>
<rdfs:comment>This enzyme is similar to EC 5.6.1.3 but the organization of the different domains differs, resulting in movement in the opposite direction along the microtubules.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2261638"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8112290"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8473343"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9288974"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9796817"/>
<rdfs:subClassOf rdf:resource="5.6.1.-"/>
<skos:broaderTransitive rdf:resource="5.6.1.-"/>
</rdf:Description>
