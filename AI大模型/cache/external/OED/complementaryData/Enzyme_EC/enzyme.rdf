<rdf:Description rdf:about="2.4.1.289">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-acetylglucosaminyl-diphospho-decaprenol L-rhamnosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.289#SIPAEF864C410731DC6"/>
<rdfs:comment>Isolated from Mycobacterium smegmatis and Mycobacterium tuberculosis.</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the addition of a rhamnosyl unit to N-acetyl-alpha-D-glucosaminyl-diphospho-trans,octacis-decaprenol, completing the synthesis of the linkage unit that attaches the arabinogalactan moiety to the peptidoglycan moiety in Mycobacterial cell wall.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15294902"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19047740"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.289#SIPAEF864C410731DC6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dTDP-beta-L-rhamnose + N-acetyl-alpha-D-glucosaminyl-1-diphospho-trans,octa-cis-decaprenol = alpha-L-rhamnosyl-(1->3)-N-acetyl-alpha-D-glucosaminyl-diphospho-trans,octa-cis-decaprenol + dTDP + H(+).</rdfs:label>
</rdf:Description>
