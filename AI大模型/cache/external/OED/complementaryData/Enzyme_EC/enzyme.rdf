<skos:altLabel>glyceollin synthase</skos:altLabel>
<activity rdf:resource="2.5.1.36#SIP33EF8B25A47E6217"/>
<activity rdf:resource="2.5.1.36#SIP77A7E4B60DEEB66F"/>
<rdfs:comment>Part of the glyceollin biosynthesis system in soybean.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
