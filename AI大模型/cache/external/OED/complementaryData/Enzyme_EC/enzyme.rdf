<skos:altLabel>HPBS desulfinase</skos:altLabel>
<activity rdf:resource="3.13.1.3#SIP4EA30CBE596D68FB"/>
<rdfs:comment>The enzyme has a narrow substrate specificity with biphenyl-2-sulfinate being the only other substrate known to date.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9308179"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12147352"/>
