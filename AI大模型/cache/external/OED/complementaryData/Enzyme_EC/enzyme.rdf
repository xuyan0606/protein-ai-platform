<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + NADH + O2 + uracil = (Z)-3-ureidoacrylate + FMN + H(+) + H2O + NAD(+).</rdfs:label>
</rdf:Description>
