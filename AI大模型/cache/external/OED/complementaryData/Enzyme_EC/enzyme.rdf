<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-hydroxybenzaldehyde + H2O + NADP(+) = 4-hydroxybenzoate + 2 H(+) + NADPH.</rdfs:label>
</rdf:Description>
