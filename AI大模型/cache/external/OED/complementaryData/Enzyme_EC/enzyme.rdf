<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.303#SIPFFAE1482E2DA6C12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,7-dihydroxy-5-methyl-1-naphthoate + S-adenosyl-L-methionine = 2-hydroxy-7-methoxy-5-methyl-1-naphthoate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
