<rdf:Description rdf:about="2.3.1.224">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetyl-CoA-benzylalcohol acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.224#SIP46F16AC02FC491ED"/>
<activity rdf:resource="2.3.1.224#SIP42F8D57F2B1656DC"/>
<rdfs:comment>The enzyme is found in flowers like Clarkia breweri, where it is important for floral scent production.</rdfs:comment>
<rdfs:comment>Unlike EC 2.3.1.84 this enzyme is active with alcohols that contain a benzyl ring.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9628024"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.224#SIP46F16AC02FC491ED">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + benzyl alcohol = benzyl acetate + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.224#SIP42F8D57F2B1656DC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-cinnamyl alcohol + acetyl-CoA = (E)-cinnamyl acetate + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9628024">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9628024"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9628024"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.225">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>protein S-acyltransferase</skos:prefLabel>
<skos:altLabel>DHHC palmitoyl transferase</skos:altLabel>
<skos:altLabel>G-protein palmitoyltransferase</skos:altLabel>
<skos:altLabel>S-protein acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.225#SIP090F7C7FF1D3F564"/>
<rdfs:comment>The enzyme catalyzes the post-translational protein palmitoylation that plays a role in protein-membrane interactions, protein trafficking, and enzyme activity.</rdfs:comment>
<rdfs:comment>Palmitoylation increases the hydrophobicity of proteins or protein domains and contributes to their membrane association.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8636152"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12681491"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22247542"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22968831"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23482856"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.225#SIP090F7C7FF1D3F564">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hexadecanoyl-CoA + L-cysteinyl-[protein] = CoA + S-hexadecanoyl-L-cysteinyl-[protein].</rdfs:label>
</rdf:Description>
