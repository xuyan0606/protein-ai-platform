<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>guanosine(1516) in 16S rRNA + S-adenosyl-L-methionine = H(+) + N(2)-methylguanosine(1516) in 16S rRNA + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
