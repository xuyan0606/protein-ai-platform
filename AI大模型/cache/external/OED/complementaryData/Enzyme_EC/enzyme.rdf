<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CoA + NADP(+) + sulfoacetaldehyde = H(+) + NADPH + sulfoacetyl-CoA.</rdfs:label>
</rdf:Description>
