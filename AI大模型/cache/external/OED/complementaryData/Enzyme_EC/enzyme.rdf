<skos:altLabel>blood platelet-activating factor acetyltransferase</skos:altLabel>
<skos:altLabel>lyso-GPC:acetyl CoA acetyltransferase</skos:altLabel>
<skos:altLabel>lysoPAF:acetyl CoA acetyltransferase</skos:altLabel>
<skos:altLabel>lyso-platelet activating factor:acetyl-CoA acetyltransferase</skos:altLabel>
<skos:altLabel>lyso-platelet-activating factor:acetyl-CoA acetyltransferase</skos:altLabel>
<skos:altLabel>PAF acetyltransferase</skos:altLabel>
<skos:altLabel>platelet-activating factor acylhydrolase</skos:altLabel>
<skos:altLabel>platelet-activating factor-synthesizing enzyme</skos:altLabel>
<activity rdf:resource="2.3.1.67#SIP3D524A238389C914"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7430122"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.67#SIP3D524A238389C914">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-O-alkyl-sn-glycero-3-phosphocholine + acetyl-CoA = a 1-O-alkyl-2-acetyl-sn-glycero-3-phosphocholine + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7430122">
