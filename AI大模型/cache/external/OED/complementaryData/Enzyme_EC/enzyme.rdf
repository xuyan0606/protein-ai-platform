<rdfs:label>beta-D-mannosylphosphodecaprenol + (1->6)-alpha-D-mannosyloligosaccharide = decaprenol phosphate + (1->6)-alpha-D-mannosyl-(1->6)-alpha-D-mannosyl-oligosaccharide.</rdfs:label>
</rdf:Description>
