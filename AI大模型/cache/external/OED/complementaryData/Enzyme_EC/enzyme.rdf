<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R)-O-phospho-3-sulfolactate = H(+) + phosphoenolpyruvate + sulfite.</rdfs:label>
</rdf:Description>
