<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.116#SIP50A8E1BE801C8EF8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-ureidoglycolate + 2 H(+) + H2O = CO2 + glyoxylate + 2 NH4(+).</rdfs:label>
</rdf:Description>
