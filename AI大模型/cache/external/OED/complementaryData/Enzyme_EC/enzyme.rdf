</rdf:Description>
<rdf:Description rdf:about="2.3.1.285">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(13S,14R)-1,13-dihydroxy-N-methylcanadine 13-O-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.285#SIP2D7BFC1281322870"/>
<rdfs:comment>The enzyme, characterized from the plant Papaver somniferum (opium poppy), participates in the biosynthesis of the isoquinoline alkaloid noscapine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25485687"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29610307"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.285#SIP2D7BFC1281322870">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(13S,14R)-1,13-dihydroxy-N-methylcanadine + acetyl-CoA = (13S,14R)-13-O-acetyl-1-hydroxy-N-methylcanadine + CoA.</rdfs:label>
</rdf:Description>
