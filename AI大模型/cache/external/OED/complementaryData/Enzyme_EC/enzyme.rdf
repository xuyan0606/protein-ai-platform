<skos:prefLabel>peptidylamidoglycolate lyase</skos:prefLabel>
<skos:altLabel>alpha-hydroxyglycine amidating dealkylase</skos:altLabel>
<activity rdf:resource="4.3.2.5#SIPF051F81DD6B01E91"/>
<rdfs:comment>Acts on the product of the reaction catalyzed by EC 1.14.17.3, thus removing a terminal glycine residue and leaving a des-glycine peptide amide.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2207061"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9405058"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.5#SIPF051F81DD6B01E91">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a [peptide]-C-terminal (2S)-2-hydroxyglycine = a [peptide]-C-terminal amide + glyoxylate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2207061">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2207061"/>
