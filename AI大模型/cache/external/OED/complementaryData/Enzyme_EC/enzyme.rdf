<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O + rifampicin = 21-phosphorifampicin + AMP + 2 H(+) + phosphate.</rdfs:label>
</rdf:Description>
