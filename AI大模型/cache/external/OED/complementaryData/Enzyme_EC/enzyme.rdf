<rdf:Description rdf:about="1.14.14.74">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>albendazole monooxygenase (hydroxylating)</skos:prefLabel>
<skos:altLabel>CYP2J2</skos:altLabel>
<activity rdf:resource="1.14.14.74#SIPB03361FA1ABDC892"/>
<rdfs:comment>CYP2J2 is a microsomal cytochrome P450 monooxygenase that catalyzes the hydroxylation of the terminal carbon of the propylsulfanyl chain in albendazole, a broad-spectrum anthelmintic used against gastrointestinal nematodes and the larval stages of cestodes. cf. EC 1.14.14.73.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23959307"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.74#SIPB03361FA1ABDC892">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>albendazole + O2 + reduced [NADPH--hemoprotein reductase] = H(+) + H2O + hydroxyalbendazole + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23959307">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23959307"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23959307"/>
<dcterms:identifier>doi:10.1128/aac.00843-13</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>fenbendazole monooxygenase (4'-hydroxylating)</skos:prefLabel>
<skos:altLabel>CYP2C19</skos:altLabel>
<activity rdf:resource="1.14.14.75#SIP557109E78ADF39C0"/>
<rdfs:comment>CYP2C19 is microsomal cytochrome P450 monooxygenase that catalyzes the hydroxylation of the benzene ring of fenbendazole, a broad-spectrum anthelmintic used against gastrointestinal nematodes and the larval stages of cestodes.</rdfs:comment>
<rdfs:comment>This activity is also carried out by CYP2J2. cf. EC 1.14.14.74.</rdfs:comment>
<rdfs:comment>CYP2C19 does not act on albendazole.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23959307"/>
