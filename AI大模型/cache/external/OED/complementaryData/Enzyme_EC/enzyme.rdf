<rdf:Description rdf:about="2.4.1.153">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-N-acetylglucosamine--dolichyl-phosphate N-acetylglucosaminyltransferase</skos:prefLabel>
<skos:altLabel>dolichyl-phosphate acetylglucosaminyltransferase</skos:altLabel>
<skos:altLabel>dolichyl-phosphate alpha-N-acetylglucosaminyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.153#SIP05992B332E40D625"/>
<rdfs:comment>The enzyme, characterized from the methanogenic archaeon Methanococcus voltae, initiates N-linked glycosylation in that organism.</rdfs:comment>
<rdfs:comment>The enzyme differs from the eukaryotic enzyme, which leaves one additional phosphate group on the dolichyl product (cf. EC 2.7.8.15).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23624439"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.153#SIP05992B332E40D625">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a dolichyl phosphate + UDP-N-acetyl-alpha-D-glucosamine = a dolichyl N-acetyl-alpha-D-glucosaminyl phosphate + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23624439">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23624439"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23624439"/>
</rdf:Description>
