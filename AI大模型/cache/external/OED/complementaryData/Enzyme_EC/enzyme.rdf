<skos:altLabel>thermomycolase</skos:altLabel>
<activity rdf:resource="3.4.21.65#SIPEC05D947CEE4FD09"/>
<rdfs:comment>From the thermophilic fungus Malbranchea pulchella var. sulfurea.</rdfs:comment>
<rdfs:comment>Contains Cys, but not inhibited by p-mercuribenzoate.</rdfs:comment>
<rdfs:comment>Very thermostable.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family S8.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1012007"/>
