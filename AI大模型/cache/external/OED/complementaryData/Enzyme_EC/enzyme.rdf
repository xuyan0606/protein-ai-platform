<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18358835"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18358835"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20400946">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/20400946"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/20400946"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.7.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.3.99.15"/>
<skos:prefLabel>benzoyl-CoA reductase</skos:prefLabel>
<activity rdf:resource="1.3.7.8#SIP984913F977398F46"/>
<activity rdf:resource="1.3.7.8#SIPDC065B7CFE01DEFB"/>
<rdfs:comment>Inactive toward aromatic acids that are not CoA esters but will also catalyze the reaction: NH3 + acceptor + 2 ADP + 2 phosphate = hydroxylamine + reduced acceptor + 2 ATP + H2O.</rdfs:comment>
<rdfs:comment>In the presence of reduced acceptor, but in the absence of oxidizable substrate, the enzyme catalyzes the hydrolysis of ATP to ADP plus phosphate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8575453"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20578740"/>
<rdfs:subClassOf rdf:resource="1.3.7.-"/>
<skos:broaderTransitive rdf:resource="1.3.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.7.8#SIP984913F977398F46">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 ADP + cyclohexa-1,5-diene-1-carbonyl-CoA + oxidized 2[4Fe-4S]-[ferredoxin] + 2 phosphate = 2 ATP + benzoyl-CoA + 2 H2O + reduced 2[4Fe-4S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.7.8#SIPDC065B7CFE01DEFB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + 2 ADP + H(+) + NH4(+) + 2 phosphate = AH2 + 2 ATP + H2O + hydroxylamine.</rdfs:label>
</rdf:Description>
