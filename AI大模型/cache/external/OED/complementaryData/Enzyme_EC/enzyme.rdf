<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/25677302"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.3.37">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>mannuronan 5-epimerase</skos:prefLabel>
<skos:altLabel>alginate epimerase</skos:altLabel>
<skos:altLabel>C(5)-mannuronan epimerase</skos:altLabel>
<skos:altLabel>mannuronan C-5-epimerase</skos:altLabel>
<activity rdf:resource="5.1.3.37#SIPB1911052CD89A745"/>
<rdfs:comment>The enzyme epimerizes the C-5 bond in some beta-D-mannuronate residues in mannuronan, converting them to alpha-L-guluronate residues, and thus modifying the mannuronan into alginate.</rdfs:comment>
<rdfs:comment>It is found in brown algae and alginate-producing bacterial species from the Pseudomonas and Azotobacter genera.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8144447"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11707327"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12581364"/>
