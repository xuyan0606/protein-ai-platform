<skos:prefLabel>aminodeoxyfutalosine deaminase</skos:prefLabel>
<skos:altLabel>AFL deaminase</skos:altLabel>
<skos:altLabel>aminofutalosine deaminase</skos:altLabel>
<activity rdf:resource="3.5.4.40#SIPFD1BF22ACDC95A88"/>
<rdfs:comment>The enzyme, found in several bacterial species, is part of the futalosine pathway for menaquinone biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21098241"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23972005"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
