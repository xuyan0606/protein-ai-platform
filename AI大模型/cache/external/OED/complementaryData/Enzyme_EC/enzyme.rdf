<rdf:Description rdf:about="1.7.3.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylindoxyl oxidase</skos:prefLabel>
<activity rdf:resource="1.7.3.2#SIP81748A7ED39E01CF"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13159343"/>
<rdfs:subClassOf rdf:resource="1.7.3.-"/>
<skos:broaderTransitive rdf:resource="1.7.3.-"/>
</rdf:Description>
