<rdf:Description rdf:about="1.14.19.78">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>decanoyl-[acyl-carrier protein] acetylenase</skos:prefLabel>
<activity rdf:resource="1.14.19.78#SIP97C9EBF08C0C5C09"/>
<rdfs:comment>The enzyme, characterized from the bacterium Teredinibacter turnerae, is specific for decanoyl-[acyl-carrier protein].</rdfs:comment>
<rdfs:comment>Activity is maximal when decanoate is loaded onto a dedicated acyl-carrier protein (TtuC), which is encoded by a gene in the same operon.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26441143"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.78#SIP97C9EBF08C0C5C09">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>decanoyl-[ACP] + 4 H(+) + 2 O2 + 4 reduced [2Fe-2S]-[ferredoxin] = dec-9-ynoyl-[ACP] + 4 H2O + 4 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
