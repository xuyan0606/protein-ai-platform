<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ecdysone + hexadecanoyl-CoA = CoA + ecdysone hexadecanoate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.140">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>rosmarinate synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.140#SIP2411C9703F269C1D"/>
<rdfs:comment>Involved with EC 1.1.1.237 in the biosynthesis of rosmarinic acid.</rdfs:comment>
<rdfs:comment>Characterized from the plant Melissa officinalis L. (lemon balm).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21354582"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.140#SIP2411C9703F269C1D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R)-3-(3,4-dihydroxyphenyl)lactate + (E)-caffeoyl-CoA = (R)-rosmarinate + CoA.</rdfs:label>
</rdf:Description>
