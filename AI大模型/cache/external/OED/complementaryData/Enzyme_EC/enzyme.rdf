<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 L-glutamate + NADP(+) = 2-oxoglutarate + H(+) + L-glutamine + NADPH.</rdfs:label>
</rdf:Description>
