<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lactate racemase</skos:prefLabel>
<skos:altLabel>hydroxyacid racemase</skos:altLabel>
<skos:altLabel>lactic acid racemase</skos:altLabel>
<skos:altLabel>lacticoracemase</skos:altLabel>
<activity rdf:resource="5.1.2.1#SIP2F5A3FB562FF3BB4"/>
<rdfs:comment>The enzyme has been characterized from the bacterium Lactobacillus plantarum and appears to be restricted to lactic acid bacteria.</rdfs:comment>
<rdfs:comment>It contains a unique nickel-containing cofactor, pyridinium-3-thioamide-5-thiocarboxylate mononucleotide Ni pincer complex.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14800428"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16166538"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24710389"/>
