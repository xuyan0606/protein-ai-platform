<rdf:Description rdf:about="3.2.2.29">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thymine-DNA glycosylase</skos:prefLabel>
<skos:altLabel>mismatch-specific thymine-DNA glycosylase</skos:altLabel>
<skos:altLabel>mismatch-specific thymine-DNA N-glycosylase</skos:altLabel>
<skos:altLabel>TDG</skos:altLabel>
<skos:altLabel>thymine DNA glycosylase</skos:altLabel>
<skos:altLabel>uracil/thymine DNA glycosylase</skos:altLabel>
<activity rdf:resource="3.2.2.29#SIP0CCDDA909847A2FF"/>
<rdfs:comment>Thymine-DNA glycosylase is part of the DNA-repair machinery.</rdfs:comment>
<rdfs:comment>Thymine removal is fastest when it is from a G/T mismatch with a 5'-flanking C/G pair.</rdfs:comment>
<rdfs:comment>The glycosylase removes uracil from G/U, C/U, and T/U base pairs faster than it removes thymine from G/T.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8407958"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9685338"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10767625"/>
<rdfs:subClassOf rdf:resource="3.2.2.-"/>
<skos:broaderTransitive rdf:resource="3.2.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.2.29#SIP0CCDDA909847A2FF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolyzes mismatched double-stranded DNA and polynucleotides, releasing free thymine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8407958">
