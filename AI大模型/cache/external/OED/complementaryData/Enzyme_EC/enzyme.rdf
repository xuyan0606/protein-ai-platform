<skos:altLabel>codeine O-demethylase</skos:altLabel>
<activity rdf:resource="1.14.11.32#SIP836DD1213308CDDD"/>
<activity rdf:resource="1.14.11.32#SIP42738939968CBBB2"/>
<rdfs:comment>Requires Fe(2+).</rdfs:comment>
<rdfs:comment>Catalyzes a step in morphine biosynthesis.</rdfs:comment>
<rdfs:comment>The enzyme also catalyzes the 3-O-demethylation of thebaine to oripavine, with lower efficiency.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20228795"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
