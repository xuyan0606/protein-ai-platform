<rdf:Description rdf:about="1.4.2.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nicotine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.4.2.2#SIP5788F44734E408FF"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudomonas putida S16, contains an FAD cofactor and belongs to the flavin-containing amine oxidase family.</rdfs:comment>
<rdfs:comment>The enzyme from this bacterium is specific for the c-type cytochrome CycN.</rdfs:comment>
<rdfs:comment>The product undergoes spontaneous hydrolysis to form pseudooxynicotine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24204321"/>
<citation rdf:resource="http://purl.uniprot.org/citations/33432238"/>
<rdfs:subClassOf rdf:resource="1.4.2.-"/>
<skos:broaderTransitive rdf:resource="1.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.2.2#SIP5788F44734E408FF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-nicotine + 2 Fe(III)-[cytochrome c] = 2 Fe(II)-[cytochrome c] + 2 H(+) + N-methylmyosmine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24204321">
