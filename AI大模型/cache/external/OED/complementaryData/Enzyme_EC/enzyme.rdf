<rdf:Description rdf:about="2.6.1.120">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-alanine--2-oxoglutarate transaminase</skos:prefLabel>
<activity rdf:resource="2.6.1.120#SIPC4256707DE0F85EF"/>
<rdfs:comment>The enzyme, found in many Gram-positive bacteria, participates in the reductive degradation of pyrimidines.</rdfs:comment>
<rdfs:comment>In eukaryotes this activity is catalyzed by EC 2.6.1.19.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3085724"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31455636"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.120#SIPC4256707DE0F85EF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + beta-alanine = 3-oxopropanoate + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3085724">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
