</rdf:Description>
<rdf:Description rdf:about="1.3.1.86">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>crotonyl-CoA reductase</skos:prefLabel>
<skos:altLabel>3-hydroxyacyl CoA reductase</skos:altLabel>
<skos:altLabel>butyryl-CoA dehydrogenase</skos:altLabel>
<skos:altLabel>enoyl-coenzyme A reductase</skos:altLabel>
