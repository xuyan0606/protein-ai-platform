</rdf:Description>
<rdf:Description rdf:about="2.3.1.203">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-N-acetylbacillosamine N-acetyltransferase</skos:prefLabel>
<skos:altLabel>UDP-4-amino-4,6-dideoxy-N-acetyl-alpha-D-glucosamine N-acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.203#SIP7B849DF860328E82"/>
<rdfs:comment>The product, UDP-N,N'-diacetylbacillosamine, is an intermediate in protein glycosylation pathways in several bacterial species, including N-linked glycosylation of certain L-asparagine residues in Campylobacter species and O-linked glycosylation of certain L-serine residues in Neisseria species.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17087520"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18198901"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21542610"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.203#SIP7B849DF860328E82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + UDP-N-acetylbacillosamine = CoA + H(+) + UDP-N,N'-diacetylbacillosamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17087520">
