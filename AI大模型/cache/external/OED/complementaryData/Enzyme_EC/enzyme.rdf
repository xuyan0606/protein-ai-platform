<rdf:Description rdf:about="1.3.1.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>Botryococcus squalene synthase</skos:prefLabel>
<activity rdf:resource="1.3.1.96#SIPF27682A65FF090A6"/>
<rdfs:comment>Isolated from the green alga Botryococcus braunii BOT22.</rdfs:comment>
<rdfs:comment>Acts in the reverse direction. cf. EC 2.5.1.21, where squalene is formed directly from farnesyl diphosphate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21746901"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
