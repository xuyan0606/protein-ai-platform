<citation rdf:resource="http://purl.uniprot.org/citations/16481164"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16531499"/>
<rdfs:subClassOf rdf:resource="4.3.3.-"/>
<skos:broaderTransitive rdf:resource="4.3.3.-"/>
</rdf:Description>
