<citation rdf:resource="http://purl.uniprot.org/citations/7845206"/>
<rdfs:subClassOf rdf:resource="3.4.21.-"/>
<skos:broaderTransitive rdf:resource="3.4.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.93#SIP8369D0E55D6186D6">
