<rdfs:comment>A similar enzyme utilizes GDP-glucose (cf. EC 2.4.1.29).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/13549448"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
