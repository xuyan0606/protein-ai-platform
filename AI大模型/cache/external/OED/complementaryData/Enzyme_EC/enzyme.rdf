<rdf:Description rdf:about="2.7.4.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ribose 1,5-bisphosphate phosphokinase</skos:prefLabel>
<skos:altLabel>ribose 1,5-bisphosphokinase</skos:altLabel>
<activity rdf:resource="2.7.4.23#SIPB2C418FDD91BA2DA"/>
<rdfs:comment>This enzyme, found in NAD suppression mutants of Escherichia coli, synthesizes 5-phospho-alpha-D-ribose 1-diphosphate (PRPP) without the participation of EC 2.7.6.1.</rdfs:comment>
<rdfs:comment>Ribose, ribose 1-phosphate and ribose 5-phosphate are not substrates, and GTP cannot act as a phosphate donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12700258"/>
<rdfs:subClassOf rdf:resource="2.7.4.-"/>
<skos:broaderTransitive rdf:resource="2.7.4.-"/>
</rdf:Description>
