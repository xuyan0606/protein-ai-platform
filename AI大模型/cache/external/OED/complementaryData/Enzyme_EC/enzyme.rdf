<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(indol-3-yl)acetate + ATP + CoA = (indol-3-yl)acetyl-CoA + AMP + diphosphate.</rdfs:label>
</rdf:Description>
