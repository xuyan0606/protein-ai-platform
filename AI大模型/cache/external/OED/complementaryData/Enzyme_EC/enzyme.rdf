<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>anthranilate + 2 ATP + L-phenylalanine + S-adenosyl-L-methionine = 2 AMP + cyclopeptine + 2 diphosphate + 2 H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
