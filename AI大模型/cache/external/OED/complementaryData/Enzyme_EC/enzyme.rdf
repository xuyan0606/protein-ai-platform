<skos:prefLabel>hydroxyacid-oxoacid transhydrogenase</skos:prefLabel>
<activity rdf:resource="1.1.99.24#SIP53E21A83CA1702A0"/>
<activity rdf:resource="1.1.99.24#SIP6094D223480F5AA9"/>
