<rdf:Description rdf:about="3.6.1.45">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-sugar diphosphatase</skos:prefLabel>
<skos:altLabel>nucleosidediphosphate-sugar diphosphatase</skos:altLabel>
<skos:altLabel>nucleosidediphosphate-sugar pyrophosphatase</skos:altLabel>
<skos:altLabel>UDP-sugar hydrolase</skos:altLabel>
<skos:altLabel>UDP-sugar pyrophosphatase</skos:altLabel>
<activity rdf:resource="3.6.1.45#SIP5752EAAC562C62D1"/>
<rdfs:comment>UDP-sugar is the best substrate, although other nucleoside-sugar diphosphates are used as substrates with similar Km values but much lower maximum velocities.</rdfs:comment>
<rdfs:comment>Thus, this enzyme has a specificity distinct from that of EC 3.6.1.21.</rdfs:comment>
<rdfs:comment>Some but not all enzymes of this class also appear to have EC 3.1.3.5 activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2548058"/>
<rdfs:subClassOf rdf:resource="3.6.1.-"/>
<skos:broaderTransitive rdf:resource="3.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.45#SIP5752EAAC562C62D1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>UDP-sugar + H2O = UMP + alpha-D-aldose 1-phosphate.</rdfs:label>
</rdf:Description>
