<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-3-O-(beta-D-glucopyranosyl)-sn-glycerol = a 1,2-diacyl-3-O-(beta-D-galactosyl)-sn-glycerol.</rdfs:label>
</rdf:Description>
