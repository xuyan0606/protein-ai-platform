<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-2-ureidoglycine + carbamoyl phosphate = allantoate + H(+) + phosphate.</rdfs:label>
</rdf:Description>
