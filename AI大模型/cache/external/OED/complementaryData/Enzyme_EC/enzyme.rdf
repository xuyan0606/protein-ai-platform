<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + chloride + H(+) + hapalindole U + O2 = CO2 + H2O + hapalindole G + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.14#SIPDB81FFFF04FA1CAB">
