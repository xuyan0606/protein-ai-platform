<rdf:Description rdf:about="1.14.14.34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methanesulfonate monooxygenase (FMNH2)</skos:prefLabel>
<activity rdf:resource="1.14.14.34#SIP89DC68A07DC5FF99"/>
<rdfs:comment>The enzyme, characterized from Pseudomonas strains, allows the organisms to utilize methanesulfonate as their sulfur source.</rdfs:comment>
<rdfs:comment>It acts in combination with a dedicated NADH-dependent FMN reductase (EC 1.5.1.42), which provides it with reduced FMN. cf. EC 1.14.13.111.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10049377"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12835925"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.34#SIP89DC68A07DC5FF99">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + methanesulfonate + O2 = FMN + formaldehyde + 2 H(+) + H2O + sulfite.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10049377">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
