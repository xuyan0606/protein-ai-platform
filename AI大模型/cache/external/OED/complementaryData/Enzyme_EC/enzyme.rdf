<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-dihydromenaquinone-9 + 2 H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] = H2O + omega-hydroxy-beta-dihydromenaquinone-9 + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
