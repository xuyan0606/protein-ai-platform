<replaces rdf:resource="1.2.2.3"/>
<skos:prefLabel>formate dehydrogenase (cytochrome c-553)</skos:prefLabel>
<activity rdf:resource="1.17.2.3#SIP75A53152FA74F7D4"/>
<rdfs:comment>The enzyme has been characterized from the bacterium Desulfovibrio vulgaris.</rdfs:comment>
<rdfs:comment>In vitro, yeast cytochrome c, ferricyanide and phenazine methosulfate can act as acceptors.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/226135"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4982127"/>
<rdfs:subClassOf rdf:resource="1.17.2.-"/>
<skos:broaderTransitive rdf:resource="1.17.2.-"/>
</rdf:Description>
