<rdf:Description rdf:about="1.14.19.63">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.21.8"/>
<skos:prefLabel>pseudobaptigenin synthase</skos:prefLabel>
<activity rdf:resource="1.14.19.63#SIP5554554CC2240544"/>
<activity rdf:resource="1.14.19.63#SIP290563784D455DE8"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) enzyme catalyzing an oxidative reaction that does not incorporate oxygen into the product.</rdfs:comment>
<rdfs:comment>Catalyzes a step in the biosynthesis of (-)-maackiain, the main pterocarpan phytoalexin in chickpea (Cicer arietinum).</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.63#SIP5554554CC2240544">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>calycosin + O2 + reduced [NADPH--hemoprotein reductase] = H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase] + pseudobaptigenin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.63#SIP290563784D455DE8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O2 + pratensein + reduced [NADPH--hemoprotein reductase] = 5-hydroxypseudobaptigenin + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.64">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.1.3.32"/>
