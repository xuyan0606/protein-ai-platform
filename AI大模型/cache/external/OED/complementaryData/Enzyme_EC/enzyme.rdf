<skos:altLabel>6-deoxy-6-sulfo-erythrulose transketolase</skos:altLabel>
<activity rdf:resource="2.2.1.15#SIP55E4BB97510ED1B1"/>
<activity rdf:resource="2.2.1.15#SIPF0AEEE95B62CF2B3"/>
<rdfs:comment>The enzyme, characterized from the bacterium Clostridium sp. MSTE9, is involved in a D-sulfoquinovose degradation pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/SIPA92E437F3CD7880E"/>
<rdfs:subClassOf rdf:resource="2.2.1.-"/>
