<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CO + H2O + 2 oxidized [2Fe-2S]-[ferredoxin] = CO2 + 2 H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
