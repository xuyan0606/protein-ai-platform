<citation rdf:resource="http://purl.uniprot.org/citations/11500043"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12063249"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12443044"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15155751"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16336265"/>
<rdfs:subClassOf rdf:resource="4.2.2.-"/>
<skos:broaderTransitive rdf:resource="4.2.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.2.19#SIP6A3E529047030AAB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Eliminative cleavage of dermatan sulfate containing (1->4)-beta-D-hexosaminyl and (1->3)-beta-D-glucurosonyl or (1->3)-alpha-L-iduronosyl linkages to disaccharides containing 4-deoxy-beta-D-gluc-4-enuronosyl groups to yield a 4,5-unsaturated dermatan-sulfate disaccharide (DeltaUA-GalNAc-4S).</rdfs:label>
</rdf:Description>
