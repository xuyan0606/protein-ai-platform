<rdfs:label>2 a plastoquinone + 2 H2O + 4 hnu = 2 a plastoquinol + O2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.10.3.9#SIPADE758644915F28E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H2O + 4 hnu + 2 plastoquinone-9 = O2 + 2 plastoquinol-9.</rdfs:label>
</rdf:Description>
