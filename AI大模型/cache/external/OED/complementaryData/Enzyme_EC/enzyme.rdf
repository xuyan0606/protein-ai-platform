<rdf:Description rdf:about="5.1.3.24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="5.1.3.n1"/>
<skos:prefLabel>N-acetylneuraminate epimerase</skos:prefLabel>
<skos:altLabel>alpha-N-acetylneuraminic acid epimerase</skos:altLabel>
<skos:altLabel>sialic acid epimerase</skos:altLabel>
<skos:altLabel>sialic acid mutarotase</skos:altLabel>
<activity rdf:resource="5.1.3.24#SIP02BBF7A677595938"/>
<rdfs:comment>Sialoglycoconjugates present in vertebrates are linked exclusively by alpha-linkages and are released in alpha form during degradation.</rdfs:comment>
<rdfs:comment>This enzyme accelerates maturotation to the beta form via the open form (which also occurs as a slow spontaneous reaction).</rdfs:comment>
<rdfs:comment>The open form is necessary for further metabolism by the bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18063573"/>
<citation rdf:resource="http://purl.uniprot.org/citations/33895133"/>
<rdfs:subClassOf rdf:resource="5.1.3.-"/>
<skos:broaderTransitive rdf:resource="5.1.3.-"/>
</rdf:Description>
