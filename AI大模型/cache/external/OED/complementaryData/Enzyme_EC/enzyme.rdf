<rdf:Description rdf:about="2.6.1.94">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2'-deamino-2'-hydroxyneamine transaminase</skos:prefLabel>
<activity rdf:resource="2.6.1.94#SIP5EDC2482BB4BD8C5"/>
<rdfs:comment>The reaction occurs in vivo in the opposite direction.</rdfs:comment>
<rdfs:comment>Involved in the biosynthetic pathway of kanamycin A and kanamycin D.</rdfs:comment>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces kanamyceticus, can also catalyze EC 2.6.1.93.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21983602"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.94#SIP5EDC2482BB4BD8C5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2'-deamino-2'-hydroxyneamine + 2-oxoglutarate = 2'-deamino-2'-hydroxy-6'-dehydroparomamine + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21983602">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21983602"/>
