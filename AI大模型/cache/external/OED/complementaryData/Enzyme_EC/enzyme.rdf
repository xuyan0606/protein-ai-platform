<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/28809486"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28809486"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.357">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phlorizin synthase</skos:prefLabel>
<activity rdf:resource="2.4.1.357#SIPF63053B0B8E6C495"/>
<rdfs:comment>Isolated from Malus X domestica (apple).</rdfs:comment>
<rdfs:comment>Phlorizin inhibits sodium-linked glucose transporters.</rdfs:comment>
<rdfs:comment>It gives the characteristic flavor of apples and cider.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18573104"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27316677"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.357#SIPF63053B0B8E6C495">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>phloretin + UDP-alpha-D-glucose = H(+) + phlorizin + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18573104">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18573104"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18573104"/>
</rdf:Description>
