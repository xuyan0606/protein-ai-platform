<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an N(6)-alkylaminopurine + UDP-alpha-D-glucose = an N(6)-alkylamino-7-beta-D-glucosylpurine + H(+) + UDP.</rdfs:label>
</rdf:Description>
