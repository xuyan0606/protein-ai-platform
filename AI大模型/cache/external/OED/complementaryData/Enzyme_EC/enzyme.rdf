<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4 H(+) + 5 malonyl-CoA = 5,7-dihydroxy-2-methyl-4H-chromen-4-one + 5 CO2 + 5 CoA + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15686354">
