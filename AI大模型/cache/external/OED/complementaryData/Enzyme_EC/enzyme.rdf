<rdf:Description rdf:about="2.5.1.98">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>Rhizobium leguminosarum exopolysaccharide glucosyl ketal-pyruvate-transferase</skos:prefLabel>
<activity rdf:resource="2.5.1.98#SIP37E5CC0ADCCE3E12"/>
<rdfs:comment>The enzyme is responsible for pyruvylation of subterminal glucose in the acidic octasaccharide repeating unit of the exopolysaccharide of Rhizobium leguminosarum (bv. viciae strain VF39) which is necessary to establish nitrogen-fixing symbiosis with Pisum sativum, Vicia faba, and Vicia sativa.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20233262"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.98#SIP37E5CC0ADCCE3E12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
