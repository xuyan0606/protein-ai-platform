<rdf:Description rdf:about="2.5.1.102">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>geranylpyrophosphate--olivetolic acid geranyltransferase</skos:prefLabel>
<activity rdf:resource="2.5.1.102#SIP0580A16CF0736694"/>
<rdfs:comment>Part of the cannabinoids biosynthetic pathway of the plant Cannabis sativa.</rdfs:comment>
<rdfs:comment>The enzyme can also use neryl diphosphate as substrate, forming cannabinerolate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9607329"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.102#SIP0580A16CF0736694">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E)-geranyl diphosphate + olivetolate = cannabigerolate + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9607329">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9607329"/>
