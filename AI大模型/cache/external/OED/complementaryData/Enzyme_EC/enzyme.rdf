<rdf:Description rdf:about="1.3.1.121">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-amino-4-deoxyprephenate dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.3.1.121#SIP8851C68328333778"/>
<rdfs:comment>The enzyme, characterized from the bacteria Streptomyces venezuelae and Streptomyces pristinaespiralis, participates in the biosynthesis of the antibiotics chloramphenicol and pristinamycin IA, respectively. cf. EC 1.3.1.12.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9044253"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11577160"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.121#SIP8851C68328333778">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-amino-4-deoxyprephenate + NAD(+) = 3-(4-aminophenyl)pyruvate + CO2 + H(+) + NADH.</rdfs:label>
</rdf:Description>
