<rdf:Description rdf:about="2.3.1.141">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>galactosylacylglycerol O-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.141#SIP06948BE9517EB731"/>
<rdfs:comment>Transfers long-chain acyl groups to the sn-1 position of the glycerol residues.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3143419"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.141#SIP06948BE9517EB731">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-acyl-3-O-(beta-D-galactosyl)-sn-glycerol + a fatty acyl-[ACP] = a 1,2-diacyl-3-O-(beta-D-galactosyl)-sn-glycerol + holo-[ACP].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3143419">
