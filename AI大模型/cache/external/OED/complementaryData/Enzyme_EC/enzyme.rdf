<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + D-arginine + H2O = 5-guanidino-2-oxopentanoate + AH2 + NH4(+).</rdfs:label>
</rdf:Description>
