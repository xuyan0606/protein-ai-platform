<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>benzylsuccinate synthase</skos:prefLabel>
<activity rdf:resource="4.1.99.11#SIP29A52CC8BD55FFD5"/>
<rdfs:comment>A glycyl radical enzyme that is inhibited by benzyl alcohol, benzaldehyde, phenylhydrazine and is inactivated by oxygen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9632263"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9765580"/>
