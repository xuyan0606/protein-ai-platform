<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-deoxy-D-glycero-beta-D-galacto-non-2-ulopyranosonate 9-phosphate + H2O = 3-deoxy-D-glycero-beta-D-galacto-non-2-ulopyranosonate + phosphate.</rdfs:label>
</rdf:Description>
