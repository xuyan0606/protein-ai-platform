<skos:altLabel>phytoene desaturase</skos:altLabel>
<activity rdf:resource="1.3.99.26#SIP18198D44CCD06741"/>
<rdfs:comment>This enzyme is involved in carotenoid biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17662111"/>
