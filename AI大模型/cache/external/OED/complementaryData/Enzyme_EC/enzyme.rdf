<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thioredoxin]-disulfide + dADP + H2O = [thioredoxin]-dithiol + ADP.</rdfs:label>
</rdf:Description>
