<skos:prefLabel>valine dehydrogenase (NAD(+))</skos:prefLabel>
<activity rdf:resource="1.4.1.23#SIPB60880139A0A4EA3"/>
<rdfs:comment>The enzyme from Streptomyces spp. has no activity with NADP(+) (cf. EC 1.4.1.8).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2324704"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3182727"/>
