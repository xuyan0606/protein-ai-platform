<rdf:Description rdf:about="2.4.1.222">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>O-fucosylpeptide 3-beta-N-acetylglucosaminyltransferase</skos:prefLabel>
<skos:altLabel>O-fucosylpeptide beta-1,3-N-acetylglucosaminyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.222#SIP8256D096DC9231EC"/>
<activity rdf:resource="2.4.1.222#SIP2E9260D65F25CCC7"/>
<rdfs:comment>The enzyme, found in animals and plants, is involved in the biosynthesis of the tetrasaccharide alpha-Neu5A-(2->3)-beta-D-Gal-(1->4)-beta-D-GlcNAc-(1->3)-L-alpha-Fuc, which is attached to L-Ser or L-Thr residues within the sequence Cys-Xaa-Xaa-Gly-Gly-Ser/Thr-Cys in EGF-like domains.</rdfs:comment>
<rdfs:comment>The substrate is provided by EC 2.4.1.221.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10935626"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10935637"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16221665"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
