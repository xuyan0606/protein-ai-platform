<skos:prefLabel>(S)-1-phenylethanol dehydrogenase</skos:prefLabel>
<skos:altLabel>PED</skos:altLabel>
<activity rdf:resource="1.1.1.311#SIPFA8BBC8AF7239D02"/>
<rdfs:comment>The enzyme is involved in degradation of ethylbenzene.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11479712"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16388583"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
