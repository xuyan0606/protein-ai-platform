<rdf:Description rdf:about="2.1.1.328">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-demethylindolmycin N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.328#SIP7B099CCFA060EDDB"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces griseus, catalyzes the ultimate reaction in the biosynthesis of indolmycin, an antibacterial drug that inhibits the bacterial EC 6.1.1.2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25730866"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
