<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12835925"/>
<dcterms:identifier>doi:10.1007/s00253-003-1233-7</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dimethylsulfone monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.14.35#SIP303F6FB20B1157E1"/>
<activity rdf:resource="1.14.14.35#SIP3DE8930981D9BCDE"/>
<rdfs:comment>The enzyme, characterized from Pseudomonas spp., is involved in a dimethyl sulfide degradation pathway.</rdfs:comment>
<rdfs:comment>It is dependent on NAD(P)H-dependent FMN reductase (EC 1.5.1.38, 1.5.1.39, or 1.5.1.42), which provides it with reduced FMN.</rdfs:comment>
<rdfs:comment>The product, methanesulfinate, is oxidized spontaneously to methanesulfonate in the presence of dioxygen and FMNH2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15661012"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27392454"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.35#SIP303F6FB20B1157E1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dimethyl sulfone + FMNH2 + O2 = FMN + formaldehyde + 2 H(+) + H2O + methanesulfinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.35#SIP3DE8930981D9BCDE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + methanesulfinate + O2 = FMN + H(+) + H2O + methanesulfonate.</rdfs:label>
</rdf:Description>
