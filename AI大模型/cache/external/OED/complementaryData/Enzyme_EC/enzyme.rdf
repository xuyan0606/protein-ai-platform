<skos:prefLabel>mycodextranase</skos:prefLabel>
<activity rdf:resource="3.2.1.61#SIPCC6A556827CEA088"/>
<rdfs:comment>Products are nigerose and 4-alpha-D-nigerosylglucose.</rdfs:comment>
<rdfs:comment>No hydrolysis of alpha-D-glucans containing only 1,3- or 1,4-bonds.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5652425"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
