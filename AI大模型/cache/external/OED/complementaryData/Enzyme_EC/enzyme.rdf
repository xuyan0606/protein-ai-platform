<rdf:Description rdf:about="1.17.99.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ethylbenzene hydroxylase</skos:prefLabel>
<skos:altLabel>ethylbenzene dehydrogenase</skos:altLabel>
<activity rdf:resource="1.17.99.2#SIP0203BD2AB48D1228"/>
<rdfs:comment>Involved in the anaerobic catabolism of ethylbenzene by denitrifying bacteria.</rdfs:comment>
<rdfs:comment>Ethylbenzene is the preferred substrate; the enzyme from some strains oxidizes propylbenzene, 1-ethyl-4-fluorobenzene, 3-methylpent-2-ene and ethylidenecyclohexane.</rdfs:comment>
<rdfs:comment>Toluene is not oxidized.</rdfs:comment>
<rdfs:comment>p-benzoquinone or ferrocenium can act as electron acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11294876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11443088"/>
<rdfs:subClassOf rdf:resource="1.17.99.-"/>
<skos:broaderTransitive rdf:resource="1.17.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.2#SIP0203BD2AB48D1228">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + ethylbenzene + H2O = (S)-1-phenylethanol + AH2.</rdfs:label>
</rdf:Description>
