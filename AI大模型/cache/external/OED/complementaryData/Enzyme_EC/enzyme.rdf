<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GTP + H(+) + valienol 1-phosphate = diphosphate + GDP-valienol.</rdfs:label>
</rdf:Description>
