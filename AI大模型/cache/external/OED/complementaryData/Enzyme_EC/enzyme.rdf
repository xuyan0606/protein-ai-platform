<rdf:Description rdf:about="1.14.99.64">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>zeaxanthin 4-ketolase</skos:prefLabel>
<activity rdf:resource="1.14.99.64#SIP935EE2A25EAA7620"/>
<activity rdf:resource="1.14.99.64#SIP0053A0A2644D15A7"/>
<rdfs:comment>The enzyme has a similar activity to that of EC 1.14.99.63, but unlike that enzyme is able to also act on zeaxanthin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21398427"/>
