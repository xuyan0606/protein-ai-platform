<skos:prefLabel>tyramine--L-glutamate ligase</skos:prefLabel>
<activity rdf:resource="6.3.4.24#SIPE6D8B0E22585737C"/>
<rdfs:comment>The enzyme, which has been characterized from the archaea Methanocaldococcus fervens, participates in the biosynthesis of the cofactor methanofuran.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25211225"/>
<rdfs:subClassOf rdf:resource="6.3.4.-"/>
<skos:broaderTransitive rdf:resource="6.3.4.-"/>
</rdf:Description>
