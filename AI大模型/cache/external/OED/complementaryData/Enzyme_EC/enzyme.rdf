<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + 2 Na(+)(in) + oxaloacetate = CO2 + 2 Na(+)(out) + pyruvate.</rdfs:label>
</rdf:Description>
