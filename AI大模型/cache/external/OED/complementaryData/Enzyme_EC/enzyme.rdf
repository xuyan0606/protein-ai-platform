<rdf:Description rdf:about="2.7.1.232">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>levoglucosan kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.232#SIPDBC1F3A152935851"/>
<rdfs:comment>Levoglucosan is formed from the pyrolysis of carbohydrates such as starch and cellulose and is an important molecular marker for pollution from biomass burning.</rdfs:comment>
<rdfs:comment>The enzyme, found in yeast and fungi, requires a magnesium ion. cf. EC 1.1.1.425.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12356473"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21719279"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26354439"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26433384"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
