</rdf:Description>
<rdf:Description rdf:about="4.2.3.33">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>stemar-13-ene synthase</skos:prefLabel>
<skos:altLabel>stemarene synthase</skos:altLabel>
<skos:altLabel>syn-stemar-13-ene synthase</skos:altLabel>
<activity rdf:resource="4.2.3.33#SIP9F46E1D96B880E21"/>
<rdfs:comment>This diterpene cyclase produces stemar-13-ene, a putative precursor of the rice phytoalexin oryzalexin S.</rdfs:comment>
<rdfs:comment>Phytoalexins are diterpenoid secondary metabolites that are involved in the defense mechanism of the plant, and are produced in response to pathogen attack through the perception of elicitor signal molecules such as chitin oligosaccharide, or after exposure to UV irradiation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8651702"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15280039"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.33#SIP9F46E1D96B880E21">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>9alpha-copalyl diphosphate = diphosphate + stemar-13-ene.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8651702">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8651702"/>
