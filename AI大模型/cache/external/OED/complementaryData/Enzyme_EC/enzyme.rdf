<rdf:Description rdf:about="2.1.1.245">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-methyltetrahydrosarcinapterin:corrinoid/iron-sulfur protein Co-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.245#SIP84ACF0C5936AF330"/>
<rdfs:comment>Catalyzes the transfer of a methyl group from the cobamide cofactor of a corrinoid/Fe-S protein to the N5 group of tetrahydrosarcinapterin.</rdfs:comment>
<rdfs:comment>Forms, together with EC 1.2.7.4 and EC 2.3.1.169 the acetyl-CoA decarbonylase/synthase complex that catalyzes the demethylation of acetyl-CoA in a reaction that also forms CO2.</rdfs:comment>
<rdfs:comment>This reaction is a key step in methanogenesis from acetate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8550451"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8626532"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.245#SIP84ACF0C5936AF330">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,6,7,8-tetrahydrosarcinapterin + methyl-Co(III)-[corrinoid Fe-S protein] = 5-methyltetrahydrosarcinapterin + Co(I)-[corrinoid Fe-S protein] + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8550451">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8550451"/>
