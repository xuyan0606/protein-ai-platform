<rdf:Description rdf:about="2.8.3.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>CoA:oxalate CoA-transferase</skos:prefLabel>
<skos:altLabel>acetyl-CoA oxalate CoA-transferase</skos:altLabel>
<skos:altLabel>acetyl-coenzyme A transferase</skos:altLabel>
<activity rdf:resource="2.8.3.19#SIPECC02DC89916AC56"/>
<rdfs:comment>The enzymes characterized from the bacteria Escherichia coli and Acetobacter aceti can also use formyl-CoA and oxalate (EC 2.8.3.16) or formyl-CoA and acetate, with significantly reduced specific activities.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23935849"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.19#SIPECC02DC89916AC56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + oxalate = acetate + oxalyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23935849">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23935849"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23935849"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>succinyl-CoA--D-citramalate CoA-transferase</skos:prefLabel>
<activity rdf:resource="2.8.3.20#SIP35A880AADF30A6AD"/>
<activity rdf:resource="2.8.3.20#SIP4AAE94C894A19A0B"/>
<rdfs:comment>The enzyme, purified from the bacterium Clostridium tetanomorphum, can also accept itaconate as acceptor, with lower efficiency.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16952935"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.20#SIP35A880AADF30A6AD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R)-citramalate + succinyl-CoA = (3R)-citramalyl-CoA + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.20#SIP4AAE94C894A19A0B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-malate + succinyl-CoA = (R)-malyl-CoA + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16952935">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
