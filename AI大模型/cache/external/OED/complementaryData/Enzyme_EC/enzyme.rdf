</rdf:Description>
<rdf:Description rdf:about="1.5.1.43">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carboxynorspermidine synthase</skos:prefLabel>
<skos:altLabel>carboxynorspermidine dehydrogenase</skos:altLabel>
<skos:altLabel>carboxyspermidine dehydrogenase</skos:altLabel>
<activity rdf:resource="1.5.1.43#SIP2CDBBC9457E469EF"/>
<activity rdf:resource="1.5.1.43#SIP468835B53EA23228"/>
<rdfs:comment>The reaction takes place in the opposite direction.</rdfs:comment>
<rdfs:comment>Part of a bacterial polyamine biosynthesis pathway.</rdfs:comment>
<rdfs:comment>L-aspartate 4-semialdehyde and propane-1,3-diamine/putrescine form a Schiff base that is reduced to form carboxynorspermidine/carboxyspermidine, respectively.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Vibrio cholerae is essential for biofilm formation.</rdfs:comment>
<rdfs:comment>The enzyme from Campylobacter jejuni only produces carboxyspermidine in vivo even though it also can produce carboxynorspermidine in vitro.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1955861"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19196710"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22025614"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.1.43#SIP2CDBBC9457E469EF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carboxynorspermidine + H2O + NADP(+) = H(+) + L-aspartate 4-semialdehyde + NADPH + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.1.43#SIP468835B53EA23228">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carboxyspermidine + H2O + NADP(+) = H(+) + L-aspartate 4-semialdehyde + NADPH + putrescine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1955861">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/1955861"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/1955861"/>
</rdf:Description>
