<rdf:Description rdf:about="2.4.2.44">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>S-methyl-5'-thioinosine phosphorylase</skos:prefLabel>
<skos:altLabel>methylthioinosine phosphorylase</skos:altLabel>
<skos:altLabel>MTI phosphorylase</skos:altLabel>
<activity rdf:resource="2.4.2.44#SIPAF66F271EE674433"/>
<rdfs:comment>No activity with S-methyl-5'-thioadenosine.</rdfs:comment>
<rdfs:comment>The catabolism of of 5'-methylthioadenosine in Pseudomonas aeruginosa involves deamination to S-methyl-5'-thioinosine (EC 3.5.4.31) and phosphorolysis to hypoxanthine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21197954"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.44#SIPAF66F271EE674433">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>phosphate + S-methyl-5'-thioinosine = hypoxanthine + S-methyl-5-thio-alpha-D-ribose 1-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21197954">
