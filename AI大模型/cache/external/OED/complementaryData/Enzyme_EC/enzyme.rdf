<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-hydroxydodecatetraenal 1-aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.115#SIP96061A1B6A1570B7"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces coelicolor A3(2), participates in the biosynthesis of coelimycin P1, where it catalyzes the amination of (2E,5S,6E,8E,10E)-5-hydroxydodeca-2,6,8,10-tetraenal.</rdfs:comment>
<rdfs:comment>L-glutamate can also serve as the amino group donor with lower efficiency.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17009021"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28451186"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.115#SIP96061A1B6A1570B7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,5S,6E,8E,10E)-1-aminododeca-2,6,8,10-tetraen-5-ol + pyruvate = (2E,5S,6E,8E,10E)-5-hydroxydodeca-2,6,8,10-tetraenal + L-alanine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17009021">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17009021"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17009021"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/28451186">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/28451186"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28451186"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>6-aminohexanoate aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.116#SIP0DD3A1CACB0D2A3D"/>
<rdfs:comment>The enzyme, characterized from the bacterium Arthrobacter sp. KI72, participates in the degradation of nylon-6.</rdfs:comment>
<rdfs:comment>Glyoxylate can serve as an alternative amino group acceptor with similar efficiency.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29188330"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.116#SIP0DD3A1CACB0D2A3D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + 6-aminohexanoate = 6-oxohexanoate + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/29188330">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/29188330"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/29188330"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.117">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-glutamine--4-(methylsulfanyl)-2-oxobutanoate aminotransferase</skos:prefLabel>
<activity rdf:resource="2.6.1.117#SIPCFCAAE2E305CFA12"/>
<rdfs:comment>A pyridoxal 5'-phosphate protein.</rdfs:comment>
<rdfs:comment>The enzyme, found in both prokaryotes and eukaryotes, catalyzes the last reaction in a methionine salvage pathway.</rdfs:comment>
<rdfs:comment>In mammals this activity is catalyzed by the multifunctional glutamine transaminase K (cf. EC 2.6.1.64).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12670965"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24837359"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.117#SIPCFCAAE2E305CFA12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-methylsulfanyl-2-oxobutanoate + L-glutamine = 2-oxoglutaramate + L-methionine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12670965">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12670965"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12670965"/>
