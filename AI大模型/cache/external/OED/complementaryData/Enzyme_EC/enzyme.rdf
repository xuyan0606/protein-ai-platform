<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5'-O-phosphonoadenylyl-(3'->5')-adenosine + H2O = 2 AMP + H(+).</rdfs:label>
</rdf:Description>
