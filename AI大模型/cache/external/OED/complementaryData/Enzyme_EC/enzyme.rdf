<skos:prefLabel>thymidylate 5'-phosphatase</skos:prefLabel>
<skos:altLabel>thymidylate 5'-nucleotidase</skos:altLabel>
<activity rdf:resource="3.1.3.35#SIP334A822914924E85"/>
<rdfs:comment>Acts on 5-methyl-dCMP and on TMP, but more slowly than on dTMP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4958986"/>
