<rdf:Description rdf:about="6.3.2.31">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>coenzyme F420-0:L-glutamate ligase</skos:prefLabel>
<activity rdf:resource="6.3.2.31#SIPA75D5699C18229B8"/>
<rdfs:comment>This protein catalyzes the successive addition of two glutamate residues to factor F420 (coenzyme F420) by two distinct and independent reactions.</rdfs:comment>
<rdfs:comment>In the reaction described here the enzyme attaches a glutamate via its alpha-amine group to F420-0.</rdfs:comment>
<rdfs:comment>In the second reaction (EC 6.3.2.34) it catalyzes the addition of a second L-glutamate residue to the gamma-carboxyl of the first glutamate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12911320"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17669425"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
<skos:broaderTransitive rdf:resource="6.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.31#SIPA75D5699C18229B8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GTP + L-glutamate + oxidized coenzyme F420-0 = GDP + H(+) + oxidized coenzyme F420-1 + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12911320">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
