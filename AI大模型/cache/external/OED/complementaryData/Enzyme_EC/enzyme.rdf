<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-galacturonosyl-[(1->2)-alpha-L-rhamnosyl-(1->4)-alpha-D-galacturonosyl](n) + UDP-beta-L-rhamnose = [(1->2)-alpha-L-rhamnosyl-(1->4)-alpha-D-galacturonosyl](n+1) + H(+) + UDP.</rdfs:label>
</rdf:Description>
