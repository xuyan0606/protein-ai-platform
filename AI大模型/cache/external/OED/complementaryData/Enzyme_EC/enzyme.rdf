<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 NADP(+) + tetrahydrocurcumin = curcumin + 2 H(+) + 2 NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.n3#SIP963CB62BE4CDFC62">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADP(+) + tetrahydrocurcumin = dihydrocurcumin + H(+) + NADPH.</rdfs:label>
</rdf:Description>
