<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + citrate + D-ornithine = AMP + diphosphate + H(+) + N(5)-[(S)-citryl]-D-ornithine.</rdfs:label>
</rdf:Description>
