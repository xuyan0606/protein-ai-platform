<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclohexanone + H(+) + NADPH + O2 = H2O + hexano-6-lactone + NADP(+).</rdfs:label>
</rdf:Description>
