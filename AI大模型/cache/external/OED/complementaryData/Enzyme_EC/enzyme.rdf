<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-prolyl-[collagen] + O2 = CO2 + succinate + trans-4-hydroxy-L-prolyl-[collagen].</rdfs:label>
</rdf:Description>
