<rdf:Description rdf:about="1.11.1.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>iodide peroxidase</skos:prefLabel>
<skos:altLabel>iodinase</skos:altLabel>
<skos:altLabel>thyroid peroxidase</skos:altLabel>
<skos:altLabel>thyroperoxidase</skos:altLabel>
<skos:altLabel>TPO</skos:altLabel>
<activity rdf:resource="1.11.1.8#SIP8F34761C79D3C259"/>
<activity rdf:resource="1.11.1.8#SIP4BE640AE9A0EB6CA"/>
<activity rdf:resource="1.11.1.8#SIPE38D646F521EDDD7"/>
<activity rdf:resource="1.11.1.8#SIP8240ADBF77C3EBAC"/>
<activity rdf:resource="1.11.1.8#SIP52292DE1AB2ED187"/>
<rdfs:comment>Thyroid peroxidase catalyzes the biosynthesis of the thyroid hormones L-thyroxine and triiodo-L-thyronine.</rdfs:comment>
<rdfs:comment>It catalyzes both the iodination of tyrosine residues in thyroglobulin (forming mono- and di-iodinated forms) and their coupling to form either L-thyroxine or triiodo-L-thyronine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1497352"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2996435"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6706930"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7021557"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7142155"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8448141"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8651700"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12325367"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13718859"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13964156"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16098474"/>
<rdfs:subClassOf rdf:resource="1.11.1.-"/>
<skos:broaderTransitive rdf:resource="1.11.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.8#SIP8F34761C79D3C259">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + H2O2 + 2 iodide = diiodine + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.8#SIP4BE640AE9A0EB6CA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thyroglobulin]-L-tyrosine + H(+) + H2O2 + iodide = [thyroglobulin]-3-iodo-L-tyrosine + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.8#SIPE38D646F521EDDD7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thyroglobulin]-3-iodo-L-tyrosine + H(+) + H2O2 + iodide = [thyroglobulin]-3,5-diiodo-L-tyrosine + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.8#SIP8240ADBF77C3EBAC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 [thyroglobulin]-3,5-diiodo-L-tyrosine + H2O2 = [thyroglobulin]-dehydroalanine + [thyroglobulin]-L-thyroxine + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.11.1.8#SIP52292DE1AB2ED187">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thyroglobulin]-3,5-diiodo-L-tyrosine + [thyroglobulin]-3-iodo-L-tyrosine + H2O2 = [thyroglobulin]-3,3',5-triiodo-L-thyronine + [thyroglobulin]-dehydroalanine + 2 H2O.</rdfs:label>
</rdf:Description>
