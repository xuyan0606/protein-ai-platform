<rdf:Description rdf:about="1.8.2.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thiocyanate desulfurase</skos:prefLabel>
<skos:altLabel>thiocyanate dehydrogenase</skos:altLabel>
<activity rdf:resource="1.8.2.7#SIP4AFBBC275968260B"/>
<rdfs:comment>The enzyme, characterized from the haloalkaliphilic sulfur-oxidizing bacterium Thioalkalivibrio paradoxus, contains three copper ions in its active site.</rdfs:comment>
<rdfs:comment>It catalyzes the direct conversion of thiocyanate into cyanate and elemental sulfur without involvement of molecular oxygen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/32094184"/>
<rdfs:subClassOf rdf:resource="1.8.2.-"/>
<skos:broaderTransitive rdf:resource="1.8.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.2.7#SIP4AFBBC275968260B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome c] + H2O + thiocyanate = cyanate + 2 Fe(II)-[cytochrome c] + 2 H(+) + sulfur.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/32094184">
