<activity rdf:resource="4.3.99.4#SIPFD78655A75BFB818"/>
<rdfs:comment>The enzyme utilizes a glycine radical to break the C-N bond in choline.</rdfs:comment>
<rdfs:comment>Found in choline-degrading anaerobic bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23151509"/>
<rdfs:subClassOf rdf:resource="4.3.99.-"/>
<skos:broaderTransitive rdf:resource="4.3.99.-"/>
</rdf:Description>
