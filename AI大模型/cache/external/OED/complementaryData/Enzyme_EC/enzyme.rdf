<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7346380"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/7346380"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.79">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>maltose O-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.79#SIPA9AF4ED96BDD10B4"/>
<rdfs:comment>Not identical with EC 2.3.1.18.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1856235"/>
