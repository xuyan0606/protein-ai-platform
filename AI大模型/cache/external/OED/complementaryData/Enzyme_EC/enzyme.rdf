<rdf:Description rdf:about="2.3.1.275">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.3.1.n3"/>
<skos:prefLabel>acyl phosphate:glycerol-3-phosphate acyltransferase</skos:prefLabel>
<skos:altLabel>acyl-phosphate--glycerol-3-phosphate acyltransferase</skos:altLabel>
<skos:altLabel>acyl-PO4 G3P acyltransferase</skos:altLabel>
<skos:altLabel>G3P acyltransferase</skos:altLabel>
<skos:altLabel>glycerol-3-phosphate acyltransferase (acyl-phosphate transferring)</skos:altLabel>
<skos:altLabel>GPAT</skos:altLabel>
<skos:altLabel>LPA synthase</skos:altLabel>
<skos:altLabel>lysophosphatidic acid synthase</skos:altLabel>
<activity rdf:resource="2.3.1.275#SIPE5E8E83A1069CACA"/>
<rdfs:comment>The enzyme, found in bacteria, catalyzes a step in the most widely distributed bacterial pathway for the initiation of phospholipid formation.</rdfs:comment>
<rdfs:comment>The enzyme is membrane-bound.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16949372"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17308305"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17645809"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19282621"/>
