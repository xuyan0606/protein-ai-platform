<rdf:Description rdf:about="2.3.1.142">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycoprotein O-fatty-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.142#SIPD4ED3F00C815A879"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2318887"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.142#SIPD4ED3F00C815A879">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>palmitoyl-CoA + mucus glycoprotein = CoA + O-palmitoylglycoprotein.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2318887">
