<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + codeine + O2 = CO2 + formaldehyde + morphine + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.32#SIP42738939968CBBB2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + O2 + thebaine = CO2 + formaldehyde + oripavine + succinate.</rdfs:label>
</rdf:Description>
