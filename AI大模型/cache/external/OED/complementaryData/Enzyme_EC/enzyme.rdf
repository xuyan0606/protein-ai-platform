<rdf:Description rdf:about="2.7.7.97">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-hydroxy-4-methylanthranilate adenylyltransferase</skos:prefLabel>
<skos:altLabel>4-MHA-activating enzyme</skos:altLabel>
<skos:altLabel>actinomycin synthase I</skos:altLabel>
<activity rdf:resource="2.7.7.97#SIP65A179C4FBF4B937"/>
<rdfs:comment>The enzyme, characterized from the bacteria Streptomyces anulatus and Streptosporangium sibiricum, activates 3-hydroxy-4-methylanthranilate, a precursor of actinomycin antibiotics and the antitumor antibiotic sibiromycin, to an adenylate form, so it can be loaded onto a dedicated aryl-carrier protein.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10212227"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21612226"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.97#SIP65A179C4FBF4B937">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-hydroxy-4-methylanthranilate + ATP + H(+) = 3-hydroxy-4-methylanthranilyl-5'-AMP + diphosphate.</rdfs:label>
</rdf:Description>
