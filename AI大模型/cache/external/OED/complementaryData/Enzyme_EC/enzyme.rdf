<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21244361"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/21244361"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.266">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>23S rRNA (adenine(2030)-N(6))-methyltransferase</skos:prefLabel>
<skos:altLabel>m(6)A(2030) methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.266#SIP08D8F7CDAD7CC795"/>
<rdfs:comment>The recombinant RlmJ protein is most active in methylating deproteinized 23S ribosomal subunit, and does not methylate the completely assembled 50S subunits.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22847818"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.266#SIP08D8F7CDAD7CC795">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine(2030) in 23S rRNA + S-adenosyl-L-methionine = H(+) + N(6)-methyladenosine(2030) in 23S rRNA + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22847818">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22847818"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22847818"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.1.1.149"/>
<skos:prefLabel>flavonoid 3',5'-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.267#SIP058809CEB0D22C09"/>
<activity rdf:resource="2.1.1.267#SIPF11121560F944C1A"/>
<activity rdf:resource="2.1.1.267#SIPC2AB3887B022EC9F"/>
<activity rdf:resource="2.1.1.267#SIP94CD4E8BD5471970"/>
<activity rdf:resource="2.1.1.267#SIPBDBE05947984B0EC"/>
<activity rdf:resource="2.1.1.267#SIP47934D34BFE9B6E8"/>
<rdfs:comment>Isolated from Vitis vinifera (grape).</rdfs:comment>
<rdfs:comment>Most active with delphinidin 3-glucoside but also acts on cyanidin 3-glucoside, cyanidin, myricetin, quercetin and quercetin 3-glucoside.</rdfs:comment>
<rdfs:comment>The enzyme from Catharanthus roseus was most active with myricetin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12482447"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19525322"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIP058809CEB0D22C09">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + a 3'-hydroxyflavonoid = S-adenosyl-L-homocysteine + a 3'-methoxyflavonoid.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIPF11121560F944C1A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + a 5'-hydroxy-3'-methoxyflavonoid = S-adenosyl-L-homocysteine + a 3',5'-dimethoxyflavonoid.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIPC2AB3887B022EC9F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>myricetin + S-adenosyl-L-methionine = H(+) + laricitrin + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIP94CD4E8BD5471970">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>laricitrin + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + syringetin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIPBDBE05947984B0EC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 5'-hydroxy-3'-methoxyflavone + S-adenosyl-L-methionine = a 3',5'-dimethoxyflavone + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.267#SIP47934D34BFE9B6E8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 3'-hydroxyflavone + S-adenosyl-L-methionine = a 3'-methoxyflavone + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
