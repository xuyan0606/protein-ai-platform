<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a long-chain fatty acyl-CoA + 2 H(+) + 2 NADPH = a long-chain primary fatty alcohol + CoA + 2 NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.84#SIP4ECBFF89133468B4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + 2 NADPH + octadecanoyl-CoA = CoA + 2 NADP(+) + octadecan-1-ol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.84#SIPEF426C96CBCAF005">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + hexadecanoyl-CoA + 2 NADPH = CoA + hexadecan-1-ol + 2 NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10712526">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/10712526"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/10712526"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.85">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-hydroxymuconate-6-semialdehyde dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.2.1.85#SIPBE05E9841E5CC09C"/>
<rdfs:comment>This substrate for this enzyme is formed by meta ring cleavage of catechol (EC 1.13.11.2), and is an intermediate in the bacterial degradation of several aromatic compounds.</rdfs:comment>
<rdfs:comment>Has lower activity with benzaldehyde.</rdfs:comment>
<rdfs:comment>Activity with NAD(+) is more than 10-fold higher than with NADP(+). cf. EC 1.2.1.32.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7868591"/>
