<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-acetylaspartylglutamylglutamate synthase</skos:prefLabel>
<skos:altLabel>NAAGS-II</skos:altLabel>
<skos:altLabel>NAAG synthetase II</skos:altLabel>
<skos:altLabel>N-acetylaspartylglutamylglutamate synthetase</skos:altLabel>
<activity rdf:resource="6.3.2.42#SIPF714E257F8D03406"/>
<rdfs:comment>The enzyme, found in mammals, also has the activity of EC 6.3.2.41.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21454531"/>
