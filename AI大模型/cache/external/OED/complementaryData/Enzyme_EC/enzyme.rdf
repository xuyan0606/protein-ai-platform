<rdf:Description rdf:about="2.1.1.325">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>juvenile hormone-III synthase</skos:prefLabel>
<skos:altLabel>farnesoic acid methyltransferase</skos:altLabel>
<skos:altLabel>juvenile hormone acid methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.325#SIP9DED4F0E1AF68A4C"/>
<activity rdf:resource="2.1.1.325#SIPEF7774AA7F82C98F"/>
<rdfs:comment>The enzyme, found in insects, is involved in the synthesis of juvenile hormone III, a sesquiterpenoid that regulates several processes including embryonic development, metamorphosis, and reproduction, in many insect species.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14530389"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21195763"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24657668"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25893162"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
