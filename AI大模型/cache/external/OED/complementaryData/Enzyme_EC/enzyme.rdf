<rdfs:label>H2O + N(6)-(dimethylallyl)adenosine 5'-phosphate = D-ribose 5-phosphate + N(6)-dimethylallyladenine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.2.n1#SIP9AEC8A8898040E93">
