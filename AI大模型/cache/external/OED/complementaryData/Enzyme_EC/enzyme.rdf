<rdf:Description rdf:about="1.14.11.79">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>protein-L-histidine (3S)-3-hydroxylase</skos:prefLabel>
<skos:altLabel>protein histidyl hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.11.79#SIP8AF669B37C151AD4"/>
<rdfs:comment>The human enzymes encoded by the RIOX1 and RIOX2 genes catalyze the hydroxylation of L-histidine residues in the 60S ribosomal proteins Rpl8 and L27a, respectively.</rdfs:comment>
<rdfs:comment>Both proteins contain JmjC and winged helix domains, and both also catalyze histone L-lysine demethylation activities.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23103944"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30151692"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
<skos:broaderTransitive rdf:resource="1.14.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.79#SIP8AF669B37C151AD4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-histidyl-[protein] + O2 = (3S)-3-hydroxy-L-histidyl-[protein] + CO2 + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23103944">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23103944"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23103944"/>
<dcterms:identifier>doi:10.1038/nchembio.1093</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/30151692">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/30151692"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/30151692"/>
