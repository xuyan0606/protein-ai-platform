<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4 Fe(III)-[cytochrome c] + hydrazine = 4 Fe(II)-[cytochrome c] + 4 H(+) + N2.</rdfs:label>
</rdf:Description>
