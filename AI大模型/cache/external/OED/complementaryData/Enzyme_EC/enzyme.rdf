<replaces rdf:resource="3.1.25.2"/>
<skos:prefLabel>DNA-(apurinic or apyrimidinic site) lyase</skos:prefLabel>
<skos:altLabel>AP endonuclease class I</skos:altLabel>
<skos:altLabel>AP lyase</skos:altLabel>
<skos:altLabel>deoxyribonuclease (apurinic or apyrimidinic)</skos:altLabel>
<skos:altLabel>E.coli endonuclease III</skos:altLabel>
<skos:altLabel>endodeoxyribonuclease (apurinic or apyrimidinic)</skos:altLabel>
<skos:altLabel>Micrococcus luteus UV endonuclease</skos:altLabel>
<skos:altLabel>phage-T4 UV endonuclease</skos:altLabel>
<activity rdf:resource="4.2.99.18#SIPC63FC6840FF13A3D"/>
<rdfs:comment>'Nicking' of the phosphodiester bond is due to a lyase-type reaction, not hydrolysis.</rdfs:comment>
<rdfs:comment>This group of enzymes was previously listed as endonucleases, under the number EC 3.1.25.2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2439070"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2471157"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2471512"/>
<rdfs:subClassOf rdf:resource="4.2.99.-"/>
<skos:broaderTransitive rdf:resource="4.2.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.18#SIPC63FC6840FF13A3D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2'-deoxyribonucleotide-(2'-deoxyribose 5'-phosphate)-2'-deoxyribonucleotide-DNA = a 3'-end 2'-deoxyribonucleotide-(2,3-dehydro-2,3-deoxyribose 5'-phosphate)-DNA + a 5'-end 5'-monophospho-2'-deoxyribonucleoside-DNA + H(+).</rdfs:label>
</rdf:Description>
