<rdf:Description rdf:about="3.4.24.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>atrolysin A</skos:prefLabel>
<skos:altLabel>Crotalus atrox alpha-proteinase</skos:altLabel>
<skos:altLabel>Crotalus atrox metalloproteinase</skos:altLabel>
<skos:altLabel>hemorrhagic toxin a</skos:altLabel>
<activity rdf:resource="3.4.24.1#SIP692689D84DA55648"/>
<rdfs:comment>A hemorrhagic endopeptidase of 68 kDa, one of six hemorrhagic toxins in the venom of the western diamondback rattlesnake.</rdfs:comment>
<rdfs:comment>The 60 kDa hemorrhagic toxin 1 of Crotalus ruber ruber shows identical specificity.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M12B.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/210790"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2949699"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3060135"/>
<rdfs:subClassOf rdf:resource="3.4.24.-"/>
<skos:broaderTransitive rdf:resource="3.4.24.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.24.1#SIP692689D84DA55648">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Cleavage of 3-Asn-|-Gln-4, 5-His-|-Leu-6, 10-His-|-Leu-11, 14-Ala-|-Leu-15 and 16-Tyr-|-Leu-17 in insulin B chain. Removes C-terminal Leu from small peptides.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/210790">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
