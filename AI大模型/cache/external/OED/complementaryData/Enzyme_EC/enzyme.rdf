<rdf:Description rdf:about="1.13.11.69">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carlactone synthase</skos:prefLabel>
<activity rdf:resource="1.13.11.69#SIPDE76C3E1609A8A3E"/>
<rdfs:comment>The enzyme participates in a pathway leading to biosynthesis of strigolactones, plant hormones involved in promotion of symbiotic associations known as arbuscular mycorrhiza.</rdfs:comment>
<rdfs:comment>Also catalyzes EC 1.13.11.70, but 10-fold slower.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12815068"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15342640"/>
