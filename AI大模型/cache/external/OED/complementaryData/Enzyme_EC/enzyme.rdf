</rdf:Description>
<rdf:Description rdf:about="2.4.1.212">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hyaluronan synthase</skos:prefLabel>
<skos:altLabel>HAS</skos:altLabel>
<activity rdf:resource="2.4.1.212#SIP40B873C524964314"/>
<activity rdf:resource="2.4.1.212#SIP0DD7A46F47BF4812"/>
<rdfs:comment>Adds GlcNAc to nascent hyaluronan when the non-reducing end is GlcA, but it adds GlcA when the non-reducing end is GlcNAc.</rdfs:comment>
<rdfs:comment>Highly specific for UDP-GlcNAc and UDP-GlcA; no copolymerization is observed if either is replaced by UDP-Glc, UDP-Gal, UDP-GalNAc or UDP-GalA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8366070"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10473619"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10988250"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15248781"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.212#SIP40B873C524964314">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[hyaluronan](n) + UDP-N-acetyl-alpha-D-glucosamine = H(+) + N-acetyl-beta-D-glucosaminyl-(1->4)-[hyaluronan](n) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.212#SIP0DD7A46F47BF4812">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>N-acetyl-beta-D-glucosaminyl-(1->4)-[hyaluronan](n) + UDP-alpha-D-glucuronate = [hyaluronan](n+1) + H(+) + UDP.</rdfs:label>
</rdf:Description>
