</rdf:Description>
<rdf:Description rdf:about="1.14.19.48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tert-amyl alcohol desaturase</skos:prefLabel>
<activity rdf:resource="1.14.19.48#SIP9414FB5847C5B113"/>
<rdfs:comment>The enzyme, characterized from the bacterium Aquincola tertiaricarbonis can also act, with lower efficiency, on 2-butanol, converting it to but-1-en-3-ol.</rdfs:comment>
<rdfs:comment>Depending on the substrate, the enzyme also catalyzes EC 1.14.13.229.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22194447"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22752178"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.48#SIP9414FB5847C5B113">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-methylbutan-2-ol + H(+) + NADPH + O2 = 3-hydroxy-3-methylbut-1-ene + 2 H2O + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22194447">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22194447"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22194447"/>
</rdf:Description>
