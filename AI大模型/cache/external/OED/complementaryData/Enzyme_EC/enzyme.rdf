<skos:prefLabel>L-ornithine N(alpha)-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.2.30#SIP71CB1934FEF1AED2"/>
<rdfs:comment>The enzyme, found in bacteria, catalyzes the first step in the biosynthesis of ornithine lipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15341653"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22958119"/>
