<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2S)-naringenin + S-adenosyl-L-methionine = (2S)-sakuranetin + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
