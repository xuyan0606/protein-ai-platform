<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GTP + H2O = 7,8-dihydroneopterin 2',3'-cyclic phosphate + diphosphate + formate + H(+).</rdfs:label>
</rdf:Description>
