<rdf:Description rdf:about="1.5.99.14">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>6-hydroxypseudooxynicotine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.5.99.14#SIP08669B4780D65ACF"/>
<rdfs:comment>Contains a cytidylyl molybdenum cofactor.</rdfs:comment>
<rdfs:comment>The enzyme, which participates in the nicotine degradation pathway, has been characterized from the soil bacterium Arthrobacter nicotinovorans.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7815950"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16820521"/>
<rdfs:subClassOf rdf:resource="1.5.99.-"/>
<skos:broaderTransitive rdf:resource="1.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.14#SIP08669B4780D65ACF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-hydroxypseudooxynicotine + A + H2O = 2,6-dihydroxypseudooxynicotine + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7815950">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7815950"/>
