<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosylcob(III)alamin 5'-phosphate + H2O = adenosylcob(III)alamin + phosphate.</rdfs:label>
</rdf:Description>
