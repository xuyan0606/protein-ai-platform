<rdf:Description rdf:about="3.4.21.34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.4.4.21"/>
<replaces rdf:resource="3.4.21.8"/>
<skos:prefLabel>plasma kallikrein</skos:prefLabel>
<skos:altLabel>kininogenin</skos:altLabel>
<skos:altLabel>serum kallikrein</skos:altLabel>
<activity rdf:resource="3.4.21.34#SIP5CE75C0A0998CD1F"/>
<rdfs:comment>Formed from plasma prokallikrein (Fletcher factor) by factor XIIa.</rdfs:comment>
<rdfs:comment>Activates coagulation factors XII, VII and plasminogen.</rdfs:comment>
<rdfs:comment>Selective for Arg > Lys in P1, in small molecule substrates.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family S1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2534361"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2598771"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3237096"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6918767"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6976185"/>
<rdfs:subClassOf rdf:resource="3.4.21.-"/>
<skos:broaderTransitive rdf:resource="3.4.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.34#SIP5CE75C0A0998CD1F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Cleaves selectively Arg-|-Xaa and Lys-|-Xaa bonds, including Lys-|-Arg and Arg-|-Ser bonds in (human) kininogen to release bradykinin.</rdfs:label>
</rdf:Description>
