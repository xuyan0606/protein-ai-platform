<citation rdf:resource="http://purl.uniprot.org/citations/9644976"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13276347"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22037356"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22974111"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.24#SIP6BE445B099E3F57A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 5-aminolevulinate = H(+) + 2 H2O + porphobilinogen.</rdfs:label>
</rdf:Description>
