<rdf:Description rdf:about="1.3.1.101">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2,3-bis-O-geranylgeranyl-sn-glycerol 1-phosphate reductase [NAD(P)H]</skos:prefLabel>
<skos:altLabel>2,3-digeranylgeranylglycerophospholipid reductase</skos:altLabel>
<skos:altLabel>DGGGPL reductase</skos:altLabel>
<skos:altLabel>digeranylgeranylglycerophospholipid reductase</skos:altLabel>
<activity rdf:resource="1.3.1.101#SIP041E02DAC667DE38"/>
<activity rdf:resource="1.3.1.101#SIPF21090E3D1E3D8CE"/>
<rdfs:comment>The enzyme from the archaeon Thermoplasma acidophilum is involved in the biosynthesis of membrane lipids.</rdfs:comment>
<rdfs:comment>In vivo the reaction occurs in the reverse direction with the formation of 2,3-bis-O-phytanyl-sn-glycerol 1-phosphate. cf. EC 1.3.7.11.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16788058"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17275067"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20869368"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.101#SIP041E02DAC667DE38">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-bis-O-(phytanyl)-sn-glycerol 1-phosphate + 8 NADP(+) = 2,3-bis-O-(geranylgeranyl)-sn-glycerol 1-phosphate + 8 H(+) + 8 NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.101#SIPF21090E3D1E3D8CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-bis-O-(phytanyl)-sn-glycerol 1-phosphate + 8 NAD(+) = 2,3-bis-O-(geranylgeranyl)-sn-glycerol 1-phosphate + 8 H(+) + 8 NADH.</rdfs:label>
</rdf:Description>
