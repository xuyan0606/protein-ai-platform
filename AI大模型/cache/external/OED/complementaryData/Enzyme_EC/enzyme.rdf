<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 glutathione amide + NAD(+) = glutathione amide disulfide + H(+) + NADH.</rdfs:label>
</rdf:Description>
