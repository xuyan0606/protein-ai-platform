<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 3'-unsubstituted flavone + O2 + reduced [NADPH--hemoprotein reductase] = a 3'-hydroxyflavone + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
