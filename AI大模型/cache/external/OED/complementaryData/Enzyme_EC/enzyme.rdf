<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-alk-1-en-1-SO-peroxol = (Z)-alkanethial oxide.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="5.3.99.12#SIPB90DE8EA7315FA28">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-prop-1-en-1-SO-peroxol = (Z)-propanethial S-oxide.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="5.3.99.12#SIPB51FD79F4F2FBF27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-but-1-en-1-SO-peroxol = (Z)-butanethial oxide.</rdfs:label>
</rdf:Description>
