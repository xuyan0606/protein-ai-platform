<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclic GMP-AMP synthase</skos:prefLabel>
<activity rdf:resource="2.7.7.86#SIPFE351E214A08A139"/>
<rdfs:comment>Cyclic Gp(2'-5')Ap(3'-5') is a signaling molecule in mammalian cells that triggers the production of type I interferons and other cytokines.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23258413"/>
