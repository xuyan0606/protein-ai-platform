<rdf:Description rdf:about="2.1.1.381">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>arginine N(omega)-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.381#SIP8169A44DFECD3CDF"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces achromogenes subsp. streptozoticus, participates in the biosynthesis of the glucosamine-nitrosourea antibiotic streptozotocin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30728519"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30763082"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.381#SIP8169A44DFECD3CDF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-arginine + S-adenosyl-L-methionine = H(+) + N(omega)-methyl-L-arginine + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
