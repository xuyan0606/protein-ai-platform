<rdf:Description rdf:about="2.7.7.82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>CMP-N,N'-diacetyllegionaminic acid synthase</skos:prefLabel>
<activity rdf:resource="2.7.7.82#SIP811841514AB2A713"/>
<rdfs:comment>Isolated from the bacteria Legionella pneumophila and Campylobacter jejuni.</rdfs:comment>
<rdfs:comment>Involved in biosynthesis of legionaminic acid, a sialic acid-like derivative that is incorporated into virulence-associated cell surface glycoconjugates which may include lipopolysaccharide (LPS), capsular polysaccharide, pili and flagella.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18275154"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19282391"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.82#SIP811841514AB2A713">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CTP + N,N-diacetyllegionaminate = CMP-N,N-diacetyllegionaminate + diphosphate.</rdfs:label>
</rdf:Description>
