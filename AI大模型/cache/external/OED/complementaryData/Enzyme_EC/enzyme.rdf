<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a diacylglycerol + H2O = a fatty acid + a monoacylglycerol + H(+).</rdfs:label>
</rdf:Description>
