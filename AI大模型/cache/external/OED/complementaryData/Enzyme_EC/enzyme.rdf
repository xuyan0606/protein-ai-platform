<rdf:Description rdf:about="2.5.1.135">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>validamine 7-phosphate valienyltransferase</skos:prefLabel>
<activity rdf:resource="2.5.1.135#SIP575E89FB1DF75F53"/>
<rdfs:comment>The enzyme, characterized from several Streptomyces strains, is involved in the biosynthesis of the antifungal agent validamycin A.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21766819"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22384130"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23028689"/>
