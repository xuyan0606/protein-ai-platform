<rdf:Description rdf:about="4.1.1.93">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pyrrole-2-carboxylate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.93#SIPF76108B70EEF75B1"/>
<activity rdf:resource="4.1.1.93#SIPFF757EB6BB61CCB3"/>
<rdfs:comment>The enzyme catalyzes both the carboxylation and decarboxylation reactions.</rdfs:comment>
<rdfs:comment>However, while bicarbonate is the preferred substrate for the carboxylation reaction, decarboxylation produces carbon dioxide.</rdfs:comment>
<rdfs:comment>The enzyme is activated by carboxylic acids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9654100"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9826198"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.93#SIPF76108B70EEF75B1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + pyrrole-2-carboxylate = 1H-pyrrole + CO2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.93#SIPFF757EB6BB61CCB3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + pyrrole-2-carboxylate = 1H-pyrrole + hydrogencarbonate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9654100">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9654100"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9654100"/>
</rdf:Description>
