<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O + L-tyrosine(out) = ADP + H(+) + L-tyrosine(in) + phosphate.</rdfs:label>
</rdf:Description>
