<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-aspartate + NADP(+) = H(+) + NADPH + NH4(+) + oxaloacetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.1.21#SIP770875BD86742830">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-aspartate + NAD(+) = H(+) + NADH + NH4(+) + oxaloacetate.</rdfs:label>
</rdf:Description>
