<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>loganin + O2 + reduced [NADPH--hemoprotein reductase] = H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase] + secologanin.</rdfs:label>
</rdf:Description>
