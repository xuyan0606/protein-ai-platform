<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Fe-coproporphyrin III + 2 H(+) = coproporphyrin III + Fe(2+).</rdfs:label>
</rdf:Description>
