<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a beta-D-GlcNAc-(1->3)-beta-D-Gal-(1->4)-beta-D-Glc-(1&lt;->1)-Cer(d18:1(4E)) + UDP-alpha-D-galactose = a beta-D-Gal-(1->3)-beta-D-GlcNAc-(1->3)-beta-D-Gal-(1->4)-beta-D-Glc-(1&lt;->1')-Cer(d18:1(4E)) + H(+) + UDP.</rdfs:label>
</rdf:Description>
