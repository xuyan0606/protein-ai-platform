<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-deoxy-D-glycero-beta-D-galacto-non-2-ulopyranosonate + CTP = CMP-beta-3-deoxy-D-glycero-beta-D-galacto-non-2-ulopyranosonate + diphosphate.</rdfs:label>
</rdf:Description>
