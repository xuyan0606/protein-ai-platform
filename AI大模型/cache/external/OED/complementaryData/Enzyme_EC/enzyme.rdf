<rdf:Description rdf:about="3.5.1.125">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N(2)-acetyl-L-2,4-diaminobutanoate deacetylase</skos:prefLabel>
<activity rdf:resource="3.5.1.125#SIPE2A1E86DDA2F3659"/>
<rdfs:comment>The enzyme, found in bacteria, has no activity with (2S)-4-acetamido-2-aminobutanoate (cf. EC 3.5.4.44).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20849449"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
