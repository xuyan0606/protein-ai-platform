<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>succinate-semialdehyde dehydrogenase (NADP(+))</skos:prefLabel>
<activity rdf:resource="1.2.1.79#SIPB2E83C45B5957C87"/>
<rdfs:comment>This enzyme participates in the degradation of glutamate and 4-aminobutyrate.</rdfs:comment>
<rdfs:comment>It is similar to EC 1.2.1.24 and EC 1.2.1.16 but is specific for NADP(+).</rdfs:comment>
<rdfs:comment>The enzyme from Escherichia coli is 20-fold more active with NADP(+) than NAD(+).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2254272"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18474219"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
