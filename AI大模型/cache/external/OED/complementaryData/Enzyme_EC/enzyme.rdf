<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>rhodopin = all-trans-lycopene + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.131#SIP0BBD46D39ADCBE7A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1,1'-dihydroxy-1,1',2,2'-tetrahydrolycopene = H2O + rhodopin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.131#SIP5988AE849DC15428">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1,1'-dihydroxy-1,1',2,2'-tetrahydroneurosporene = 1-hydroxy-all-trans-1,2-dihydro-neurosporene + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.131#SIPDCB57414639E8D0B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-hydroxy-all-trans-1,2-dihydro-neurosporene = all-trans-neurosporene + H2O.</rdfs:label>
</rdf:Description>
