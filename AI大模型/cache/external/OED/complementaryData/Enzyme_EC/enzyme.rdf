<rdf:Description rdf:about="1.13.11.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>chlorite O2-lyase</skos:prefLabel>
<skos:altLabel>chlorite dismutase</skos:altLabel>
<activity rdf:resource="1.13.11.49#SIP2C94B28A67DFFC33"/>
<rdfs:comment>Reaction occurs in the reverse direction in chlorate- and perchlorate-reducing bacteria.</rdfs:comment>
<rdfs:comment>There is no activity when chlorite is replaced by hydrogen peroxide, perchlorate, chlorate or nitrite.</rdfs:comment>
<rdfs:comment>The term 'chlorite dismutase' is misleading as the reaction does not involve dismutation/disproportionation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8929278"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11472023"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
