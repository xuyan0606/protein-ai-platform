<replaces rdf:resource="3.13.1.8"/>
<skos:prefLabel>(R)-S-adenosyl-L-methionine hydrolase (adenosine-forming)</skos:prefLabel>
<skos:altLabel>SAM hydroxide adenosyltransferase</skos:altLabel>
<activity rdf:resource="3.13.2.3#SIP6B118625EE0F169C"/>
<rdfs:comment>The enzyme, found in bacteria and archaea, is involved in removing the (R) isomer of S-adenosyl-L-methionine from the cell.</rdfs:comment>
<rdfs:comment>It catalyzes a nucleophilic attack of water at the C5' carbon of S-adenosyl-L-methionine to generate adenosine and L-methionine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18720493"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19739191"/>
<citation rdf:resource="http://purl.uniprot.org/citations/32776704"/>
<rdfs:subClassOf rdf:resource="3.13.2.-"/>
<skos:broaderTransitive rdf:resource="3.13.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.13.2.3#SIP6B118625EE0F169C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-S-adenosyl-L-methionine + H2O = adenosine + H(+) + L-methionine.</rdfs:label>
</rdf:Description>
