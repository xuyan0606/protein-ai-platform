<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha,alpha-trehalose + H2O = alpha-D-glucose + beta-D-glucose.</rdfs:label>
</rdf:Description>
