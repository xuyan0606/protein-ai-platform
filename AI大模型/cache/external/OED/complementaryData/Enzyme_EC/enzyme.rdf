<rdf:Description rdf:about="2.1.3.12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>decarbamoylnovobiocin carbamoyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.3.12#SIP789EA09540A4A314"/>
<rdfs:comment>The enzyme catalyzes the last step in the biosynthesis of the aminocoumarin antibiotic novobiocin.</rdfs:comment>
<rdfs:comment>The reaction is activated by ATP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14694473"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18997325"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
