<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>fluoroacetaldehyde + L-threonine = 4-fluoro-L-threonine + acetaldehyde.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12404452">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
