<citation rdf:resource="http://purl.uniprot.org/citations/19656416"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21323772"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
