<rdf:Description rdf:about="2.4.99.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lipopolysaccharide heptosyltransferase I</skos:prefLabel>
<skos:altLabel>heptosyltransferase I</skos:altLabel>
<activity rdf:resource="2.4.99.23#SIP8B443AEC78DC2F26"/>
<activity rdf:resource="2.4.99.23#SIP3E7BF46EAEF729FA"/>
<rdfs:comment>The enzyme catalyzes a glycosylation step in the biosynthesis of the inner core oligosaccharide of the lipopolysaccharide (endotoxin) of many Gram-negative bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9171387"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9446588"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9831648"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11717579"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16963083"/>
<rdfs:subClassOf rdf:resource="2.4.99.-"/>
