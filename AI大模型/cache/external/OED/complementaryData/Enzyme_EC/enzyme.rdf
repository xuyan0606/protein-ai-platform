<skos:prefLabel>4-sulfomuconolactone hydrolase</skos:prefLabel>
<activity rdf:resource="3.1.1.92#SIP1B56F18E97A75DE5"/>
<rdfs:comment>The enzyme was isolated from the bacteria Hydrogenophaga intermedia and Agrobacterium radiobacter S2.</rdfs:comment>
<rdfs:comment>It catalyzes a step in the degradation of 4-sulfocatechol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17660282"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.92#SIP1B56F18E97A75DE5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-sulfomuconolactone + H2O = 2 H(+) + maleylacetate + sulfite.</rdfs:label>
</rdf:Description>
