<rdf:Description rdf:about="1.11.2.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-methyl-L-tyrosine peroxygenase</skos:prefLabel>
<skos:altLabel>3-methyl-L-tyrosine peroxidase</skos:altLabel>
<skos:altLabel>3-methyltyrosine peroxidase</skos:altLabel>
<activity rdf:resource="1.11.2.5#SIP4A17575CF40D7438"/>
<rdfs:comment>The heme-containing peroxygenase from the bacterium Streptomyces lavendulae is involved in biosynthesis of saframycin A, a potent antitumor antibiotic that belongs to the tetrahydroisoquinoline family.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22187429"/>
<rdfs:subClassOf rdf:resource="1.11.2.-"/>
<skos:broaderTransitive rdf:resource="1.11.2.-"/>
</rdf:Description>
