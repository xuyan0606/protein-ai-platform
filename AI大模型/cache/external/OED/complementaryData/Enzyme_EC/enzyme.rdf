<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + L-aspartate = CoA + H(+) + N-acetyl-L-aspartate.</rdfs:label>
</rdf:Description>
