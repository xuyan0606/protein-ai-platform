<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + L-lysyl-[alpha-tubulin] = CoA + H(+) + N(6)-acetyl-L-lysyl-[alpha-tubulin].</rdfs:label>
</rdf:Description>
