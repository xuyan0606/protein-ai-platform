<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-glutamine + phenylacetyl-CoA = CoA + H(+) + N(2)-phenylacetyl-L-glutamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycerol-3-phosphate 1-O-acyltransferase</skos:prefLabel>
<skos:altLabel>glycerol-3-phosphate O-acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.15#SIP9850608FBE3AD471"/>
<rdfs:comment>Acyl-[acyl-carrier-protein] can also act as acyl donor.</rdfs:comment>
<rdfs:comment>Acts only with derivatives of fatty acids of chain length above C10.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4650158"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6350296"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6825679"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
