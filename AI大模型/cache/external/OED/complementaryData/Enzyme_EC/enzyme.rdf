<skos:prefLabel>zerumbone synthase</skos:prefLabel>
<activity rdf:resource="1.1.1.326#SIP0F6A81613B229241"/>
<rdfs:comment>The enzyme was cloned from shampoo ginger, Zingiber zerumbet.</rdfs:comment>
