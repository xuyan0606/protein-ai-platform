<skos:prefLabel>hydroxyanthraquinone glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.181#SIP40EBD9B571732FE4"/>
<rdfs:comment>A range of anthraquinones and some flavones can act as acceptors; best substrates are emodin, anthrapurpurin, quinizarin, 2,6-dihydroxyanthraquinone and 1,8-dihydroxyanthraquinone.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
