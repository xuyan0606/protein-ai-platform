<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-coumaroyl-CoA + H(+) + H2O + malonyl-CoA = 4-hydroxybenzalacetone + 2 CO2 + 2 CoA.</rdfs:label>
</rdf:Description>
