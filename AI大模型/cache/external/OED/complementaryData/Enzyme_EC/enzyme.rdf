<skos:broaderTransitive rdf:resource="7.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="7.1.1.1#SIPD860CE9055DB3AD8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+)(in) + NAD(+) + NADPH = H(+)(out) + NADH + NADP(+).</rdfs:label>
</rdf:Description>
