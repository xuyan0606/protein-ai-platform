<rdf:Description rdf:about="1.13.11.88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoeugenol monooxygenase</skos:prefLabel>
<activity rdf:resource="1.13.11.88#SIP0AE69870A3AD6553"/>
<rdfs:comment>Contains Fe(2+).</rdfs:comment>
<rdfs:comment>The enzyme, charcterised from the bacteria Pseudomonas putida and Pseudomonas nitroreducens, catalyzes the epoxidation of the double bond in the side chain of isoeugenol, followed by a second oxygenation and cleavage of the side chain in the form of acetaldehyde.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10702906"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16944125"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17516050"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20091296"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23391906"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.13.11.88#SIP0AE69870A3AD6553">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-isoeugenol + O2 = acetaldehyde + vanillin.</rdfs:label>
</rdf:Description>
