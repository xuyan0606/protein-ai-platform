<rdf:Description rdf:about="2.1.1.281">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phenylpyruvate C(3)-methyltransferase</skos:prefLabel>
<skos:altLabel>phenylpyruvate Cbeta-methyltransferase</skos:altLabel>
<skos:altLabel>phenylpyruvate methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.281#SIPB7D7278315BE717C"/>
<rdfs:comment>The enzyme from the bacterium Streptomyces hygroscopicus NRRL3085 is involved in synthesis of the nonproteinogenic amino acid (2S,3S)-beta-methyl-phenylalanine, a building block of the antibiotic mannopeptimycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19731276"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.281#SIPB7D7278315BE717C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-phenylpyruvate + S-adenosyl-L-methionine = (3S)-2-oxo-3-phenylbutanoate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19731276">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19731276"/>
