<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an all-trans-retinyl ester + H2O = 11-cis-retinol + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
