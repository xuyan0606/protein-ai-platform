<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-2-chloropropanoate + NADP(+) = 2-chloroacrylate + H(+) + NADPH.</rdfs:label>
</rdf:Description>
