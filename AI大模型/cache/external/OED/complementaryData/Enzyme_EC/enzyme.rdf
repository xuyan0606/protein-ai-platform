</rdf:Description>
<rdf:Description rdf:about="2.5.1.111">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-hydroxyphenylpyruvate 3-dimethylallyltransferase</skos:prefLabel>
<skos:altLabel>4HPP dimethylallyltransferase</skos:altLabel>
<activity rdf:resource="2.5.1.111#SIP71BB716FD201214D"/>
<rdfs:comment>The enzyme's product feeds into the biosynthesis of the aminocoumarin antibiotics clorobiocin and novobiocin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12618544"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17077503"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19557032"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20946900"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.111#SIP71BB716FD201214D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-(4-hydroxyphenyl)pyruvate + dimethylallyl diphosphate = 3-dimethylallyl-4-hydroxyphenylpyruvate + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12618544">
