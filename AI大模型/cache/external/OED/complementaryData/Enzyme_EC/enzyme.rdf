<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>oxamate amidohydrolase</skos:prefLabel>
<activity rdf:resource="3.5.1.126#SIP84EE859CA9083CF8"/>
<rdfs:comment>The enzyme has been characterized from the bacterium Klebsiella pneumoniae.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27303801"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
