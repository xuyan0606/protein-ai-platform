<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + NADPH = NADH + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.3.108#SIP83C5FB0629341DBB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + NADP(+) = NAD(+) + phosphate.</rdfs:label>
</rdf:Description>
