<rdf:Description rdf:about="1.1.1.426">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-N-acetyl-alpha-D-quinovosamine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.1.1.426#SIP5CCA2D8B86C31D45"/>
<activity rdf:resource="1.1.1.426#SIP24AAE0B42C5182AE"/>
<rdfs:comment>The enzyme participates in the biosynthesis of N-acetyl-alpha-D-quinovosamine, a 6-deoxy sugar that is present in the O antigens of many Gram-negative bacteria, including Pseudomonas aeruginosa serotypes O6 and O10, Rhizobium etli, and Brucella abortus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10627048"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14551189"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24817117"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
