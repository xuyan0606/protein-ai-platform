<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + uridine(2552) in 23S rRNA = 2'-O-methyluridine(2552) in 23S rRNA + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
