<rdf:Description rdf:about="1.17.4.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.1.4.2"/>
<skos:prefLabel>vitamin-K-epoxide reductase (warfarin-insensitive)</skos:prefLabel>
<skos:altLabel>vitamin K 2,3-epoxide reductase</skos:altLabel>
<activity rdf:resource="1.17.4.5#SIP60B9438097E0C928"/>
<rdfs:comment>Vitamin K 2,3-epoxide is reduced to 3-hydroxy- (and 2-hydroxy-) vitamin K by 1,4-dithiothreitol, which is oxidized to a disulfide.</rdfs:comment>
<rdfs:comment>Not inhibited by warfarin (cf. EC 1.17.4.4).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3857611"/>
<rdfs:subClassOf rdf:resource="1.17.4.-"/>
<skos:broaderTransitive rdf:resource="1.17.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.4.5#SIP60B9438097E0C928">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-hydroxy-2-methyl-3-phytyl-2,3-dihydro-1,4-naphthoquinone + oxidized dithiothreitol = 1,4-dithiothreitol + 2,3-epoxyphylloquinone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3857611">
