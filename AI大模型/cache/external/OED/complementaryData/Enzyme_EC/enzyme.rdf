<dcterms:identifier>doi:10.1111/1751-7915.12329</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.114">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cis-3-alkyl-4-alkyloxetan-2-one decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.114#SIP5346ABF72B303794"/>
<rdfs:comment>The enzyme, found in certain bacterial species, catalyzes the last step in a pathway for the production of olefins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28029240"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28223313"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.114#SIP5346ABF72B303794">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a cis-3-alkyl-4-alkyloxetan-2-one = a cis-alkene + CO2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/28029240">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
