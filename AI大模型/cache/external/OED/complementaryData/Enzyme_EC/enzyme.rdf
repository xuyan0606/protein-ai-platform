<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dodecanoyl-CoA + H(+) + malonyl-[ACP] = 3-oxotetradecanoyl-[ACP] + CO2 + CoA.</rdfs:label>
</rdf:Description>
