<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(omega)-alpha-(ADP-D-ribosyl)-L-arginyl-[dinitrogen reductase] = ADP-D-ribose + L-arginyl-[dinitrogen reductase].</rdfs:label>
</rdf:Description>
