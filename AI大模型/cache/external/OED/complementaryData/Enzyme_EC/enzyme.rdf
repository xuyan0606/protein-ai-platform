<rdf:Description rdf:about="1.14.20.9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tyrosine isonitrile desaturase</skos:prefLabel>
<activity rdf:resource="1.14.20.9#SIPC85B25E0A74FE311"/>
<rdfs:comment>The enzyme is a member of the Fe(2+), 2-oxoglutarate-dependent oxygenases and requires Fe(2+).</rdfs:comment>
<rdfs:comment>It has been characterized from bacteria that form the isonitrile-functionalized compound paerucumarin. cf. EC 1.14.20.10.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18689486"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18824174"/>
