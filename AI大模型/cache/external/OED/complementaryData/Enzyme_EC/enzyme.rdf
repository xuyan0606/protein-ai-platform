<rdf:Description rdf:about="2.1.1.220">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.1.1.36"/>
<skos:prefLabel>tRNA (adenine(58)-N(1))-methyltransferase</skos:prefLabel>
<skos:altLabel>tRNA (m(1)A(58)) methyltransferase</skos:altLabel>
<skos:altLabel>tRNA m(1)A(58) methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.220#SIPFAE4FD0937B7E910"/>
<rdfs:comment>The enzyme specifically methylates adenine(58) in tRNA.</rdfs:comment>
<rdfs:comment>The methylation of A(58) is critical for maintaining the stability of initiator tRNA(Met) in yeast.</rdfs:comment>
