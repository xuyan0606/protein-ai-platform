<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sordaricin 6-deoxyaltrosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.353#SIP6F335DEF4FD9B0F9"/>
<rdfs:comment>The enzyme, isolated from the fungus Sordaria araneosa, is involved in the biosynthesis of the glycoside antibiotic sordarin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27072286"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
