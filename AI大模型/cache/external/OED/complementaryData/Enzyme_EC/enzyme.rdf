<rdf:Description rdf:about="2.3.2.25">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-terminal E2 ubiquitin-conjugating enzyme</skos:prefLabel>
<skos:altLabel>N-terminal ubiquitin-conjugating enzyme E2</skos:altLabel>
<activity rdf:resource="2.3.2.25#SIP01606053BC7B5BDE"/>
<rdfs:comment>The enzyme ubiquitinylates the N-terminus of the acceptor protein.</rdfs:comment>
<rdfs:comment>It is not reactive toward free lysine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9774340"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23560854"/>
