<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2'-hydroxybiphenyl-2-sulfinate + H2O = biphenyl-2-ol + H(+) + sulfite.</rdfs:label>
</rdf:Description>
