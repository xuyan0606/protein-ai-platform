<rdfs:label>3-[[[(2R,3R)-3-carboxyoxiran-2-yl]carbonyl]amino]-L-alanine + ATP + L-valine = ADP + dapdiamide E + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.47#SIP33A4BB19980768B2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-valine + N(3)-fumaramoyl-(S)-2,3-diaminopropanoate = ADP + dapdiamide A + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.47#SIPDF231D42ABD8E5A2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-isoleucine + N(3)-fumaramoyl-(S)-2,3-diaminopropanoate = ADP + dapdiamide B + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.47#SIPA15C3A1D71C8D61C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-leucine + N(3)-fumaramoyl-(S)-2,3-diaminopropanoate = ADP + dapdiamide C + H(+) + phosphate.</rdfs:label>
</rdf:Description>
