<replaces rdf:resource="1.6.99.n1"/>
<skos:prefLabel>8-hydroxy-5-deazaflavin:NADPH oxidoreductase</skos:prefLabel>
<activity rdf:resource="1.5.1.40#SIPE12362408B3013B3"/>
<rdfs:comment>The enzyme has an absolute requirement for both the 5-deazaflavin structure and the presence of an 8-hydroxy group in the substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2492438"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
