<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O2 + spermidine = 3-aminopropanal + H2O2 + putrescine.</rdfs:label>
</rdf:Description>
