<rdf:Description rdf:about="1.14.13.238">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dimethylamine monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.13.238#SIPAA042C789E850F76"/>
<rdfs:comment>The enzyme, characterized from several bacterial species, is involved in a pathway for the degradation of methylated amines.</rdfs:comment>
<rdfs:comment>It is composed of three subunits, one of which is a ferredoxin, and contains heme iron and an FMN cofactor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3624236"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4389011"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4401380"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28304370"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.238#SIPAA042C789E850F76">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dimethylamine + H(+) + NADPH + O2 = formaldehyde + H2O + methylamine + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3624236">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3624236"/>
