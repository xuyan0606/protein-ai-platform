<rdf:Description rdf:about="2.7.1.231">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-oxoisoapionate kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.231#SIPA4E0A675D4EC0A97"/>
<rdfs:comment>The enzyme, characterized from several bacterial species, participates in the degradation of D-apionate.</rdfs:comment>
<rdfs:comment>Stereospecificity of the product, 3-oxoisoapionate 4-phosphate, has not been determined.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29867142"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
