<rdf:Description rdf:about="2.3.1.87">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aralkylamine N-acetyltransferase</skos:prefLabel>
<skos:altLabel>AANAT</skos:altLabel>
<skos:altLabel>arylalkylamine N-acetyltransferase</skos:altLabel>
<skos:altLabel>melatonin rhythm enzyme</skos:altLabel>
<skos:altLabel>serotonin acetylase</skos:altLabel>
<skos:altLabel>serotonin acetyltransferase</skos:altLabel>
<skos:altLabel>serotonin N-acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.87#SIP33D0832838D3CFED"/>
<activity rdf:resource="2.3.1.87#SIP2BB4255F0595497D"/>
<rdfs:comment>Narrow specificity toward 2-arylethylamines, including serotonin (5-hydroxytryptamine), tryptamine, 5-methoxytryptamine and phenylethylamine.</rdfs:comment>
<rdfs:comment>This is the penultimate enzyme in the production of melatonin (5-methoxy-N-acetyltryptamine) and controls its synthesis (cf. EC 2.1.1.4).</rdfs:comment>
<rdfs:comment>Differs from EC 2.3.1.5.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6469990"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10722724"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.87#SIP33D0832838D3CFED">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-arylethylamine + acetyl-CoA = an N-acetyl-2-arylethylamine + CoA + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.87#SIP2BB4255F0595497D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + serotonin = CoA + H(+) + N-acetylserotonin.</rdfs:label>
</rdf:Description>
