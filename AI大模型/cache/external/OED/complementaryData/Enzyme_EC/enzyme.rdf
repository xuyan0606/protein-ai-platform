<skos:prefLabel>glutamate--putrescine ligase</skos:prefLabel>
<skos:altLabel>gamma-glutamylputrescine synthetase</skos:altLabel>
<activity rdf:resource="6.3.1.11#SIPB501DC1735E58470"/>
<rdfs:comment>Forms part of a bacterial putrescine utilization pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15590624"/>
