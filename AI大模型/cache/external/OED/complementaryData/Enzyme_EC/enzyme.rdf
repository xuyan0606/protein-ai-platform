<rdf:Description rdf:about="1.3.99.28">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phytoene desaturase (neurosporene-forming)</skos:prefLabel>
<skos:altLabel>3-step phytoene desaturase</skos:altLabel>
<activity rdf:resource="1.3.99.28#SIP2E9292B230920721"/>
<rdfs:comment>This enzyme is involved in carotenoid biosynthesis and catalyzes up to three desaturation steps (cf. EC 1.3.99.29, EC 1.3.99.30, EC 1.3.99.31).</rdfs:comment>
<rdfs:comment>The enzyme is activated by FAD.</rdfs:comment>
<rdfs:comment>NAD(+), NADP(+) or ATP show no activating effect.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8830054"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11526111"/>
