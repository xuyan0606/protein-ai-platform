<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2,3-saturated acyl-CoA + NADP(+) = a 2,3-dehydroacyl-CoA + H(+) + NADPH.</rdfs:label>
</rdf:Description>
