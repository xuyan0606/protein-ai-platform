<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cholest-4-en-3-one + 5 H(+) + 3 O2 + 6 reduced [2Fe-2S]-[ferredoxin] = (25S)-3-oxocholest-4-en-26-oate + 4 H2O + 6 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
