<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3E)-4-(2-hydroxyphenyl)-2-oxobut-3-enoate + H2O = pyruvate + salicylaldehyde.</rdfs:label>
</rdf:Description>
