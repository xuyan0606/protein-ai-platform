<rdf:Description rdf:about="1.3.99.40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carotenoid chi-ring synthase</skos:prefLabel>
<activity rdf:resource="1.3.99.40#SIPB967DBB86E47213D"/>
<rdfs:comment>The enzyme, found in purple sulfur bacteria (Chromatiaceae) and some cyanobacteria, is involved in the biosynthesis of carotenoids that contain chi-type end groups, such as okenone, renierapurpurin, and synechoxanthin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18849428"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22070388"/>
<rdfs:subClassOf rdf:resource="1.3.99.-"/>
<skos:broaderTransitive rdf:resource="1.3.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.40#SIPB967DBB86E47213D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 A + a carotenoid beta-end derivative = a carotenoid chi-end derivative + 2 AH2.</rdfs:label>
</rdf:Description>
