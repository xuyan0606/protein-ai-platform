<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/20047909"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/20047909"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.2.31">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dihydromonacolin L-[lovastatin nonaketide synthase] thioesterase</skos:prefLabel>
<activity rdf:resource="3.1.2.31#SIPC0FF45C54BCDC82B"/>
<rdfs:comment>Dihydromonacolin L acid is synthesized while bound to an acyl-carrier protein domain of EC 2.3.1.161.</rdfs:comment>
<rdfs:comment>Since that enzyme lacks a thioesterase domain, release of the dihydromonacolin L acid moiety from the polyketide synthase requires this dedicated enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23653178"/>
<rdfs:subClassOf rdf:resource="3.1.2.-"/>
<skos:broaderTransitive rdf:resource="3.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.2.31#SIPC0FF45C54BCDC82B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dihydromonacolin L-[lovastatin nonaketide synthase] + H2O = dihydromonacolin L carboxylate + H(+) + holo-[lovastatin nonaketide synthase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23653178">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23653178"/>
