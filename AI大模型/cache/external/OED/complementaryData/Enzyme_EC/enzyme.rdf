<rdf:Description rdf:about="1.14.99.44">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diapolycopene oxygenase</skos:prefLabel>
<activity rdf:resource="1.14.99.44#SIPE467A8964836EC88"/>
<rdfs:comment>Little activity with neurosporene or lycopene.</rdfs:comment>
<rdfs:comment>Involved in the biosynthesis of C30 carotenoids such as staphyloxanthin.</rdfs:comment>
<rdfs:comment>The enzyme oxidizes each methyl group to the hydroxymethyl and then a dihydroxymethyl group, followed by the spontaneous loss of water to give an aldehyde group.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15850982"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15933032"/>
<rdfs:subClassOf rdf:resource="1.14.99.-"/>
<skos:broaderTransitive rdf:resource="1.14.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.99.44#SIPE467A8964836EC88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4 AH2 + all-trans-4,4'-diapolycopene + 4 O2 = 4 A + all-trans-4,4'-diapolycopene-4,4'-dial + 6 H2O.</rdfs:label>
</rdf:Description>
