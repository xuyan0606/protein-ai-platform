<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclo(L-phenylalanyl-L-leucyl) + 2 O2 = albonoursin + 2 H2O2.</rdfs:label>
</rdf:Description>
