<rdf:Description rdf:about="3.4.21.95">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>snake venom factor V activator</skos:prefLabel>
<skos:altLabel>factor V-activating proteinase</skos:altLabel>
<skos:altLabel>RVV-V component</skos:altLabel>
<activity rdf:resource="3.4.21.95#SIPCF6C8DBC5AC119E5"/>
<rdfs:comment>Inhibited by diisopropyl fluorophosphate.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family S1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3053712"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7043192"/>
<rdfs:subClassOf rdf:resource="3.4.21.-"/>
<skos:broaderTransitive rdf:resource="3.4.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.95#SIPCF6C8DBC5AC119E5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Fully activates human clotting factor V by a single cleavage at the 1545-Trp-Tyr-Leu-Arg-|-Ser-Asn-Asn-Gly-1552 bond. Cattle, but not rabbit, factor V is cleaved, and no other proteins of the clotting system are attacked. Esterase activity is observed on Bz-Arg-OEt and Tos-Arg-OMe, and amidase activity on Phe-pipecolyl-Arg-NHPhNO2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3053712">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3053712"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3053712"/>
</rdf:Description>
