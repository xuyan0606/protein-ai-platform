</rdf:Description>
<rdf:Description rdf:about="4.1.99.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>deoxyribodipyrimidine photo-lyase</skos:prefLabel>
<skos:altLabel>DNA photolyase</skos:altLabel>
<skos:altLabel>photoreactivating enzyme</skos:altLabel>
<activity rdf:resource="4.1.99.3#SIP91AFD8B70223093B"/>
<activity rdf:resource="4.1.99.3#SIP76ED95ECAAAC15A1"/>
<rdfs:comment>A flavoprotein containing a second chromophore group.</rdfs:comment>
<rdfs:comment>Catalyzes the reactivation by light of irradiated DNA.</rdfs:comment>
<rdfs:comment>A similar reactivation of irradiated RNA is probably due to a separate enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/804322"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3539939"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5649902"/>
<rdfs:subClassOf rdf:resource="4.1.99.-"/>
<skos:broaderTransitive rdf:resource="4.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.99.3#SIP91AFD8B70223093B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclobutadipyrimidine (in DNA) = 2 pyrimidine residues (in DNA).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.99.3#SIP76ED95ECAAAC15A1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclobutadithymidine in DNA = a thymidine dimer in DNA.</rdfs:label>
</rdf:Description>
