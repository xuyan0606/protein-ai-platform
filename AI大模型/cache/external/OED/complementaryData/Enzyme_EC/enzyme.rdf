<rdf:Description rdf:about="1.14.14.144">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.108"/>
<skos:prefLabel>abieta-7,13-diene hydroxylase</skos:prefLabel>
<skos:altLabel>abietadiene hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.14.144#SIP3D6EBF5377AD5757"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein.</rdfs:comment>
<rdfs:comment>This enzyme catalyzes a step in the pathway of abietic acid biosynthesis.</rdfs:comment>
<rdfs:comment>The activity has been demonstrated in cell-free stem extracts of Abies grandis (grand fir) and Pinus contorta (lodgepole pine).</rdfs:comment>
<rdfs:comment>Activity is induced by wounding of the plant tissue.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8311462"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12232380"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.144#SIP3D6EBF5377AD5757">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>abieta-7,13-diene + O2 + reduced [NADPH--hemoprotein reductase] = abieta-7,13-dien-18-ol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8311462">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8311462"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/8311462"/>
<dcterms:identifier>doi:10.1006/abbi.1994.1036</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12232380">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12232380"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12232380"/>
<dcterms:identifier>doi:10.1104/pp.106.3.999</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.145">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.109"/>
<skos:prefLabel>abieta-7,13-dien-18-ol hydroxylase</skos:prefLabel>
<skos:altLabel>abietadienol hydroxylase</skos:altLabel>
<skos:altLabel>CYP720B1</skos:altLabel>
<activity rdf:resource="1.14.14.145#SIP6643F98772549032"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein.</rdfs:comment>
<rdfs:comment>This enzyme catalyzes a step in the pathway of abietic acid biosynthesis.</rdfs:comment>
<rdfs:comment>The activity has been demonstrated in cell-free stem extracts of Abies grandis (grand fir) and Pinus contorta (lodgepole pine), and the gene encoding the enzyme has been identified in Pinus taeda (loblolly pine).</rdfs:comment>
<rdfs:comment>The recombinant enzyme catalyzes the oxidation of multiple diterpene alcohol and aldehydes, including levopimaradienol, isopimara-7,15-dienol, isopimara-7,15-dienal, dehydroabietadienol and dehydroabietadienal.</rdfs:comment>
<rdfs:comment>It is not able to oxidize abietadiene.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8311462"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12232380"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15911762"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.145#SIP6643F98772549032">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>abieta-7,13-dien-18-ol + 2 O2 + 2 reduced [NADPH--hemoprotein reductase] = abieta-7,13-dien-18-oate + 3 H(+) + 3 H2O + 2 oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
