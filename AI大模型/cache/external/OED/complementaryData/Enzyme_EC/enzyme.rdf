<rdfs:label>2-oxoglutarate + a flavanone + O2 = a flavone + CO2 + H2O + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.5#SIP5F51F3909FEB1E47">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2S)-naringenin + 2-oxoglutarate + O2 = apigenin + CO2 + H(+) + H2O + succinate.</rdfs:label>
</rdf:Description>
