<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/28932214"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28932214"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>propanoyl-CoA:succinate CoA transferase</skos:prefLabel>
<activity rdf:resource="2.8.3.27#SIP258C1037A1985E00"/>
<rdfs:comment>The enzyme is most specific in Escherichia coli, where the preferred substrates are propanoyl-CoA and succinate.</rdfs:comment>
<rdfs:comment>In other organisms, the enzyme uses acetyl-CoA at the same rate as propanoyl-CoA (cf. EC 2.8.3.18).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10769117"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14102852"/>
<citation rdf:resource="http://purl.uniprot.org/citations/SIPA92E437F3CD7880E"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19103231"/>
<citation rdf:resource="http://purl.uniprot.org/citations/33931420"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.27#SIP258C1037A1985E00">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>propanoyl-CoA + succinate = propanoate + succinyl-CoA.</rdfs:label>
</rdf:Description>
