<replaces rdf:resource="2.7.1.141"/>
<skos:prefLabel>[RNA-polymerase]-subunit kinase</skos:prefLabel>
<skos:altLabel>CTD kinase</skos:altLabel>
<activity rdf:resource="2.7.11.23#SIPB017A199C58BE69F"/>
<rdfs:comment>Appears to be distinct from other protein phosphokinases.</rdfs:comment>
<rdfs:comment>Brings about multiple phosphorylation of the unique C-terminal repeat domain of the largest subunit of eukaryotic EC 2.7.7.6.</rdfs:comment>
<rdfs:comment>Does not phosphorylate casein, phosvitin or histone.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2657724"/>
<rdfs:subClassOf rdf:resource="2.7.11.-"/>
<skos:broaderTransitive rdf:resource="2.7.11.-"/>
</rdf:Description>
