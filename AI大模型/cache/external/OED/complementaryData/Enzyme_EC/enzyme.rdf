<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>With an iron-sulfur protein as acceptor</skos:prefLabel>
<rdfs:subClassOf rdf:resource="1.4.-.-"/>
<skos:broaderTransitive rdf:resource="1.4.-.-"/>
