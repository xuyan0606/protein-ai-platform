<rdf:Description rdf:about="1.14.13.237">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aliphatic glucosinolate S-oxygenase</skos:prefLabel>
<skos:altLabel>omega-(methylthio)alkylglucosinolate S-oxygenase</skos:altLabel>
<activity rdf:resource="1.14.13.237#SIP8F3330ACC25DAFA1"/>
<rdfs:comment>The enzyme is a member of the flavin-dependent monooxygenase (FMO) family (cf. EC 1.14.13.8).</rdfs:comment>
<rdfs:comment>The plant Arabidopsis thaliana contains five isoforms.</rdfs:comment>
<rdfs:comment>GS-OX1 through GS-OX4 are able to catalyze the S-oxygenation independent of chain length, while GS-OX5 is specific for 8-(methylsulfanyl)octyl glucosinolate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17461789"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18799661"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.237#SIP8F3330ACC25DAFA1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (Z)-omega-(methylsulfanyl)-N-sulfo-alkylhydroximate S-glucoside + H(+) + NADPH + O2 = a (Z)-omega-(methylsulfinyl)-alkyl-glucosinolate + H2O + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17461789">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17461789"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17461789"/>
</rdf:Description>
