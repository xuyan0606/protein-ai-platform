<activity rdf:resource="3.1.1.112#SIP18D4DDF5A4E070B8"/>
<rdfs:comment>The enzyme, characterized from the yeast Saccharomyces cerevisiae, hydrolyzes acetate esters.</rdfs:comment>
<rdfs:comment>It acts preferentially on 3-methylbutyl acetate, a major determinant of sake flavor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10855721"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
