<rdf:Description rdf:about="3.6.4.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>vesicle-fusing ATPase</skos:prefLabel>
<activity rdf:resource="3.6.4.6#SIP05AEEC61C40E23D7"/>
<rdfs:comment>A large family of ATP-hydrolyzing enzymes involved in the heterotypic fusion of membrane vesicles with target membranes and the homotypic fusion of various membrane compartments.</rdfs:comment>
<rdfs:comment>They belong to the AAA-type (ATPase associated with a variety of cell activities) ATPase superfamily.</rdfs:comment>
<rdfs:comment>They include peroxin, which apparently is involved in Zellweger's syndrome.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7646486"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9606181"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9817926"/>
<rdfs:subClassOf rdf:resource="3.6.4.-"/>
<skos:broaderTransitive rdf:resource="3.6.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.6.4.6#SIP05AEEC61C40E23D7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O = ADP + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7646486">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7646486"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/7646486"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9606181">
