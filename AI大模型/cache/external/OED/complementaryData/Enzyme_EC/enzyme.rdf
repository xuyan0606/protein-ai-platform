<rdf:Description rdf:about="2.4.1.165">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-acetylneuraminylgalactosylglucosylceramide beta-1,4-N-acetylgalactosaminyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.165#SIPEFF098ECB346015A"/>
<rdfs:comment>Only substances containing sialic acid residues can act as acceptors; bovine fetuin is the best acceptor tested.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2425965"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3106337"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4632917"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
