<activity rdf:resource="1.14.14.159#SIP5BCE7326B7EE5120"/>
<activity rdf:resource="1.14.14.159#SIP8AE220B935F3C2E6"/>
<rdfs:comment>A cytochrome P450 (heme thiolate) enzyme characterized from maize.</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the epoxidation of dolabradiene at C-16, followed by hydroxylation at C-3.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29475898"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
