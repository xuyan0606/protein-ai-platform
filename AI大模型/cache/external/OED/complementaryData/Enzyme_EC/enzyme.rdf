<rdf:Description rdf:about="2.7.1.230">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>amicoumacin kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.230#SIP097FCB9D7527025A"/>
<rdfs:comment>The enzyme, found in some bacterial species, inactivates the antibiotic amicoumacin A by phosphorylating it, conferring resistance on the bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30181282"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
