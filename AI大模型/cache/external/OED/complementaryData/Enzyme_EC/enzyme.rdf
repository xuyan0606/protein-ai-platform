<rdf:Description rdf:about="4.2.1.129">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>squalene--hopanol cyclase</skos:prefLabel>
<skos:altLabel>squalene--hopene cyclase</skos:altLabel>
<activity rdf:resource="4.2.1.129#SIPE9EAE2E6C7A797F4"/>
<rdfs:comment>The enzyme produces the cyclization products hopene (cf. EC 5.4.99.17) and hopanol from squalene at a constant ratio of 5:1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15056909"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15136801"/>
