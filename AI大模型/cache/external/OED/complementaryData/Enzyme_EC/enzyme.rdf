<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-arginyl-[dinitrogen reductase] + NAD(+) = H(+) + N(omega)-alpha-(ADP-D-ribosyl)-L-arginyl-[dinitrogen reductase] + nicotinamide.</rdfs:label>
</rdf:Description>
