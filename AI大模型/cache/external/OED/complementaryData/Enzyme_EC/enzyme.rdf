<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H2O + tungstate(in) = ADP + H(+) + phosphate + tungstate(out).</rdfs:label>
</rdf:Description>
