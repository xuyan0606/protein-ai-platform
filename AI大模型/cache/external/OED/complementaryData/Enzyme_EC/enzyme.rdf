<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a quinone + L-proline = (S)-1-pyrroline-5-carboxylate + a quinol + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.5.2#SIP390860C17C15ABAE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ubiquinone + L-proline = (S)-1-pyrroline-5-carboxylate + a ubiquinol + H(+).</rdfs:label>
</rdf:Description>
