<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-hydroxyhexa-2,4-dienoate hydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.132#SIP67C8398A0AB8ECDC"/>
<rdfs:comment>This enzyme catalyzes a late step in the bacterial steroid degradation pathway.</rdfs:comment>
<rdfs:comment>The product, 4-hydroxy-2-oxohexanoate, forms a 2-hydroxy-4-hex-2-enolactone under acidic conditions.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16151114"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
