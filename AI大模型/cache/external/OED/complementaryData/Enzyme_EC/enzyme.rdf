<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17046597"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23376633">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23376633"/>
