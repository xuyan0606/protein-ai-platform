<rdf:Description rdf:about="2.1.1.271">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-4 methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.271#SIPF898BF842E43314E"/>
<rdfs:comment>This enzyme, which participates in the anaerobic (early cobalt insertion) cobalamin biosynthesis pathway, catalyzes the methylation of C-11 in cobalt-precorrin-4 to form cobalt-precorrin-5A.</rdfs:comment>
<rdfs:comment>See EC 2.1.1.133 for the equivalent enzyme that participates in the aerobic cobalamin biosynthesis pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9660189"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9665173"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16866557"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.271#SIPF898BF842E43314E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co-precorrin-4 + S-adenosyl-L-methionine = Co-precorrin-5A + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
