<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + NADP(+) + staphylopine = (2S)-2-amino-4-{[(1R)-1-carboxy-2-(1H-imidazol-4-yl)ethyl]amino}butanoate + H(+) + NADPH + pyruvate.</rdfs:label>
</rdf:Description>
