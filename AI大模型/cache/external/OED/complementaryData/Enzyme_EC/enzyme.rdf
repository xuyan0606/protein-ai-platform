<rdf:Description rdf:about="2.1.1.344">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ornithine lipid N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.344#SIPFAFF312021CE24DF"/>
<rdfs:comment>The enzyme, characterized from the bacterium Singulisphaera acidiphila, catalyzes three successive methylations of the terminal delta-nitrogen in ornithine lipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25925947"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.344#SIPFAFF312021CE24DF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an N(2)-[(3R)-3-(2-saturated-acyloxy)acyl]-L-ornithine lipid + 3 S-adenosyl-L-methionine = an N,N,N-trimethylornithine lipid + 3 H(+) + 3 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25925947">
