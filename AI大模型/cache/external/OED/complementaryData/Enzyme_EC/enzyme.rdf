<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + citrate + L-glutamate = ADP + beta-citrylglutamate + H(+) + phosphate.</rdfs:label>
</rdf:Description>
