<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-nitroanthranilate + H(+) + H2O = 5-nitrosalicylate + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20081004">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
