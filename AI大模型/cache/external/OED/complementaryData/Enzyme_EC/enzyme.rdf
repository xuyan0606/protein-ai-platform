<citation rdf:resource="http://purl.uniprot.org/citations/18271580"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18516049"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19152323"/>
<rdfs:subClassOf rdf:resource="4.3.3.-"/>
<skos:broaderTransitive rdf:resource="4.3.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.3.6#SIP438E66B798C547CA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>aldehydo-D-ribose 5-phosphate + D-glyceraldehyde 3-phosphate + L-glutamine = H(+) + 3 H2O + L-glutamate + phosphate + pyridoxal 5'-phosphate.</rdfs:label>
</rdf:Description>
