<replaces rdf:resource="4.1.1.41"/>
<skos:prefLabel>(S)-methylmalonyl-CoA decarboxylase (sodium-transporting)</skos:prefLabel>
<skos:altLabel>(S)-2-methyl-3-oxopropanoyl-CoA carboxy-lyase</skos:altLabel>
<skos:altLabel>(S)-methylmalonyl-CoA carboxy-lyase</skos:altLabel>
<skos:altLabel>methylmalonyl-coenzyme A decarboxylase</skos:altLabel>
<activity rdf:resource="7.2.4.3#SIP6F741946504EB202"/>
<rdfs:comment>This bacterial enzyme couples the decarboxylation of (S)-methylmalonyl-CoA to propanoyl-CoA to the vectorial transport of Na(+) across the cytoplasmic membrane, thereby creating a sodium ion motive force that is used for ATP synthesis.</rdfs:comment>
<rdfs:comment>It is a membrane-associated biotin protein and is strictly dependent on sodium ions for activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2920730"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5646172"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7070502"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7601825"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9428714"/>
<rdfs:subClassOf rdf:resource="7.2.4.-"/>
<skos:broaderTransitive rdf:resource="7.2.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="7.2.4.3#SIP6F741946504EB202">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-methylmalonyl-CoA + H(+)(out) + Na(+)(in) = CO2 + Na(+)(out) + propanoyl-CoA.</rdfs:label>
</rdf:Description>
