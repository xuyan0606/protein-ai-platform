</rdf:Description>
<rdf:Description rdf:about="6.3.5.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="6.3.4.1"/>
<skos:prefLabel>GMP synthase (glutamine-hydrolyzing)</skos:prefLabel>
<skos:altLabel>GMP synthetase (glutamine-hydrolyzing)</skos:altLabel>
<activity rdf:resource="6.3.5.2#SIP344FF025CBA4B235"/>
<rdfs:comment>Involved in the de novo biosynthesis of guanosine nucleotides.</rdfs:comment>
<rdfs:comment>An N-terminal glutaminase domain binds L-glutamine and generates ammonia, which is transferred by a substrate-protective tunnel to the ATP-pyrophosphatase domain.</rdfs:comment>
<rdfs:comment>The enzyme can catalyze the second reaction alone in the presence of ammonia.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2982857"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13563458"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17103135"/>
<rdfs:subClassOf rdf:resource="6.3.5.-"/>
<skos:broaderTransitive rdf:resource="6.3.5.-"/>
</rdf:Description>
