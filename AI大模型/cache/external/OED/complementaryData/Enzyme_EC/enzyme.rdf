<skos:prefLabel>electron-transferring-flavoprotein dehydrogenase</skos:prefLabel>
<skos:altLabel>electron transfer flavoprotein-ubiquinone oxidoreductase</skos:altLabel>
<skos:altLabel>ETF dehydrogenase</skos:altLabel>
<skos:altLabel>ETF-QO</skos:altLabel>
<skos:altLabel>ETF-ubiquinone oxidoreductase</skos:altLabel>
<activity rdf:resource="1.5.5.1#SIP84F3B120892C3583"/>
<rdfs:comment>Forms part of the mitochondrial electron-transfer system.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/925004"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4052375"/>
<rdfs:subClassOf rdf:resource="1.5.5.-"/>
