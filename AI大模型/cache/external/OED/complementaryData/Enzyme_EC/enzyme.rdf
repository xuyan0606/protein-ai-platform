<rdf:Description rdf:about="2.5.1.145">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phosphatidylglycerol--prolipoprotein diacylglyceryl transferase</skos:prefLabel>
<activity rdf:resource="2.5.1.145#SIP8BBB76251424FA7F"/>
<rdfs:comment>This bacterial enzyme, which is associated with the membrane, catalyzes the transfer of an sn-1,2-diacylglyceryl group from phosphatidylglycerol to the sulfhydryl group of the prospective N-terminal cysteine of a prolipoprotein, the first step in the formation of mature triacylated lipoproteins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7592473"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7896715"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8051048"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9139912"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22287519"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.145#SIP8BBB76251424FA7F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol) + L-cysteinyl-[prolipoprotein] = H(+) + S-1,2-diacyl-sn-glyceryl-L-cysteinyl-[prolipoprotein] + sn-glycerol 1-phosphate.</rdfs:label>
</rdf:Description>
