</rdf:Description>
<rdf:Description rdf:about="6.3.2.47">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dapdiamide synthase</skos:prefLabel>
<skos:altLabel>dapdiamide A synthase</skos:altLabel>
<activity rdf:resource="6.3.2.47#SIP08360CB9AD44BE40"/>
<activity rdf:resource="6.3.2.47#SIP33A4BB19980768B2"/>
<activity rdf:resource="6.3.2.47#SIPDF231D42ABD8E5A2"/>
<activity rdf:resource="6.3.2.47#SIPA15C3A1D71C8D61C"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pantoea agglomerans, is involved in biosynthesis of dapdiamide tripeptide antibiotics, a family of fumaramoyl- and epoxysuccinamoyl-peptides named for the presence of an (S)-2,3-diaminopropanoate (DAP) moiety and two amide linkages in their scaffold.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19807062"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20945916"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
