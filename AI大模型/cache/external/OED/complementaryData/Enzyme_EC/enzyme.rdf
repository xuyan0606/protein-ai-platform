<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>curcumin reductase</skos:prefLabel>
<skos:altLabel>NADPH-dependent curcumin/dihydrocurcumin reductase</skos:altLabel>
<activity rdf:resource="1.3.1.n3#SIP094D4B67F14AACD2"/>
<activity rdf:resource="1.3.1.n3#SIP963CB62BE4CDFC62"/>
<activity rdf:resource="1.3.1.n3#SIPC9D6416C687A559F"/>
<rdfs:comment>The enzyme, from the bacterium Escherichia coli is also active with 3-octene-2-one (59.7%), 3-hepten-2-one (28%), and resveratrol (14.8%).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21467222"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
