</rdf:Description>
<rdf:Description rdf:about="2.3.1.299#SIPACD30EE87A7E4EF7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a sphingoid base + octadecanoyl-CoA = an N-octadecanoyl-sphingoid base + CoA + H(+).</rdfs:label>
</rdf:Description>
