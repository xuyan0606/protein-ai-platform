<rdf:Description rdf:about="5.1.3.43">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfoquinovose mutarotase</skos:prefLabel>
<activity rdf:resource="5.1.3.43#SIP95978AE2A705BF34"/>
<rdfs:comment>The enzyme is found in bacteria that possess sulfoglycolytic pathways.</rdfs:comment>
<rdfs:comment>The enzyme can also act on other aldohexoses such as D-galactose, D-glucose, D-glucose-6-phosphate, and D-glucuronate, but with lower efficiency.</rdfs:comment>
<rdfs:comment>Does not act on D-mannose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29535276"/>
<rdfs:subClassOf rdf:resource="5.1.3.-"/>
<skos:broaderTransitive rdf:resource="5.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.3.43#SIP95978AE2A705BF34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-sulfo-alpha-D-quinovose = 6-sulfo-beta-D-quinovose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/29535276">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
