<citation rdf:resource="http://purl.uniprot.org/citations/10512735"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11412116"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.15#SIP0F3AE33B7FC8B6DD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5beta-cholestane-3alpha,7alpha,12alpha-triol + 5 H(+) + 3 O2 + 6 reduced [adrenodoxin] = (25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oate + 4 H2O + 6 oxidized [adrenodoxin].</rdfs:label>
</rdf:Description>
