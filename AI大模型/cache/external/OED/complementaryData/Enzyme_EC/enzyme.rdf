<rdf:Description rdf:about="2.4.1.207">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>xyloglucan:xyloglucosyl transferase</skos:prefLabel>
<skos:altLabel>endo-xyloglucan transferase</skos:altLabel>
<skos:altLabel>xyloglucan endotransglycosylase</skos:altLabel>
<activity rdf:resource="2.4.1.207#SIPDDEB305E919864E6"/>
<rdfs:comment>Does not use cello-oligosaccharides as either donor or acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1400418"/>
<citation rdf:resource="http://purl.uniprot.org/citations/1554366"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.207#SIPDDEB305E919864E6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>breaks a beta-(1->4) bond in the backbone of a xyloglucan and transfers the xyloglucanyl segment on to O-4 of the non-reducing terminal glucose residue of an acceptor, which can be a xyloglucan or an oligosaccharide of xyloglucan.</rdfs:label>
</rdf:Description>
