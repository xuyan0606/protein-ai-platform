<rdf:Description rdf:about="2.4.1.315">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diglucosyl diacylglycerol synthase (1,6-linking)</skos:prefLabel>
<skos:altLabel>DGlcDAG synthase</skos:altLabel>
<skos:altLabel>MGlcDAG (1->6) glucosyltransferase</skos:altLabel>
<skos:altLabel>monoglucosyl diacylglycerol (1->6) glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.315#SIP22F16C70D9E3707B"/>
<activity rdf:resource="2.4.1.315#SIP8809A1319FB5D459"/>
<rdfs:comment>The enzyme is found in several bacterial species.</rdfs:comment>
<rdfs:comment>The enzyme from Bacillus subtilis is specific for glucose.</rdfs:comment>
<rdfs:comment>The enzyme from Mycoplasma genitalium can incoporate galactose with similar efficiency, but forms mainly 1,2-diacyl-diglucopyranosyl-sn-glycerol in vivo.</rdfs:comment>
<rdfs:comment>The enzyme from Staphylococcus aureus can also form glucosyl-glycero-3-phospho-(1'-sn-glycerol).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9720862"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10848996"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21835921"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
