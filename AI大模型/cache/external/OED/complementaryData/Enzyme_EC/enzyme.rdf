<skos:broaderTransitive rdf:resource="3.1.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.21.6#SIP023422CB6C4FC5B1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>endonucleolytic cleavage to give 5'-phosphooligonucleotide end-products, with a preference for cleavage within the sequence CC.</rdfs:label>
</rdf:Description>
