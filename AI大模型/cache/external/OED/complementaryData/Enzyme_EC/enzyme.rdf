</rdf:Description>
<rdf:Description rdf:about="2.3.1.156">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phloroisovalerophenone synthase</skos:prefLabel>
<skos:altLabel>3-methyl-1-(trihydroxyphenyl)butan-1-one synthase</skos:altLabel>
<skos:altLabel>acylphloroglucinol synthase</skos:altLabel>
<skos:altLabel>valerophenone synthase</skos:altLabel>
<activity rdf:resource="2.3.1.156#SIP2A8483D0B003BA64"/>
<activity rdf:resource="2.3.1.156#SIP808AE2D7C624F009"/>
<activity rdf:resource="2.3.1.156#SIPD06BF47660E64FF4"/>
<rdfs:comment>Closely related to EC 2.3.1.74.</rdfs:comment>
<rdfs:comment>Also acts on isobutyryl-CoA as substrate to give phlorisobutyrophenone.</rdfs:comment>
<rdfs:comment>The products are intermediates in the biosynthesis of the bitter acids in hops (Humulus lupulus) and glucosides in strawberry (Fragaria X ananassa).</rdfs:comment>
<rdfs:comment>It is also able to generate naringenin chalcone from 4-coumaroyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26169681"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.156#SIP2A8483D0B003BA64">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-methylbutanoyl-CoA + 3 H(+) + 3 malonyl-CoA = 3 CO2 + 4 CoA + phlorisovalerophenone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.156#SIP808AE2D7C624F009">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-methylpropanoyl-CoA + 3 H(+) + 3 malonyl-CoA = 3 CO2 + 4 CoA + phlorisobutanophenone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.156#SIPD06BF47660E64FF4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-coumaroyl-CoA + 2 H(+) + 3 malonyl-CoA = 2',4,4',6'-tetrahydroxychalcone + 3 CO2 + 4 CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26169681">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/26169681"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/26169681"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.157">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucosamine-1-phosphate N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.157#SIP2BD39F7876C9BDC2"/>
<rdfs:comment>The enzyme from several bacteria has been shown to be bifunctional and also to possess the activity of EC 2.7.7.23.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8083170"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8555230"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11329257"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.157#SIP2BD39F7876C9BDC2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + alpha-D-glucosamine 1-phosphate = CoA + H(+) + N-acetyl-alpha-D-glucosamine 1-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8083170">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8083170"/>
