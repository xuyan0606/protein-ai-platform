<rdf:Description rdf:about="1.14.13.220">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>resorcinol 4-hydroxylase (NADH)</skos:prefLabel>
<activity rdf:resource="1.14.13.220#SIPEAB321900918103B"/>
<rdfs:comment>The enzyme, characterized from the bacterium Rhodococcus jostii RHA1, is a single-component hydroxylase.</rdfs:comment>
<rdfs:comment>The enzyme has no activity with NADPH. cf. EC 1.14.13.219 and EC 1.14.14.27.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26319878"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.220#SIPEAB321900918103B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADH + O2 + resorcinol = benzene-1,2,4-triol + H2O + NAD(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26319878">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
