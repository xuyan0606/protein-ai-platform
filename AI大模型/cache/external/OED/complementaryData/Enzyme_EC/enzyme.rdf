<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-hydroxyisoflavanone dehydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.105#SIP284702D695FA29C3"/>
<activity rdf:resource="4.2.1.105#SIPF3020ACA710FC90A"/>
<rdfs:comment>Catalyzes the final step in the formation of the isoflavonoid skeleton.</rdfs:comment>
<rdfs:comment>The reaction also occurs spontaneously.</rdfs:comment>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
