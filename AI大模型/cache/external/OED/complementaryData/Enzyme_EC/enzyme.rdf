<rdf:Description rdf:about="1.14.14.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dibenzothiophene sulfone monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.14.22#SIPE227589EEEB3B60A"/>
<rdfs:comment>This bacterial enzyme catalyzes a step in the desulfurization pathway of dibenzothiophenes.</rdfs:comment>
<rdfs:comment>The enzyme forms a two-component system with EC 1.5.1.42, which also interacts with EC 1.14.14.21.</rdfs:comment>
<rdfs:comment>The flavin-N(5)-oxide that is formed by the enzyme reacts spontaneously with NADH to give oxidized flavin, releasing a water molecule.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9634856"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16232672"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16232919"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16243275"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27120486"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28784589"/>
<citation rdf:resource="http://purl.uniprot.org/citations/32066967"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.22#SIPE227589EEEB3B60A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dibenzothiophene 5,5-dioxide + FMNH2 + NADH + O2 = 2'-hydroxybiphenyl-2-sulfinate + FMN + H(+) + H2O + NAD(+).</rdfs:label>
</rdf:Description>
