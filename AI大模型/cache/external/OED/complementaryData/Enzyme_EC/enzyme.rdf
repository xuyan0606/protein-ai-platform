<skos:altLabel>CYP71AJ4</skos:altLabel>
<activity rdf:resource="1.14.14.148#SIP9A364F30172000BE"/>
<rdfs:comment>This cytochrome P450 (heme-thiolate) enzyme from wild parsnip is involved in the formation of angular furanocoumarins.</rdfs:comment>
<rdfs:comment>Attacks its substrate by syn-elimination of hydrogen from C-3'.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19098286"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
