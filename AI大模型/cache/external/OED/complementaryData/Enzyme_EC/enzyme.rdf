<rdf:Description rdf:about="4.2.3.115">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alpha-terpinene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.115#SIP1EC41A978047F782"/>
<rdfs:comment>The enzyme has been characterized from Dysphania ambrosioides (American wormseed).</rdfs:comment>
<rdfs:comment>The enzyme will also use (3R)-linalyl diphosphate.</rdfs:comment>
<rdfs:comment>The reaction involves a 1,2-hydride shift.</rdfs:comment>
<rdfs:comment>The 1-pro-S hydrogen of geranyl diphosphate is lost.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/736574"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8460944"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
