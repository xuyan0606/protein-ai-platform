<rdf:Description rdf:about="5.3.3.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lutein isomerase</skos:prefLabel>
<skos:altLabel>meso-zeaxanthin isomerase</skos:altLabel>
<activity rdf:resource="5.3.3.22#SIP0AF10C11D6AC156E"/>
<rdfs:comment>The enzyme is found in the retinal pigment epithelium (RPE) of vertebrates.</rdfs:comment>
<rdfs:comment>It also has the activity of EC 3.1.1.64.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28874556"/>
<rdfs:subClassOf rdf:resource="5.3.3.-"/>
<skos:broaderTransitive rdf:resource="5.3.3.-"/>
</rdf:Description>
