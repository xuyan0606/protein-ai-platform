<rdf:Description rdf:about="2.1.1.196">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-6B (C(15))-methyltransferase [decarboxylating]</skos:prefLabel>
<skos:altLabel>cobalt-precorrin-6Y (C(15))-methyltransferase [decarboxylating]</skos:altLabel>
<activity rdf:resource="2.1.1.196#SIP6FA7CF5A273E3E1A"/>
<rdfs:comment>This enzyme, which participates in the anaerobic (early cobalt insertion) adenosylcobalamin biosynthesis pathway, catalyzes both methylation at C-15 and decarboxylation of the C-12 acetate side chain of cobalt-precorrin-6B.</rdfs:comment>
<rdfs:comment>The equivalent activity in the aerobic adenosylcobalamin biosynthesis pathway is catalyzed by the bifunctional enzyme EC 2.1.1.132.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12429089"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16198574"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23922391"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
