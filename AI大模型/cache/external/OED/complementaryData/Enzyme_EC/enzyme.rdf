<rdf:Description rdf:about="1.8.3.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.4.1.18"/>
<skos:prefLabel>prenylcysteine oxidase</skos:prefLabel>
<skos:altLabel>prenylcysteine lyase</skos:altLabel>
<activity rdf:resource="1.8.3.5#SIPC2BBADAA64A106CF"/>
<activity rdf:resource="1.8.3.5#SIP6BC3F757E92454C0"/>
<activity rdf:resource="1.8.3.5#SIP80F6221CD1A42A9B"/>
<rdfs:comment>Cleaves the thioether bond of S-prenyl-L-cysteines, such as S-farnesylcysteine and S-geranylgeranylcysteine.</rdfs:comment>
<rdfs:comment>N-Acetyl-prenylcysteine and prenylcysteinyl peptides are not substrates.</rdfs:comment>
<rdfs:comment>May represent the final step in the degradation of prenylated proteins in mammalian tissues.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9287348"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11078725"/>
<rdfs:subClassOf rdf:resource="1.8.3.-"/>
<skos:broaderTransitive rdf:resource="1.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.3.5#SIPC2BBADAA64A106CF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an S-prenyl-L-cysteine + H2O + O2 = a prenal + H2O2 + L-cysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.8.3.5#SIP6BC3F757E92454C0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O2 + S-(2E,6E)-farnesyl-L-cysteine = (2E,6E)-farnesal + H2O2 + L-cysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.8.3.5#SIP80F6221CD1A42A9B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(2E,6E,10E)-geranylgeranyl]-L-cysteine + H2O + O2 = (2E,6E,10E)-geranylgeranial + H2O2 + L-cysteine.</rdfs:label>
</rdf:Description>
