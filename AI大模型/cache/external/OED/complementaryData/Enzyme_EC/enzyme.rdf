<rdf:Description rdf:about="2.3.1.218">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phenylpropanoylacetyl-CoA synthase</skos:prefLabel>
<skos:altLabel>phenylpropanoyl-diketide-CoA synthase</skos:altLabel>
<activity rdf:resource="2.3.1.218#SIPCD4C5E07C666DE1C"/>
<activity rdf:resource="2.3.1.218#SIPE7E271E667822662"/>
<rdfs:comment>The enzyme has been characterized from the plant Curcuma longa (turmeric).</rdfs:comment>
<rdfs:comment>It prefers feruloyl-CoA, and has no activity with cinnamoyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19258320"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.218#SIPCD4C5E07C666DE1C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-feruloyl-CoA + H(+) + malonyl-CoA = (E)-feruloylacetyl-CoA + CO2 + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.218#SIPE7E271E667822662">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-coumaroyl-CoA + H(+) + malonyl-CoA = (4-coumaroyl)acetyl-CoA + CO2 + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19258320">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19258320"/>
