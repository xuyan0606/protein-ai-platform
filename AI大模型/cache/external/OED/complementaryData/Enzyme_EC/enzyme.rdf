</rdf:Description>
<rdf:Description rdf:about="2.7.1.174">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.1.n5"/>
<skos:prefLabel>diacylglycerol kinase (CTP)</skos:prefLabel>
<skos:altLabel>CTP-dependent diacylglycerol kinase</skos:altLabel>
<skos:altLabel>DAG kinase</skos:altLabel>
<skos:altLabel>diacylglycerol kinase (CTP dependent)</skos:altLabel>
<skos:altLabel>diglyceride kinase</skos:altLabel>
<activity rdf:resource="2.7.1.174#SIP54360C61315CBD0B"/>
<rdfs:comment>Involved in synthesis of membrane phospholipids and the neutral lipid triacylglycerol.</rdfs:comment>
<rdfs:comment>Unlike the diacylglycerol kinases from bacteria, plants, and animals (cf. EC 2.7.1.107), the enzyme from Saccharomyces cerevisiae utilizes CTP.</rdfs:comment>
<rdfs:comment>The enzyme can also use dCTP, but not ATP, GTP or UTP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18458075"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18458076"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21071438"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.174#SIP54360C61315CBD0B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycerol + CTP = a 1,2-diacyl-sn-glycero-3-phosphate + CDP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18458075">
