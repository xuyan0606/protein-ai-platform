<rdf:Description rdf:about="3.4.19.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>gamma-D-glutamyl-meso-diaminopimelate peptidase</skos:prefLabel>
<skos:altLabel>endopeptidase I</skos:altLabel>
<skos:altLabel>gamma-D-glutamyl-L-diamino acid endopeptidase I</skos:altLabel>
<skos:altLabel>gamma-D-glutamyl-meso-diaminopimelate peptidase I</skos:altLabel>
<activity rdf:resource="3.4.19.11#SIP6790CE20F5A8039A"/>
<rdfs:comment>Metallopeptidase from Bacillus sphaericus, the substrates being components of the bacterial spore wall.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M14.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/849747"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3922755"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8503890"/>
<rdfs:subClassOf rdf:resource="3.4.19.-"/>
<skos:broaderTransitive rdf:resource="3.4.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.19.11#SIP6790CE20F5A8039A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of gamma-D-glutamyl bonds to the L-terminus (position 7) of meso-diaminopimelic acid (meso-A2pm) in 7-(L-Ala-gamma-D-Glu)-meso-A2pm and 7-(L-Ala-gamma-D-Glu)-7-(D-Ala)-meso-A2pm. It is required that the D-terminal amino and carboxy groups of meso-A2pm are unsubstituted.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/849747">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/849747"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/849747"/>
</rdf:Description>
