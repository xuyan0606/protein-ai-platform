<rdf:Description rdf:about="1.3.1.103">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-haloacrylate reductase</skos:prefLabel>
<activity rdf:resource="1.3.1.103#SIP6AB39ACFD8D06796"/>
<rdfs:comment>The enzyme acts in the degradation pathway of unsaturated organohalogen compounds by the bacterium Burkholderia sp. WS.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15781461"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
