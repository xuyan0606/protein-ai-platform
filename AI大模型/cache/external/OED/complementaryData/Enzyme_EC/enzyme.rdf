<replaces rdf:resource="1.2.1.n1"/>
<skos:prefLabel>3,4-dehydroadipyl-CoA semialdehyde dehydrogenase (NADP(+))</skos:prefLabel>
<skos:altLabel>3,4-dehydroadipyl-CoA semialdehyde dehydrogenase</skos:altLabel>
<activity rdf:resource="1.2.1.77#SIP33C213AB8CDF40BF"/>
<rdfs:comment>This enzyme catalyzes a step in the aerobic benzoyl-coenzyme A catabolic pathway in Azoarcus evansii and Burkholderia xenovorans.</rdfs:comment>
