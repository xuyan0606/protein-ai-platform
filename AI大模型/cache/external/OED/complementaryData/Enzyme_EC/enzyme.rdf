<rdf:Description rdf:about="4.8.1.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thiohydroximate-O-sulfate sulfate/sulfur-lyase (nitrile-forming)</skos:prefLabel>
<activity rdf:resource="4.8.1.5#SIPFBB8B2A28B074B58"/>
<rdfs:comment>The enzyme is involved in the breakdown of glucosinolates.</rdfs:comment>
<rdfs:comment>It can act on both aliphatic and aromatic glucosinolates, and forms nitrile-containing products. cf. EC 4.8.1.6 and EC 4.8.1.7.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18987211"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19224919"/>
<rdfs:subClassOf rdf:resource="4.8.1.-"/>
<skos:broaderTransitive rdf:resource="4.8.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.8.1.5#SIPFBB8B2A28B074B58">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (Z)-N-(sulfonatooxy)alkanimidothioate = a nitrile + sulfate + sulfur.</rdfs:label>
</rdf:Description>
