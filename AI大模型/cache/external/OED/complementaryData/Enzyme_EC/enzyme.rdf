</rdf:Description>
<rdf:Description rdf:about="2.3.1.196">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>benzyl alcohol O-benzoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.196#SIP7D5BF1FED1CD01B3"/>
<rdfs:comment>The enzyme is involved in volatile benzenoid and benzoic acid biosynthesis.</rdfs:comment>
<rdfs:comment>The enzyme from Petunia hybrida also catalyzes the formation of 2-phenylethyl benzoate from benzoyl-CoA and 2-phenylethanol.</rdfs:comment>
<rdfs:comment>The apparent catalytic efficiency of the enzyme from Petunia hybrida with benzoyl-CoA is almost 6-fold higher than with acetyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12226525"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15286288"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.196#SIP7D5BF1FED1CD01B3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>benzoyl-CoA + benzyl alcohol = benzyl benzoate + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12226525">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12226525"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12226525"/>
</rdf:Description>
