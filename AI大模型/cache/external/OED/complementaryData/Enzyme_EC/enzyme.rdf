<citation rdf:resource="http://purl.uniprot.org/citations/12060294"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15584955"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.195#SIP7B2404D4A31F6C5A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(Z)-2-phenyl-1-thioacetohydroximate + UDP-alpha-D-glucose = (Z)-desulfoglucotropeolin + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.195#SIP7CE00B5A09282226">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (Z)-omega-(methylsulfanyl)alkyl-thiohydroximate + UDP-alpha-D-glucose = an aliphatic (Z)-desulfo-glucosinolate + UDP.</rdfs:label>
</rdf:Description>
