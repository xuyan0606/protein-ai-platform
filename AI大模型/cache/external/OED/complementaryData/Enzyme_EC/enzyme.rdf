<rdf:Description rdf:about="2.1.1.261">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-dimethylallyltryptophan N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.261#SIPA547ECA483E0C643"/>
<rdfs:comment>The enzyme catalyzes a step in the pathway leading to biosynthesis of ergot alkaloids in certain fungi.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18678866"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.261#SIPA547ECA483E0C643">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-(3-methylbut-2-enyl)-L-tryptophan + S-adenosyl-L-methionine = 4-(3-methylbut-2-enyl)-L-abrine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18678866">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
