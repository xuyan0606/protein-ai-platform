<rdf:Description rdf:about="1.14.15.13">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pulcherriminic acid synthase</skos:prefLabel>
<skos:altLabel>cyclo-L-leucyl-L-leucyl dipeptide oxidase</skos:altLabel>
<skos:altLabel>CYP134A1</skos:altLabel>
<activity rdf:resource="1.14.15.13#SIP0CA3227DAB6B3216"/>
<rdfs:comment>A P450 enzyme from the bacterium Bacillus subtilis.</rdfs:comment>
<rdfs:comment>The order of events during the overall reaction is unknown.</rdfs:comment>
<rdfs:comment>Pulcherrimic acid spontaneously forms an iron chelate with Fe(3+) to form the red pigment pulcherrimin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20690619"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.13#SIP0CA3227DAB6B3216">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclo(L-leucyl-L-leucyl) + 4 H(+) + 3 O2 + 6 reduced [2Fe-2S]-[ferredoxin] = 4 H2O + 6 oxidized [2Fe-2S]-[ferredoxin] + pulcherriminic acid.</rdfs:label>
</rdf:Description>
