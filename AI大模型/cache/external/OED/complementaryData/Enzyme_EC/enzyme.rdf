<skos:prefLabel>L-glutamate oxidase</skos:prefLabel>
<activity rdf:resource="1.4.3.11#SIP5BAC436D9C6632C0"/>
<rdfs:comment>The enzyme from Azotobacter previously listed under this number, which did not produce H2O2, was a crude cell-free extract which probably contained catalase.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.4.3.-"/>
<skos:broaderTransitive rdf:resource="1.4.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.11#SIP5BAC436D9C6632C0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-glutamate + O2 = 2-oxoglutarate + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclohexylamine oxidase</skos:prefLabel>
<activity rdf:resource="1.4.3.12#SIPFB91FCDEAA69009B"/>
<rdfs:comment>Some other cyclic amines can act instead of cyclohexylamine, but not simple aliphatic and aromatic amides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18451"/>
<rdfs:subClassOf rdf:resource="1.4.3.-"/>
<skos:broaderTransitive rdf:resource="1.4.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.12#SIPFB91FCDEAA69009B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclohexylamine + H2O + O2 = cyclohexanone + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18451">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18451"/>
