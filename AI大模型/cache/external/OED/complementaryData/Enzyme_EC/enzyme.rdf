<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[amino-group carrier protein]-C-terminal-gamma-(L-ornithyl)-L-glutamate + H2O = [amino-group carrier protein]-C-terminal-L-glutamate + L-ornithine.</rdfs:label>
</rdf:Description>
