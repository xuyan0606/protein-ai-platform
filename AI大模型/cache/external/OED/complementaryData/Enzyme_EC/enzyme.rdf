<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-(indol-3-yl)acetaldehyde oxime = (indol-3-yl)acetonitrile + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/14099566">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
