<rdf:Description rdf:about="3.5.1.55">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>long-chain-fatty-acyl-glutamate deacylase</skos:prefLabel>
<skos:altLabel>long-chain aminoacylase</skos:altLabel>
<activity rdf:resource="3.5.1.55#SIPF6D5F1551B7AEA9A"/>
<rdfs:comment>Does not act on acyl derivatives of other amino acids.</rdfs:comment>
<rdfs:comment>Optimum chain length of acyl residue is 12 to 16.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7096313"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.55#SIPF6D5F1551B7AEA9A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-(long-chain-fatty-acyl)-L-glutamate = a long-chain fatty acid + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7096313">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
