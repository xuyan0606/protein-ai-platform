<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(4S)-4-hydroxy-2-oxoglutarate = glyoxylate + pyruvate.</rdfs:label>
</rdf:Description>
