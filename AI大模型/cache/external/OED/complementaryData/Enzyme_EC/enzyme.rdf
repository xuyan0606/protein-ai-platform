<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-hydroxyethane-1-sulfonate + NAD(+) = H(+) + NADH + sulfoacetaldehyde.</rdfs:label>
</rdf:Description>
