<rdf:Description rdf:about="3.5.4.26">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diaminohydroxyphosphoribosylaminopyrimidine deaminase</skos:prefLabel>
<activity rdf:resource="3.5.4.26#SIPF2797B1A24B8F54F"/>
<rdfs:comment>The substrate is the product of EC 3.5.4.25.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30756"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.4.26#SIPF2797B1A24B8F54F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,5-diamino-6-hydroxy-4-(5-phosphoribosylamino)-pyrimidine + H(+) + H2O = 5-amino-6-(5-phospho-D-ribosylamino)uracil + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/30756">
