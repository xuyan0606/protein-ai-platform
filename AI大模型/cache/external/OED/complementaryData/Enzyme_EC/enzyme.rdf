<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome c553] + formate = CO2 + 2 Fe(II)-[cytochrome c553] + H(+).</rdfs:label>
</rdf:Description>
