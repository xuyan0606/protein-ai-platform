<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + descarbamoylnovobiocin = novobiocin + phosphate.</rdfs:label>
</rdf:Description>
