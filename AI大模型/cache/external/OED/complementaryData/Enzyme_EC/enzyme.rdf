<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>amicoumacin phosphatase</skos:prefLabel>
<activity rdf:resource="3.1.3.107#SIP4397B68CF7F74B9A"/>
<rdfs:comment>This bacterial enzyme activates the antibiotic amicoumacin A by removing a phosphate group that is added by EC 2.7.1.230.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30181282"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
