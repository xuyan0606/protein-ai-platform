<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbon disulfide + 2 H2O = CO2 + 2 H(+) + 2 hydrogen sulfide.</rdfs:label>
</rdf:Description>
