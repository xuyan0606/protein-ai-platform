<rdf:Description rdf:about="2.4.1.320">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>1,4-beta-mannosyl-N-acetylglucosamine phosphorylase</skos:prefLabel>
<activity rdf:resource="2.4.1.320#SIP063D000C617C751E"/>
<rdfs:comment>The enzyme isolated from the anaerobic bacterium Bacteroides thetaiotaomicron is involved in the degradation of host-derived N-glycans.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23943617"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.320#SIP063D000C617C751E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-O-beta-D-mannopyranosyl-N-acetyl-D-glucosamine + phosphate = alpha-D-mannose 1-phosphate + N-acetyl-D-glucosamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23943617">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23943617"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23943617"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.321">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cellobionic acid phosphorylase</skos:prefLabel>
<activity rdf:resource="2.4.1.321#SIPFA41705AB0FB85C2"/>
<rdfs:comment>The enzyme occurs in cellulolytic bacteria and fungi.</rdfs:comment>
<rdfs:comment>It catalyzes the reversible phosphorolysis of cellobionic acid.</rdfs:comment>
<rdfs:comment>In the synthetic direction it produces 4-O-beta-D-glucopyranosyl-D-glucuronate from alpha-D-glucose 1-phosphate and D-glucuronate with low activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24055472"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.321#SIPFA41705AB0FB85C2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-O-beta-D-glucopyranosyl-D-gluconate + phosphate = alpha-D-glucose 1-phosphate + D-gluconate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24055472">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24055472"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24055472"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.322">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>devancosaminyl-vancomycin vancosaminetransferase</skos:prefLabel>
<skos:altLabel>desvancosaminyl-vancomycin vancosaminetransferase</skos:altLabel>
<skos:altLabel>devancosamine-vancomycin TDP-vancosaminyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.322#SIP90C93E9D762442D9"/>
<rdfs:comment>The enzyme, isolated from the bacterium Amycolatopsis orientalis, catalyzes the ultimate step in the biosynthesis of the antibiotic vancomycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11294642"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15122882"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.322#SIP90C93E9D762442D9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>devancoaminyl-vancomycin + dTDP-beta-L-vancosamine = dTDP + H(+) + vancomycin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11294642">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11294642"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/11294642"/>
</rdf:Description>
