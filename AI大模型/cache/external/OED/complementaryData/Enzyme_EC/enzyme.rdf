</rdf:Description>
<rdf:Description rdf:about="4.2.99.24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thebaine synthase</skos:prefLabel>
<skos:altLabel>THS</skos:altLabel>
<activity rdf:resource="4.2.99.24#SIP2F39910E738A6A7F"/>
<rdfs:comment>Isolated from the plant Papaver somniferum (opium poppy).</rdfs:comment>
<rdfs:comment>The reaction occurs spontaneously when the pH is between 8-9, but the enzyme is required at the physiological pH, which is close to 7.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29807982"/>
<rdfs:subClassOf rdf:resource="4.2.99.-"/>
<skos:broaderTransitive rdf:resource="4.2.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.99.24#SIP2F39910E738A6A7F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(7S)-O-acetylsalutaridinol = acetate + H(+) + thebaine.</rdfs:label>
</rdf:Description>
