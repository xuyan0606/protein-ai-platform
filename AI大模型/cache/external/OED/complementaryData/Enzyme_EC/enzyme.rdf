<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cytokinin riboside 5'-monophosphate phosphoribohydrolase</skos:prefLabel>
<activity rdf:resource="3.2.2.n1#SIP2FFBA1A7C0926A3E"/>
<activity rdf:resource="3.2.2.n1#SIP9AEC8A8898040E93"/>
<rdfs:comment>The enzyme, isolated from plants, is involved in the activation of cytokinins (such as N(6)-(dimethylallyl)adenine and trans-zeatin) plant hormones that are important for meristem activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17287810"/>
