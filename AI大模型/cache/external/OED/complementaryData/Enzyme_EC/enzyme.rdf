<rdf:Description rdf:about="2.7.1.182">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phytol kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.182#SIP71A1C6E65FCB7910"/>
<rdfs:comment>The enzyme is found in plants and photosynthetic algae and is involved in phytol salvage.</rdfs:comment>
<rdfs:comment>It can use UTP as an alternative phosphate donor with lower activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16306049"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16361393"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.182#SIP71A1C6E65FCB7910">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CTP + phytol = CDP + H(+) + phytyl phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16306049">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
