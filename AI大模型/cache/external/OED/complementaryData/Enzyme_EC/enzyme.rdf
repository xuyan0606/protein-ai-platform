<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-carnitine + ATP + CoA = (R)-carnitinyl-CoA + AMP + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.48#SIPD491A35F5E50C5A5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + CoA + crotonobetaine = AMP + crotonobetainyl-CoA + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.48#SIP52354E758B3E5F70">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-(trimethylamino)butanoate + ATP + CoA = 4-(trimethylamino)butanoyl-CoA + AMP + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7815937">
