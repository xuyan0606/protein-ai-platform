<citation rdf:resource="http://purl.uniprot.org/citations/15369826"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15713082"/>
<rdfs:subClassOf rdf:resource="1.1.3.-"/>
<skos:broaderTransitive rdf:resource="1.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.3.17#SIPE7AC1526BDDE9D32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>choline + H2O + 2 O2 = glycine betaine + H(+) + 2 H2O2.</rdfs:label>
</rdf:Description>
