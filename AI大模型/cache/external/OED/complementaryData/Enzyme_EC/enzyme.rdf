<rdf:Description rdf:about="3.7.1.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-diketone hydrolase</skos:prefLabel>
<skos:altLabel>oxidized PVA hydrolase</skos:altLabel>
<activity rdf:resource="3.7.1.7#SIPA4ACCFF416E89E20"/>
<rdfs:comment>Also acts on the product of the action of EC 1.1.3.18 on polyvinyl alcohols.</rdfs:comment>
<rdfs:comment>Involved in the bacterial degradation of polyvinyl alcohol.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
