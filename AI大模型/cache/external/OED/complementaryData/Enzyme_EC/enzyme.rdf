<skos:prefLabel>aklavinone 12-hydroxylase</skos:prefLabel>
<skos:altLabel>aklavinone 11-hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.13.180#SIPB7301C528D530205"/>
<rdfs:comment>The enzymes from the Gram-positive bacteria Streptomyces peucetius and Streptomyces purpurascens participate in the biosynthesis of daunorubicin, doxorubicin and rhodomycins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7773378"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10082933"/>
