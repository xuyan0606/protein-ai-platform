<rdfs:label>H2O + N(tele)-phospho-L-histidyl-[protein] = L-histidyl-[protein] + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.9.1.3#SIP7A3CEAE5EE19336C">
