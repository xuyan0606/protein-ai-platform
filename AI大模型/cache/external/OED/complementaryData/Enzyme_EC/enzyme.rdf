<rdf:Description rdf:about="2.5.1.142">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nerylneryl diphosphate synthase</skos:prefLabel>
<skos:altLabel>CPT2</skos:altLabel>
<activity rdf:resource="2.5.1.142#SIP2036531E95E30C75"/>
<rdfs:comment>Isolated from the plant Solanum lycopersicum (tomato).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23134568"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25786135"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.142#SIP2036531E95E30C75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dimethylallyl diphosphate + 3 isopentenyl diphosphate = 3 diphosphate + nerylneryl diphosphate.</rdfs:label>
</rdf:Description>
