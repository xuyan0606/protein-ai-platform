<rdf:Description rdf:about="2.6.1.103">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(S)-3,5-dihydroxyphenylglycine transaminase</skos:prefLabel>
<activity rdf:resource="2.6.1.103#SIPEF528D59F7BFB404"/>
<rdfs:comment>The enzyme from the bacterium Amycolatopsis orientalis catalyzes the reaction in the reverse direction as part of the biosynthesis of the (S)-3,5-dihydroxyphenylglycine constituent of the glycopeptide antibiotic chloroeremomycin.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.103#SIPEF528D59F7BFB404">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-3,5-dihydroxyphenylglycine + 2-oxoglutarate = 2-(3,5-dihydroxyphenyl)-2-oxoacetate + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.104">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-dehydro-glucose-6-phosphate--glutamate transaminase</skos:prefLabel>
<skos:altLabel>3-oxo-glucose-6-phosphate:glutamate aminotransferase</skos:altLabel>
<activity rdf:resource="2.6.1.104#SIPEECED4A97EC34CA8"/>
<rdfs:comment>The enzyme, found in the bacterium Bacillus subtilis, is involved in a kanosamine biosynthesis pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19342798"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23586652"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.104#SIPEECED4A97EC34CA8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-dehydro-D-glucose 6-phosphate + L-glutamate = 2-oxoglutarate + D-kanosamine 6-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19342798">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/19342798"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/19342798"/>
</rdf:Description>
