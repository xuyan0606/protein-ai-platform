<rdf:Description rdf:about="2.1.1.302">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-hydroxy-5-methyl-1-naphthoate 3-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.302#SIP8C77C310B7375DE8"/>
<rdfs:comment>The enzyme from the bacterium Streptomyces sahachiroi is involved in the biosynthesis of 3-methoxy-5-methyl-1-naphthoate, a component of of the the antitumor antibiotic azinomycin B.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20485749"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
