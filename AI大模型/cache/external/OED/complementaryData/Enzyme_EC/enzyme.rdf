<rdf:Description rdf:about="1.8.7.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>assimilatory sulfite reductase (ferredoxin)</skos:prefLabel>
<skos:altLabel>sulfite reductase (ferredoxin)</skos:altLabel>
<activity rdf:resource="1.8.7.1#SIP18069F169174FC84"/>
<rdfs:comment>The enzyme participates in sulfate assimilation.</rdfs:comment>
<rdfs:comment>While it is usually found in cyanobacteria, plants and algae, it has also been reported in bacteria (cf. EC 1.8.1.2).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4390248"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8347657"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9661674"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10939523"/>
