<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>leukotriene-C4 hydrolase</skos:prefLabel>
<skos:altLabel>gamma-glutamyl leukotrienase</skos:altLabel>
<activity rdf:resource="3.4.19.14#SIP6D12B84BBDFC0F31"/>
<rdfs:comment>The mouse enzyme is specific for leukotriene C4, while the human enzyme also has considerable activity toward glutathione and oxidized glutathione (cf. EC 3.4.19.13).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9139674"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11463821"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12163373"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21447318"/>
<rdfs:subClassOf rdf:resource="3.4.19.-"/>
<skos:broaderTransitive rdf:resource="3.4.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.19.14#SIP6D12B84BBDFC0F31">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + leukotriene C4 = L-glutamate + leukotriene D4.</rdfs:label>
</rdf:Description>
