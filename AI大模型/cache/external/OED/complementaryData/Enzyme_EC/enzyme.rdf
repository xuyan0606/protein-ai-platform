<rdf:Description rdf:about="4.4.1.24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(2R)-sulfolactate sulfo-lyase</skos:prefLabel>
<skos:altLabel>sulfolactate sulfo-lyase</skos:altLabel>
<activity rdf:resource="4.4.1.24#SIP62C193A33B308BD0"/>
<rdfs:comment>This inducible enzyme participates in cysteate degradation in Paracoccus pantotrophus NKNCYSA and in 3-sulfolactate degradation in Chromohalobacter salexigens.</rdfs:comment>
<rdfs:comment>The enzyme is specific for the (R) isomer.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12013276"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15758220"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20007648"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
<skos:broaderTransitive rdf:resource="4.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.24#SIP62C193A33B308BD0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R)-3-sulfolactate = H(+) + pyruvate + sulfite.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12013276">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12013276"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12013276"/>
</rdf:Description>
