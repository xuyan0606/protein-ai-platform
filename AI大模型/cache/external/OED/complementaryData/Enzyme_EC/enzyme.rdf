<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cyclic (2R)-2,3-bisphosphoglycerate + H2O = (2R)-2,3-bisphosphoglycerate + 2 H(+).</rdfs:label>
</rdf:Description>
