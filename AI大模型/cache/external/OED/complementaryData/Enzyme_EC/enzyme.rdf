<rdf:Description rdf:about="6.2.1.75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>indoleacetate--CoA ligase</skos:prefLabel>
<activity rdf:resource="6.2.1.75#SIPDC02FB5B3CA6D8D7"/>
<rdfs:comment>The enzyme, characterized from the bacterium Aromatoleum aromaticum, is involved in degradation of (indol-3-yl)acetate.</rdfs:comment>
<rdfs:comment>It is also active with phenylacetate and the non-physiological compound (2-naphthyl)acetate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27102732"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
