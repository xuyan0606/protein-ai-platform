<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22941084"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24657616">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24657616"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24657616"/>
</rdf:Description>
