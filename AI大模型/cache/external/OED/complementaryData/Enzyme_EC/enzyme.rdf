<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5beta-cholestan-3-one + NADP(+) = cholest-4-en-3-one + H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.3#SIPF6AF1CB86B924754">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
