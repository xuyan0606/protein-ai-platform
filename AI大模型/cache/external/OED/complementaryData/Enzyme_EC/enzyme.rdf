<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>With an iron-sulfur protein as acceptor</skos:prefLabel>
<rdfs:subClassOf rdf:resource="1.17.-.-"/>
<skos:broaderTransitive rdf:resource="1.17.-.-"/>
<skos:narrowerTransitive rdf:resource="1.17.7.1"/>
<skos:narrowerTransitive rdf:resource="1.17.7.2"/>
<skos:narrowerTransitive rdf:resource="1.17.7.3"/>
<skos:narrowerTransitive rdf:resource="1.17.7.4"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.7.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.17.4.3"/>
<skos:prefLabel>(E)-4-hydroxy-3-methylbut-2-enyl-diphosphate synthase (ferredoxin)</skos:prefLabel>
<skos:altLabel>(E)-4-hydroxy-3-methylbut-2-enyl diphosphate synthase</skos:altLabel>
<skos:altLabel>4-hydroxy-3-methylbut-2-en-1-yl diphosphate synthase</skos:altLabel>
<activity rdf:resource="1.17.7.1#SIP78DDE6126E1874D0"/>
<rdfs:comment>Forms part of an alternative non-mevalonate pathway for isoprenoid biosynthesis.</rdfs:comment>
<rdfs:comment>Bacteria have a similar enzyme that uses flavodoxin rather than ferredoxin (cf. EC 1.17.7.3).</rdfs:comment>
<rdfs:comment>The enzyme from the plant Arabidopsis thaliana is active with photoreduced 5-deazaflavin but not with flavodoxin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12434382"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15650872"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15792953"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16480720"/>
<rdfs:subClassOf rdf:resource="1.17.7.-"/>
<skos:broaderTransitive rdf:resource="1.17.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.7.1#SIP78DDE6126E1874D0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E)-4-hydroxy-3-methylbut-2-enyl diphosphate + H2O + 2 oxidized [2Fe-2S]-[ferredoxin] = 2-C-methyl-D-erythritol 2,4-cyclic diphosphate + H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12434382">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12434382"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12434382"/>
</rdf:Description>
