<rdf:Description rdf:about="2.1.1.128">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(RS)-norcoclaurine 6-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.128#SIP514CBE867564693F"/>
<activity rdf:resource="2.1.1.128#SIPA7183B41BA516333"/>
<rdfs:comment>The enzyme will also catalyze the 6-O-methylation of (RS)-norlaudanosoline to form 6-O-methyl-norlaudanosoline, but this alkaloid has not been found to occur in plants.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7925429"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17405035"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
