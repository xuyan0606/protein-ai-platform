<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8357532"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/8357532"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>quinoline-4-carboxylate 2-oxidoreductase</skos:prefLabel>
<skos:altLabel>quinaldic acid 4-oxidoreductase</skos:altLabel>
<skos:altLabel>quinoline-4-carboxylic acid 2-oxidoreductase</skos:altLabel>
<activity rdf:resource="1.3.99.19#SIPD9D40BB673C3EA8B"/>
<rdfs:comment>Quinoline, 4-methylquinoline and 4-chloroquinoline can also serve as substrates for the enzyme from Agrobacterium sp. 1B.</rdfs:comment>
<rdfs:comment>Iodonitrotetrazolium chloride, thionine, menadione and 2,6-dichlorophenolindophenol can act as electron acceptors.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1418685"/>
<rdfs:subClassOf rdf:resource="1.3.99.-"/>
<skos:broaderTransitive rdf:resource="1.3.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.99.19#SIPD9D40BB673C3EA8B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + quinoline-4-carboxylate = 2-oxo-1,2-dihydroquinoline-4-carboxylate + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1418685">
