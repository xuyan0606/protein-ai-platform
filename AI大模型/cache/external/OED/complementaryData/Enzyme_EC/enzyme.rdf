<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>indole + O2 + reduced [NADPH--hemoprotein reductase] = H(+) + H2O + indolin-2-one + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
