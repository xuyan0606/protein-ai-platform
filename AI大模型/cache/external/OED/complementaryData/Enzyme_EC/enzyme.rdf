<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(9Z)-hexadecenoyl-CoA + [Wnt protein]-L-serine = [Wnt protein]-O-(9Z)-hexadecenoyl-L-serine + CoA.</rdfs:label>
</rdf:Description>
