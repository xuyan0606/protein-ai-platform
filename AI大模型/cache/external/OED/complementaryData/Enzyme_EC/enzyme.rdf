</rdf:Description>
<rdf:Description rdf:about="1.2.1.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-hydroxybenzaldehyde dehydrogenase (NADP(+))</skos:prefLabel>
<skos:altLabel>p-hydroxybenzaldehyde dehydrogenase</skos:altLabel>
<activity rdf:resource="1.2.1.96#SIP5598B5173E2CC607"/>
<rdfs:comment>Involved in the aerobic pathway for degradation of toluene, 4-methylphenol, and 2,4-xylenol by several Pseudomonas strains.</rdfs:comment>
<rdfs:comment>The enzyme is also active with 4-hydroxy-3-methylbenzaldehyde. cf. EC 1.2.1.64.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2019564"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23736872"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
