<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-lysine oxidase</skos:prefLabel>
<activity rdf:resource="1.4.3.14#SIP1C1F22E46D310B79"/>
<rdfs:comment>Also acts, more slowly, on L-ornithine, L-phenylalanine, L-arginine and L-histidine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6101334"/>
