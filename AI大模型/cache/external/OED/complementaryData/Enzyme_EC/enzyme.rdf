<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of the -Gly-|-Gly- bond in the pentaglycine inter-peptide link joining staphylococcal cell wall peptidoglycans.</rdfs:label>
</rdf:Description>
