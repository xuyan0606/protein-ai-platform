<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (3R)-hydroxyacyl-[ACP] + a UDP-3-O-[(3R)-3-hydroxyacyl]-alpha-D-glucosamine = a UDP-2-N,3-O-bis[(3R)-3-hydroxyacyl]-alpha-D-glucosamine + H(+) + holo-[ACP].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.191#SIP3B7CA8D58567E463">
