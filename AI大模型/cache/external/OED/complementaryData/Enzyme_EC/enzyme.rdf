<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>demethylmacrocin + S-adenosyl-L-methionine = H(+) + macrocin + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
