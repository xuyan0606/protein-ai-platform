<rdf:Description rdf:about="1.14.15.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>C-19 steroid 1alpha-hydroxylase</skos:prefLabel>
<skos:altLabel>CYP260A1</skos:altLabel>
<activity rdf:resource="1.14.15.19#SIP1548D5E6C8153789"/>
<activity rdf:resource="1.14.15.19#SIP18E94746416992B3"/>
<rdfs:comment>The enzyme, characterized from the bacterium Sorangium cellulosum, is a class I cytochrome P450, and uses ferredoxin as its electron donor.</rdfs:comment>
<rdfs:comment>It was shown to act on several C-19 steroid substrates, including testosterone, androstenedione, testosterone-acetate and 11-oxoandrostenedione.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19696019"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26478560"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.19#SIP1548D5E6C8153789">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] + testosterone = 1alpha-hydroxytestosterone + H2O + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.19#SIP18E94746416992B3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>androst-4-ene-3,17-dione + 2 H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] = 1alpha-hydroxyandrost-4-ene-3,17-dione + H2O + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
