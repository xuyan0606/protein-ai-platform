<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucuronan lyase</skos:prefLabel>
<activity rdf:resource="4.2.2.14#SIP7872015480DE25F3"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9283009"/>
<rdfs:subClassOf rdf:resource="4.2.2.-"/>
<skos:broaderTransitive rdf:resource="4.2.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.2.14#SIP7872015480DE25F3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Eliminative cleavage of (1->4)-beta-D-glucuronans to give oligosaccharides with 4-deoxy-beta-D-gluc-4-enuronosyl groups at their non-reducing ends. Complete degradation of glucuronans results in the formation of tetrasaccharides.</rdfs:label>
</rdf:Description>
