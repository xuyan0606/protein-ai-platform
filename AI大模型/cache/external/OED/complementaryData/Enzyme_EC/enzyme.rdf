<rdf:Description rdf:about="3.1.3.82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-glycero-beta-D-manno-heptose 1,7-bisphosphate 7-phosphatase</skos:prefLabel>
<activity rdf:resource="3.1.3.82#SIPF43BAD6AD3A88518"/>
<rdfs:comment>The enzyme is involved in biosynthesis of ADP-L-glycero-beta-D-manno-heptose, which is utilized for assembly of the lipopolysaccharide inner core in Gram-negative bacteria.</rdfs:comment>
<rdfs:comment>In vitro the catalytic efficiency with the beta-anomer is 100-200-fold higher than with the alpha-anomer.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11751812"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12101286"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20050615"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.3.82#SIPF43BAD6AD3A88518">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-glycero-beta-D-manno-heptose 1,7-bisphosphate + H2O = D-glycero-beta-D-manno-heptose 1-phosphate + phosphate.</rdfs:label>
</rdf:Description>
