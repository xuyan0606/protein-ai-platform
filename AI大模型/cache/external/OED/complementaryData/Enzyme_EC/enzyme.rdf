<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + cholest-1,4-dien-3-one + H2O = 25-hydroxycholest-1,4-dien-3-one + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.10#SIP1E1CA669CB9A3DA7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + calciol + H2O = AH2 + calcidiol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.17.99.10#SIP0E8766882BF5CDBA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + cholest-4,6-dien-3-one + H2O = 25-hydroxycholest-4,6-dien-3-one + AH2.</rdfs:label>
</rdf:Description>
