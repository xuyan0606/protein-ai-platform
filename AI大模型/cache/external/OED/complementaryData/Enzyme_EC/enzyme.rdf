<rdf:Description rdf:about="4.2.1.135">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-N-acetylglucosamine 4,6-dehydratase (configuration-retaining)</skos:prefLabel>
<activity rdf:resource="4.2.1.135#SIPCFDA132F8665A3BD"/>
<rdfs:comment>This is the first enzyme in the biosynthetic pathway of N,N'-diacetylbacillosamine, the first carbohydrate in the glycoprotein N-linked heptasaccharide in Campylobacter jejuni.</rdfs:comment>
<rdfs:comment>This enzyme belongs to the short-chain dehydrogenase/reductase family of enzymes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16286454"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17087520"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.135#SIPCFDA132F8665A3BD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>UDP-N-acetyl-alpha-D-glucosamine = H2O + UDP-2-acetamido-2,6-dideoxy-alpha-D-xylo-hex-4-ulose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16286454">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
