<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22907798"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.17.1.6"/>
<replaces rdf:resource="1.17.98.1"/>
<replaces rdf:resource="1.17.99.5"/>
<skos:prefLabel>3alpha-hydroxybile acid CoA 3-dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.1.1.395#SIPA32E008D038B6098"/>
<activity rdf:resource="1.1.1.395#SIPE2BE68DCE5A5B7BF"/>
<activity rdf:resource="1.1.1.395#SIP4592D39A4C535093"/>
<activity rdf:resource="1.1.1.395#SIP5067437EBA2518BB"/>
<activity rdf:resource="1.1.1.395#SIPFC160784744F9512"/>
<rdfs:comment>This bacterial enzyme is involved in the 7-dehydroxylation process associated with bile acid degradation.</rdfs:comment>
<rdfs:comment>The enzyme has very little activity with unconjugated bile acid substrates.</rdfs:comment>
<rdfs:comment>It has similar activity with choloyl-CoA, chenodeoxycholoyl-CoA, deoxycholoyl-CoA, and lithocholoyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7766153"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23836456"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395#SIPA32E008D038B6098">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 3alpha-hydroxy bile acid CoA + NAD(+) = a 3-oxo bile acid CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395#SIPE2BE68DCE5A5B7BF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>choloyl-CoA + NAD(+) = 7alpha,12alpha-dihydroxy-3-oxochol-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395#SIP4592D39A4C535093">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>chenodeoxycholoyl-CoA + NAD(+) = 7alpha-hydroxy-3-oxochol-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395#SIP5067437EBA2518BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>deoxycholoyl-CoA + NAD(+) = 12alpha-hydroxy-3-oxocholan-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.1.395#SIPFC160784744F9512">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>lithocholoyl-CoA + NAD(+) = 3-oxocholan-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7766153">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7766153"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/7766153"/>
</rdf:Description>
