<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(+)-larreatricin hydroxylase</skos:prefLabel>
<activity rdf:resource="1.14.99.47#SIPA95E5342687A2EEE"/>
<rdfs:comment>Isolated from the plant Larrea tridentata (creosote bush).</rdfs:comment>
<rdfs:comment>The enzyme has a strong preference for the 3' position of (+)-larreatricin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12960376"/>
<rdfs:subClassOf rdf:resource="1.14.99.-"/>
