<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 flaviolin + H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] = 3,3'-biflaviolin + 2 H2O + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
