</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24244885">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24244885"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24244885"/>
