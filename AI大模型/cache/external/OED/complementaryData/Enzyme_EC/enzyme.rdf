</rdf:Description>
<rdf:Description rdf:about="2.4.1.284">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-deoxystreptamine glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.284#SIP7CE351E948F933C8"/>
<rdfs:comment>Involved in the biosynthesis of kanamycin B and kanamycin C.</rdfs:comment>
<rdfs:comment>Also catalyzes EC 2.4.1.283, but activity is only one fifth of that with UDP-alpha-D-glucose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21983602"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
