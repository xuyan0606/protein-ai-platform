<skos:broaderTransitive rdf:resource="3.4.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.11.20#SIPB369BEEE228EECF2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Differs from other aminopeptidases in broad specificity for amino acids in the P1 position and the ability to hydrolyze peptides of four or five residues that contain Pro in the P1' position.</rdfs:label>
</rdf:Description>
