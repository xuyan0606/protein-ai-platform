<skos:altLabel>anhydroneuraminidase</skos:altLabel>
<skos:altLabel>sialglycoconjugate N-acylneuraminylhydrolase (2,7-cyclizing)</skos:altLabel>
<skos:altLabel>sialidase L</skos:altLabel>
<activity rdf:resource="4.2.2.15#SIP5D1DCE1D7C2111BC"/>
<rdfs:comment>Also acts on N-glycolylneuraminate glycosides. cf. EC 3.2.1.18 and EC 3.2.1.129.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2254319"/>
