<citation rdf:resource="http://purl.uniprot.org/citations/11863440"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16698895"/>
<rdfs:subClassOf rdf:resource="1.4.3.-"/>
<skos:broaderTransitive rdf:resource="1.4.3.-"/>
</rdf:Description>
