<rdf:Description rdf:about="4.1.2.64">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-dehydro-3-deoxy-L-fuconate aldolase</skos:prefLabel>
