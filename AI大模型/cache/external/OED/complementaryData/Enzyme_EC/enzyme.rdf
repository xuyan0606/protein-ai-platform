<rdf:Description rdf:about="2.7.7.78">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GDP-D-glucose phosphorylase</skos:prefLabel>
<activity rdf:resource="2.7.7.78#SIP8FEBB2DE9A886FF6"/>
<rdfs:comment>The enzyme may be involved in prevention of misincorporation of glucose in place of mannose residues into glycoconjugates i.e. to remove accidentally produced GDP-alpha-D-glucose.</rdfs:comment>
<rdfs:comment>Activities with GDP-L-galactose, GDP-D-mannose and UDP-D-glucose are all less than 3% that with GDP-D-glucose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21507950"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.78#SIP8FEBB2DE9A886FF6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GDP-alpha-D-glucose + phosphate = alpha-D-glucose 1-phosphate + GDP + H(+).</rdfs:label>
</rdf:Description>
