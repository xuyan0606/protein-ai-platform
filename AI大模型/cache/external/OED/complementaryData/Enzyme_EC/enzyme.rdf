<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-lysyl(9)-[histone H3] + 2 S-adenosyl-L-methionine = 2 H(+) + N(6),N(6)-dimethyl-L-lysyl(9)-[histone H3] + 2 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
