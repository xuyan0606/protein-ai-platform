<rdf:Description rdf:about="1.8.3.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>farnesylcysteine lyase</skos:prefLabel>
<skos:altLabel>FC lyase</skos:altLabel>
<activity rdf:resource="1.8.3.6#SIP6BC3F757E92454C0"/>
<rdfs:comment>In contrast to mammalian EC 1.8.3.5 the farnesylcysteine lyase from Arabidopsis is specific for S-farnesyl-L-cysteine and shows no activity with S-geranylgeranyl-L-cysteine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17425716"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19969520"/>
