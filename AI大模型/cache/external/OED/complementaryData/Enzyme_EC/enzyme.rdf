<rdf:Description rdf:about="2.8.3.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>malonate CoA-transferase</skos:prefLabel>
<activity rdf:resource="2.8.3.3#SIP43EF0BB883A9F4D9"/>
<rdfs:comment>The enzyme from Pseudomonas ovalis also catalyzes the reaction of EC 4.1.1.9.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.3#SIP43EF0BB883A9F4D9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + malonate = acetate + malonyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obsolete>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-oxoacid CoA-transferase</skos:prefLabel>
<skos:altLabel>succinyl-CoA:3-ketoacid-CoA transferase</skos:altLabel>
<activity rdf:resource="2.8.3.5#SIPCFFEA1460F5A8606"/>
<activity rdf:resource="2.8.3.5#SIP2368E9CEF373CF96"/>
<rdfs:comment>Acetoacetate or, more slowly, 3-oxopropanoate, 3-oxopentanoate, 3-oxo-4-methylpentanoate or 3-oxohexanoate can act as acceptor.</rdfs:comment>
<rdfs:comment>Malonyl-CoA can act instead of succinyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/13115439"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13345795"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13769479"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.5#SIPCFFEA1460F5A8606">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 3-oxo acid + succinyl-CoA = a 3-oxoacyl-CoA + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.5#SIP2368E9CEF373CF96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetoacetate + succinyl-CoA = acetoacetyl-CoA + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/13115439">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/13115439"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/13115439"/>
<dcterms:identifier>doi:10.1016/0006-3002(53)90149-8</dcterms:identifier>
</rdf:Description>
