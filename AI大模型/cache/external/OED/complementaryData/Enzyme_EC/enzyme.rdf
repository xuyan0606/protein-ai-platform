<rdf:Description rdf:about="1.14.99.55">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lytic starch monooxygenase</skos:prefLabel>
<skos:altLabel>LPMO</skos:altLabel>
<activity rdf:resource="1.14.99.55#SIPF02C899DDA568746"/>
<rdfs:comment>The enzyme cleaves starch in an oxidative manner.</rdfs:comment>
<rdfs:comment>It releases fragments of starch with a D-glucono-1,5-lactone at the reducing end.</rdfs:comment>
<rdfs:comment>The initially formed alpha-D-glucono-1,5-lactone at the reducing end of the shortend amylose chain quickly hydrolyzes spontaneously to the aldonic acid.</rdfs:comment>
<rdfs:comment>In vitro ascorbate has been found to be able to serve as reducing agent.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24828494"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25201969"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25608804"/>
<rdfs:subClassOf rdf:resource="1.14.99.-"/>
<skos:broaderTransitive rdf:resource="1.14.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.99.55#SIPF02C899DDA568746">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>starch + reduced acceptor + O2 = D-glucono-1,5-lactone-terminated malto-oligosaccharides + short-chain malto-oligosaccharides + acceptor + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24828494">
