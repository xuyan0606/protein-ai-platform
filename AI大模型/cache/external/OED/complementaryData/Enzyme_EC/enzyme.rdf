<activity rdf:resource="1.1.1.274#SIPC497BF1D559A1974"/>
<rdfs:comment>The enzyme is involved in the catabolism of 2,5-didehydrogluconate. cf. EC 1.1.1.346.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
