<rdf:Description rdf:about="2.5.1.103">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>presqualene diphosphate synthase</skos:prefLabel>
<activity rdf:resource="2.5.1.103#SIPB62254C849FA59B6"/>
<rdfs:comment>Isolated from the green alga Botryococcus braunii BOT22.</rdfs:comment>
<rdfs:comment>Unlike EC 2.5.1.21, where squalene is formed in one step from farnesyl diphosphate, in this alga the intermediate presqualene diphosphate is generated and released by this enzyme.</rdfs:comment>
<rdfs:comment>This compound is then converted into either squalene (by EC 1.3.1.96) or botryococcene (EC 1.3.1.97).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21746901"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26258173"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.103#SIPB62254C849FA59B6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 (2E,6E)-farnesyl diphosphate = diphosphate + presqualene diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21746901">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/21746901"/>
