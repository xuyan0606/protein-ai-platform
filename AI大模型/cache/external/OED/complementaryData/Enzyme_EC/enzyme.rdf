<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3922755"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3922755"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8503890">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/8503890"/>
