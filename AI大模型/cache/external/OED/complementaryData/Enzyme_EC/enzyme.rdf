<activity rdf:resource="4.2.3.158#SIP453A7153DA37019C"/>
<rdfs:comment>The enzyme, which forms the diterpene (-)-spiroviolene, has been characterized from the bacterium Streptomyces violens.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28146322"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
