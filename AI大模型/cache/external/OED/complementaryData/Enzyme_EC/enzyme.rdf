<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-ribulose 1,5-bisphosphate + H2O = D-ribulose 1-phosphate + phosphate.</rdfs:label>
</rdf:Description>
