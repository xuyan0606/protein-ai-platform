<citation rdf:resource="http://purl.uniprot.org/citations/11606739"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11943176"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12885882"/>
<rdfs:subClassOf rdf:resource="3.4.21.-"/>
<skos:broaderTransitive rdf:resource="3.4.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.112#SIP556B6956731A7243">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Processes precursors containing basic and hydrophobic/aliphatic residues at P4 and P2, respectively, with a relatively relaxed acceptance of amino acids at P1 and P3.</rdfs:label>
</rdf:Description>
