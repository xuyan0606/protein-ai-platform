<rdfs:label>[(1->4)-beta-D-mannosyl](n) + phosphate = [(1->4)-beta-D-mannosyl](n-1) + alpha-D-mannose 1-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23093406">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
