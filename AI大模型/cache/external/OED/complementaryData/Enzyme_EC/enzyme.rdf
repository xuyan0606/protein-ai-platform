<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>biochanin A + UDP-alpha-D-glucose = biochanin A 7-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.170#SIPE6545565092B96A6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>daidzein + UDP-alpha-D-glucose = daidzein 7-O-beta-D-glucoside + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.170#SIP57B65073D08408D5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>genistein + UDP-alpha-D-glucose = genistein 7-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
