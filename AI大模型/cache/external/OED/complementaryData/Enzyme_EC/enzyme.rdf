<replaces rdf:resource="3.4.1.1"/>
<skos:prefLabel>leucyl aminopeptidase</skos:prefLabel>
<skos:altLabel>cytosol aminopeptidase</skos:altLabel>
<skos:altLabel>leucine aminopeptidase</skos:altLabel>
<skos:altLabel>peptidase S</skos:altLabel>
<activity rdf:resource="3.4.11.1#SIP7AFF9470D0B83F1C"/>
<rdfs:comment>Is activated by heavy metal ions.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M17.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7417261"/>
<rdfs:subClassOf rdf:resource="3.4.11.-"/>
<skos:broaderTransitive rdf:resource="3.4.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.11.1#SIP7AFF9470D0B83F1C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Release of an N-terminal amino acid, Xaa-|-Yaa-, in which Xaa is preferably Leu, but may be other amino acids including Pro although not Arg or Lys, and Yaa may be Pro. Amino acid amides and methyl esters are also readily hydrolyzed, but rates on arylamides are exceedingly low.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/7417261">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
