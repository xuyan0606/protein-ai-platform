<citation rdf:resource="http://purl.uniprot.org/citations/15632054"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16666133"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17148453"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
