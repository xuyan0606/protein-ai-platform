<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-(gamma-L-glutamylamino)-(2S)-2-hydroxybutanoyl-[BtrI ACP] + ribostamycin = gamma-L-glutamyl-butirosin B + H(+) + holo-[BtrI ACP].</rdfs:label>
</rdf:Description>
