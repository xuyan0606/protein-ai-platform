<rdf:Description rdf:about="4.2.3.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(3R,6E)-nerolidol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.49#SIP260ECEA4520075FA"/>
<rdfs:comment>The enzyme catalyzes a step in the formation of (3E)-4,8-dimethyl-1,3,7-nonatriene, a key signal molecule in induced plant defense mediated by the attraction of enemies of herbivores.</rdfs:comment>
<rdfs:comment>Nerolidol is a naturally occurring sesquiterpene found in the essential oils of many types of plants.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12481088"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.49#SIP260ECEA4520075FA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl diphosphate + H2O = (3R,6E)-nerolidol + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12481088">
