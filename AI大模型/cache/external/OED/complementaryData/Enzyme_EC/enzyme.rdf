<rdf:Description rdf:about="1.2.7.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aldehyde ferredoxin oxidoreductase</skos:prefLabel>
<skos:altLabel>AOR</skos:altLabel>
<skos:altLabel>tungsten-containing aldehyde ferredoxin oxidoreductase</skos:altLabel>
<activity rdf:resource="1.2.7.5#SIPF05956A40EF7AE9D"/>
<rdfs:comment>This is an oxygen-sensitive enzyme.</rdfs:comment>
<rdfs:comment>Catalyzes the oxidation of aldehydes (including crotonaldehyde, acetaldehyde, formaldehyde and glyceraldehyde) to their corresponding acids.</rdfs:comment>
<rdfs:comment>However, it does not oxidize glyceraldehyde 3-phosphate (see EC 1.2.7.6).</rdfs:comment>
<rdfs:comment>Can use ferredoxin or methylviologen but not NAD(P)(+) as electron acceptor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1907273"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7878465"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8444863"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11265456"/>
<rdfs:subClassOf rdf:resource="1.2.7.-"/>
<skos:broaderTransitive rdf:resource="1.2.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.7.5#SIPF05956A40EF7AE9D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an aldehyde + H2O + 2 oxidized [2Fe-2S]-[ferredoxin] = a carboxylate + 3 H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
