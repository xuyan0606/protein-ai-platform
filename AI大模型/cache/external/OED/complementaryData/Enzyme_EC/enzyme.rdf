<skos:prefLabel>cyclic dehypoxanthinyl futalosine synthase</skos:prefLabel>
<skos:altLabel>dehypoxanthinyl futalosine cyclase</skos:altLabel>
<activity rdf:resource="1.21.98.1#SIP996D9CE1F44FEE2E"/>
<rdfs:comment>This enzyme is a member of the 'AdoMet radical' (radical SAM) family.</rdfs:comment>
<rdfs:comment>The enzyme, found in several bacterial species, is part of the futalosine pathway for menaquinone biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18801996"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23763543"/>
<rdfs:subClassOf rdf:resource="1.21.98.-"/>
<skos:broaderTransitive rdf:resource="1.21.98.-"/>
</rdf:Description>
