<rdf:Description rdf:about="3.1.4.56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>7,8-dihydroneopterin 2',3'-cyclic phosphate phosphodiesterase</skos:prefLabel>
<activity rdf:resource="3.1.4.56#SIP0959447F3FBA9928"/>
<activity rdf:resource="3.1.4.56#SIP8B32FC97FD1AEE46"/>
<rdfs:comment>Hydrolyzes 7,8-dihydroneopterin 2',3'-cyclic phosphate, a step in tetrahydromethanopterin biosynthesis.</rdfs:comment>
<rdfs:comment>In vitro the enzyme forms 7,8-dihydroneopterin 2'-phosphate and 7,8-dihydroneopterin 3'-phosphate at a ratio of 4:1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19746965"/>
<rdfs:subClassOf rdf:resource="3.1.4.-"/>
<skos:broaderTransitive rdf:resource="3.1.4.-"/>
</rdf:Description>
