<rdfs:comment>Induced in Escherichia coli by T-even phages.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4289819"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
