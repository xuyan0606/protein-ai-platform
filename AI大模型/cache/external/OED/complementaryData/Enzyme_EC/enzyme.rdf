<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co-precorrin-2 + S-adenosyl-L-methionine = Co-precorrin-3 + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9778368">
