</rdf:Description>
<rdf:Description rdf:about="2.3.1.144">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>anthranilate N-benzoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.144#SIP55574E9EBE3A91A2"/>
<rdfs:comment>Cinnamoyl-CoA, 4-coumaroyl-CoA and salicyloyl-CoA can act as donors, more slowly.</rdfs:comment>
<rdfs:comment>Involved in the biosynthesis of phytoalexins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2817901"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.144#SIP55574E9EBE3A91A2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>anthranilate + benzoyl-CoA = CoA + N-benzoylanthranilate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2817901">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2817901"/>
