<skos:altLabel>4'CGT</skos:altLabel>
<activity rdf:resource="2.4.1.286#SIP1EC2667658A5C355"/>
<activity rdf:resource="2.4.1.286#SIP3BB4B21BC0B228FF"/>
<rdfs:comment>Isolated from the plant Antirrhinum majus (snapdragon).</rdfs:comment>
<rdfs:comment>Involved in the biosynthesis of aurones, plant flavonoids that provide yellow color to the flowers.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16832053"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
