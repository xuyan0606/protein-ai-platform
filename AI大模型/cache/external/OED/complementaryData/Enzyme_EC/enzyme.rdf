<skos:altLabel>NADPH-dependent FMN reductase</skos:altLabel>
<skos:altLabel>NADPH-flavin reductase</skos:altLabel>
<skos:altLabel>NADPH-FMN reductase</skos:altLabel>
<skos:altLabel>NADPH-specific FMN reductase</skos:altLabel>
<skos:altLabel>riboflavine mononucleotide reductase</skos:altLabel>
<skos:altLabel>riboflavin mononucleotide (reduced nicotinamide adenine dinucleotide phosphate) reductase</skos:altLabel>
<skos:altLabel>riboflavin mononucleotide reductase</skos:altLabel>
<activity rdf:resource="1.5.1.30#SIP500D9CC749B61FDA"/>
<rdfs:comment>The enzyme from Entamoeba histolytica reduces riboflavin and galactoflavin, and, more slowly, FMN and FAD.</rdfs:comment>
<rdfs:comment>NADH is oxidized more slowly than NADPH.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3453680"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6258069"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.1.30#SIP500D9CC749B61FDA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADP(+) + reduced riboflavin = 2 H(+) + NADPH + riboflavin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3453680">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3453680"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3453680"/>
</rdf:Description>
