</rdf:Description>
<rdf:Description rdf:about="3.4.19.16#SIP17D5F93B73A13DBF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(Z)-1-(glutathione-S-yl)-2-phenylacetohydroximate + H2O = (Z)-1-(glycyl-L-cystein-S-yl)-2-phenylacetohydroximate + L-glutamate.</rdfs:label>
</rdf:Description>
