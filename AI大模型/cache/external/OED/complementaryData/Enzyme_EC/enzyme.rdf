<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9405058"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>gamma-L-glutamyl-butirosin B gamma-glutamyl cyclotransferase</skos:prefLabel>
<activity rdf:resource="4.3.2.6#SIP7A22892BB811F295"/>
<rdfs:comment>The enzyme catalyzes the last step in the biosynthesis of the aminoglycoside antibiotic butirosin B.</rdfs:comment>
<rdfs:comment>The enzyme acts as a cyclotransferase, cleaving the amide bond via transamidation using the alpha-amine of the terminal gamma-L-glutamate of the side chain, releasing it as the cyclic 5-oxoproline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17462573"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.6#SIP7A22892BB811F295">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>gamma-L-glutamyl-butirosin B = 5-oxo-L-proline + butirosin B.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17462573">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17462573"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17462573"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glutathione-specific gamma-glutamylcyclotransferase</skos:prefLabel>
<skos:altLabel>gamma-glu-GCG</skos:altLabel>
<activity rdf:resource="4.3.2.7#SIPE120AF9908AC6644"/>
<rdfs:comment>The enzyme, found in bacteria, fungi and animals, is specific for glutathione (cf. EC 4.3.2.9).</rdfs:comment>
<rdfs:comment>The enzyme acts as a cyclotransferase, cleaving the amide bond via transamidation using the alpha-amine of the L-glutamyl residue, releasing it as the cyclic 5-oxo-L-proline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23070364"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27913623"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.7#SIPE120AF9908AC6644">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glutathione = 5-oxo-L-proline + L-cysteinylglycine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23070364">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23070364"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23070364"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/27913623">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27913623"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/27913623"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>gamma-glutamylamine cyclotransferase</skos:prefLabel>
<activity rdf:resource="4.3.2.8#SIP8E484B61C866E9D2"/>
<rdfs:comment>The enzyme, found in vertebrates, has no activity toward alpha-(gamma-L-glutamyl)-L-amino acids (cf. EC 4.3.2.9).</rdfs:comment>
<rdfs:comment>The enzyme acts as a cyclotransferase, cleaving the amide bond via transamidation using the alpha-amine of the gamma-L-glutamyl residue, releasing it as the cyclic 5-oxo-L-proline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6107907"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20110353"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.8#SIP8E484B61C866E9D2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>epsilon-(gamma-L-glutamyl)-L-lysine = 5-oxo-L-proline + L-lysine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6107907">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/6107907"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/6107907"/>
</rdf:Description>
