<skos:prefLabel>lycopene epsilon-cyclase</skos:prefLabel>
<activity rdf:resource="5.5.1.18#SIP1F91F5BE75F13D8E"/>
<activity rdf:resource="5.5.1.18#SIP9896254F8D35D99E"/>
<activity rdf:resource="5.5.1.18#SIP468FC6E1F541962A"/>
<rdfs:comment>The carotenoid lycopene has the psi-end group at both ends.</rdfs:comment>
<rdfs:comment>When acting on one end, this enzyme forms delta-carotene.</rdfs:comment>
<rdfs:comment>When acting on both ends, it forms epsilon-carotene.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11226339"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12712234"/>
<rdfs:subClassOf rdf:resource="5.5.1.-"/>
<skos:broaderTransitive rdf:resource="5.5.1.-"/>
</rdf:Description>
