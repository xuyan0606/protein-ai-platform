<rdf:Description rdf:about="2.4.2.53">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.8.30"/>
<replaces rdf:resource="2.7.8.n1"/>
<skos:prefLabel>undecaprenyl-phosphate 4-deoxy-4-formamido-L-arabinose transferase</skos:prefLabel>
<skos:altLabel>Ara4FN transferase</skos:altLabel>
<skos:altLabel>polymyxin resistance protein PmrF</skos:altLabel>
<skos:altLabel>undecaprenyl-phosphate Ara4FN transferase</skos:altLabel>
<activity rdf:resource="2.4.2.53#SIP9656DD81AE7ABD60"/>
<rdfs:comment>The enzyme shows no activity with UDP-4-amino-4-deoxy-beta-L-arabinose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11706007"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15695810"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.53#SIP9656DD81AE7ABD60">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>di-trans,octa-cis-undecaprenyl phosphate + UDP-4-deoxy-4-formamido-beta-L-arabinose = 4-deoxy-4-formamido-alpha-L-arabinopyranosyl di-trans,octa-cis-undecaprenyl phosphate + UDP.</rdfs:label>
</rdf:Description>
