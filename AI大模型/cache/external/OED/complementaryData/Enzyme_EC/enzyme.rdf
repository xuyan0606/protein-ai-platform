<rdf:Description rdf:about="4.2.1.88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>synephrine dehydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.88#SIP890B6069FB6535D6"/>
<rdfs:comment>Removal of H2O from (R)-synephrine produces a 2,3-enamine, which hydrolyzes to the products shown in the reaction above.</rdfs:comment>
<rdfs:comment>The enzyme from Arthrobacter synephrinum is highly specific.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1008837"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3729420"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
