<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>germacra-1(10),4,11(13)-trien-12-oate + O2 + reduced [NADPH--hemoprotein reductase] = (+)-costunolide + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12011356">
