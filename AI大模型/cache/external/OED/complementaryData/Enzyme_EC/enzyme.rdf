<skos:prefLabel>phosphatidylserine sn-1 acylhydrolase</skos:prefLabel>
<skos:altLabel>phosphatidylserine-specific phospholipase A1</skos:altLabel>
<activity rdf:resource="3.1.1.111#SIPAA141A6F28C46A96"/>
<activity rdf:resource="3.1.1.111#SIP5B43C75B07352246"/>
<rdfs:comment>The enzyme, which has described from mammals, is specific for phosphatidylserine and 2-lysophosphatidylserine, and does not act on phosphatidylcholine, phosphatidylethanolamine, phosphatidic acid or phosphatidylinositol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8999922"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10196188"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11395520"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12069807"/>
