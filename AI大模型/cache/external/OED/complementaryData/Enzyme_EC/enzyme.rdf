<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cholesterol + O2 + reduced [NADPH--hemoprotein reductase] = (24S)-hydroxycholesterol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
