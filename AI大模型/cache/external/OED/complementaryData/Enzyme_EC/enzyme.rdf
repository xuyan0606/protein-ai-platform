<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ent-pimara-9(11),15-diene synthase</skos:prefLabel>
<skos:altLabel>PMD synthase</skos:altLabel>
<activity rdf:resource="4.2.3.31#SIPA74AAB4866B53E8E"/>
<rdfs:comment>Involved in the biosynthesis of the diterpenoid viguiepinol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17148547"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
