<rdf:Description rdf:about="2.4.1.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lactose synthase</skos:prefLabel>
<skos:altLabel>N-acetyllactosamine synthase</skos:altLabel>
<skos:altLabel>UDP-galactose--glucose galactosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.22#SIPEE7EAEC877A345A9"/>
<rdfs:comment>The enzyme is a complex of 2 proteins A and B.</rdfs:comment>
<rdfs:comment>In the absence of the B protein (alpha-lactalbumin) the enzyme catalyzes the transfer of galactose from UDP-galactose to N-acetylglucosamine (cf. EC 2.4.1.90).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/812340"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5440844"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14005251"/>
