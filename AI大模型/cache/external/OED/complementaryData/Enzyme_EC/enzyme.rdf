<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-arginine + NAD(+) = 5-guanidino-2-oxopentanoate + H(+) + NADH + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.1.25#SIPA02B69F50151D4C7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-arginine + NADP(+) = 5-guanidino-2-oxopentanoate + H(+) + NADPH + NH4(+).</rdfs:label>
</rdf:Description>
