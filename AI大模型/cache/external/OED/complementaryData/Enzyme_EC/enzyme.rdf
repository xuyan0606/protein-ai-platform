<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + guanidinoethyl methyl phosphate = ADP + H(+) + N'-phosphoguanidinoethyl methylphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.3.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ammonia kinase</skos:prefLabel>
<activity rdf:resource="2.7.3.8#SIPB9C5521936E264DC"/>
<rdfs:comment>Has a wide specificity.</rdfs:comment>
<rdfs:comment>In the reverse direction, N-phosphoglycine and N-phosphohistidine can also act as phosphate donors, and ADP, dADP, GDP, CDP, dTDP, dCDP, IDP and UDP can act as phosphate acceptors (in decreasing order of activity).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5647264"/>
<rdfs:subClassOf rdf:resource="2.7.3.-"/>
<skos:broaderTransitive rdf:resource="2.7.3.-"/>
</rdf:Description>
