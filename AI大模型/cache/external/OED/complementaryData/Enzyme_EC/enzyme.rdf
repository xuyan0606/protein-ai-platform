<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylxylan esterase</skos:prefLabel>
<activity rdf:resource="3.1.1.72#SIP498568710822BC18"/>
<rdfs:comment>catalyzes the hydrolysis of acetyl groups from polymeric xylan, acetylated xylose, acetylated glucose, alpha-napthyl acetate, p-nitrophenyl acetate but not from triacetylglycerol.</rdfs:comment>
<rdfs:comment>Does not act on acetylated mannan or pectin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8647098"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
