<rdf:Description rdf:about="1.10.3.15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>grixazone synthase</skos:prefLabel>
<activity rdf:resource="1.10.3.15#SIP25408877790C4EE5"/>
<activity rdf:resource="1.10.3.15#SIPFFCC81A99517B315"/>
<rdfs:comment>The enzyme, isolated from the bacterium Streptomyces griseus, catalyzes an 8 electron oxidation.</rdfs:comment>
<rdfs:comment>Activation of the enzyme requires a copper chaperone (GriE).</rdfs:comment>
<rdfs:comment>It also acts on 3-amino-4-hydroxybenzaldehyde, giving grixazone A.</rdfs:comment>
<rdfs:comment>The second aldehyde group is presumably lost as formate.</rdfs:comment>
<rdfs:comment>The enzyme also catalyzes the reaction of EC 1.10.3.4.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17003031"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19268377"/>
<rdfs:subClassOf rdf:resource="1.10.3.-"/>
<skos:broaderTransitive rdf:resource="1.10.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.10.3.15#SIP25408877790C4EE5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 3-amino-4-hydroxybenzoate + H(+) + N-acetyl-L-cysteine + 2 O2 = CO2 + grixazone B + 4 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.10.3.15#SIPFFCC81A99517B315">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 3-amino-4-hydroxybenzaldehyde + N-acetyl-L-cysteine + 2 O2 = formate + grixazone A + H(+) + 3 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17003031">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17003031"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17003031"/>
</rdf:Description>
