<rdf:Description rdf:about="4.1.1.113">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>trans-aconitate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.113#SIP0C4EBFB46608E915"/>
<rdfs:comment>The enzyme, characterized from the smut fungus Ustilago maydis, is involved in an alternative pathway for the biosynthesis of itaconate. cf. EC 4.1.1.6.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26639528"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.113#SIP0C4EBFB46608E915">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + trans-aconitate = CO2 + itaconate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26639528">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/26639528"/>
