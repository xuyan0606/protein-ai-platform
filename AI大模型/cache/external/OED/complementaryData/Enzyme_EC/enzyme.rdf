<rdf:Description rdf:about="2.1.1.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycine N-methyltransferase</skos:prefLabel>
<skos:altLabel>glycine methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.20#SIP0318F54A00096AEE"/>
<rdfs:comment>Thought to play an important role in the regulation of methyl group metabolism in the liver and pancreas by regulating the ratio between S-adenosyl-L-methionine and S-adenosyl-L-homocysteine.</rdfs:comment>
<rdfs:comment>Inhibited by 5-methyltetrahydrofolate pentaglutamate.</rdfs:comment>
<rdfs:comment>Sarcosine, which has no physiological role, is converted back into glycine by the action of EC 1.5.8.3.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9597750"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10608809"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10833353"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12859184"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13971907"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15340920"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.20#SIP0318F54A00096AEE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycine + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + sarcosine.</rdfs:label>
</rdf:Description>
