<skos:prefLabel>(indol-3-yl)acetyl-L-aspartate hydrolase</skos:prefLabel>
<skos:altLabel>indole-3-acetyl-L-aspartate hydrolase</skos:altLabel>
<activity rdf:resource="3.5.1.134#SIP3E2C771065405A0E"/>
<rdfs:comment>The enzyme, isolated from the bacterium Pantoea agglomerans, is specific for its substrate and does not act efficiently on other indole-3-acetate conjugates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9747708"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12226446"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
