<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + L-2,4-diaminobutanoate = CO2 + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
