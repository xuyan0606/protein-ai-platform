<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>laccase</skos:prefLabel>
<skos:altLabel>urishiol oxidase</skos:altLabel>
<activity rdf:resource="1.10.3.2#SIPAE71CF37BB4D37FE"/>
<rdfs:comment>A group of multi-copper proteins of low specificity.</rdfs:comment>
<rdfs:comment>Acts on both o- and p-quinols, and often acting also on aminophenols and phenylenediamine.</rdfs:comment>
<rdfs:comment>The semiquinone may react further either enzymically or non-enzymically.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.10.3.-"/>
<skos:broaderTransitive rdf:resource="1.10.3.-"/>
</rdf:Description>
