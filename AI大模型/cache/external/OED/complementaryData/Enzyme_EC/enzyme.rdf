<rdf:Description rdf:about="4.2.3.36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>terpentetriene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.36#SIP490BC4377BD0BA35"/>
<rdfs:comment>Following on from EC 5.5.1.15, this enzyme completes the transformation of geranylgeranyl diphosphate (GGDP) into terpentetriene, which is a precursor of the diterpenoid antibiotic terpentecin.</rdfs:comment>
<rdfs:comment>Farnesyl diphosphate can also act as a substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11567009"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12138123"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12839434"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.36#SIP490BC4377BD0BA35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>terpentedienyl diphosphate = diphosphate + terpentetriene.</rdfs:label>
</rdf:Description>
