<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADP(+) + scyllo-inositol = H(+) + NADPH + scyllo-inosose.</rdfs:label>
</rdf:Description>
