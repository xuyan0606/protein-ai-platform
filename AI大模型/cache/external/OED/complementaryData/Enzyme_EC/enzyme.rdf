<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-ornithine + NADPH + O2 = H2O + N(5)-hydroxy-L-ornithine + NADP(+).</rdfs:label>
</rdf:Description>
