<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O2 + 2 reduced coenzyme F420-(gamma-L-Glu)(n) = 2 H(+) + 2 H2O + 2 oxidized coenzyme F420-(gamma-L-Glu)(n).</rdfs:label>
</rdf:Description>
