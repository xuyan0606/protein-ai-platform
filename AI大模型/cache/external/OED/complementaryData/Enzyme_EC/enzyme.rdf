<rdf:Description rdf:about="1.14.20.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.11.23"/>
<skos:prefLabel>flavonol synthase</skos:prefLabel>
<skos:altLabel>flavonoid 2-oxoglutarate-dependent dioxygenase</skos:altLabel>
<skos:altLabel>FLS</skos:altLabel>
<activity rdf:resource="1.14.20.6#SIP76FFEB7BE9CF1759"/>
<rdfs:comment>In addition to the desaturation of (2R,3R)-dihydroflavonols to flavonols, the enzyme from the satsuma Citrus unshiu also has a non-specific activity that trans-hydroxylates the flavanones (2S)-naringenin and the unnatural (2R)-naringenin at C-3 to kaempferol and (2R,3R)-dihydrokaempferol, respectively.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12180990"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12620339"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12782296"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14570878"/>
<rdfs:subClassOf rdf:resource="1.14.20.-"/>
<skos:broaderTransitive rdf:resource="1.14.20.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.6#SIP76FFEB7BE9CF1759">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + a (2R,3R)-dihydroflavonol + O2 = a flavonol + CO2 + H2O + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12180990">
