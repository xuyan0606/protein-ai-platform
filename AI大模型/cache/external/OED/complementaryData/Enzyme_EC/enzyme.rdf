<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + nonyl sufate + O2 = CO2 + H(+) + nonanal + succinate + sulfate.</rdfs:label>
</rdf:Description>
