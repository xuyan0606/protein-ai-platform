<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23386483"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23386483"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.151">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pentamethylcyclopentadecatrienol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.151#SIP3F2C1D34423ED690"/>
<rdfs:comment>Isolated from the bacterium Streptomyces sp. SANK 60404.</rdfs:comment>
<rdfs:comment>This trifunctional enzyme also produces (R)-nephthenol and (R)-cembrene A (cf. EC 4.2.3.149 and EC 4.2.3.150).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23386483"/>
