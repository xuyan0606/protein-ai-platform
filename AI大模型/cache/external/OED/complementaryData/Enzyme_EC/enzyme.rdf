<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12195810"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12195810"/>
<dcterms:identifier>doi:10.1039/b108967f</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.82">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phosphonopyruvate decarboxylase</skos:prefLabel>
<skos:altLabel>3-phosphonopyruvate carboxy-lyase</skos:altLabel>
<activity rdf:resource="4.1.1.82#SIP93C09E66EE84B781"/>
<rdfs:comment>Catalyzes a step in the biosynthetic pathway of 2-aminoethylphosphonate, a component of the capsular polysaccharide complex of Bacteroides fragilis.</rdfs:comment>
<rdfs:comment>Activated by the divalent cations Mg(2+), Ca(2+) and Mn(2+).</rdfs:comment>
<rdfs:comment>Pyruvate and sulfopyruvate can also act as substrates, but more slowly.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8180189"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9127192"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12904299"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.82#SIP93C09E66EE84B781">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-phosphonopyruvate + H(+) = CO2 + phosphonoacetaldehyde.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/8180189">
