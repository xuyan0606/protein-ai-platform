<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-dihydroxybenzoate + ATP + holo-[ACP] = 2,3-dihydroxybenzoyl-[ACP] + AMP + diphosphate.</rdfs:label>
</rdf:Description>
