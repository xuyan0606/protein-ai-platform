<citation rdf:resource="http://purl.uniprot.org/citations/22168819"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22169019"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
<skos:broaderTransitive rdf:resource="1.14.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.61#SIP2DCF176EB8AB8E1C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-feruloyl-CoA + 2-oxoglutarate + O2 = (E)-6-hydroxyferuloyl-CoA + CO2 + succinate.</rdfs:label>
</rdf:Description>
