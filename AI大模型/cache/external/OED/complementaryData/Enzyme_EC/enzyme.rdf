<replaces rdf:resource="4.4.1.27"/>
<skos:prefLabel>carbon disulfide hydrolase</skos:prefLabel>
<skos:altLabel>carbon disulfide lyase</skos:altLabel>
<skos:altLabel>CS2-converting enzyme</skos:altLabel>
<skos:altLabel>CS2 hydrolase</skos:altLabel>
<activity rdf:resource="3.13.1.5#SIP7535B8013D61271E"/>
<rdfs:comment>The hyperthermophilic archaeon Acidianus sp. A1-3 obtains energy by the conversion of carbon disulfide to hydrogen sulfide, with carbonyl sulfide as an intermediate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22012399"/>
<rdfs:subClassOf rdf:resource="3.13.1.-"/>
<skos:broaderTransitive rdf:resource="3.13.1.-"/>
</rdf:Description>
