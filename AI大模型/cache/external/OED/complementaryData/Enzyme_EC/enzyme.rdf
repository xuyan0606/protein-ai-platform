<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alkylmercury lyase</skos:prefLabel>
<skos:altLabel>organomercurial lyase</skos:altLabel>
<skos:altLabel>organomercury lyase</skos:altLabel>
<activity rdf:resource="4.99.1.2#SIP3E7C578E7C003A43"/>
<rdfs:comment>Acts on CH3Hg(+) and a number of other alkylmercury compounds, in the presence of cysteine or other thiols, liberating mercury as a mercaptide.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9382"/>
