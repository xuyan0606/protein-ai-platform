<skos:prefLabel>lactosylceramide beta-1,3-galactosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.179#SIPA5388231E8956605"/>
<rdfs:comment>R may be an oligosaccharide or a glycolipid.</rdfs:comment>
<rdfs:comment>Lactose can also act as acceptor, more slowly.</rdfs:comment>
<rdfs:comment>Involved in the elongation of oligosaccharide chains, especially in glycolipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3129295"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
