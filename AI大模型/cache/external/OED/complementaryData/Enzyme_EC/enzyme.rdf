<rdf:Description rdf:about="7.1.1.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ferredoxin--NAD(+) oxidoreductase (H(+)-transporting)</skos:prefLabel>
<skos:altLabel>Rnf complex</skos:altLabel>
<activity rdf:resource="7.1.1.11#SIP498649BF1BDABAA1"/>
<rdfs:comment>This iron-sulfur and flavin-containing electron transport complex, isolated from some anaerobic bacteria, couples the energy from reduction of NAD(+) by ferredoxin to pumping protons out of the cell, generating a proton motive force across the cytoplasmic membrane.</rdfs:comment>
<rdfs:comment>Most similar complexes pump sodium ions rather than protons (cf. EC 7.2.1.2).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23269825"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27114876"/>
<rdfs:subClassOf rdf:resource="7.1.1.-"/>
<skos:broaderTransitive rdf:resource="7.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="7.1.1.11#SIP498649BF1BDABAA1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3 H(+)(in) + NAD(+) + 2 reduced [2Fe-2S]-[ferredoxin] = 2 H(+)(out) + NADH + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23269825">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23269825"/>
