<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>n a quinone + n H(+) + n hydrogen sulfide = n a quinol + n sulfur.</rdfs:label>
</rdf:Description>
