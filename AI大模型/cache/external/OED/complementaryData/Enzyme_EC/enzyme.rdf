<rdf:Description rdf:about="1.3.1.122">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.3.1.99"/>
<skos:prefLabel>(S)-8-oxocitronellyl enol synthase</skos:prefLabel>
<skos:altLabel>iridoid synthase</skos:altLabel>
<activity rdf:resource="1.3.1.122#SIP8BCE0308259FAA84"/>
<activity rdf:resource="1.3.1.122#SIP8733543845AEF31A"/>
<rdfs:comment>Isolated from the plants Catharanthus roseus, Olea europaea (common olive), and several Nepeta species.</rdfs:comment>
<rdfs:comment>The enzyme reduces 8-oxogeranial, generating an unstable product that is subsequently cyclized into several possible products, either non-enzymically or by dedicated cyclases.</rdfs:comment>
<rdfs:comment>The products, known as iridoids, are involved in the biosynthesis of many indole alkaloids. cf. EC 1.3.1.123.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23172143"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26709230"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26768532"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26868105"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29091815"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30531909"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30664302"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.122#SIP8BCE0308259FAA84">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-8-oxocitronellyl enol + NADP(+) = (6E)-8-oxogeranial + H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.122#SIP8733543845AEF31A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-8-oxocitronellyl enol + NAD(+) = (6E)-8-oxogeranial + H(+) + NADH.</rdfs:label>
</rdf:Description>
