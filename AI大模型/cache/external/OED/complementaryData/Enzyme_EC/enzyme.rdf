<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2Z,4Z)-2-hydroxyhexa-2,4-dienoate + H2O = 4-hydroxy-2-oxohexanoate.</rdfs:label>
</rdf:Description>
