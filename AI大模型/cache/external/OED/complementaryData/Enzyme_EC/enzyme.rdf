<rdf:Description rdf:about="2.3.1.235">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tetracenomycin F2 synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.235#SIP96449EAA895EF6EC"/>
<rdfs:comment>A multi-domain polyketide synthase involved in the synthesis of tetracenomycin in the bacterium Streptomyces glaucescens.</rdfs:comment>
<rdfs:comment>It involves a ketosynthase complex, an acyl carrier protein, a malonyl CoA:ACP acyltransferase, and a cyclase.</rdfs:comment>
<rdfs:comment>A malonyl-CoA molecule is initially bound to the acyl carrier protein and decarboxylated to form an acetyl starter unit.</rdfs:comment>
<rdfs:comment>Additional two-carbon units are added from nine more malonyl-CoA molecules.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9609708"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.235#SIP96449EAA895EF6EC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>8 H(+) + 10 malonyl-CoA = 10 CO2 + 10 CoA + 2 H2O + tetracenomycin F2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9609708">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9609708"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9609708"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.236">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-methylnaphthoic acid synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.236#SIP54270666A43A3186"/>
