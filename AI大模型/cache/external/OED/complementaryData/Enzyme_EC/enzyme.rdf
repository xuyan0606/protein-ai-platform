<rdf:Description rdf:about="6.2.1.76">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="6.2.1.n3"/>
<skos:prefLabel>malonate--CoA ligase</skos:prefLabel>
<activity rdf:resource="6.2.1.76#SIPF467A9D5B55DDE9C"/>
<rdfs:comment>The enzyme, found in mitochondria, detoxifies malonate, which is a potent inhibitor of mitochondrial respiration, and provides malonyl-CoA to the mitochondrial fatty acid biosynthesis pathway.</rdfs:comment>
