<rdf:Description rdf:about="2.4.2.60">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cysteine-dependent adenosine diphosphate thiazole synthase</skos:prefLabel>
<skos:altLabel>ADP-thiazole synthase</skos:altLabel>
<activity rdf:resource="2.4.2.60#SIP33DED77C2173D98B"/>
<rdfs:comment>This iron dependent enzyme, found in fungi, plants, and some archaea, is involved in the thiamine phosphate biosynthesis pathway.</rdfs:comment>
<rdfs:comment>It is a single turn-over enzyme since the cysteine residue is not regenerated in vivo.</rdfs:comment>
<rdfs:comment>The homologous enzyme in archaea (EC 2.4.2.59) uses sulfide as sulfur donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16912043"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22031445"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25348237"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26919468"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.60#SIP33DED77C2173D98B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[ADP-thiazole synthase]-L-cysteine + glycine + NAD(+) = [ADP-thiazole synthase]-dehydroalanine + ADP-5-ethyl-4-methylthiazole-2-carboxylate + 2 H(+) + 3 H2O + nicotinamide.</rdfs:label>
</rdf:Description>
