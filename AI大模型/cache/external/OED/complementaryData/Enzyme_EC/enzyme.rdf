</rdf:Description>
<rdf:Description rdf:about="2.3.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-hydroxyarylamine O-acetyltransferase</skos:prefLabel>
<skos:altLabel>arylamine N-acetyltransferase</skos:altLabel>
<skos:altLabel>arylhydroxamate N,O-acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.118#SIP30B08B14DB494192"/>
<rdfs:comment>The enzyme from liver, but not that from bacteria, can also catalyze N-acetylation of arylamines and N,O-acetylation of arylhydroxamates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3745141"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.118#SIP30B08B14DB494192">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + an N-hydroxyarylamine = an N-acetoxyarylamine + CoA.</rdfs:label>
</rdf:Description>
