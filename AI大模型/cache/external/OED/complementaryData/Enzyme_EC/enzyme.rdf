</rdf:Description>
<rdf:Description rdf:about="2.3.1.223">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.3.1.n11"/>
<skos:prefLabel>3-oxo-5,6-didehydrosuberyl-CoA thiolase</skos:prefLabel>
<activity rdf:resource="2.3.1.223#SIP5026447EE88F1B84"/>
<rdfs:comment>The enzyme acts in the opposite direction.</rdfs:comment>
<rdfs:comment>The enzymes from the bacteria Escherichia coli and Pseudomonas sp. Y2 also have the activity of EC 2.3.1.174.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20660314"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.223#SIP5026447EE88F1B84">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-didehydroadipoyl-CoA + acetyl-CoA = 3-oxo-5,6-didehydrosuberyl-CoA + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20660314">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/20660314"/>
