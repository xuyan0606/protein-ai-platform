<rdf:Description rdf:about="4.4.1.38">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isethionate sulfite-lyase</skos:prefLabel>
<activity rdf:resource="4.4.1.38#SIP6A8F63063E295CBB"/>
<rdfs:comment>The enzyme, characterized from the human gut bacterium Bilophila wadsworthia, participates in a taurine degradation pathway that leads to sulfide production.</rdfs:comment>
<rdfs:comment>The active form of the enzyme contains a glycyl radical that is generated by a dedicated activating enzyme via chemistry involving S-adenosyl-L-methionine (SAM) and a [4Fe-4S] cluster.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/30718429"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30962433"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
<skos:broaderTransitive rdf:resource="4.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.38#SIP6A8F63063E295CBB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-hydroxyethane-1-sulfonate = acetaldehyde + H(+) + sulfite.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/30718429">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/30718429"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/30718429"/>
<dcterms:identifier>doi:10.1073/pnas.1815661116</dcterms:identifier>
</rdf:Description>
