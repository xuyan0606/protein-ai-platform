<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23659790"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23659790"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.58">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hydroxyproline O-arabinosyltransferase</skos:prefLabel>
<skos:altLabel>HPAT</skos:altLabel>
<activity rdf:resource="2.4.2.58#SIP2B3B38FDA7657426"/>
<rdfs:comment>The enzyme, found in plants and mosses, catalyzes the O-arabinosylation of hydroxyprolines in hydroxyproline-rich glycoproteins.</rdfs:comment>
<rdfs:comment>The enzyme acts on the first hydroxyproline in the motif Val-hydroxyPro-hydroxyPro-Ser.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24036508"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
