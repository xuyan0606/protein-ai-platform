<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>10-deacetyltaxuyunnanin C + acetyl-CoA = CoA + taxuyunnanin C.</rdfs:label>
</rdf:Description>
