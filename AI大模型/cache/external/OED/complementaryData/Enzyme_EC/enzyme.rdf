</rdf:Description>
<rdf:Description rdf:about="2.1.3.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>oxamate carbamoyltransferase</skos:prefLabel>
<skos:altLabel>oxamic transcarbamylase</skos:altLabel>
<activity rdf:resource="2.1.3.5#SIP6A6C0344E5CB6F32"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.5#SIP6A6C0344E5CB6F32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + oxamate = N-carbamoyl-2-oxoglycine + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>putrescine carbamoyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.3.6#SIPDFC0538C9F665EBA"/>
<rdfs:comment>The plant enzyme also catalyzes the reactions of EC 2.1.3.3, EC 2.7.2.2 and EC 3.5.3.12, thus acting as putrescine synthase, converting agmatine and ornithine into putrescine and citrulline respectively.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4621632"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6895223"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.6#SIPDFC0538C9F665EBA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + putrescine = H(+) + N-carbamoylputrescine + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4621632">
