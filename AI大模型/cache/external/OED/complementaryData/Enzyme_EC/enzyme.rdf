<rdf:Description rdf:about="2.1.1.162">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycine/sarcosine/dimethylglycine N-methyltransferase</skos:prefLabel>
<skos:altLabel>glycine sarcosine dimethylglycine N-methyltransferase</skos:altLabel>
<skos:altLabel>GSDMT</skos:altLabel>
<activity rdf:resource="2.1.1.162#SIPDDE9CC43D1CD61AC"/>
<rdfs:comment>Unlike EC 2.1.1.156, EC 2.1.1.157 and EC 2.1.1.161, this enzyme, from the halophilic methanoarchaeon Methanohalophilus portucalensis, can methylate glycine and all of its intermediates to form the compatible solute betaine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17098399"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.162#SIPDDE9CC43D1CD61AC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycine + 3 S-adenosyl-L-methionine = glycine betaine + 3 H(+) + 3 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17098399">
