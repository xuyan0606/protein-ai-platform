<rdf:Description rdf:about="2.7.1.168">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-glycero-alpha-D-manno-heptose-7-phosphate kinase</skos:prefLabel>
<skos:altLabel>D-alpha-D-heptose-7-phosphate kinase</skos:altLabel>
<activity rdf:resource="2.7.1.168#SIP5E79A566B62110A1"/>
<rdfs:comment>The enzyme is involved in biosynthesis of GDP-D-glycero-alpha-D-manno-heptose, which is required for assembly of S-layer glycoprotein in Gram-positive bacteria.</rdfs:comment>
<rdfs:comment>The enzyme is specific for the alpha-anomer.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11279237"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12101286"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.168#SIP5E79A566B62110A1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + D-glycero-alpha-D-manno-heptose 7-phosphate = ADP + D-glycero-alpha-D-manno-heptose 1,7-bisphosphate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11279237">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11279237"/>
