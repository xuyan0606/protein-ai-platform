<rdf:Description rdf:about="3.5.1.56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N,N-dimethylformamidase</skos:prefLabel>
<activity rdf:resource="3.5.1.56#SIP0A7A2874813035AC"/>
<rdfs:comment>Also acts on N-ethylformamide and N-methylformamide and, more slowly, on N,N-diethylformamide, N,N-dimethylacetamide and unsubstituted acyl amides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3732281"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.56#SIP0A7A2874813035AC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N,N-dimethylformamide = dimethylamine + formate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3732281">
