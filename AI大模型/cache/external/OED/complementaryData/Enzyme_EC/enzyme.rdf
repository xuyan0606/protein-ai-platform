<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>aspulvinone E + 2 dimethylallyl diphosphate = aspulvinone H + 2 diphosphate.</rdfs:label>
</rdf:Description>
