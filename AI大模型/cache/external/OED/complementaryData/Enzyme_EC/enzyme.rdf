<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ribostamycin + UDP-N-acetyl-alpha-D-glucosamine = 2'''-acetyl-6'''-hydroxyneomycin C + H(+) + UDP.</rdfs:label>
</rdf:Description>
