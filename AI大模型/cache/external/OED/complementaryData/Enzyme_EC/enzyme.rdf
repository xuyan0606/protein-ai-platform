<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>norbelladine O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.336#SIP08BBFAD24FF21693"/>
<rdfs:comment>The enzyme, characterized from the plants Nerine bowdenii and Narcissus aff pseudonarcissus (daffodil), participates in the biosynthesis of alkaloids produced by plants that belong to the Amaryllidaceae family.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14109227"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25061748"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
