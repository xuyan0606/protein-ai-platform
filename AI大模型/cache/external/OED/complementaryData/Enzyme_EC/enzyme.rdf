<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + oxidized coenzyme F420-(gamma-L-Glu)(n) + tetracycline = 5a,11a-dehydrotetracycline + reduced coenzyme F420-(gamma-L-Glu)(n).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.98.4#SIP58E4FE49D9DE2F86">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + oxidized coenzyme F420-(gamma-L-Glu)(n) + oxytetracycline = 5a,11a-dehydrooxytetracycline + reduced coenzyme F420-(gamma-L-Glu)(n).</rdfs:label>
</rdf:Description>
