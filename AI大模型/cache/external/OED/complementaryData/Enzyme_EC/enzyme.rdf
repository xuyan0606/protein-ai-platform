<citation rdf:resource="http://purl.uniprot.org/citations/12039559"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12163023"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
<skos:broaderTransitive rdf:resource="1.14.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.29#SIPD7843C9F23800C92">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + L-prolyl-[hypoxia-inducible factor alpha subunit] + O2 = CO2 + succinate + trans-4-hydroxy-L-prolyl-[hypoxia-inducible factor alpha subunit].</rdfs:label>
</rdf:Description>
