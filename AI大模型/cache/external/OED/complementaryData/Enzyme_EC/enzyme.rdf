<rdf:Description rdf:about="2.1.1.340">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-aminomethylindole N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.340#SIP0170DF673D0600D1"/>
<rdfs:comment>The enzyme, characterized from Hordeum vulgare (barley), catalyzes two successive N-methylation reactions during the biosynthesis of gramine, a toxic indole alkaloid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16664431"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16930646"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.340#SIP0170DF673D0600D1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-(aminomethyl)indole + 2 S-adenosyl-L-methionine = gramine + 2 H(+) + 2 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16664431">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16664431"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/16664431"/>
</rdf:Description>
