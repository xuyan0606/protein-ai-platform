<skos:prefLabel>N-acetyl-alpha-D-muramate 1-phosphate uridylyltransferase</skos:prefLabel>
<activity rdf:resource="2.7.7.99#SIP1DA9171B90BE8267"/>
<rdfs:comment>The enzyme, characterized from Pseudomonas species, participates in a peptidoglycan salvage pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23831760"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25767118"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
