<skos:prefLabel>3-succinoylsemialdehyde-pyridine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.2.1.83#SIPD836A2267DAFC9E7"/>
<rdfs:comment>The enzyme has been characterized from the soil bacterium Pseudomonas sp. HZN6.</rdfs:comment>
<rdfs:comment>It participates in the nicotine degradation pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22267672"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.83#SIPD836A2267DAFC9E7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-oxo-4-(pyridin-3-yl)butanal + H2O + NADP(+) = 4-oxo-4-(pyridin-3-yl)butanoate + 2 H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22267672">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22267672"/>
