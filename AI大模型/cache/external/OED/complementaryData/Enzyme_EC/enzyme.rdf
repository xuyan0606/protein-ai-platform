<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADP(+) + shikimate = 3-dehydroshikimate + H(+) + NADPH.</rdfs:label>
</rdf:Description>
