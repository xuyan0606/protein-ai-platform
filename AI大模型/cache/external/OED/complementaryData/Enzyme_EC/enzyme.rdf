</rdf:Description>
<rdf:Description rdf:about="1.3.1.3#SIPED107A8DE9F530C8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5beta-dihydrotestosterone + NADP(+) = H(+) + NADPH + testosterone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.3#SIPDAF02F56C24ACC6C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
