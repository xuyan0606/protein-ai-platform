<rdf:Description rdf:about="3.5.1.116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.5.3.19"/>
<skos:prefLabel>ureidoglycolate amidohydrolase</skos:prefLabel>
<skos:altLabel>ureidoglycolate hydrolase</skos:altLabel>
<activity rdf:resource="3.5.1.116#SIP50A8E1BE801C8EF8"/>
<rdfs:comment>This plant enzyme is involved in the degradation of ureidoglycolate, an intermediate of purine degradation.</rdfs:comment>
<rdfs:comment>Not to be confused with EC 4.3.2.3, which releases urea rather than ammonia.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1910298"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16666035"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19935661"/>
