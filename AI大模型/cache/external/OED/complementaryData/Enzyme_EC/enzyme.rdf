<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-(methylsulfanyl)propanoyl-CoA + H(+) + oxidized [electron-transfer flavoprotein] = 3-(methylsulfanyl)acryloyl-CoA + reduced [electron-transfer flavoprotein].</rdfs:label>
</rdf:Description>
