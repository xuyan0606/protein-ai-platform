<rdf:Description rdf:about="2.7.2.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carbamate kinase</skos:prefLabel>
<activity rdf:resource="2.7.2.2#SIP546FC1992828A116"/>
<rdfs:comment>The enzyme catalyzes the reversible conversion of carbamoyl phosphate and ADP to ATP and carbamate, which hydrolyzes to ammonia and hydrogen carbonate.</rdfs:comment>
<rdfs:comment>The physiological role of the enzyme is to generate ATP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4959296"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5857367"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6895223"/>
<rdfs:subClassOf rdf:resource="2.7.2.-"/>
<skos:broaderTransitive rdf:resource="2.7.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.2.2#SIP546FC1992828A116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + hydrogencarbonate + NH4(+) = ADP + carbamoyl phosphate + H(+) + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4959296">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
