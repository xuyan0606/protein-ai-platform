<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[N-(6-aminohexanoyl)](n) + H2O = 6-aminohexanoate + [N-(6-aminohexanoyl)](n-1).</rdfs:label>
</rdf:Description>
