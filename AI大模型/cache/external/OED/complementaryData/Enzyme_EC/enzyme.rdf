</rdf:Description>
<rdf:Description rdf:about="4.1.1.121">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-oxoisoapionate-4-phosphate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.121#SIPD63C3F93FC3BF973"/>
<rdfs:comment>The enzyme, characterized from several bacterial species, participates in the degradation of D-apionate.</rdfs:comment>
<rdfs:comment>It belongs to the RuBisCO-like-protein (RLP) superfamily.</rdfs:comment>
<rdfs:comment>Stereospecificity of 3-oxoisoapionate 4-phosphate has not been determined.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29867142"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.121#SIPD63C3F93FC3BF973">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-oxoisoapionate 4-phosphate + H(+) = CO2 + L-erythrulose 1-phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/29867142">
