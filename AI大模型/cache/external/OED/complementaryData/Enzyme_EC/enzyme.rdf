<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (2R)-2-hydroxycarboxylate + NAD(+) = a 2-oxocarboxylate + H(+) + NADH.</rdfs:label>
</rdf:Description>
