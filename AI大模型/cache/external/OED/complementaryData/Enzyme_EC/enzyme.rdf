<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 L-arginine + 4 O2 + 3 reduced [flavodoxin] = 5 H(+) + 4 H2O + 2 L-citrulline + 2 nitric oxide + 3 oxidized [flavodoxin].</rdfs:label>
</rdf:Description>
