</rdf:Description>
<rdf:Description rdf:about="3.1.2.32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-aminobenzoylacetyl-CoA thioesterase</skos:prefLabel>
<activity rdf:resource="3.1.2.32#SIPA5E2D2832F64A0D0"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudomonas aeruginosa, participates in the production of the signal molecule 2-heptyl-4(1H)-quinolone (HHQ).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19788310"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25960261"/>
<rdfs:subClassOf rdf:resource="3.1.2.-"/>
<skos:broaderTransitive rdf:resource="3.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.2.32#SIPA5E2D2832F64A0D0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2-aminobenzoyl)acetyl-CoA + H2O = (2-aminobenzoyl)acetate + CoA + H(+).</rdfs:label>
</rdf:Description>
