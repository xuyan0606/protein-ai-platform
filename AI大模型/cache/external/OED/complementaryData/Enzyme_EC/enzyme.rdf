<rdfs:label>a primary alcohol + 2 Fe(III)-[cytochrome cL] = an aldehyde + 2 Fe(II)-[cytochrome cL] + 2 H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.2.7#SIPF0A96B636B9138B6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome cL] + methanol = 2 Fe(II)-[cytochrome cL] + formaldehyde + 2 H(+).</rdfs:label>
</rdf:Description>
