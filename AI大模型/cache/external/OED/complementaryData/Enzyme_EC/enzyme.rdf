<rdf:Description rdf:about="4.4.1.34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoprene-epoxide--glutathione S-transferase</skos:prefLabel>
<activity rdf:resource="4.4.1.34#SIPA82A79E701E1D6A1"/>
<rdfs:comment>The enzyme, characterized from the bacterium Rhodococcus sp. AD45, is involved in isoprene degradation.</rdfs:comment>
<rdfs:comment>The enzyme can catalyze the glutathione-dependent ring opening of various epoxides, but the highest activity is with (3R)-3,4-epoxy-3-methylbut-1-ene, which is derived from isoprene by EC 1.14.13.69.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9687433"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10094686"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
<skos:broaderTransitive rdf:resource="4.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.34#SIPA82A79E701E1D6A1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-glutathionyl-2-methylbut-3-en-1-ol = (3R)-3,4-epoxy-3-methylbut-1-ene + glutathione.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9687433">
