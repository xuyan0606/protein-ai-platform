<skos:prefLabel>UDP-GlcNAc:ribostamycin N-acetylglucosaminyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.285#SIPDCE31364FEF45C67"/>
<rdfs:comment>Involved in biosynthesis of the aminoglycoside antibiotic neomycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18311744"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
