<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-2,3-diaminopropanoate + 2-[(2-aminoethylcarbamoyl)methyl]-2-hydroxybutanedioate + ATP = 2-[(L-alanin-3-ylcarbamoyl)methyl]-3-(2-aminoethylcarbamoyl)-2-hydroxypropanoate + AMP + diphosphate.</rdfs:label>
</rdf:Description>
