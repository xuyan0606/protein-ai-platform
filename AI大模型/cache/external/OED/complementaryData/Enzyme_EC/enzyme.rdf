<rdf:Description rdf:about="2.4.1.282">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-O-alpha-D-glucosyl-L-rhamnose phosphorylase</skos:prefLabel>
<activity rdf:resource="2.4.1.282#SIP0E3FA07C84AE67CE"/>
<rdfs:comment>The enzyme does not phosphorylate alpha,alpha-trehalose, kojibiose, nigerose, or maltose.</rdfs:comment>
<rdfs:comment>In the reverse phosphorolysis reaction the enzyme is specific for L-rhamnose as acceptor and beta-D-glucose 1-phosphate as donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22277537"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.282#SIP0E3FA07C84AE67CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-O-alpha-D-glucosyl-L-rhamnose + phosphate = beta-D-glucose 1-phosphate + L-rhamnopyranose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22277537">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22277537"/>
