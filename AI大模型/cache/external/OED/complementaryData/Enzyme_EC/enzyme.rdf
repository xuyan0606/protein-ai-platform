<activity rdf:resource="3.5.1.111#SIP5372A97567F6324E"/>
<rdfs:comment>The enzyme, which is highly specific for its substrate, participates in the nicotine degradation pathway of several Gram-positive bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21288482"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
