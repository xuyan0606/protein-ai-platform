<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (2E,4E)-dienoyl-CoA + H(+) + NADPH = a 4,5-saturated-(3E)-enoyl-CoA + NADP(+).</rdfs:label>
</rdf:Description>
