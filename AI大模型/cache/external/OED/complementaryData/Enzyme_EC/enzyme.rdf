<rdf:Description rdf:about="1.1.5.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclic alcohol dehydrogenase (quinone)</skos:prefLabel>
<skos:altLabel>cyclic alcohol dehydrogenase</skos:altLabel>
<skos:altLabel>MCAD</skos:altLabel>
<activity rdf:resource="1.1.5.7#SIP6F8B1DBD3F3DEB12"/>
<rdfs:comment>This enzyme oxidizes a wide variety of cyclic alcohols.</rdfs:comment>
<rdfs:comment>Some minor enzyme activity is found with aliphatic secondary alcohols and sugar alcohols, but not primary alcohols.</rdfs:comment>
<rdfs:comment>The enzyme is unable to catalyze the reverse reaction of cyclic ketones or aldehydes to cyclic alcohols.</rdfs:comment>
<rdfs:comment>This enzyme differs from EC 1.1.5.5, which shows activity with ethanol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11826975"/>
<rdfs:subClassOf rdf:resource="1.1.5.-"/>
<skos:broaderTransitive rdf:resource="1.1.5.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.5.7#SIP6F8B1DBD3F3DEB12">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a cyclic alcohol + a quinone = a cyclic ketone + a quinol.</rdfs:label>
</rdf:Description>
