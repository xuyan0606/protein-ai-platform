<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>mogrol + UDP-alpha-D-glucose = H(+) + mogroside IE + UDP.</rdfs:label>
</rdf:Description>
