<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an aliphatic amide = a nitrile + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.85">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dimethylmaleate hydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.85#SIP35A0B4DA5B182A9D"/>
<rdfs:comment>Inhibited by oxygen.</rdfs:comment>
<rdfs:comment>Forms part of the nicotinate-fermentation catabolism pathway in Eubacterium barkeri.</rdfs:comment>
<rdfs:comment>Other enzymes involved in this pathway are EC 1.17.5.1, EC 1.3.7.1, EC 3.5.2.18, EC 1.1.1.291, EC 5.4.99.4, EC 5.3.3.6 and EC 4.1.3.32.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6489933"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.85#SIP35A0B4DA5B182A9D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R,3S)-2,3-dimethylmalate = dimethylmaleate + H2O.</rdfs:label>
</rdf:Description>
