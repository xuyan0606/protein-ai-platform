<rdfs:label>2 AH2 + all-trans-zeaxanthin + 2 O2 = 2 A + all-trans-adonixanthin + 3 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.99.64#SIP0053A0A2644D15A7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 AH2 + all-trans-adonixanthin + 2 O2 = 2 A + all-trans-(3S,3'S)-astaxanthin + 3 H2O.</rdfs:label>
</rdf:Description>
