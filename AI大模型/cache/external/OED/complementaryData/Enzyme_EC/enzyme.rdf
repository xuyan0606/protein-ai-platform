<skos:prefLabel>dTDP-4-amino-2,3,4,6-tetradeoxy-D-glucose N,N-dimethyltransferase</skos:prefLabel>
<skos:altLabel>TDP-4-amino-2,3,6-trideoxy-D-glucose N,N-dimethyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.324#SIP2E1EC39E64BFE075"/>
<rdfs:comment>The enzyme was isolated from the bacterium Saccharopolyspora spinosa, where it is involved in the biosynthesis of spinosyn A, an active ingredient of several commercial insecticides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18345667"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
