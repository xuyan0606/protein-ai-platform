<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<dcterms:identifier>doi:doi.org/10.1021/ja00108a042</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>N-succinylornithine carbamoyltransferase</skos:prefLabel>
<skos:altLabel>N-succinyl-L-ornithine transcarbamylase</skos:altLabel>
<skos:altLabel>SOTCase</skos:altLabel>
<skos:altLabel>succinylornithine transcarbamylase</skos:altLabel>
<activity rdf:resource="2.1.3.11#SIPF292219D8059ED56"/>
<rdfs:comment>Specific for N-succinyl-L-ornithine and cannot use either L-ornithine (see EC 2.1.3.3) or N-acetyl-L-ornithine (see EC 2.1.3.9) as substrate.</rdfs:comment>
<rdfs:comment>However, a single amino-acid substitution (Pro90Glu) is sufficient to switch the enzyme to one that uses N-acetyl-L-ornithine as substrate.</rdfs:comment>
<rdfs:comment>It is essential for de novo arginine biosynthesis in the obligate anaerobe Bacteroides fragilis, suggesting that this organism uses an alternative pathway for synthesizing arginine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16704984"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17600144"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.11#SIPF292219D8059ED56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + N(2)-succinyl-L-ornithine = H(+) + N(2)-succinyl-L-citrulline + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16704984">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16704984"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/16704984"/>
</rdf:Description>
