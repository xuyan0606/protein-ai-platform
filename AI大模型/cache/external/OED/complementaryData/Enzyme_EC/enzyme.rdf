<rdf:Description rdf:about="4.3.2.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(3R)-3-[(carboxylmethyl)amino]fatty acid synthase</skos:prefLabel>
<activity rdf:resource="4.3.2.11#SIP5DAEEE10714B7011"/>
<activity rdf:resource="4.3.2.11#SIPC24E33FB16B1DAFA"/>
<rdfs:comment>The enzyme, found in some actinobacterial species, participates in the biosynthesis of isonitrile-containing lipopeptides.</rdfs:comment>
<rdfs:comment>It catalyzes the formation of (3R)-3-[(carboxylmethyl)amino]fatty acid by the addition of glycine and the release of the product from the acyl-carrier protein.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28634299"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29906336"/>
<rdfs:subClassOf rdf:resource="4.3.2.-"/>
<skos:broaderTransitive rdf:resource="4.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.11#SIP5DAEEE10714B7011">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (3R)-3-[(carboxymethyl)amino]fatty acid + H(+) + holo-[ACP] = a (2E)-enoyl-[ACP] + glycine + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.3.2.11#SIPC24E33FB16B1DAFA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R)-3-[(carboxymethyl)amino]butanoate + H(+) + holo-[ACP] = (2E)-butenoyl-[ACP] + glycine + H2O.</rdfs:label>
</rdf:Description>
