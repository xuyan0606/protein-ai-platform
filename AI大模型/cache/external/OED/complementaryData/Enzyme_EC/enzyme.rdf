<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/31324716"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/31911243">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/31911243"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/31911243"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.156">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>oligosaccharide reducing-end xylanase</skos:prefLabel>
<skos:altLabel>reducing end xylose-releasing exo-oligoxylanase</skos:altLabel>
<skos:altLabel>Rex</skos:altLabel>
<activity rdf:resource="3.2.1.156#SIP43D53A0CD66FD1A5"/>
<rdfs:comment>The enzyme, originally isolated from the bacterium Bacillus halodurans C-125, releases the xylose unit at the reducing end of oligosaccharides ending with the structure beta-D-xylopyranosyl-(1->4)-beta-D-xylopyranosyl-(1->4)-beta-D-xylopyranose, leaving the new reducing end in the alpha configuration.</rdfs:comment>
<rdfs:comment>It is specific for the beta anomers of xylooligosaccharides whose degree of polymerization is equal to or greater than 3.</rdfs:comment>
<rdfs:comment>The penultimate residue must be beta-D-xylopyranose, but replacing either of the flanking residues with glucose merely slows the rate greatly.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15491996"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15718242"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.156#SIP43D53A0CD66FD1A5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->4)-beta-D-xylose residues from the reducing end of oligosaccharides.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15491996">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/15491996"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/15491996"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15718242">
