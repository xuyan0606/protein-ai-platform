<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>indole-3-carboxylate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.92#SIPDFC9803A7FE50CF6"/>
<rdfs:comment>Activated by Zn(2+), Mn(2+) or Mg(2+).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12506977"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.92#SIPDFC9803A7FE50CF6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + indole-3-carboxylate = CO2 + indole.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12506977">
