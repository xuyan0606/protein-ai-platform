<activity rdf:resource="3.1.13.4#SIP6AE082DA09A9BADF"/>
<rdfs:comment>Cleaves poly(A) in either the single- or double-stranded form.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6246077"/>
