<rdf:Description rdf:about="2.1.1.286">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>25S rRNA (adenine(2142)-N(1))-methyltransferase</skos:prefLabel>
<skos:altLabel>25S rRNA m(1)A(2142) methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.286#SIPC946049B73967087"/>
<rdfs:comment>In the yeast Saccharomyces cerevisiae this methylation is important for resistance toward hydrogen peroxide and the antibiotic anisomycin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23558746"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
