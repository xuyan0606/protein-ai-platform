<rdf:Description rdf:about="1.8.5.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfite dehydrogenase (quinone)</skos:prefLabel>
<activity rdf:resource="1.8.5.6#SIP89E8F37B8551E861"/>
<rdfs:comment>This membrane-bound bacterial enzyme catalyzes the direct oxidation of sulfite to sulfate in the cytoplasm.</rdfs:comment>
<rdfs:comment>Characterized from the bacteria Ruegeria pomeroyi and Allochromatium vinosum. cf. EC 1.8.2.1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24030319"/>
<rdfs:subClassOf rdf:resource="1.8.5.-"/>
<skos:broaderTransitive rdf:resource="1.8.5.-"/>
</rdf:Description>
