<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endonucleolytic cleavage of DNA to give random double-stranded fragments with terminal 5'-phosphates, ATP is simultaneously hydrolyzed.</rdfs:label>
</rdf:Description>
