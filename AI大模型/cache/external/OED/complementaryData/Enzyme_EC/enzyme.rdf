<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-4-coumarate + UDP-alpha-D-glucose = 4-O-(beta-D-glucosyl)-trans-4-coumarate + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.127">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>monoterpenol beta-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.127#SIP3DCFD7DB3A531CD7"/>
