<citation rdf:resource="http://purl.uniprot.org/citations/14188174"/>
<rdfs:subClassOf rdf:resource="4.2.2.-"/>
<skos:broaderTransitive rdf:resource="4.2.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.2.9#SIP0014C5A8962C9D05">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(1->4)-alpha-D-galacturonosyl](n) = 4-(4-deoxy-alpha-D-galact-4-enuronosyl)-D-galacturonate + [(1->4)-alpha-D-galacturonosyl](n-2).</rdfs:label>
</rdf:Description>
