<skos:prefLabel>octopamine dehydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.87#SIPC07FFE9E42226300"/>
<rdfs:comment>The enzyme-catalyzed reaction is believed to be dehydration to an enamine, which is spontaneously hydrolyzed to an aldehyde and ammonia.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3034855"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
