<rdf:Description rdf:about="1.14.20.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(5R)-carbapenem-3-carboxylate synthase</skos:prefLabel>
<activity rdf:resource="1.14.20.3#SIP36E9447B3FC902E5"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of the carbapenem beta-lactam antibiotic (5R)-carbapen-2-em-3-carboxylate in the bacterium Pectobacterium carotovorum.</rdfs:comment>
<rdfs:comment>It catalyzes a stereoinversion at C(5) and introduces a double bond between C-2 and C-3.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12611886"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12848554"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15174175"/>
<rdfs:subClassOf rdf:resource="1.14.20.-"/>
<skos:broaderTransitive rdf:resource="1.14.20.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.3#SIP36E9447B3FC902E5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3S,5S)-carbapenam-3-caboxylate + 2-oxoglutarate + O2 = (5R)-carbapenem-3-carboxylate + CO2 + H2O + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12611886">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
