<rdf:Description rdf:about="3.5.99.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="5.3.1.10"/>
<skos:prefLabel>glucosamine-6-phosphate deaminase</skos:prefLabel>
<skos:altLabel>GlcN6P deaminase</skos:altLabel>
<skos:altLabel>glucosamine-6-phosphate isomerase</skos:altLabel>
<skos:altLabel>glucosamine phosphate deaminase</skos:altLabel>
<skos:altLabel>phosphoglucosamine isomerase</skos:altLabel>
<skos:altLabel>phosphoglucosaminisomerase</skos:altLabel>
<activity rdf:resource="3.5.99.6#SIPA1918F4A0E7E9E42"/>
<rdfs:comment>Isomerization of the aldose-ketose type converts the -CH(-NH2)-CH=O group of glucosamine 6-phosphate into -C(=NH)-CH2-OH, forming 2-deoxy-2-imino-D-arabino-hexitol which then hydrolyzes to yield fructose 6-phosphate and ammonia.</rdfs:comment>
<rdfs:comment>N-acetyl-D-glucosamine 6-phosphate, which is not broken down, activates the enzyme.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/13403679"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13549465"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14484386"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18436239"/>
<rdfs:subClassOf rdf:resource="3.5.99.-"/>
<skos:broaderTransitive rdf:resource="3.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.99.6#SIPA1918F4A0E7E9E42">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-glucosamine 6-phosphate + H2O = beta-D-fructose 6-phosphate + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/13403679">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/13403679"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/13403679"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/13549465">
