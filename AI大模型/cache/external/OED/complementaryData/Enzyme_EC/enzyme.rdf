<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-ubiquitinyl-[E1 ubiquitin-activating enzyme]-L-cysteine + [E2 ubiquitin-conjugating enzyme]-L-cysteine = [E1 ubiquitin-activating enzyme]-L-cysteine + S-ubiquitinyl-[E2 ubiquitin-conjugating enzyme]-L-cysteine.</rdfs:label>
</rdf:Description>
