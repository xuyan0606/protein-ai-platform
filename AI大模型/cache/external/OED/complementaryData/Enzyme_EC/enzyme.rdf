<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (3R)-hydroxyacyl-[ACP] + L-ornithine = a lyso-ornithine lipid + H(+) + holo-[ACP].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15341653">
