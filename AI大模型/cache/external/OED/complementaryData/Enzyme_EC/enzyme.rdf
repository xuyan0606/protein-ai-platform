<rdf:Description rdf:about="6.3.4.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>formate--phosphoribosylaminoimidazolecarboxamide ligase</skos:prefLabel>
<skos:altLabel>5-formaminoimidazole-4-carboxamide-1-beta-D-ribofuranosyl 5'-monophosphate synthetase</skos:altLabel>
<skos:altLabel>5-formaminoimidazole-4-carboxamide ribonucleotide synthetase</skos:altLabel>
<activity rdf:resource="6.3.4.23#SIP48C0C35021090D37"/>
<rdfs:comment>This archaeal enzyme, characterized from the methanogen Methanocaldococcus jannaschii, catalyzes a step in the synthesis of purine nucleotides.</rdfs:comment>
<rdfs:comment>It differs from the orthologous bacterial/eukaryotic enzymes, which utilize 10-formyltetrahydrofolate rather than formate and ATP. cf. EC 2.1.2.3.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15623504"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18069798"/>
<rdfs:subClassOf rdf:resource="6.3.4.-"/>
<skos:broaderTransitive rdf:resource="6.3.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.3.4.23#SIP48C0C35021090D37">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-amino-1-(5-phospho-beta-D-ribosyl)imidazole-4-carboxamide + ATP + formate = 5-formamido-1-(5-phospho-D-ribosyl)imidazole-4-carboxamide + ADP + phosphate.</rdfs:label>
</rdf:Description>
