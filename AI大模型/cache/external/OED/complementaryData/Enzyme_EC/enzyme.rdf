<citation rdf:resource="http://purl.uniprot.org/citations/9108258"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11265457"/>
<rdfs:subClassOf rdf:resource="1.2.7.-"/>
<skos:broaderTransitive rdf:resource="1.2.7.-"/>
</rdf:Description>
