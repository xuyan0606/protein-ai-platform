<rdf:Description rdf:about="3.7.1.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.7.1.n2"/>
<skos:prefLabel>3D-(3,5/4)-trihydroxycyclohexane-1,2-dione acylhydrolase (decyclizing)</skos:prefLabel>
<skos:altLabel>THcHDO hydrolase</skos:altLabel>
<activity rdf:resource="3.7.1.22#SIP84122721B4FC38B9"/>
<rdfs:comment>The enzyme, found in the bacterium Bacillus subtilis, is part of the myo-inositol degradation pathway leading to acetyl-CoA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18310071"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
