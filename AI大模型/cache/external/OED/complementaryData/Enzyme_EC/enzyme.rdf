<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/20382657"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/20382657"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22761755">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22761755"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22761755"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.115">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.5.1.n8"/>
<skos:prefLabel>homogentisate phytyltransferase</skos:prefLabel>
<skos:altLabel>HPT</skos:altLabel>
<activity rdf:resource="2.5.1.115#SIP1BA97793527C35A4"/>
<rdfs:comment>Involved in the biosynthesis of the vitamin E tocopherols.</rdfs:comment>
<rdfs:comment>While the enzyme from the cyanobacterium Synechocystis PCC 6803 has an appreciable activity with geranylgeranyl diphosphate (EC 2.5.1.116), the enzyme from the plant Arabidopsis thaliana has only a low activity with that substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11706191"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12011362"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16989822"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21223386"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.115#SIP1BA97793527C35A4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + homogentisate + phytyl diphosphate = 2-methyl-6-phytyl-1,4-benzene-1,4-diol + CO2 + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11706191">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11706191"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/11706191"/>
</rdf:Description>
