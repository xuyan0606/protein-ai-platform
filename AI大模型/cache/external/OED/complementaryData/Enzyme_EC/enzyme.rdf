<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hydrogen sulfide + NADP(+) + n sulfur = NADPH + (n+1) sulfur.</rdfs:label>
</rdf:Description>
