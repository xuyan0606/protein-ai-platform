<skos:altLabel>free-methionine (R)-S-oxide reductase</skos:altLabel>
<skos:altLabel>free met-R-(o) reductase</skos:altLabel>
<skos:altLabel>FRMsr</skos:altLabel>
<activity rdf:resource="1.8.4.14#SIP5275F61AAC157BE9"/>
