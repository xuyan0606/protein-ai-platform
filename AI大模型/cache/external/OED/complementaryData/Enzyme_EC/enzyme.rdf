<rdf:Description rdf:about="3.4.23.48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>plasminogen activator Pla</skos:prefLabel>
<skos:altLabel>coagulase/fibrinolysin</skos:altLabel>
<activity rdf:resource="3.4.23.48#SIP272CA84674D31DF8"/>
<rdfs:comment>From the bacterium Yersinia pestis that causes plague.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family A26.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11401715"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.48#SIP272CA84674D31DF8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Converts human Glu-plasminogen to plasmin by cleaving the 560-Arg-|-Val-561 peptide bond that is also hydrolyzed by the mammalian u-plasminogen activator and t-plasminogen activator. Also cleaves arginyl bonds in other proteins.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11401715">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11401715"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/11401715"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.4.21.87"/>
<skos:prefLabel>omptin</skos:prefLabel>
<skos:altLabel>outer membrane protein 3B</skos:altLabel>
<skos:altLabel>protease A</skos:altLabel>
<skos:altLabel>protease VII</skos:altLabel>
<activity rdf:resource="3.4.23.49#SIPC71F293EEA6722DB"/>
<rdfs:comment>Shows a preference for cleavage between consecutive basic amino acids, but is capable of cleavage when P1' is a non-basic residue.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family A26.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1603076"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3056908"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3278297"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11566868"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11576541"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15317797"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.49#SIPC71F293EEA6722DB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Has a virtual requirement for Arg in the P1 position and a slightly less stringent preference for this residue in the P1' position, which can also contain Lys, Gly or Val.</rdfs:label>
</rdf:Description>
