<rdf:Description rdf:about="3.1.1.88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pyrethroid hydrolase</skos:prefLabel>
<skos:altLabel>permethrinase</skos:altLabel>
<skos:altLabel>pyrethroid-cleaving enzyme</skos:altLabel>
<skos:altLabel>pyrethroid-hydrolyzing carboxylesterase</skos:altLabel>
<skos:altLabel>pyrethroid-hydrolyzing esterase</skos:altLabel>
<skos:altLabel>pyrethroid-selective esterase</skos:altLabel>
<activity rdf:resource="3.1.1.88#SIP6C079B57DAA97970"/>
<rdfs:comment>The enzyme is involved in degradation of pyrethroid pesticides.</rdfs:comment>
<rdfs:comment>The enzymes from Sphingobium sp., Klebsiella sp. and Aspergillus niger hydrolyze cis-permethrin at approximately equal rate to trans-permethrin.</rdfs:comment>
<rdfs:comment>The enzyme from mouse hydrolyzes trans-permethrin at a rate about 22-fold higher than cis-permethrin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8357241"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15123619"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16159167"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16448191"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19581484"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.88#SIP6C079B57DAA97970">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-trans-permethrin + H2O = (1S,3R)-3-(2,2-dichlorovinyl)-2,2-dimethylcyclopropanecarboxylate + (3-phenoxyphenyl)methanol + H(+).</rdfs:label>
</rdf:Description>
