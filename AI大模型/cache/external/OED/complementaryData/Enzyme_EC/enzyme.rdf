<rdf:Description rdf:about="2.1.1.341">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>vanillate/3-O-methylgallate O-demethylase</skos:prefLabel>
<activity rdf:resource="2.1.1.341#SIP181031EF02E9C985"/>
<activity rdf:resource="2.1.1.341#SIPEB1F835B9038CAEA"/>
<rdfs:comment>The enzyme, characterized from the bacterium Sphingomonas sp. SYK6, is involved in the degradation of lignin.</rdfs:comment>
<rdfs:comment>The enzyme has similar activities with vanillate and 3-O-methylgallate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9501423"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15090517"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15743951"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
