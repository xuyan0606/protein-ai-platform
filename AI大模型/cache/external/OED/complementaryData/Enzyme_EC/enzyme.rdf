<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphoethanolamine + alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid A (E. coli) = 7-O-[2-aminoethoxy(hydroxy)phosphoryl]-alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid A + a 1,2-diacyl-sn-glycerol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.42#SIPBF12A13085A1715C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphoethanolamine + alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid IVA (E. coli) = 7-O-[2-aminoethoxy(hydroxy)phosphoryl]-alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid IVA (E. coli) + a 1,2-diacyl-sn-glycerol.</rdfs:label>
</rdf:Description>
