<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-epi-6-deoxocathasterone + O2 + reduced [NADPH--hemoprotein reductase] = 6-deoxotyphasterol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.147#SIP5568C6E7B2F418E5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(22S,24R)-22-hydroxy-5alpha-ergostan-3-one + O2 + reduced [NADPH--hemoprotein reductase] = 3-dehydro-6-deoxoteasterone + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
