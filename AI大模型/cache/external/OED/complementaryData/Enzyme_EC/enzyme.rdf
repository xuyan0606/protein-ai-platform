<rdf:Description rdf:about="3.2.1.142">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>limit dextrinase</skos:prefLabel>
<skos:altLabel>amylopectin-1,6-glucosidase</skos:altLabel>
<skos:altLabel>R-enzyme</skos:altLabel>
<activity rdf:resource="3.2.1.142#SIPF4321115C0E0CBCC"/>
<rdfs:comment>Plant enzymes with little or no action on glycogen.</rdfs:comment>
<rdfs:comment>Action on amylopectin is incomplete, but action on alpha-limit dextrins is complete.</rdfs:comment>
<rdfs:comment>Maltose is the smallest sugar it can release from an alpha-(1->6)-linkage.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.142#SIPF4321115C0E0CBCC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->6)-alpha-D-glucosidic linkages in alpha- and beta-limit dextrins of amylopectin and glycogen, and in amylopectin and pullulan.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.143">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>poly(ADP-ribose) glycohydrolase</skos:prefLabel>
<activity rdf:resource="3.2.1.143#SIPA707C3DF383A473F"/>
