<rdf:Description rdf:about="4.2.3.28">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ent-cassa-12,15-diene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.28#SIP0FED1D348B784FB1"/>
<rdfs:comment>This class I diterpene cyclase produces ent-cassa-12,15-diene, a precursor of the rice phytoalexins (-)-phytocassanes A-E. Phytoalexins are diterpenoid secondary metabolites that are involved in the defense mechanism of the plant, and are produced in response to pathogen attack through the perception of elicitor signal molecules such as chitin oligosaccharide, or after exposure to UV irradiation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14675427"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.28#SIP0FED1D348B784FB1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ent-copalyl diphosphate = diphosphate + ent-cassa-12,15-diene.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/14675427">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
