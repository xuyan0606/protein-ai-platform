<skos:prefLabel>2-oxo-4-hydroxy-4-carboxy-5-ureidoimidazoline decarboxylase</skos:prefLabel>
<skos:altLabel>OHCU decarboxylase</skos:altLabel>
<activity rdf:resource="4.1.1.97#SIP74EEA7CB01F57F1C"/>
<rdfs:comment>This enzyme is part of the pathway from urate to (S)-allantoin, which is present in bacteria, plants and animals (but not in humans).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16462750"/>
