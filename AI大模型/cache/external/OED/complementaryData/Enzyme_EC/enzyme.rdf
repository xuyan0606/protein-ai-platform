<rdf:Description rdf:about="2.7.7.91">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>valienol-1-phosphate guanylyltransferase</skos:prefLabel>
<activity rdf:resource="2.7.7.91#SIP573959D52F346347"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces hygroscopicus subsp. limoneus, is involved in the biosynthesis of the antifungal agent validamycin A.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20981366"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21766819"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
