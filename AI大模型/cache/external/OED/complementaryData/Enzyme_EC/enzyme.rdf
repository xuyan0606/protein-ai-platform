<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>The enzyme releases L-Ala-gamma-D-Glu dipeptides from cell wall peptides via cleavage of an L-Ala-gamma-D-Glu-|-L-Lys bond.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11747447">
