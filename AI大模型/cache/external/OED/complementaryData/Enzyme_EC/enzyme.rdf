<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 L-tyrosyl-tRNA(Tyr) = cyclo(L-tyrosyl-L-tyrosyl) + 2 tRNA(Tyr).</rdfs:label>
</rdf:Description>
