<activity rdf:resource="2.3.1.101#SIPF46302D9912FE0CD"/>
<rdfs:comment>Methanofuran is a complex 4-substituted furfurylamine and is involved in the formation of methane from CO2 in Methanobacterium thermoautotrophicum.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3097011"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
