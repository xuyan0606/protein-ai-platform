<rdf:Description rdf:about="1.17.1.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>CDP-4-dehydro-6-deoxyglucose reductase</skos:prefLabel>
<skos:altLabel>CDP-4-keto-6-deoxy-D-glucose-3-dehydrogenase system</skos:altLabel>
<skos:altLabel>CDP-4-keto-6-deoxyglucose reductase</skos:altLabel>
<skos:altLabel>CDP-4-keto-deoxy-glucose reductase</skos:altLabel>
<skos:altLabel>cytidine diphosphate 4-keto-6-deoxy-D-glucose-3-dehydrogenase</skos:altLabel>
<skos:altLabel>cytidine diphospho-4-keto-6-deoxy-D-glucose reductase</skos:altLabel>
<skos:altLabel>NAD(P)H:CDP-4-keto-6-deoxy-D-glucose oxidoreductase</skos:altLabel>
<activity rdf:resource="1.17.1.1#SIP1F20E2FFDFFC69CE"/>
<activity rdf:resource="1.17.1.1#SIPB1B6A7972095C60B"/>
<rdfs:comment>The enzyme consists of two proteins.</rdfs:comment>
<rdfs:comment>One forms an enzyme-bound adduct of the CDP-4-dehydro-6-deoxyglucose with pyridoxamine phosphate, in which the 3-hydroxy group has been removed.</rdfs:comment>
<rdfs:comment>The second catalyzes the reduction of this adduct by NAD(P)H and release of the CDP-4-dehydro-3,6-dideoxy-D-glucose and pyridoxamine phosphate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4152100"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4389672"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7826006"/>
<rdfs:subClassOf rdf:resource="1.17.1.-"/>
<skos:broaderTransitive rdf:resource="1.17.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.17.1.1#SIP1F20E2FFDFFC69CE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CDP-4-dehydro-3,6-dideoxy-alpha-D-glucose + H2O + NAD(+) = CDP-4-dehydro-6-deoxy-alpha-D-glucose + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.17.1.1#SIPB1B6A7972095C60B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CDP-4-dehydro-3,6-dideoxy-alpha-D-glucose + H2O + NADP(+) = CDP-4-dehydro-6-deoxy-alpha-D-glucose + H(+) + NADPH.</rdfs:label>
</rdf:Description>
