<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-1-phenylethanol + NAD(+) = acetophenone + H(+) + NADH.</rdfs:label>
</rdf:Description>
