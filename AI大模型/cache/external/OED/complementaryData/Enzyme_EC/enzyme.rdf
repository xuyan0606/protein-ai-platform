<rdf:Description rdf:about="2.7.7.48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>RNA-directed RNA polymerase</skos:prefLabel>
<skos:altLabel>RNA nucleotidyltransferase (RNA-directed)</skos:altLabel>
<activity rdf:resource="2.7.7.48#SIP1071BA4F95839D47"/>
<rdfs:comment>Catalyzes RNA-template-directed extension of the 3'-end of an RNA strand by one nucleotide at a time.</rdfs:comment>
<rdfs:comment>Can initiate a chain de novo.</rdfs:comment>
<rdfs:comment>See also EC 2.7.7.6.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.48#SIP1071BA4F95839D47">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ribonucleoside 5'-triphosphate + RNA(n) = diphosphate + RNA(n+1).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>RNA-directed DNA polymerase</skos:prefLabel>
<skos:altLabel>DNA nucleotidyltransferase (RNA-directed)</skos:altLabel>
<skos:altLabel>reverse transcriptase</skos:altLabel>
<skos:altLabel>revertase</skos:altLabel>
<activity rdf:resource="2.7.7.49#SIPD6709105FFB2E7A3"/>
<rdfs:comment>Catalyzes RNA-template-directed extension of the 3'-end of a DNA strand by one deoxynucleotide at a time.</rdfs:comment>
<rdfs:comment>Cannot initiate a chain de novo.</rdfs:comment>
<rdfs:comment>Requires a RNA or DNA primer.</rdfs:comment>
<rdfs:comment>DNA can also serve as template.</rdfs:comment>
<rdfs:comment>See also EC 2.7.7.7.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4316300"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4316301"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.49#SIPD6709105FFB2E7A3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2'-deoxyribonucleoside 5'-triphosphate + DNA(n) = diphosphate + DNA(n+1).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4316300">
