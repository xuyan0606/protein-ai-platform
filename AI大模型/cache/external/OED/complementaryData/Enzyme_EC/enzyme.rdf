<rdf:Description rdf:about="2.4.1.174">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucuronylgalactosylproteoglycan 4-beta-N-acetylgalactosaminyltransferase</skos:prefLabel>
<skos:altLabel>glucuronylgalactosylproteoglycan beta-1,4-N-acetylgalactosaminyltransferase</skos:altLabel>
<skos:altLabel>N-acetylgalactosaminyltransferase I</skos:altLabel>
<skos:altLabel>uridine diphosphoacetylgalactosamine-chondroitin acetylgalactosaminyltransferase I</skos:altLabel>
<activity rdf:resource="2.4.1.174#SIP1B2A1E00AC5B3B0B"/>
<rdfs:comment>Involved in the biosynthesis of chondroitin sulfate.</rdfs:comment>
<rdfs:comment>Key enzyme activity for the initiation of chondroitin and dermatan sulfates, transferring GalNAc to the GlcA-Gal-Gal-Xyl-Ser core.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3922754"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11788602"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.174#SIP1B2A1E00AC5B3B0B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-O-(beta-D-GlcA-(1->3)-beta-D-Gal-(1->3)-beta-D-Gal-(1->4)-beta-D-Xyl)-L-seryl-[protein] + UDP-N-acetyl-alpha-D-galactosamine = 3-O-(beta-D-GalNAc-(1->4)-beta-D-GlcA-(1->3)-beta-D-Gal-(1->3)-beta-D-Gal-(1->4)-beta-D-Xyl)-L-seryl-[protein] + H(+) + UDP.</rdfs:label>
</rdf:Description>
