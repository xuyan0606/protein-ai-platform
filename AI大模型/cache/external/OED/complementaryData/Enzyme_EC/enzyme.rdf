<rdf:Description rdf:about="1.14.14.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.1.1"/>
<replaces rdf:resource="1.14.14.2"/>
