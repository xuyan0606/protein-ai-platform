<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-5-epi-aristolochene + 2 O2 + 2 reduced [NADPH--hemoprotein reductase] = capsidiol + 2 H(+) + 2 H2O + 2 oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
