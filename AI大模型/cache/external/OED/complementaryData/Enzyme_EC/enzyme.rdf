<rdf:Description rdf:about="4.1.1.112">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.1.1.3"/>
<skos:prefLabel>oxaloacetate decarboxylase</skos:prefLabel>
<skos:altLabel>oxalate beta-decarboxylase</skos:altLabel>
<skos:altLabel>oxaloacetate carboxy-lyase</skos:altLabel>
<activity rdf:resource="4.1.1.112#SIP67D6CAA298CBDF6F"/>
<rdfs:comment>The enzymes from the fish Gadus morhua (Atlantic cod) and the bacterium Micrococcus luteus prefer Mn(2+), while those from the bacteria Pseudomonas putida and Pseudomonas aeruginosa prefer Mg(2+).</rdfs:comment>
<rdfs:comment>Unlike EC 7.2.4.2, there is no evidence of the enzyme's involvement in Na(+) transport.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5972993"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14205502"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15251467"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18081320"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.112#SIP67D6CAA298CBDF6F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + oxaloacetate = CO2 + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/5972993">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/5972993"/>
