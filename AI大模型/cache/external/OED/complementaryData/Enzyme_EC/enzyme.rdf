<rdf:Description rdf:about="2.3.1.312">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-glutamate N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.312#SIPC40A8330299FE073"/>
<activity rdf:resource="2.3.1.312#SIP2EF6F9DEB86F9F53"/>
<activity rdf:resource="2.3.1.312#SIP696D23F418581DB3"/>
<rdfs:comment>The enzyme, present in bacteria and archaea, participates in a pathway for the degradation of D-glutamate.</rdfs:comment>
<rdfs:comment>The enzyme from the marine bacterium Pseudoalteromonas sp. CF6-2 can also acetylate D-glutamine, D-aspartate, and D-asparagine with lower activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/36690779"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.312#SIPC40A8330299FE073">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + D-glutamate = CoA + H(+) + N-acetyl-D-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.312#SIP2EF6F9DEB86F9F53">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + D-glutamine = CoA + H(+) + N-acetyl-D-glutamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.312#SIP696D23F418581DB3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + D-aspartate = CoA + H(+) + N-acetyl-D-aspartate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/36690779">
