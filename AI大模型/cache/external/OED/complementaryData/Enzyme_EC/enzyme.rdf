<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-lipoate + ATP + L-lysyl-[lipoyl-carrier protein] = AMP + diphosphate + H(+) + N(6)-[(R)-lipoyl]-L-lysyl-[lipoyl-carrier protein].</rdfs:label>
</rdf:Description>
