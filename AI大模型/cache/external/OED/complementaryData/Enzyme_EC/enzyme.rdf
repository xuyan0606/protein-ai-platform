</rdf:Description>
<rdf:Description rdf:about="2.3.1.220">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2,4,6-trihydroxybenzophenone synthase</skos:prefLabel>
<skos:altLabel>benzophenone synthase</skos:altLabel>
<activity rdf:resource="2.3.1.220#SIP43400EED2F1FC970"/>
<rdfs:comment>Involved in the biosynthesis of plant xanthones.</rdfs:comment>
<rdfs:comment>The enzyme from the plant Hypericum androsaemum L can use 3-hydroxybenzoyl-CoA instead of benzoyl-CoA, but with lower activity (cf. EC 2.3.1.151).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9459298"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22390826"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.220#SIP43400EED2F1FC970">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>benzoyl-CoA + 2 H(+) + 3 malonyl-CoA = 2,4,6-trihydroxybenzophenone + 3 CO2 + 4 CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9459298">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9459298"/>
