<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-amyrin + O2 + reduced [NADPH--hemoprotein reductase] = 16alpha-hydroxy-beta-amyrin + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
