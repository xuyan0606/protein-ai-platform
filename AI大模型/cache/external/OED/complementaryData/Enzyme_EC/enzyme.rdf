<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5a,11a-dehydrotetracycline reductase</skos:prefLabel>
<skos:altLabel>12-dehydrotetracycline dehydrogenase</skos:altLabel>
<skos:altLabel>12-dehydrotetracycline reductase</skos:altLabel>
<skos:altLabel>dehydrooxytetracycline dehydrogenase</skos:altLabel>
<activity rdf:resource="1.3.98.4#SIPFAD8F5C1F8844A66"/>
<activity rdf:resource="1.3.98.4#SIP58E4FE49D9DE2F86"/>
<rdfs:comment>The enzyme, characterized from the bacteria Streptomyces aureofaciens and Streptomyces rimosus, catalyzes the last step in the biosynthesis of the tetracycline antibiotics tetracycline and oxytetracycline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23621493"/>
<rdfs:subClassOf rdf:resource="1.3.98.-"/>
<skos:broaderTransitive rdf:resource="1.3.98.-"/>
</rdf:Description>
