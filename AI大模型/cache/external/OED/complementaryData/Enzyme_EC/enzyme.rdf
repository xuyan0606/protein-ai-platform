<rdf:Description rdf:about="6.3.2.48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-arginine-specific L-amino acid ligase</skos:prefLabel>
<activity rdf:resource="6.3.2.48#SIP1DD90063736ED9AB"/>
<rdfs:comment>The enzyme shows strict substrate specificity toward L-arginine as the N-terminal amino acid of the product.</rdfs:comment>
<rdfs:comment>The second amino acid could be any standard protein-building amino acid except for L-proline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19352016"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
<skos:broaderTransitive rdf:resource="6.3.2.-"/>
</rdf:Description>
