<rdf:Description rdf:about="1.14.14.31">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.207"/>
<skos:prefLabel>ipsdienol synthase</skos:prefLabel>
<skos:altLabel>CYP9T2</skos:altLabel>
<skos:altLabel>CYP9T3</skos:altLabel>
<skos:altLabel>myrcene hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.14.31#SIP44C1CE17BAC3D968"/>
<rdfs:comment>Involved in the insect aggregation pheromone production.</rdfs:comment>
<rdfs:comment>Isolated from the pine engraver beetle, Ips pini.</rdfs:comment>
<rdfs:comment>A small amount of (S)-ipsdienol is also formed.</rdfs:comment>
<rdfs:comment>In vitro it also hydroxylates (+)- and (-)-alpha-pinene, 3-carene, and (+)-limonene, but not alpha-phellandrene, (-)-beta-pinene, gamma-terpinene, or terpinolene.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17046597"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23376633"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.31#SIP44C1CE17BAC3D968">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-myrcene + O2 + reduced [NADPH--hemoprotein reductase] = (4R)-ipsdienol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17046597">
