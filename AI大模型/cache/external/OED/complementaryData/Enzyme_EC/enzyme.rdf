<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-erythrose 4-phosphate + H2O + NAD(+) = 4-phospho-D-erythronate + 2 H(+) + NADH.</rdfs:label>
</rdf:Description>
