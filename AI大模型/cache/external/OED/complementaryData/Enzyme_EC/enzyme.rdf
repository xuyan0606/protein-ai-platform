<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18223037"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.339">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>xanthohumol 4-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.339#SIP0DB00613EBD530D7"/>
<rdfs:comment>The enzyme from hops (Humulus lupulus) has a broad substrate specificity.</rdfs:comment>
<rdfs:comment>The best substrates in vitro are resveratrol, desmethylxanthohumol, chalconaringenin and isoliquiritigenin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18223037"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.339#SIP0DB00613EBD530D7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + xanthohumol = 4-O-methylxanthohumol + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18223037">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
