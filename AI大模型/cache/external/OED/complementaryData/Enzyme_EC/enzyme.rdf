<rdf:Description rdf:about="2.7.1.223">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>aminoimidazole riboside kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.223#SIPC218A4B176BB25DB"/>
<rdfs:comment>The enzyme, characterized from the bacterium Salmonella enterica, can phosphorylate exogeneously-provided 5-amino-1-(beta-D-ribosyl)imidazole to form 5-amino-1-(5-phospho-beta-D-ribosyl)imidazole (AIR), an important intermediate in the production of both purine mononucleotides and the hydroxymethyl pyrimidine moiety of thiamine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12486071"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15458630"/>
