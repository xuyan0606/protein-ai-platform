<skos:prefLabel>human endogenous retrovirus K endopeptidase</skos:prefLabel>
<skos:altLabel>HERV K10 endopeptidase</skos:altLabel>
<skos:altLabel>HERV K10 retropepsin</skos:altLabel>
<skos:altLabel>human endogenous retrovirus K10 endopeptidase</skos:altLabel>
<skos:altLabel>human endogenous retrovirus K113 protease</skos:altLabel>
<skos:altLabel>human retrovirus K10 retropepsin</skos:altLabel>
<activity rdf:resource="3.4.23.50#SIPBE338556238730FD"/>
<rdfs:comment>Belongs to peptidase family A2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9860826"/>
