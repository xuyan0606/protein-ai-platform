<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11747448"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/11747448"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.1.21">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoleucine 2-epimerase</skos:prefLabel>
<skos:altLabel>BCAA racemase</skos:altLabel>
<activity rdf:resource="5.1.1.21#SIP99CFA7AA9695D821"/>
<rdfs:comment>The enzyme, characterized from the bacterium Lactobacillus buchneri, specifically catalyzes racemization of nonpolar amino acids at the C-2 position.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24039265"/>
<rdfs:subClassOf rdf:resource="5.1.1.-"/>
<skos:broaderTransitive rdf:resource="5.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.1.21#SIP99CFA7AA9695D821">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-isoleucine = D-allo-isoleucine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24039265">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24039265"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24039265"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.1.22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-hydroxyproline betaine 2-epimerase</skos:prefLabel>
<activity rdf:resource="5.1.1.22#SIPAFD65F4360466C9F"/>
<activity rdf:resource="5.1.1.22#SIP24EB1251B2BE0E4C"/>
<rdfs:comment>The enzyme, characterized from the bacteria Pelagibaca bermudensis and Paracoccus denitrificans, specifically catalyzes racemization of trans-4-hydroxy-L-proline betaine and L-proline betaine at the C-2 position.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24056934"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24520058"/>
<rdfs:subClassOf rdf:resource="5.1.1.-"/>
<skos:broaderTransitive rdf:resource="5.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.1.22#SIPAFD65F4360466C9F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>trans-4-hydroxy-L-proline betaine = cis-4-hydroxy-D-proline betaine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="5.1.1.22#SIP24EB1251B2BE0E4C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-proline betaine = D-proline betaine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24056934">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/24056934"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/24056934"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24520058">
