<rdf:Description rdf:about="6.3.2.40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.7.54"/>
<replaces rdf:resource="2.7.7.55"/>
<skos:prefLabel>cyclopeptine synthase</skos:prefLabel>
<activity rdf:resource="6.3.2.40#SIPA7F73B3C671DD207"/>
<rdfs:comment>Cyclopeptine synthase is the key enzyme of benzodiazepine alkaloid biosynthesis in the fungus Penicillium cyclopium.</rdfs:comment>
<rdfs:comment>The enzyme is a non-ribosomal peptide synthase.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2995633"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
<skos:broaderTransitive rdf:resource="6.3.2.-"/>
</rdf:Description>
