<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-oxoisoapionate + ATP = 3-oxoisoapionate 4-phosphate + ADP + H(+).</rdfs:label>
</rdf:Description>
