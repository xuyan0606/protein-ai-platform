<rdf:Description rdf:about="2.3.1.160">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>vinorine synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.160#SIP8485454DFDF96EFA"/>
<rdfs:comment>The reaction proceeds in two stages.</rdfs:comment>
<rdfs:comment>The indole nitrogen of 16-epivellosimine interacts with its aldehyde group giving an hydroxy-substituted new ring.</rdfs:comment>
<rdfs:comment>This alcohol is then acetylated.</rdfs:comment>
<rdfs:comment>Also acts on gardneral (11-methoxy-16-epivellosimine).</rdfs:comment>
<rdfs:comment>Generates the ajmalan skeleton, which forms part of the route to ajmaline.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15110860"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15450182"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15665331"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.160#SIP8485454DFDF96EFA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>16-epivellosimine + acetyl-CoA = CoA + vinorine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/15110860">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/15110860"/>
