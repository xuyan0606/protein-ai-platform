<skos:altLabel>vicilin peptidohydrolase</skos:altLabel>
<activity rdf:resource="3.4.22.34#SIP00A06091BD725ADB"/>
<rdfs:comment>Best known from legume seeds, the trematode Schistosoma mansoni and mammalian lysosomes.</rdfs:comment>
<rdfs:comment>Not inhibited by compound E-64.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family C13.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9891971"/>
<rdfs:subClassOf rdf:resource="3.4.22.-"/>
<skos:broaderTransitive rdf:resource="3.4.22.-"/>
</rdf:Description>
