<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E,10E)-geranylgeranyl diphosphate = diphosphate + rhizathalene A.</rdfs:label>
</rdf:Description>
