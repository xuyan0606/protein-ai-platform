<rdf:Description rdf:about="3.7.1.20">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-fumarylpyruvate hydrolase</skos:prefLabel>
<activity rdf:resource="3.7.1.20#SIP461DA406B29732ED"/>
<rdfs:comment>The enzyme is involved in bacterial degradation of 5-substituted salicylates, including gentisate (5-hydroxysalicylate), 5-nitrosalicylate and 5-halosalicylates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11133965"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21498645"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.7.1.20#SIP461DA406B29732ED">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-fumarylpyruvate + H2O = fumarate + H(+) + pyruvate.</rdfs:label>
</rdf:Description>
