<rdf:Description rdf:about="4.1.1.87">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>malonyl-[malonate decarboxylase] decarboxylase</skos:prefLabel>
<skos:altLabel>malonyl-S-ACP decarboxylase</skos:altLabel>
<skos:altLabel>malonyl-S-acyl-carrier protein decarboxylase</skos:altLabel>
<activity rdf:resource="4.1.1.87#SIP7AB34428DE2C9DB3"/>
<rdfs:comment>This enzyme comprises the beta and gamma subunits of EC 4.1.1.88 but is not present in EC 7.2.4.4.</rdfs:comment>
<rdfs:comment>It follows on from EC 2.3.1.187 and results in the regeneration of the acetylated form of the acyl-carrier-protein subunit of malonate decarboxylase.</rdfs:comment>
<rdfs:comment>The carboxy group is lost with retention of configuration.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8620876"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10496981"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10561613"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11902724"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12619701"/>
