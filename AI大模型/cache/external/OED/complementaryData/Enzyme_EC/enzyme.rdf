<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/27355"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.127">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>1,6-alpha-L-fucosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.127#SIP08B704AEF7E6B3C7"/>
<rdfs:comment>The enzyme from Aspergillus niger does not act on 1,2-, 1,3-, or 1,4-L-fucosyl linkages.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2423086"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.127#SIP08B704AEF7E6B3C7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of (1->6)-linkages between alpha-L-fucose and N-acetyl-D-glucosamine in glycopeptides such as immunoglobulin G glycopeptide and fucosyl-asialo-agalacto-fetuin.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2423086">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2423086"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/2423086"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.128">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycyrrhizinate beta-glucuronidase</skos:prefLabel>
<activity rdf:resource="3.2.1.128#SIP1BB713CA01FF3359"/>
<rdfs:comment>The enzyme from Aspergillus niger is specific for the hydrolysis of the triterpenoid glycoside glycyrrhizinate from roots of Glycyrrhiza sp.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.128#SIP1BB713CA01FF3359">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glycyrrhizin + H2O = 2-(beta-D-glucuronosyl)-D-glucuronate + glycyrrhetinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.129">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>endo-alpha-sialidase</skos:prefLabel>
<skos:altLabel>endo-N-acetylneuraminidase</skos:altLabel>
<skos:altLabel>endoneuraminidase</skos:altLabel>
<skos:altLabel>poly(alpha-2,8-sialosyl) endo-N-acetylneuraminidase</skos:altLabel>
<activity rdf:resource="3.2.1.129#SIPCD88E5D1A661BE0B"/>
<rdfs:comment>Although the name endo-N-acetylneuraminidase has also been used for this enzyme, this is misleading since its activity is not restricted to acetyl-substituted substrates.</rdfs:comment>
<rdfs:comment>An exo-alpha-sialidase activity is listed as EC 3.2.1.18.</rdfs:comment>
<rdfs:comment>See also 4.2.2.15.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1883340"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2778882"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3142874"/>
