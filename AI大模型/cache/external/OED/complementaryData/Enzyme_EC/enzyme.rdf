<rdf:Description rdf:about="1.14.13.148">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>trimethylamine monooxygenase</skos:prefLabel>
<skos:altLabel>flavin-containing monooxygenase 3</skos:altLabel>
<activity rdf:resource="1.14.13.148#SIPFFD48B79BE071E6D"/>
<rdfs:comment>The bacterial enzyme enables bacteria to use trimethylamine as the sole source of carbon and energy.</rdfs:comment>
<rdfs:comment>The mammalian enzyme is involved in detoxification of trimethylamine.</rdfs:comment>
<rdfs:comment>Mutations in the human enzyme cause the inheritable disease known as trimethylaminuria (fish odor syndrome).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4404764"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9417913"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9536088"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22006322"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.148#SIPFFD48B79BE071E6D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADPH + O2 + trimethylamine = H2O + NADP(+) + trimethylamine N-oxide.</rdfs:label>
</rdf:Description>
