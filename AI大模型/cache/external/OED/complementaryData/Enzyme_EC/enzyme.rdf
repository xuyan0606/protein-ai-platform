<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 a thiol + L-cysteinyl-[sulfatase] + O2 = 3-oxo-L-alanyl-[sulfatase] + an organic disulfide + H(+) + H2O + hydrogen sulfide.</rdfs:label>
</rdf:Description>
