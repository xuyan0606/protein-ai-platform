<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (3R)-3-hydroxyacyl-CoA = a (2E)-enoyl-CoA + H2O.</rdfs:label>
</rdf:Description>
