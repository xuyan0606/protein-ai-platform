<rdfs:label>(1R,4R)-bornane-2,5-dione + FMNH2 + O2 = (1R,4R)-5-oxo-1,2-campholide + FMN + H(+) + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.108#SIPDF3B2E844356DDC7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(1R,4R)-5-oxo-1,2-campholide = [(1R)-2,2,3-trimethyl-5-oxocyclopent-3-en-1-yl]acetate + H(+).</rdfs:label>
</rdf:Description>
