<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxo-3-(5-oxofuran-2-ylidene)propanoate + H2O = 3-maleylpyruvate + H(+).</rdfs:label>
</rdf:Description>
