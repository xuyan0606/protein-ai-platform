<rdf:Description rdf:about="1.14.11.49">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>uridine-5'-phosphate dioxygenase</skos:prefLabel>
<activity rdf:resource="1.14.11.49#SIP7997F244E21DF3B0"/>
<rdfs:comment>The enzyme catalyzes a net dephosphorylation and oxidation of UMP to generate 5'-dehydrouridine, the first intermediate in the biosynthesis of the unusual aminoribosyl moiety found in several C(7)-furanosyl nucleosides such as A-90289s, caprazamycins, liposidomycins, muraymycins and FR-900453.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21216959"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23034228"/>
<rdfs:subClassOf rdf:resource="1.14.11.-"/>
<skos:broaderTransitive rdf:resource="1.14.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.11.49#SIP7997F244E21DF3B0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + O2 + UMP = CO2 + phosphate + succinate + uridine-5'-aldehyde.</rdfs:label>
</rdf:Description>
