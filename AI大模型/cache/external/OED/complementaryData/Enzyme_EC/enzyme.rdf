<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>9-cis-10'-apo-beta-carotenal + 2 O2 = (11R)-carlactone + (2E,4E,6E)-7-hydroxy-4-methylhepta-2,4,6-trienal.</rdfs:label>
</rdf:Description>
