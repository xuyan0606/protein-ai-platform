<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + norspermine + O2 = 3-aminopropanal + H2O2 + norspermidine.</rdfs:label>
</rdf:Description>
