<rdf:Description rdf:about="4.2.3.116">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(+)-camphene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.116#SIPDD9E39C1A4F1F27D"/>
<rdfs:comment>Cyclase I of Salvia officinalis (sage) gives about equal parts (+)-camphene and (+)-alpha-pinene.</rdfs:comment>
<rdfs:comment>(3R)-Linalyl diphosphate can also be used by the enzyme in preference to (3S)-linalyl diphosphate.</rdfs:comment>
<rdfs:comment>See also EC 4.2.3.121.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3392006"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6693393"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8109978"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8109979"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.116#SIPDD9E39C1A4F1F27D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E)-geranyl diphosphate = (1R,4S)-camphene + diphosphate.</rdfs:label>
</rdf:Description>
