<rdf:Description rdf:about="2.1.1.386">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.1.1.n8"/>
<skos:prefLabel>small RNA 2'-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.386#SIP99B901B7D8D02D10"/>
<rdfs:comment>The enzyme adds a 2'-O-methyl group to the ribose of the last nucleotide in several types of small RNAs (sRNAs), protecting the 3'-end of sRNAs from uridylation activity and subsequent degradation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12225663"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15705854"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18029764"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19812675"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29703750"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.386#SIP99B901B7D8D02D10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + small RNA 3'-end nucleotide = H(+) + S-adenosyl-L-homocysteine + small RNA 3'-end 2'-O-methylnucleotide.</rdfs:label>
</rdf:Description>
