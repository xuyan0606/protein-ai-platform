<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-amino-4-deoxychorismate = 4-aminobenzoate + H(+) + pyruvate.</rdfs:label>
</rdf:Description>
