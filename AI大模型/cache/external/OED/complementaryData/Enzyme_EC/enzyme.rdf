<rdf:Description rdf:about="2.1.1.291">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(R,S)-reticuline 7-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.291#SIPFF29ED355D5EE3A2"/>
<activity rdf:resource="2.1.1.291#SIPBCCFAF1EDCAF58E5"/>
<rdfs:comment>The enzyme from the plant Papaver somniferum (opium poppy) methylates (S)- and (R)-reticuline with equal efficiency and is involved in the biosynthesis of tetrahydrobenzylisoquinoline alkaloids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14675446"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15353584"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
