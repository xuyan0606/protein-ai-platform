<rdf:Description rdf:about="3.4.11.19">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-stereospecific aminopeptidase</skos:prefLabel>
<activity rdf:resource="3.4.11.19#SIP91448C8A0FF58681"/>
<rdfs:comment>A thiol-dependent peptidase known from the bacterium Ochrobactrum anthropi.</rdfs:comment>
<rdfs:comment>A homolog of EC 3.4.16.4.</rdfs:comment>
<rdfs:comment>Not metal dependent; probably has serine at the active center.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family S12.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1540587"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2760064"/>
<rdfs:subClassOf rdf:resource="3.4.11.-"/>
<skos:broaderTransitive rdf:resource="3.4.11.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.11.19#SIP91448C8A0FF58681">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Release of an N-terminal D-amino acid from a peptide, Xaa-|-Yaa-, in which Xaa is preferably D-Ala, D-Ser or D-Thr. D-amino acid amides and methyl esters also are hydrolyzed, as is glycine amide.</rdfs:label>
</rdf:Description>
