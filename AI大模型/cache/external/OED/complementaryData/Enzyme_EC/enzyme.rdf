<rdf:Description rdf:about="1.14.19.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.99.5"/>
<skos:prefLabel>stearoyl-CoA 9-desaturase</skos:prefLabel>
<skos:altLabel>acyl-CoA desaturase</skos:altLabel>
<skos:altLabel>Delta(9)-desaturase</skos:altLabel>
<skos:altLabel>fatty acid desaturase</skos:altLabel>
<skos:altLabel>stearoyl-CoA desaturase</skos:altLabel>
<activity rdf:resource="1.14.19.1#SIP2DE86DB46C95D6BA"/>
<rdfs:comment>The liver enzyme is an enzyme system involving cytochrome b5 and EC 1.6.2.2.</rdfs:comment>
<rdfs:comment>The ferricytochrome b5 produced is reduced by NADH and EC 1.6.2.2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4373719"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4382040"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5543646"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14167617"/>
