<rdf:Description rdf:about="2.3.1.117">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2,3,4,5-tetrahydropyridine-2,6-dicarboxylate N-succinyltransferase</skos:prefLabel>
<skos:altLabel>succinyl-CoA:tetrahydrodipicolinate N-succinyltransferase</skos:altLabel>
<skos:altLabel>tetrahydrodipicolinate N-succinyltransferase</skos:altLabel>
<skos:altLabel>tetrahydrodipicolinate succinylase</skos:altLabel>
<skos:altLabel>tetrahydrodipicolinate succinyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.117#SIP064B45A1A63EA4C7"/>
<rdfs:comment>Involved in the biosynthesis of lysine in bacteria, cyanobacteria and higher plants.</rdfs:comment>
<rdfs:comment>Earlier erroneously called 2,3,4,5-tetrahydropyridine-2-carboxylate N-succinyltransferase.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6365916"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.117#SIP064B45A1A63EA4C7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-2,3,4,5-tetrahydrodipicolinate + H2O + succinyl-CoA = (S)-2-succinylamino-6-oxoheptanedioate + CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6365916">
