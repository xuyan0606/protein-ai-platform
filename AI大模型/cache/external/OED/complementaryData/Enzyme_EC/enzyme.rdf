<rdf:Description rdf:about="3.1.3.73">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>adenosylcobalamin/alpha-ribazole phosphatase</skos:prefLabel>
<skos:altLabel>adenosylcobalamin phosphatase</skos:altLabel>
<skos:altLabel>alpha-ribazole phosphatase</skos:altLabel>
<activity rdf:resource="3.1.3.73#SIP858DDD633D9C8D4A"/>
<activity rdf:resource="3.1.3.73#SIP76ADB52653E877AE"/>
<rdfs:comment>This enzyme catalyzes the last step in the anaerobic (early cobalt insertion) pathway of adenosylcobalamin biosynthesis, characterized in Salmonella enterica.</rdfs:comment>
<rdfs:comment>It also participates in a salvage pathway that recycles cobinamide into adenosylcobalamin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7929373"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12195810"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17209023"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
