<rdf:Description rdf:about="2.6.99.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>O-ureido-L-serine synthase</skos:prefLabel>
<activity rdf:resource="2.6.99.3#SIPDF63DC27040A0E0F"/>
<rdfs:comment>The enzyme participates in the biosynthetic pathway of D-cycloserine, an antibiotic substance produced by several Streptomyces species.</rdfs:comment>
<rdfs:comment>Also catalyzes EC 2.5.1.47.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20086163"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23529730"/>
<rdfs:subClassOf rdf:resource="2.6.99.-"/>
<skos:broaderTransitive rdf:resource="2.6.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.99.3#SIPDF63DC27040A0E0F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>hydroxyurea + O-acetyl-L-serine = acetate + H(+) + O-ureido-L-serine.</rdfs:label>
</rdf:Description>
