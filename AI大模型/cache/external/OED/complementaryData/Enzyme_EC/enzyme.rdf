<rdfs:label>(8R)-hydroperoxy-(5Z,9E,11Z,14Z)-eicosatetraenoate = 8-oxo-(5Z,9E,11Z,14Z)-eicosatetraenoate + H2O.</rdfs:label>
</rdf:Description>
