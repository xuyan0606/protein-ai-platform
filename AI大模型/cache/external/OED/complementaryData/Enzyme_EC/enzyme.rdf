<skos:prefLabel>cycloartenol 24-C-methyltransferase</skos:prefLabel>
<skos:altLabel>sterol C-methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.142#SIP7216EB70489AA537"/>
<rdfs:comment>S-Adenosyl-L-methionine methylates the Si face of the 24(25)-double bond with elimination of a hydrogen atom from the pro-Z methyl group at C-25.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10882005"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
