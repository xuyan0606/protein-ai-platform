<rdf:Description rdf:about="2.1.1.327">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phenazine-1-carboxylate N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.327#SIP77FC2011382AF9BB"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudomonas aeruginosa, is involved in the biosynthesis of pyocyanine, a toxin produced and secreted by the organism.</rdfs:comment>
<rdfs:comment>The enzyme is active in vitro only in the presence of EC 1.14.13.218.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17253782"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.327#SIP77FC2011382AF9BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>phenazine-1-carboxylate + S-adenosyl-L-methionine = 5-methyl-phenazine-1-carboxylate + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17253782">
