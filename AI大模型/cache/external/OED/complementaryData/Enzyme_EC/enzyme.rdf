<replaces rdf:resource="4.1.2.n1"/>
<skos:prefLabel>2,3-epoxybenzoyl-CoA dihydrolase</skos:prefLabel>
<skos:altLabel>benzoyl-CoA-dihydrodiol lyase</skos:altLabel>
<skos:altLabel>dihydrodiol transforming enzyme</skos:altLabel>
<activity rdf:resource="4.1.2.44#SIP66681DE65931E78D"/>
<rdfs:comment>The enzyme is involved in the aerobic benzoyl-CoA catabolic pathway of the bacterium Azoarcus evansii.</rdfs:comment>
<rdfs:comment>The enzyme converts 2,3-epoxy-2,3-dihydrobenzoyl-CoA to its oxepin form prior to the ring-opening and the formation of a dialdehyde intermediate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15916608"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20452977"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
