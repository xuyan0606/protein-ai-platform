<replaces rdf:resource="2.7.1.112"/>
<skos:prefLabel>non-specific protein-tyrosine kinase</skos:prefLabel>
<skos:altLabel>cytoplasmic protein tyrosine kinase</skos:altLabel>
<activity rdf:resource="2.7.10.2#SIP4EDF633C735C93B2"/>
<rdfs:comment>Unlike EC 2.7.10.1, this protein-tyrosine kinase does not have a transmembrane domain.</rdfs:comment>
<rdfs:comment>In the human genome, 32 non-specific protein-tyrosine kinases have been identified and these can be divided into 10 families.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11114734"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15504335"/>
<rdfs:subClassOf rdf:resource="2.7.10.-"/>
<skos:broaderTransitive rdf:resource="2.7.10.-"/>
</rdf:Description>
