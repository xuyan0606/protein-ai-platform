<rdf:Description rdf:about="1.5.99.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>spermidine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.5.99.6#SIPC52F429AB309BF7E"/>
<rdfs:comment>Ferricyanide, 2,6-dichloroindophenol and cytochrome c can act as acceptor.</rdfs:comment>
<rdfs:comment>4-aminobutanal condenses non-enzymically to 1-pyrroline.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.5.99.-"/>
<skos:broaderTransitive rdf:resource="1.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.6#SIPC52F429AB309BF7E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>A + H2O + spermidine = 4-aminobutanal + AH2 + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
