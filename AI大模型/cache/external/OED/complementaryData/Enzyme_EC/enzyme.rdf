<rdf:Description rdf:about="3.1.3.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alkaline phosphatase</skos:prefLabel>
<skos:altLabel>alkaline phosphomonoesterase</skos:altLabel>
<skos:altLabel>glycerophosphatase</skos:altLabel>
<skos:altLabel>phosphomonoesterase</skos:altLabel>
<activity rdf:resource="3.1.3.1#SIP59249A8475687EC6"/>
<rdfs:comment>Active at a high pH optimum.</rdfs:comment>
<rdfs:comment>Wide specificity.</rdfs:comment>
