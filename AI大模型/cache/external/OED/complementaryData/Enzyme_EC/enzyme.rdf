<rdf:Description rdf:about="1.14.14.180">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>brassinolide synthase</skos:prefLabel>
<skos:altLabel>CYP85A2</skos:altLabel>
<skos:altLabel>CYP85A3</skos:altLabel>
<activity rdf:resource="1.14.14.180#SIPE73B82DB7188FAC2"/>
<activity rdf:resource="1.14.14.180#SIPFA13637102C69514"/>
<activity rdf:resource="1.14.14.180#SIPAE5C30BF844BF90A"/>
<rdfs:comment>This cytochrome P450 (heme thiolate) plant enzyme catalyzes the lactonization of several brassinosteroids, including castasterone, teasterone, and typhasterol.</rdfs:comment>
<rdfs:comment>The CYP85A2 enzyme of Arabidopsis thaliana also catalyzes the activity of EC 1.14.14.179.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15710611"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16024588"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18685225"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.180#SIPE73B82DB7188FAC2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>castasterone + O2 + reduced [NADPH--hemoprotein reductase] = brassinolide + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.180#SIPFA13637102C69514">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O2 + reduced [NADPH--hemoprotein reductase] + typhasterol = 7-oxatyphasterol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.180#SIPAE5C30BF844BF90A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>O2 + reduced [NADPH--hemoprotein reductase] + teasterone = 7-oxateasterone + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
