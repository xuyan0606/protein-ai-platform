<skos:prefLabel>flavin reductase (NADPH)</skos:prefLabel>
<skos:altLabel>flavine mononucleotide reductase</skos:altLabel>
<skos:altLabel>flavin mononucleotide reductase</skos:altLabel>
<skos:altLabel>FMN reductase (NADPH)</skos:altLabel>
<skos:altLabel>NADPH:flavin oxidoreductase</skos:altLabel>
<skos:altLabel>NADPH:riboflavin oxidoreductase</skos:altLabel>
