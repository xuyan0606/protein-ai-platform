<rdf:Description rdf:about="4.1.3.24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>malyl-CoA lyase</skos:prefLabel>
<skos:altLabel>(3S)-3-carboxy-3-hydroxypropanoyl-CoA glyoxylate-lyase</skos:altLabel>
<skos:altLabel>L-malyl-CoA lyase</skos:altLabel>
<skos:altLabel>malyl-coenzyme A lyase</skos:altLabel>
<activity rdf:resource="4.1.3.24#SIP2259397161F53680"/>
<activity rdf:resource="4.1.3.24#SIP99C0EE058BB9AFFE"/>
<rdfs:comment>The enzymes from Rhodobacter species catalyze a step in the ethylmalonyl-CoA pathway for acetate assimilation.</rdfs:comment>
<rdfs:comment>The enzyme from halophilic bacteria participate in the methylaspartate cycle and catalyze the reaction in the direction of malyl-CoA formation.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Chloroflexus aurantiacus, which participates in the 3-hydroxypropanoate cycle for carbon assimilation, also has the activity of EC 4.1.3.25.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12374834"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14285256"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15687206"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17259315"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20047909"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27920298"/>
<rdfs:subClassOf rdf:resource="4.1.3.-"/>
<skos:broaderTransitive rdf:resource="4.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.3.24#SIP2259397161F53680">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-malyl-CoA = acetyl-CoA + glyoxylate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.3.24#SIP99C0EE058BB9AFFE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R,3S)-beta-methylmalyl-CoA = glyoxylate + propanoyl-CoA.</rdfs:label>
</rdf:Description>
