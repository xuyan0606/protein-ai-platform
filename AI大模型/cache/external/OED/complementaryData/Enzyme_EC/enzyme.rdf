<activity rdf:resource="3.4.24.76#SIP43DFEB0717117678"/>
<rdfs:comment>The specificity is similar to that of EC 3.4.24.33, but the two are reported to be structurally dissimilar.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M12.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7771796"/>
<rdfs:subClassOf rdf:resource="3.4.24.-"/>
<skos:broaderTransitive rdf:resource="3.4.24.-"/>
</rdf:Description>
