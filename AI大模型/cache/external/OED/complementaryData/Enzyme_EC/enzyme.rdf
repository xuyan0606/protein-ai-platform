<skos:prefLabel>pentalenic acid synthase</skos:prefLabel>
<skos:altLabel>CYP105D7</skos:altLabel>
<activity rdf:resource="1.14.15.11#SIPA7D6F22B4F1450A3"/>
<rdfs:comment>Isolated from the bacterium Streptomyces avermitilis.</rdfs:comment>
<rdfs:comment>The product, pentalenate, is a co-metabolite from pentalenolactone biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21081950"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.15.11#SIPA7D6F22B4F1450A3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-deoxypentalenate + 2 H(+) + O2 + reduced 2[4Fe-4S]-[ferredoxin] = H2O + oxidized 2[4Fe-4S]-[ferredoxin] + pentalenate.</rdfs:label>
</rdf:Description>
