<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cis-cis-nepetalactol + NAD(+) = cis-cis-nepetalactone + H(+) + NADH.</rdfs:label>
</rdf:Description>
