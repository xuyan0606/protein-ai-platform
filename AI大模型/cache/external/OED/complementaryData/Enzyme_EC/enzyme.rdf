<rdf:Description rdf:about="1.14.14.160">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>zealexin A1 synthase</skos:prefLabel>
<skos:altLabel>CYP71Z18</skos:altLabel>
<activity rdf:resource="1.14.14.160#SIP7B7F4E4041C77ABA"/>
<rdfs:comment>A cytochrome P450 (heme thiolate) enzyme characterized from maize.</rdfs:comment>
<rdfs:comment>The enzyme sequentially oxidizes(S)-beta-macrocarpene via alcohol and aldehyde intermediates to form zealexin A1, a maize phytoalexin that provides biochemical protection against fungal infection.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26471326"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.160#SIP7B7F4E4041C77ABA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-beta-macrocarpene + 3 O2 + 3 reduced [NADPH--hemoprotein reductase] = 4 H(+) + 4 H2O + 3 oxidized [NADPH--hemoprotein reductase] + zealexin A1.</rdfs:label>
</rdf:Description>
