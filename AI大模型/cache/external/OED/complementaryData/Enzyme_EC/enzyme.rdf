<skos:altLabel>isochorismatase</skos:altLabel>
<activity rdf:resource="3.3.2.15#SIPF9B06EAD94C75DE3"/>
<rdfs:comment>Isolated from the bacterium Pseudomonas aeruginosa.</rdfs:comment>
<rdfs:comment>Involved in phenazine biosynthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11591691"/>
