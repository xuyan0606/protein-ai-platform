<rdf:Description rdf:about="2.1.1.337">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>reticuline N-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.337#SIP7AF7E8CEA367154E"/>
<activity rdf:resource="2.1.1.337#SIP75167DD700B44210"/>
<activity rdf:resource="2.1.1.337#SIPEEC9DF0FFC850516"/>
<activity rdf:resource="2.1.1.337#SIP92EB752D2C7A3831"/>
<activity rdf:resource="2.1.1.337#SIP9BEA7E9AF68F0424"/>
<activity rdf:resource="2.1.1.337#SIPE33DD3F2AF68BA34"/>
<rdfs:comment>The enzyme from opium poppy (Papaver somniferum) can also methylate (R)-reticuline, tetrahydropapaverine, (S)-glaucine and (S)-bulbocapnine.</rdfs:comment>
<rdfs:comment>It is involved in the biosynthesis of the quaternary benzylisoquinoline alkaloid magnoflorine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27634038"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIP7AF7E8CEA367154E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-reticuline + S-adenosyl-L-methionine = (S)-tembetarine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIP75167DD700B44210">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-corytuberine + S-adenosyl-L-methionine = magnoflorine + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIPEEC9DF0FFC850516">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-reticuline + S-adenosyl-L-methionine = (R)-tembetarine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIP92EB752D2C7A3831">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-tetrahydropapaverine + S-adenosyl-L-methionine = (S)-N-methyltetrahydropapaverine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIP9BEA7E9AF68F0424">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-glaucine + S-adenosyl-L-methionine = (S)-N-methylglaucine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.337#SIPE33DD3F2AF68BA34">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-bulbocapnine + S-adenosyl-L-methionine = (S)-N-methylbulbocapnine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
