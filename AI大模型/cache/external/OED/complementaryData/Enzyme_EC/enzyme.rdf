<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 S-adenosyl-L-methionine + tricetin = 3',5'-di-O-methyltricetin + 2 H(+) + 2 S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
