<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-halobenzoate + H(+) + NADH + O2 = a halide anion + catechol + CO2 + NAD(+).</rdfs:label>
</rdf:Description>
