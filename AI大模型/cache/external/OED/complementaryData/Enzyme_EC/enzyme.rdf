<rdf:Description rdf:about="5.4.99.59">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dTDP-fucopyranose mutase</skos:prefLabel>
<activity rdf:resource="5.4.99.59#SIPC44D8AFFA91D55D2"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of the Escherichia coli O52 O antigen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19019146"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
