<activity rdf:resource="2.4.2.35#SIPD61C70CF0B96A606"/>
<rdfs:comment>Flavonol 3-O-glucoside, flavonol 3-O-galactoside and, more slowly, rutin, can act as acceptors.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
