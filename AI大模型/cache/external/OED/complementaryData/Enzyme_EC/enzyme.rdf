<activity rdf:resource="4.2.1.77#SIP7D707F878B38CE49"/>
<rdfs:comment>Highly specific.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22528483"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
