<skos:prefLabel>nitrosuccinate lyase</skos:prefLabel>
<activity rdf:resource="4.3.99.5#SIP7CBEBC5525265B01"/>
<rdfs:comment>The enzyme, found in some Actinobacteria, is involved in a pathway that forms nitrite, which is subsequently used to generate a diazo group in some secondary metabolites.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26689788"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30120394"/>
<rdfs:subClassOf rdf:resource="4.3.99.-"/>
<skos:broaderTransitive rdf:resource="4.3.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.3.99.5#SIP7CBEBC5525265B01">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-nitrobutanedioate = fumarate + H(+) + nitrite.</rdfs:label>
</rdf:Description>
