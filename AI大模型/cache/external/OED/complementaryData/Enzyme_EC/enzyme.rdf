<citation rdf:resource="http://purl.uniprot.org/citations/16463021"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17191898"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
<skos:broaderTransitive rdf:resource="4.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.13#SIPE525A955560BD899">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an S-substituted L-cysteine + H2O = a thiol + NH4(+) + pyruvate.</rdfs:label>
</rdf:Description>
