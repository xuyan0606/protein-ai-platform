<rdfs:label>apigenin + S-adenosyl-L-methionine = acacetin + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.76">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>quercetin 3-O-methyltransferase</skos:prefLabel>
