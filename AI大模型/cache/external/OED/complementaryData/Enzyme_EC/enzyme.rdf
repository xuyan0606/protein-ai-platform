<rdf:Description rdf:about="1.14.12.17">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nitric oxide dioxygenase</skos:prefLabel>
<skos:altLabel>NOD</skos:altLabel>
<activity rdf:resource="1.14.12.17#SIP87583C6DC3F26C43"/>
<activity rdf:resource="1.14.12.17#SIP6827242F72D7E49D"/>
<rdfs:comment>It has been proposed that FAD functions as the electron carrier from NADPH to the ferric heme cofactor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9724711"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9756889"/>
<rdfs:subClassOf rdf:resource="1.14.12.-"/>
<skos:broaderTransitive rdf:resource="1.14.12.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.12.17#SIP87583C6DC3F26C43">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADPH + 2 nitric oxide + 2 O2 = H(+) + NADP(+) + 2 nitrate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.12.17#SIP6827242F72D7E49D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NADH + 2 nitric oxide + 2 O2 = H(+) + NAD(+) + 2 nitrate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9724711">
