<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-amino-1-(beta-D-ribosyl)imidazole + ATP = 5-amino-1-(5-phospho-beta-D-ribosyl)imidazole + ADP + H(+).</rdfs:label>
</rdf:Description>
