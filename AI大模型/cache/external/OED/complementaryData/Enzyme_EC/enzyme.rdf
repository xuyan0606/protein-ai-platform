<rdf:Description rdf:about="2.7.1.228">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>mannosyl-inositol-phosphoceramide inositolphosphotransferase</skos:prefLabel>
<activity rdf:resource="2.7.1.228#SIP36A25984E9B47E40"/>
<rdfs:comment>This enzyme catalyzes the ultimate reaction in the yeast sphingolipid biosynthesis pathway.</rdfs:comment>
<rdfs:comment>It transfers a second phosphoinositol group to mannosyl-inositol-phospho-alpha-hydroxyphytoceramide (MIPC), forming the final and most abundant yeast sphingolipid, mannosyl-diphosphoinositol-ceramide (MIP2C).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9368028"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.228#SIP36A25984E9B47E40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phospho-(1D-myo-inositol) + an alpha-D-mannosyl-(1&lt;->6)-1D-myo-inositol-1-phospho-N-[(R)-2-hydroxy-very-long-chain fatty acyl]-(R)-4-hydroxysphingoid base = a 1,2-diacyl-sn-glycerol + an alpha-D-mannosyl-6-(1D-myo-inositol phospho)-(1&lt;->6)-1D-myo-inositol-1-phospho-N-[(R)-2-hydroxy-very-long-chain fatty acyl]-(R)-4-hydroxysphingoid base.</rdfs:label>
</rdf:Description>
