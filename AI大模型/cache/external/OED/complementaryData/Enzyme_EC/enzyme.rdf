<rdf:Description rdf:about="2.3.1.286">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>protein acetyllysine N-acetyltransferase</skos:prefLabel>
<skos:altLabel>NAD(+)-dependent protein deacetylase</skos:altLabel>
<skos:altLabel>protein lysine deacetylase</skos:altLabel>
<activity rdf:resource="2.3.1.286#SIP5CB82F4CEB0B2313"/>
<rdfs:comment>The enzyme, found in all domains of life, is involved in gene regulation by deacetylating proteins.</rdfs:comment>
<rdfs:comment>Some of the 2''-O-acetyl-ADP-D-ribose converts non-enzymically to 3''-O-acetyl-ADP-D-ribose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11095969"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11336676"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11747420"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14522996"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16756498"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.286#SIP5CB82F4CEB0B2313">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(6)-acetyl-L-lysyl-[protein] + NAD(+) = 2''-O-acetyl-ADP-D-ribose + L-lysyl-[protein] + nicotinamide.</rdfs:label>
</rdf:Description>
