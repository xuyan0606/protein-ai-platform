<rdf:Description rdf:about="2.7.1.229">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>deoxyribokinase</skos:prefLabel>
<activity rdf:resource="2.7.1.229#SIP1660B628DD6D271E"/>
<rdfs:comment>The enzyme, characterized from bacteria, is much more active with 2-deoxy-D-ribose than with D-ribose. cf. EC 2.7.1.15.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4867740"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10648508"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13563487"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13641245"/>
