<rdf:Description rdf:about="4.1.2.59">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dihydroneopterin phosphate aldolase</skos:prefLabel>
<skos:altLabel>H2NMP aldolase</skos:altLabel>
<activity rdf:resource="4.1.2.59#SIP4E83B8DFDDA4BE1F"/>
<rdfs:comment>The enzyme participates in methanopterin biosynthesis the archaeon Pyrococcus furiosus.</rdfs:comment>
<rdfs:comment>The enzyme is specific for 7,8-dihydroneopterin 3'-phosphate. cf. EC 4.1.2.25 and EC 4.1.2.60.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22931285"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.59#SIP4E83B8DFDDA4BE1F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7,8-dihydroneopterin 3'-phosphate = 6-hydroxymethyl-7,8-dihydropterin + glycolaldehyde phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22931285">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22931285"/>
