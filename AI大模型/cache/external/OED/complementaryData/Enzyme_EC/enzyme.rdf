<rdf:Description rdf:about="1.14.19.66">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.1.3.34"/>
<replaces rdf:resource="1.14.21.3"/>
<skos:prefLabel>berbamunine synthase</skos:prefLabel>
<skos:altLabel>(S)-N-methylcoclaurine oxidase (C-O phenol-coupling)</skos:altLabel>
<activity rdf:resource="1.14.19.66#SIP5D4EE10878FA6EE6"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein found in plants.</rdfs:comment>
<rdfs:comment>Forms the bisbenzylisoquinoline alkaloid berbamunine by phenol oxidation of N-methylcoclaurine without the incorporation of oxygen into the product.</rdfs:comment>
<rdfs:comment>Reaction of two molecules of (R)-N-methylcoclaurine gives the dimer guattagaumerine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8380416"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.66#SIP5D4EE10878FA6EE6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-N-methylcoclaurine + (S)-N-methylcoclaurine + O2 + reduced [NADPH--hemoprotein reductase] = berbamunine + H(+) + 2 H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
