<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA-5-taurinomethyluridine 2-sulfurtransferase</skos:prefLabel>
<activity rdf:resource="2.8.1.14#SIP440F02F5B9B36AAF"/>
<rdfs:comment>The enzyme, found in mitochondria, catalyzes formation of 5-taurinomethyl-2-thiouridine in the wobble position of mitochondrial tRNA(Gln), tRNA(Lys) and tRNA(Glu).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15509579"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17706197"/>
