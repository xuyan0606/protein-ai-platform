<activity rdf:resource="2.1.1.160#SIPE4ADD5EF96909742"/>
<activity rdf:resource="2.1.1.160#SIP7B1AE1A3C55CC60F"/>
<activity rdf:resource="2.1.1.160#SIP6933F8AB501F148B"/>
<rdfs:comment>Paraxanthine is the best substrate for this enzyme but the paraxanthine pathway is considered to be a minor pathway for caffeine biosynthesis.</rdfs:comment>
