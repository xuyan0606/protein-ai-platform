<rdfs:comment>alpha-D-ribose 1,5-bisphosphate, 2-deoxy-alpha-D-ribose 1,5-bisphosphate, or alpha-D-glucose 1,6-bisphosphate can act as cofactor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4992818"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5824563"/>
<rdfs:subClassOf rdf:resource="5.4.2.-"/>
