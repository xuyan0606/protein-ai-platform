<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/29168502"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/29168502"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.18">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>succinyl-CoA:acetate CoA-transferase</skos:prefLabel>
<skos:altLabel>SCACT</skos:altLabel>
<activity rdf:resource="2.8.3.18#SIPB0C2BDC54C53D549"/>
<rdfs:comment>In some bacteria the enzyme catalyzes the conversion of acetate to acetyl-CoA as part of a modified tricarboxylic acid (TCA) cycle.</rdfs:comment>
<rdfs:comment>In other organisms it converts acetyl-CoA to acetate during fermentation.</rdfs:comment>
<rdfs:comment>In some organisms the enzyme also catalyzes the activity of EC 2.8.3.27.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3090435"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8550525"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18502856"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19103231"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23030530"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28452983"/>
<citation rdf:resource="http://purl.uniprot.org/citations/33931420"/>
<rdfs:subClassOf rdf:resource="2.8.3.-"/>
<skos:broaderTransitive rdf:resource="2.8.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.3.18#SIPB0C2BDC54C53D549">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetate + succinyl-CoA = acetyl-CoA + succinate.</rdfs:label>
</rdf:Description>
