<rdf:Description rdf:about="2.3.1.288">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-O-sulfo trehalose long-chain-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.288#SIPB2869D2C04E205DF"/>
<activity rdf:resource="2.3.1.288#SIP5DC946CFD7521DC0"/>
<rdfs:comment>This mycobacterial enzyme catalyzes the acylation of 2-O-sulfo-alpha,alpha-trehalose at the 2' position by a C16 or C18 fatty acyl group during the biosynthesis of mycobacterial sulfolipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17592143"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22194604"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
