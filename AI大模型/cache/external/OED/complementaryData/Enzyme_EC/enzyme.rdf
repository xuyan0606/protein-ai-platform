<rdf:Description rdf:about="2.3.1.72">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>indoleacetylglucose--inositol O-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.72#SIPF0172B9217DF1042"/>
<rdfs:comment>The position of acylation is indeterminate because of the ease of acyl transfer between hydroxy groups.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6218801"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6446303"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.72#SIPF0172B9217DF1042">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-O-(indol-3-ylacetyl)-beta-D-glucose + myo-inositol = D-glucose + indole-3-acetyl-1D-myo-inositol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6218801">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/6218801"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/6218801"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6446303">
