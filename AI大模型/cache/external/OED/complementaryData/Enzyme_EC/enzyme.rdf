</rdf:Description>
<rdf:Description rdf:about="2.1.3.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lysine carbamoyltransferase</skos:prefLabel>
<skos:altLabel>lysine transcarbamylase</skos:altLabel>
<activity rdf:resource="2.1.3.8#SIPCAC1B610C7C01B0A"/>
<rdfs:comment>Not identical with EC 2.1.3.3.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6409607"/>
<rdfs:subClassOf rdf:resource="2.1.3.-"/>
<skos:broaderTransitive rdf:resource="2.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.3.8#SIPCAC1B610C7C01B0A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>carbamoyl phosphate + L-lysine = H(+) + L-homocitrulline + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/6409607">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/6409607"/>
