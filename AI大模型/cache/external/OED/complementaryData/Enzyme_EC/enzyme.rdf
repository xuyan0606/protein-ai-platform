<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12101296"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12101296"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17237164">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17237164"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17237164"/>
</rdf:Description>
