<rdf:Description rdf:about="4.1.1.104">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-dehydro-4-phosphotetronate decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.104#SIPB230B48C9969A88C"/>
<activity rdf:resource="4.1.1.104#SIPB288A6E20183D32C"/>
<rdfs:comment>The enzyme, characterized from bacteria, is involved in D-erythronate and L-threonate catabolism.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27402745"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.104#SIPB230B48C9969A88C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-dehydro-4-O-phospho-D-erythronate + H(+) = CO2 + dihydroxyacetone phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.104#SIPB288A6E20183D32C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-dehydro-4-O-phospho-L-erythronate + H(+) = CO2 + dihydroxyacetone phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/27402745">
