<rdf:Description rdf:about="2.1.1.256">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA (guanine(6)-N(2))-methyltransferase</skos:prefLabel>
<skos:altLabel>m(2)G6 methyltransferase</skos:altLabel>
<skos:altLabel>methyltransferase Trm14</skos:altLabel>
<activity rdf:resource="2.1.1.256#SIP8043EB1D73BECCA2"/>
<rdfs:comment>The enzyme specifically methylates guanine(6) at N(2) in tRNA.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21693558"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.256#SIP8043EB1D73BECCA2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>guanosine(6) in tRNA + S-adenosyl-L-methionine = H(+) + N(2)-methylguanosine(6) in tRNA + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21693558">
