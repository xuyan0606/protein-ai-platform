<rdf:Description rdf:about="2.4.1.347">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alpha,alpha-trehalose-phosphate synthase (ADP-forming)</skos:prefLabel>
<skos:altLabel>ADP-glucose--glucose-phosphate glucosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.347#SIP15EFFC8B7D2248E2"/>
<rdfs:comment>The enzyme has been reported from the yeast Saccharomyces cerevisiae and from mycobacteria.</rdfs:comment>
<rdfs:comment>The enzyme from Mycobacterium tuberculosis can also use UDP-alpha-D-glucose, but the activity with ADP-alpha-D-glucose, which is considered the main substrate in vivo, is higher.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9133641"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12473104"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25277548"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
