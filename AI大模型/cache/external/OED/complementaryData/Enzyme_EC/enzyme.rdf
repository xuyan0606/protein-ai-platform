<rdf:Description rdf:about="1.2.1.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methylmalonate-semialdehyde dehydrogenase (CoA acylating)</skos:prefLabel>
<skos:altLabel>methylmalonate-semialdehyde dehydrogenase (acylating)</skos:altLabel>
<skos:altLabel>MMSA dehydrogenase</skos:altLabel>
<skos:altLabel>MSDH</skos:altLabel>
<activity rdf:resource="1.2.1.27#SIP031F838E673BAE63"/>
<activity rdf:resource="1.2.1.27#SIP3529E1DC89A775C1"/>
<rdfs:comment>Also converts 3-oxopropanoate into acetyl-CoA.</rdfs:comment>
<rdfs:comment>The reaction occurs in two steps with the decarboxylation process preceding CoA-binding.</rdfs:comment>
<rdfs:comment>Bicarbonate rather than CO2 is released as a final product.</rdfs:comment>
