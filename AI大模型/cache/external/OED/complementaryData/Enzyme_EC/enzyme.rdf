<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-cis-trans-nepetalactol + 3 O2 + 3 reduced [NADPH--hemoprotein reductase] = 7-deoxyloganetate + 4 H(+) + 4 H2O + 3 oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
