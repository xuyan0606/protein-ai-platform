<citation rdf:resource="http://purl.uniprot.org/citations/12731863"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.79#SIPA9AF4ED96BDD10B4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + D-maltose = 1-O-acetylmaltose + CoA.</rdfs:label>
</rdf:Description>
