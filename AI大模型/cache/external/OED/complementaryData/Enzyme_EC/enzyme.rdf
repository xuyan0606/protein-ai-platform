<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + beta-D-ribosylnicotinate = ADP + H(+) + nicotinate beta-D-ribonucleotide.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17914902">
