<rdf:Description rdf:about="3.1.3.88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5''-phosphoribostamycin phosphatase</skos:prefLabel>
<activity rdf:resource="3.1.3.88#SIP3FFFF20FE3637C17"/>
<rdfs:comment>Involved in the biosynthetic pathways of several clinically important aminocyclitol antibiotics, including ribostamycin, neomycin and butirosin.</rdfs:comment>
<rdfs:comment>No metal is required for activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17482823"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
