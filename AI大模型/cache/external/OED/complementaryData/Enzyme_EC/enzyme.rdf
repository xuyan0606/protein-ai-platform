<rdf:Description rdf:about="2.4.3.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.4.99.2"/>
<skos:prefLabel>beta-D-galactosyl-(1->3)-N-acetyl-beta-D-galactosaminide alpha-2,3-sialyltransferase</skos:prefLabel>
<skos:altLabel>monosialoganglioside sialyltransferase</skos:altLabel>
<activity rdf:resource="2.4.3.2#SIP73CC68B4A210F652"/>
<activity rdf:resource="2.4.3.2#SIP5152EB1DA239CD36"/>
<rdfs:comment>The enzyme recognizes the sequence beta-D-galactosyl-(1->3)-N-acetyl-D-galactosaminyl (known as type 1 histo-blood group precursor disaccharide) in non-reducing termini of glycan moieties in glycoproteins and glycolipids.</rdfs:comment>
<rdfs:comment>When acting on gangloside GM1a, it forms gangloside GD1a.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/438198"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4351506"/>
<rdfs:subClassOf rdf:resource="2.4.3.-"/>
<skos:broaderTransitive rdf:resource="2.4.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.3.2#SIP73CC68B4A210F652">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a beta-D-galactosyl-(1->3)-N-acetyl-beta-D-galactosaminyl derivative + CMP-N-acetyl-beta-neuraminate = an N-acetyl-alpha-neuraminyl-(2->3)-beta-D-galactosyl-(1->3)-N-acetyl-beta-D-galactosaminyl derivative + CMP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.3.2#SIP5152EB1DA239CD36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ganglioside GM1 (d18:1(4E)) + CMP-N-acetyl-beta-neuraminate = a ganglioside GD1a (d18:1(4E)) + CMP + H(+).</rdfs:label>
</rdf:Description>
