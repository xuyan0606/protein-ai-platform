<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>norbelladine + S-adenosyl-L-methionine = 4'-O-methylnorbelladine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
