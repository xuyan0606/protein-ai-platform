<rdf:Description rdf:about="1.8.2.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thiosulfate reductase (cytochrome)</skos:prefLabel>
<activity rdf:resource="1.8.2.5#SIP8481D9EFEA6A0FEB"/>
<rdfs:comment>The enzyme is found in sulfate-reducing bacteria.</rdfs:comment>
<rdfs:comment>The source of the electrons is molecular hydrogen, via EC 1.12.2.1.</rdfs:comment>
<rdfs:comment>The organisms utilize the sulfite that is produced for energy generation by EC 1.8.99.5.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/242299"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2993256"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5573735"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5784203"/>
<rdfs:subClassOf rdf:resource="1.8.2.-"/>
<skos:broaderTransitive rdf:resource="1.8.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.2.5#SIP8481D9EFEA6A0FEB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome c3] + hydrogen sulfide + sulfite = 2 Fe(II)-[cytochrome c3] + thiosulfate.</rdfs:label>
</rdf:Description>
