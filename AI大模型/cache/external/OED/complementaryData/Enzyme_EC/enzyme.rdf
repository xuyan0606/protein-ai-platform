<activity rdf:resource="3.1.1.80#SIP369A95304AED4088"/>
<activity rdf:resource="3.1.1.80#SIPFD956EDAE1178079"/>
<rdfs:comment>Responsible for the last stages in the biosynthesis of the indole alkaloid ajmaline.</rdfs:comment>
<rdfs:comment>Highly specific for the substrates 17-O-acetylajmaline and 17-O-acetylnorajmaline as the structurally related acetylated alkaloids vinorine, vomilenine, 1,2-dihydrovomilenine and 1,2-dihydroraucaffricine cannot act as substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2955586"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16133216"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.80#SIP369A95304AED4088">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>17-O-acetylajmaline + H2O = acetate + ajmaline + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.80#SIPFD956EDAE1178079">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>17-O-acetylnorajmaline + H2O = acetate + H(+) + norajmaline.</rdfs:label>
</rdf:Description>
