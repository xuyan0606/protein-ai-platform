<rdf:Description rdf:about="1.2.1.72">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>erythrose-4-phosphate dehydrogenase</skos:prefLabel>
<skos:altLabel>E4P dehydrogenase</skos:altLabel>
<skos:altLabel>E4PDH</skos:altLabel>
<skos:altLabel>erythrose 4-phosphate dehydrogenase</skos:altLabel>
<activity rdf:resource="1.2.1.72#SIPBE4720BDA1157C1A"/>
<rdfs:comment>Was originally thought to be an EC 1.2.1.12, but this has since been disproved, as glyceraldehyde 3-phosphate is not a substrate.</rdfs:comment>
<rdfs:comment>Forms part of the pyridoxal-5'-phosphate cofactor biosynthesis pathway in Escherichia coli, along with EC 1.1.1.290, EC 2.6.1.52, EC 1.1.1.262, EC 2.6.99.2 and EC 1.4.3.5.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7751290"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9182530"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9696782"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
