<rdf:Description rdf:about="3.1.1.118">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phospholipid sn-1 acylhydrolase</skos:prefLabel>
<skos:altLabel>PA-PLA1</skos:altLabel>
<skos:altLabel>phosphatidic acid-preferring phospholipase A1</skos:altLabel>
<skos:altLabel>phospholipase DDHD1</skos:altLabel>
<activity rdf:resource="3.1.1.118#SIP8F32CF909D308DDB"/>
<activity rdf:resource="3.1.1.118#SIP264980ABC76C1CF9"/>
<rdfs:comment>The human enzyme shows broad specificity, and has a preference for phosphatidate over other phospholipids.</rdfs:comment>
<rdfs:comment>Unlike EC 3.1.1.32 it is also active against phosphatidylinositol.</rdfs:comment>
<rdfs:comment>It is not active toward acyl groups linked at the sn-2 position.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20359546"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24599962"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.118#SIP8F32CF909D308DDB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phospho-(1D-myo-inositol) + H2O = a 2-acyl-sn-glycero-3-phospho-D-myo-inositol + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.118#SIP264980ABC76C1CF9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phosphate + H2O = a 2-acyl-sn-glycerol 3-phosphate + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
