<citation rdf:resource="http://purl.uniprot.org/citations/11754484"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12784644"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.232#SIP1D815CD5032CE581">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Transfers an alpha-D-mannosyl residue from GDP-mannose into lipid-linked oligosaccharide, forming an alpha-(1->6)-D-mannosyl-D-mannose linkage.</rdfs:label>
</rdf:Description>
