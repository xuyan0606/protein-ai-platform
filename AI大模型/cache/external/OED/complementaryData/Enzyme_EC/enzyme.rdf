<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/10666320"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.163">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>10-hydroxytaxane O-acetyltransferase</skos:prefLabel>
<skos:altLabel>acetyl coenzyme A:10-hydroxytaxane O-acetyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.163#SIP71173C59500894AD"/>
<rdfs:comment>Acts on a number of related taxane diterpenoids with a free 10-beta-hydroxy group.</rdfs:comment>
<rdfs:comment>May be identical to EC 2.3.1.167.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10192963"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
