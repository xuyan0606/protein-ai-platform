</rdf:Description>
<rdf:Description rdf:about="1.1.99.40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(R)-2-hydroxyglutarate--pyruvate transhydrogenase</skos:prefLabel>
<activity rdf:resource="1.1.99.40#SIP6BF77A8FFA34001F"/>
<activity rdf:resource="1.1.99.40#SIP55CB4547095D7A56"/>
<rdfs:comment>The enzyme, characterized in the yeast Saccharomyces cerevisiae, also functions as EC 1.1.2.4 and is active with oxaloacetate as electron acceptor forming (R)-malate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26774271"/>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.40#SIP6BF77A8FFA34001F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-2-hydroxyglutarate + pyruvate = (R)-lactate + 2-oxoglutarate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.40#SIP55CB4547095D7A56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-2-hydroxyglutarate + oxaloacetate = (R)-malate + 2-oxoglutarate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26774271">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/26774271"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/26774271"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.41">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-hydroxy-1,2-didehydro-2,3-dihydrotabersonine reductase</skos:prefLabel>
<skos:altLabel>T3R</skos:altLabel>
<skos:altLabel>tabersonine 3-reductase</skos:altLabel>
<activity rdf:resource="1.1.99.41#SIP101C22BC781AB594"/>
<activity rdf:resource="1.1.99.41#SIP6D50BAF8266957EF"/>
<rdfs:comment>This enzyme is involved in the biosynthesis of vindoline and vindorosine in the plant Catharanthus roseus (Madagascar periwinkle).</rdfs:comment>
<rdfs:comment>In vivo, it functions in the direction of reduction.</rdfs:comment>
<rdfs:comment>It has no activity with 3-epoxylated compounds, which can form spontaneously from its unstable substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25918424"/>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.41#SIP101C22BC781AB594">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R)-3-hydroxy-16-methoxy-2,3-dihydrotabersonine + A = (3R)-1,2-didehydro-3-hydroxy-16-methoxy-2,3-dihydrotabersonine + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.41#SIP6D50BAF8266957EF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(3R)-3-hydroxy-2,3-dihydrotabersonine + A = (3R)-1,2-didehydro-3-hydroxy-2,3-dihydrotabersonine + AH2.</rdfs:label>
</rdf:Description>
