<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ethylnitronate + O2 = acetaldehyde + chemical entity + H(+) + nitrite.</rdfs:label>
</rdf:Description>
