</rdf:Description>
<rdf:Description rdf:about="3.1.3.97">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3',5'-nucleoside bisphosphate phosphatase</skos:prefLabel>
<activity rdf:resource="3.1.3.97#SIP05D529E55B4B4E36"/>
<rdfs:comment>The enzyme, characterized from the bacterium Chromobacterium violaceum, has similar catalytic efficiencies with all the bases.</rdfs:comment>
<rdfs:comment>The enzyme has similar activity with ribonucleoside and 2'-deoxyribonucleoside 3',5'-bisphosphates, but shows no activity with nucleoside 2',5'-bisphosphates (cf. EC 3.1.3.7).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24401123"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.3.97#SIP05D529E55B4B4E36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ribonucleoside 3',5'-bisphosphate + H2O = a ribonucleoside 5'-phosphate + phosphate.</rdfs:label>
</rdf:Description>
