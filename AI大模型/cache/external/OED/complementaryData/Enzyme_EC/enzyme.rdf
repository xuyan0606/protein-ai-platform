<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>macrocin + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + tylosin.</rdfs:label>
</rdf:Description>
