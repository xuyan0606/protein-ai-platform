<replaces rdf:resource="1.14.99.19"/>
<skos:prefLabel>plasmanylethanolamine desaturase</skos:prefLabel>
<skos:altLabel>2-acyl-1-alkyl-sn-glycero-3-phosphoethanolamine desaturase</skos:altLabel>
<skos:altLabel>alkylacylglycerophosphoethanolamine desaturase</skos:altLabel>
<activity rdf:resource="1.14.19.77#SIPCA221E0E707D4DE4"/>
<rdfs:comment>The enzyme catalyzes the introduction of a double bond at position 1 of the alkyl group attached by an ether bond at the sn-1 position of plasmanylethanolamine, generating a vinyl ether-containing plasmenylethanolamine.</rdfs:comment>
<rdfs:comment>The enzyme is found in animals and some bacteria, but not in plants, fungi, or most aerobic bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4144394"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4403444"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5550967"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11946011"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31604315"/>
