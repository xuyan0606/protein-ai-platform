<rdf:Description rdf:about="2.4.1.232">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>initiation-specific alpha-1,6-mannosyltransferase</skos:prefLabel>
<skos:altLabel>alpha-1,6-mannosyltransferase</skos:altLabel>
<skos:altLabel>glycolipid 6-alpha-mannosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.232#SIP1D815CD5032CE581"/>
<rdfs:comment>In Saccharomyces cerevisiae, this enzyme catalyzes an essential step in the outer chain elongation of N-linked oligosaccharides.</rdfs:comment>
<rdfs:comment>Man8GlcNAc and Man9GlcNAc are equally good substrates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1820199"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2644248"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8146181"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8253757"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8797833"/>
