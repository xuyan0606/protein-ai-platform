<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl diphosphate = (2S,3R,6S,9S)-(-)-protoillud-7-ene + diphosphate.</rdfs:label>
</rdf:Description>
