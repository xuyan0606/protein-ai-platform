<rdf:Description rdf:about="4.2.3.86">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>7-epi-alpha-selinene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.86#SIP4B46D2B65F1E1D1D"/>
<rdfs:comment>The recombinant enzyme from Vitis vinifera forms 49.5% (+)-valencene (cf. EC 4.2.3.73) and 35.5% (-)-7-epi-alpha-selinene.</rdfs:comment>
<rdfs:comment>Initial cyclization gives (+)-germacrene A in an enzyme bound form which is not released to the medium.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15464152"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19359488"/>
