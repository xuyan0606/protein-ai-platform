<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>mannan exo-1,2-1,6-alpha-mannosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.137#SIP4F51592164B72E30"/>
<rdfs:comment>Mannose residues linked alpha-D-1,3- are also released very slowly.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
