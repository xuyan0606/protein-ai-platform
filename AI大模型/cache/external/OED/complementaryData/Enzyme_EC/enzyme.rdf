<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>chlorogenate + D-glucarate = 2-O-caffeoylglucarate + L-quinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.99">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>quinate O-hydroxycinnamoyltransferase</skos:prefLabel>
<skos:altLabel>hydroxycinnamoyl coenzyme A-quinate transferase</skos:altLabel>
<activity rdf:resource="2.3.1.99#SIP84E4534CA5C927CE"/>
<rdfs:comment>Caffeoyl-CoA and 4-coumaroyl-CoA can also act as donors, more slowly.</rdfs:comment>
<rdfs:comment>Involved in the biosynthesis of chlorogenic acid in sweet potato and, with EC 2.3.1.98 in the formation of caffeoyl-CoA in tomato.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3722170"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
