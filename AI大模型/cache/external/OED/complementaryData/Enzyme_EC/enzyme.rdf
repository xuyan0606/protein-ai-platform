<rdf:Description rdf:about="2.1.1.338">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>desmethylxanthohumol 6'-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.338#SIP2F23D06EEB3F36EE"/>
<activity rdf:resource="2.1.1.338#SIP990FF03DCD0F744D"/>
<rdfs:comment>Found in hops (Humulus lupulus).</rdfs:comment>
<rdfs:comment>The enzyme can also methylate xanthogalenol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18223037"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.338#SIP2F23D06EEB3F36EE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>desmethylxanthohumol + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + xanthohumol.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.338#SIP990FF03DCD0F744D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + xanthogalenol = 4'-O-methylxanthohumol + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18223037">
