<rdf:Description rdf:about="1.5.1.52">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>staphylopine dehydrogenase</skos:prefLabel>
<skos:altLabel>staphylopine synthase</skos:altLabel>
<activity rdf:resource="1.5.1.52#SIPBF27622BB13272B4"/>
<rdfs:comment>The enzyme, characterized from the bacterium Staphylococcus aureus, catalyzes the last reaction in the biosynthesis of the metallophore staphylopine, which is involved in the acquisition of nickel, copper, and cobalt.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27230378"/>
<citation rdf:resource="http://purl.uniprot.org/citations/29618515"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
