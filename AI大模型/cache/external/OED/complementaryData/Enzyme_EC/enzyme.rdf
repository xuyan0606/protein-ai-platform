<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>decaprenyl-phosphate phosphoribosyltransferase</skos:prefLabel>
<skos:altLabel>5-phospho-alpha-D-ribose-1-diphosphate:decaprenyl-phosphate 5-phosphoribosyltransferase</skos:altLabel>
<skos:altLabel>5-phospho-alpha-D-ribose 1-pyrophosphate:decaprenyl phosphate 5-phosphoribosyltransferase</skos:altLabel>
<skos:altLabel>DPPR synthase</skos:altLabel>
<activity rdf:resource="2.4.2.45#SIPC9E73CA376FFD176"/>
<rdfs:comment>Isolated from Mycobacterium tuberculosis.</rdfs:comment>
<rdfs:comment>Has some activity with other polyprenyl phosphates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15878857"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.45#SIPC9E73CA376FFD176">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-phospho-alpha-D-ribose 1-diphosphate + H(+) + trans,octa-cis-decaprenyl phosphate = diphosphate + trans,octa-cis-decaprenylphospho-beta-D-ribofuranose 5-phosphate.</rdfs:label>
</rdf:Description>
