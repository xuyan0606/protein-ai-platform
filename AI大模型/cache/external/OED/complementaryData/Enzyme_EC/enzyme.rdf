<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nucleotide diphosphokinase</skos:prefLabel>
<skos:altLabel>nucleotide pyrophosphokinase</skos:altLabel>
<activity rdf:resource="2.7.6.4#SIP77C60B2624EC93BE"/>
<rdfs:comment>Acts on the 5'-mono-, di- and triphosphate derivatives of purine nucleosides.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.7.6.-"/>
<skos:broaderTransitive rdf:resource="2.7.6.-"/>
</rdf:Description>
