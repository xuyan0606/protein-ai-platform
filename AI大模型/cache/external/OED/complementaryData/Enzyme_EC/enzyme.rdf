<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + N-acetyl-alpha-D-galactosamine 1-phosphate + UTP = diphosphate + UDP-N-acetyl-alpha-D-galactosamine.</rdfs:label>
</rdf:Description>
