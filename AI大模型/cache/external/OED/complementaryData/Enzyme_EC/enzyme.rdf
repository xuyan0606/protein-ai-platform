<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isoflavone-7-O-beta-glucoside 6''-O-malonyltransferase</skos:prefLabel>
<skos:altLabel>flavone/flavonol 7-O-beta-D-glucoside malonyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.115#SIPA379EB1BA7BF86FF"/>
<rdfs:comment>The 6-position of the glucose residue of formononetin can also act as acceptor; some other 7-O-glucosides of isoflavones, flavones and flavonols can also act, but more slowly.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6497385"/>
<citation rdf:resource="http://purl.uniprot.org/citations/6639051"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.115#SIPA379EB1BA7BF86FF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>biochanin A 7-O-beta-D-glucoside + malonyl-CoA = biochanin A 7-O-beta-D-glucoside 6''-O-malonate + CoA.</rdfs:label>
</rdf:Description>
