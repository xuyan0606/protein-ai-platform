<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3D-3,5/4-trihydroxycyclohexane-1,2-dione + H2O = 5-deoxy-D-glucuronate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18310071">
