<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + biotin + L-lysyl-[protein] = AMP + diphosphate + H(+) + N(6)-biotinyl-L-lysyl-[protein].</rdfs:label>
</rdf:Description>
