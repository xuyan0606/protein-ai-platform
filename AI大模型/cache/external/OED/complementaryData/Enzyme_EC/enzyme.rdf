<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>NAD(+) + prephenate = 3-(4-hydroxyphenyl)pyruvate + CO2 + NADH.</rdfs:label>
