<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-guanidino-2-oxopentanoate + S-adenosyl-L-methionine = 5-guanidino-3-methyl-2-oxopentanoate + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
