<rdf:Description rdf:about="6.2.1.40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4-hydroxybutyrate--CoA ligase (AMP-forming)</skos:prefLabel>
<skos:altLabel>4-hydroxybutyrate--CoA ligase</skos:altLabel>
<skos:altLabel>4-hydroxybutyrate-CoA synthetase</skos:altLabel>
<activity rdf:resource="6.2.1.40#SIPA87E344008D09C40"/>
<rdfs:comment>Isolated from the archaeon Metallosphaera sedula.</rdfs:comment>
<rdfs:comment>Involved in the 3-hydroxypropanoate/4-hydroxybutanoate cycle. cf. EC 6.2.1.56.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21169482"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23258541"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.40#SIPA87E344008D09C40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-hydroxybutanoate + ATP + CoA = 4-hydroxybutanoyl-CoA + AMP + diphosphate.</rdfs:label>
</rdf:Description>
