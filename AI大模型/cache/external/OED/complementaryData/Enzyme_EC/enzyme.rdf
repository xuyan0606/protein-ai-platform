<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12543708"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12543708"/>
<dcterms:identifier>doi:10.1146/annurev.biochem.72.121801.161712</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="2.8.2.35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dermatan 4-sulfotransferase</skos:prefLabel>
<skos:altLabel>CHST14 protein</skos:altLabel>
<skos:altLabel>dermatan N-acetylgalactosamine 4-O-sulfotransferase</skos:altLabel>
<skos:altLabel>dermatan-specific N-acetylgalactosamine 4-O-sulfotransferase</skos:altLabel>
<activity rdf:resource="2.8.2.35#SIP59C9A4681E045AC7"/>
<rdfs:comment>The sulfation takes place at the 4-position of N-acetylgalactosamine residues of dermatan.</rdfs:comment>
<rdfs:comment>D4ST-1 shows a strong preference in vitro for sulfate transfer to IdoUAalpha(1,3)GalNAcbeta(1,4) that is flanked by GlcUAbeta(1,3)GalNAcbeta(1,4) as compared with IdoUAalpha(1,3)GalNAcbeta(1,4) flanked by IdoUAalpha(1,3)GalNAcbeta(1,4).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11470797"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12847091"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16702220"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19661164"/>
<rdfs:subClassOf rdf:resource="2.8.2.-"/>
<skos:broaderTransitive rdf:resource="2.8.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.8.2.35#SIP59C9A4681E045AC7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>n 3'-phosphoadenylyl sulfate + dermatan = n adenosine 3',5'-bisphosphate + dermatan 4'-sulfate + n H(+).</rdfs:label>
</rdf:Description>
