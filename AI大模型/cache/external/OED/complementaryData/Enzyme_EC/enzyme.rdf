<skos:prefLabel>premnaspirodiene oxygenase</skos:prefLabel>
<skos:altLabel>CYP71D55</skos:altLabel>
<skos:altLabel>HPO</skos:altLabel>
<skos:altLabel>Hyoscymus muticus premnaspirodiene oxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.151#SIPD063A0DAE19949C5"/>
<activity rdf:resource="1.14.14.151#SIPAD29B805A4AEE8EA"/>
<activity rdf:resource="1.14.14.151#SIP8D8A9997640B34CC"/>
<activity rdf:resource="1.14.14.151#SIP19A9B3B43AD80BCD"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein.</rdfs:comment>
<rdfs:comment>The enzyme from the plant Hyoscymus muticus also hydroxylates valencene at C-2 to give the alpha-hydroxy compound, nootkatol, and this is converted into nootkatone.</rdfs:comment>
<rdfs:comment>5-Epiaristolochene and epieremophilene are hydroxylated at C-2 to give a 2beta-hydroxy derivatives that are not oxidized further.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17715131"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.151#SIPD063A0DAE19949C5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(-)-vetispiradiene + 2 O2 + 2 reduced [NADPH--hemoprotein reductase] = 2 H(+) + 3 H2O + 2 oxidized [NADPH--hemoprotein reductase] + solavetivone.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.151#SIPAD29B805A4AEE8EA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-valencene + 2 O2 + 2 reduced [NADPH--hemoprotein reductase] = (+)-nootkatone + 2 H(+) + 3 H2O + 2 oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.151#SIP8D8A9997640B34CC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(+)-5-epi-aristolochene + O2 + reduced [NADPH--hemoprotein reductase] = 2beta-hydroxy-5-epi-aristolochene + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.151#SIP19A9B3B43AD80BCD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-epi-eremophilene + O2 + reduced [NADPH--hemoprotein reductase] = 4-epi-eremophilene-2beta-ol + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
