<rdf:Description rdf:about="1.5.99.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nicotine 6-hydroxylase</skos:prefLabel>
<skos:altLabel>D-nicotine oxidase</skos:altLabel>
<skos:altLabel>L-nicotine oxidase</skos:altLabel>
<skos:altLabel>nicotine dehydrogenase</skos:altLabel>
<activity rdf:resource="1.5.99.4#SIP3F0DFB07E583A82A"/>
<activity rdf:resource="1.5.99.4#SIP6EDD2AEF49FB6D03"/>
<rdfs:comment>A metalloprotein (FMN).</rdfs:comment>
<rdfs:comment>The enzyme can act on both the naturally found (S)-enantiomer and the synthetic (R)-enantiomer of nicotine, with retention of configuration in both cases.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4962139"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5849820"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13475371"/>
<citation rdf:resource="http://purl.uniprot.org/citations/13610912"/>
<rdfs:subClassOf rdf:resource="1.5.99.-"/>
<skos:broaderTransitive rdf:resource="1.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.4#SIP3F0DFB07E583A82A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-nicotine + A + H2O = (S)-6-hydroxynicotine + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.4#SIP6EDD2AEF49FB6D03">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-nicotine + A + H2O = (R)-6-hydroxynicotine + AH2.</rdfs:label>
</rdf:Description>
