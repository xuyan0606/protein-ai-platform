<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>cannabigerolate + O2 = Delta(9)-tetrahydrocannabinolate + H2O2.</rdfs:label>
</rdf:Description>
