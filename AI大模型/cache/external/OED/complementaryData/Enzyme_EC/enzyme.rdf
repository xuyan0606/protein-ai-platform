<citation rdf:resource="http://purl.uniprot.org/citations/20693992"/>
<citation rdf:resource="http://purl.uniprot.org/citations/22965231"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
