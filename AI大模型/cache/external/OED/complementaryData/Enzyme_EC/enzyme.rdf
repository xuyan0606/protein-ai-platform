<rdfs:label>oleanolate + UDP-alpha-D-glucose = H(+) + oleanolate 3-O-beta-D-glucoside + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23027665">
