<rdf:Description rdf:about="4.1.2.62">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5-deoxyribulose 1-phosphate aldolase</skos:prefLabel>
<skos:altLabel>5-(methylthio)ribulose-1-phosphate aldolase</skos:altLabel>
<activity rdf:resource="4.1.2.62#SIP5D3A1F491F4E9CFA"/>
<activity rdf:resource="4.1.2.62#SIP47FD6EF42AF95D8F"/>
<rdfs:comment>The enzyme, originally characterized from the bacterium Rhodospirillum rubrum, is involved in degradation pathways for 5'-deoxyadenosine and S-methyl-5'-thioadenosine, which are formed from S-adenosyl-L-methionine (SAM, AdoMet) by radical SAM enzymes and other types of SAM-dependent enzymes, respectively.</rdfs:comment>
<rdfs:comment>The enzyme requires a divalent metal cation, with Co(2+) producing the highest activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/29133429"/>
<citation rdf:resource="http://purl.uniprot.org/citations/31950558"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.62#SIP5D3A1F491F4E9CFA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-deoxy-D-ribulose 1-phosphate = acetaldehyde + dihydroxyacetone phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="4.1.2.62#SIP47FD6EF42AF95D8F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-methyl-5-thio-D-ribulose 1-phosphate = 2-(methylsulfanyl)acetaldehyde + dihydroxyacetone phosphate.</rdfs:label>
</rdf:Description>
