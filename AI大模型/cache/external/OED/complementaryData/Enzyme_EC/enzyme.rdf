<rdf:Description rdf:about="4.99.1.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sirohydrochlorin nickelchelatase</skos:prefLabel>
<activity rdf:resource="4.99.1.11#SIPE240F5DEB29B9C61"/>
<rdfs:comment>The enzyme, studied from the methanogenic archaeon Methanosarcina acetivorans, participates in the biosynthesis of the nickel-containing tetrapyrrole cofactor coenzyme F430, which is required by EC 2.8.4.1.</rdfs:comment>
<rdfs:comment>It catalyzes the insertion of the nickel ion into sirohydrochlorin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/27846569"/>
<rdfs:subClassOf rdf:resource="4.99.1.-"/>
<skos:broaderTransitive rdf:resource="4.99.1.-"/>
</rdf:Description>
