<rdf:Description rdf:about="2.1.1.212">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2,7,4'-trihydroxyisoflavanone 4'-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.212#SIPB96BE075408BE0BC"/>
<rdfs:comment>Specifically methylates 2,4',7-trihydroxyisoflavanone on the 4'-position.</rdfs:comment>
<rdfs:comment>No activity with isoflavones.</rdfs:comment>
<rdfs:comment>The enzyme is involved in formononetin biosynthesis in legumes.</rdfs:comment>
<rdfs:comment>The protein from pea (Pisum sativum) also methylates (+)-6a-hydroxymaackiain at the 3-position (cf. EC 2.1.1.270).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12610212"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17001495"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17172354"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
