<replaces rdf:resource="5.5.1.n1"/>
<skos:prefLabel>D-ribose pyranase</skos:prefLabel>
<activity rdf:resource="5.4.99.62#SIP477D545B90A882E1"/>
<activity rdf:resource="5.4.99.62#SIPDEFA37E26EF32137"/>
<rdfs:comment>The enzyme also catalyzes the conversion between beta-allofuranose and beta-allopyranose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12738765"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15060078"/>
