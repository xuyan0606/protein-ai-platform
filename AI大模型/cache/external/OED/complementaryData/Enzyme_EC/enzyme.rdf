<skos:prefLabel>Kdo2-lipid A phosphoethanolamine 7''-transferase</skos:prefLabel>
<activity rdf:resource="2.7.8.42#SIPD6C63072F8219309"/>
<activity rdf:resource="2.7.8.42#SIPBF12A13085A1715C"/>
<rdfs:comment>The enzyme has been characterized from the bacterium Escherichia coli.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11042192"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15795227"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23659637"/>
