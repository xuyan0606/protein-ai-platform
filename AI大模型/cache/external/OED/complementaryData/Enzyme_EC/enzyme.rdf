<activity rdf:resource="3.1.3.91#SIP07E81221033AD01D"/>
<activity rdf:resource="3.1.3.91#SIP9DF40F867F6CFEDD"/>
<rdfs:comment>The enzyme also has low activity with N(7)-methyl-GDP, producing N(7)-methyl-GMP.</rdfs:comment>
<rdfs:comment>Does not accept AMP or GMP, and has low activity with UMP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23223233"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
