<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of keratin, and of other proteins with subtilisin-like specificity. Hydrolyzes peptide amides.</rdfs:label>
</rdf:Description>
