<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>DNA 4,6-diamino-5-formamidopyrimidine = DNA adenine + H2O.</rdfs:label>
</rdf:Description>
