<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(20S)-ginsenoside F1 + UDP-alpha-D-glucose = (20S)-ginsenoside Rg1 + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26032089">
