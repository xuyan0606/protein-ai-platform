<rdf:Description rdf:about="3.7.1.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acylpyruvate hydrolase</skos:prefLabel>
<activity rdf:resource="3.7.1.5#SIP49D81ADC72DE3D15"/>
<rdfs:comment>Acts on formylpyruvate, 2,4-dioxopentanoate, 2,4-dioxohexanoate and 2,4-dioxoheptanoate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4375963"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.7.1.5#SIP49D81ADC72DE3D15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 3-acylpyruvate + H2O = a carboxylate + H(+) + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4375963">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/4375963"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/4375963"/>
</rdf:Description>
<rdf:Description rdf:about="3.7.1.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>acetylpyruvate hydrolase</skos:prefLabel>
<activity rdf:resource="3.7.1.6#SIPED7DF168D9285187"/>
<rdfs:comment>Highly specific; does not act on pyruvate, oxaloacetate, maleylpyruvate, fumarylpyruvate or acetylacetone.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/236305"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.7.1.6#SIPED7DF168D9285187">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetylpyruvate + H2O = acetate + H(+) + pyruvate.</rdfs:label>
</rdf:Description>
