<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>poly(ribitol-phosphate) alpha-N-acetylglucosaminyltransferase</skos:prefLabel>
<skos:altLabel>poly(ribitol-phosphate) N-acetylglucosaminyltransferase</skos:altLabel>
<skos:altLabel>UDP acetylglucosamine-poly(ribitol phosphate) acetylglucosaminyltransferase</skos:altLabel>
<activity rdf:resource="2.4.1.70#SIPC4288AA37DA9D79B"/>
