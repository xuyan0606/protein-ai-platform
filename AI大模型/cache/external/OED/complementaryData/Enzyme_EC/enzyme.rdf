<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>norcoclaurine + S-adenosyl-L-methionine = coclaurine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.128#SIPA7183B41BA516333">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-norcoclaurine + S-adenosyl-L-methionine = (S)-coclaurine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
