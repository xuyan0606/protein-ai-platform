<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-deoxy-6-sulfo-D-fructose + D-glyceraldehyde 3-phosphate = 4-deoxy-4-sulfo-D-erythrose + D-xylulose 5-phosphate.</rdfs:label>
</rdf:Description>
