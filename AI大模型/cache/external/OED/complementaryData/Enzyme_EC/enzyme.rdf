<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-quinate + NADP(+) = 3-dehydroquinate + H(+) + NADPH.</rdfs:label>
</rdf:Description>
