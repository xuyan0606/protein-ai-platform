<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18079405"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18079405"/>
<dcterms:identifier>doi:10.1126/science.1149976</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/19429610">
