</rdf:Description>
<rdf:Description rdf:about="2.7.8.38">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>archaetidylserine synthase</skos:prefLabel>
<activity rdf:resource="2.7.8.38#SIP4EE1CF25148923D4"/>
<activity rdf:resource="2.7.8.38#SIP901B73BC97C7A640"/>
<rdfs:comment>Isolated from the archaeon Methanothermobacter thermautotrophicus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12562787"/>
<rdfs:subClassOf rdf:resource="2.7.8.-"/>
<skos:broaderTransitive rdf:resource="2.7.8.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.38#SIP4EE1CF25148923D4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CDP-2,3-bis-O-(geranylgeranyl)-sn-glycerol + L-serine = archaetidylserine + CMP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.38#SIP901B73BC97C7A640">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>CDP-2,3-bis-O-(phytanyl)-sn-glycerol + L-serine = 2,3-bis-O-phytanyl-sn-glycero-3-phospho-L-serine + CMP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12562787">
