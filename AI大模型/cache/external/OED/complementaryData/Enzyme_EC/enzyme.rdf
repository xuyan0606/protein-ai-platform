</rdf:Description>
<rdf:Description rdf:about="2.3.1.216">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>5,7-dihydroxy-2-methylchromone synthase</skos:prefLabel>
<skos:altLabel>pentaketide chromone synthase</skos:altLabel>
<activity rdf:resource="2.3.1.216#SIPF4D54C8EBD86C390"/>
<rdfs:comment>A polyketide synthase from the plant Aloe arborescens (aloe).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15686354"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
