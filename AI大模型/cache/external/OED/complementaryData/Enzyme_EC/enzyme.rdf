<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alpha-D-ribose 1-methylphosphonate 5-triphosphate synthase</skos:prefLabel>
<activity rdf:resource="2.7.8.37#SIPD8C3E87990BBFD54"/>
<rdfs:comment>Isolated from the bacterium Escherichia coli.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22089136"/>
<rdfs:subClassOf rdf:resource="2.7.8.-"/>
<skos:broaderTransitive rdf:resource="2.7.8.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.8.37#SIPD8C3E87990BBFD54">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + methylphosphonate = adenine + alpha-D-ribose 1-methylphosphonate 5-triphosphate.</rdfs:label>
</rdf:Description>
