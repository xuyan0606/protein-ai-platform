<rdf:Description rdf:about="1.2.1.80">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>long-chain acyl-[acyl-carrier-protein] reductase</skos:prefLabel>
<skos:altLabel>fatty acyl-[acyl-carrier-protein] reductase</skos:altLabel>
<activity rdf:resource="1.2.1.80#SIP954C29B9B86E8141"/>
<activity rdf:resource="1.2.1.80#SIPD31A017535B76478"/>
<rdfs:comment>Catalyzes the reaction in the opposite direction.</rdfs:comment>
<rdfs:comment>This enzyme, purified from the cyanobacterium Synechococcus elongatus PCC 7942, catalyzes the NAD(P)H-dependent reduction of an activated fatty acid (acyl-[acp]) to the corresponding aldehyde.</rdfs:comment>
<rdfs:comment>Together with EC 4.1.99.5, it is involved in alkane biosynthesis.</rdfs:comment>
<rdfs:comment>The natural substrates of the enzyme are C16 to C18 activated fatty acids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20671186"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.80#SIP954C29B9B86E8141">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a long-chain fatty aldehyde + holo-[ACP] + NADP(+) = a long-chain fatty acyl-[ACP] + H(+) + NADPH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.80#SIPD31A017535B76478">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a long-chain fatty aldehyde + holo-[ACP] + NAD(+) = a long-chain fatty acyl-[ACP] + H(+) + NADH.</rdfs:label>
</rdf:Description>
