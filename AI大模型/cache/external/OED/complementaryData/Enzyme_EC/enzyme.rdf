<rdf:Description rdf:about="2.7.1.177">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-threonine kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.177#SIPC9D0770AFCE76188"/>
<rdfs:comment>The enzyme is involved in the de novo synthesis of adenosylcobalamin.</rdfs:comment>
<rdfs:comment>It is specific for ATP and free L-threonine.</rdfs:comment>
<rdfs:comment>In the bacterium Salmonella enterica the activity with CTP, GTP, or UTP is 6, 11, and 3% of the activity with ATP.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18308727"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19509296"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.177#SIPC9D0770AFCE76188">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-threonine = ADP + H(+) + O-phospho-L-threonine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18308727">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
