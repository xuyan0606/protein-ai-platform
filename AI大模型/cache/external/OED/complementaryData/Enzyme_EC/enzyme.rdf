<rdf:Description rdf:about="2.5.1.112">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.5.1.n4"/>
<skos:prefLabel>adenylate dimethylallyltransferase (ADP/ATP-dependent)</skos:prefLabel>
<skos:altLabel>adenylate isopentenyltransferase</skos:altLabel>
<skos:altLabel>cytokinin synthase</skos:altLabel>
<skos:altLabel>isopentenyltransferase</skos:altLabel>
<activity rdf:resource="2.5.1.112#SIPCCEE456D0CB55A23"/>
<activity rdf:resource="2.5.1.112#SIP479AC01DC1D8C7A7"/>
<rdfs:comment>Involved in the biosynthesis of cytokinins in plants.</rdfs:comment>
<rdfs:comment>The IPT4 isoform from the plant Arabidopsis thaliana is specific for ADP and ATP.</rdfs:comment>
<rdfs:comment>Other isoforms, such as IPT1 from Arabidopsis thaliana and the enzyme from the common hop, Humulus lupulus, also have a lower activity with AMP (cf. EC 2.5.1.27).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11313355"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11479373"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15381407"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.112#SIPCCEE456D0CB55A23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ADP + dimethylallyl diphosphate = diphosphate + N(6)-(dimethylallyl)adenosine 5'-diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.112#SIP479AC01DC1D8C7A7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + dimethylallyl diphosphate = diphosphate + N(6)-(dimethylallyl)adenosine 5'-triphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11313355">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/11313355"/>
