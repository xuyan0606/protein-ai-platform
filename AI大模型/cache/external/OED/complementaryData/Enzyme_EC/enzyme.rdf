<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-glucosamine 1-phosphate = D-glucosamine 6-phosphate.</rdfs:label>
</rdf:Description>
