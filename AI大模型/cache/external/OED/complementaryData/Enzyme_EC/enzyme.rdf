<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/18412541"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/18412541"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18626641">
