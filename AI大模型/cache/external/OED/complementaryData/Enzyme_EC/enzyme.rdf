<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>mycinamicin III + S-adenosyl-L-methionine = H(+) + mycinamicin IV + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
