<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17592143"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17592143"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.284">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3'-(hydroxy)phthioceranyl-2'-palmitoyl(stearoyl)-2-O-sulfo-trehalose (hydroxy)phthioceranyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.284#SIP7C1DF0F14CD216EC"/>
<rdfs:comment>The enzyme, present in mycobacteria, catalyzes the ultimate step in the biosynthesis of mycobacterial sulfolipids.</rdfs:comment>
<rdfs:comment>It catalyzes two successive transfers of a (hydroxy)phthioceranyl group from two diacylated intermediates to third diacylated intermediate, generating the tetraacylated sulfolipid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22194604"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.284#SIP7C1DF0F14CD216EC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3 3'-(hydroxy)phthioceranyl-2'-palmitoyl(stearoyl)-2-O-sulfo-alpha,alpha-trehalose = 3,6,6'-tris-(hydroxy)phthioceranyl-2-palmitoyl(stearoyl)-2'-sulfo-alpha-alpha-trehalose + 2 2'-palmitoyl/stearoyl-2-O-sulfo-alpha,alpha-trehalose.</rdfs:label>
</rdf:Description>
