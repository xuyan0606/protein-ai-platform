<rdf:Description rdf:about="3.2.1.145">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>galactan 1,3-beta-galactosidase</skos:prefLabel>
<activity rdf:resource="3.2.1.145#SIPA22BB3E9F83038D3"/>
<rdfs:comment>This enzyme removes not only free galactose, but also 6-glycosylated residues, e.g., (1->6)-beta-D-galactobiose, and galactose bearing oligosaccharide chains on O-6.</rdfs:comment>
<rdfs:comment>Hence, it releases branches from [arabino-galacto-(1->6)]-(1->3)-beta-D-galactans.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2158993"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7805066"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.145#SIPA22BB3E9F83038D3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of terminal, non-reducing beta-D-galactose residues in (1->3)-beta-D-galactopyranans.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2158993">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/2158993"/>
