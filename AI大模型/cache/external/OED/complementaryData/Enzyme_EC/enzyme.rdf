<skos:prefLabel>2-phosphinomethylmalate synthase</skos:prefLabel>
<activity rdf:resource="2.3.3.18#SIP30FD454D1C4B00AE"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces hygroscopicus, participates in the pathway for bialaphos biosynthesis.</rdfs:comment>
<rdfs:comment>It requires a divalent metal ion and can also act on oxaloacetate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1368511"/>
<citation rdf:resource="http://purl.uniprot.org/citations/3170341"/>
<rdfs:subClassOf rdf:resource="2.3.3.-"/>
<skos:broaderTransitive rdf:resource="2.3.3.-"/>
</rdf:Description>
