<rdf:Description rdf:about="2.3.1.202">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>UDP-4-amino-4,6-dideoxy-N-acetyl-beta-L-altrosamine N-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.202#SIP1EAF759DDC9BA05D"/>
<rdfs:comment>Isolated from Helicobacter pylori.</rdfs:comment>
<rdfs:comment>The enzyme is involved in the biosynthesis of pseudaminic acid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16751642"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.202#SIP1EAF759DDC9BA05D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + UDP-4-amino-4,6-dideoxy-N-acetyl-beta-L-altrosamine = CoA + H(+) + UDP-2,4-diacetamido-2,4,6-trideoxy-beta-L-altrose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16751642">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16751642"/>
