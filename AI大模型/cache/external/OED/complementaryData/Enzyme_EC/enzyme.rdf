<rdf:Description rdf:about="2.1.1.79">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cyclopropane-fatty-acyl-phospholipid synthase</skos:prefLabel>
<skos:altLabel>CFA synthase</skos:altLabel>
<skos:altLabel>cyclopropane fatty acid synthase</skos:altLabel>
<skos:altLabel>cyclopropane synthetase</skos:altLabel>
<skos:altLabel>unsaturated-phospholipid methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.79#SIPFCE2F394C6B84569"/>
<rdfs:comment>Adds a methylene group across the 9,10 position of a Delta(9)-olefinic acyl chain in phosphatidylethanolamine or, more slowly, phosphatidylglycerol or phosphatidylinositol forming a cyclopropane derivative (cf. EC 2.1.1.16).</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
