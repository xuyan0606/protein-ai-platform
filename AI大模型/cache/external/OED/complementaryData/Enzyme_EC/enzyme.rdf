<rdf:Description rdf:about="2.7.1.176">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.7.1.n7"/>
<skos:prefLabel>UDP-N-acetylglucosamine kinase</skos:prefLabel>
<skos:altLabel>UNAG kinase</skos:altLabel>
<activity rdf:resource="2.7.1.176#SIP705156653DC7B0C7"/>
<rdfs:comment>Toxic component of a toxin-antitoxin (TA) module.</rdfs:comment>
<rdfs:comment>The phosphorylation of UDP-N-acetyl-alpha-D-glucosamine results in the inhibition of EC 2.5.1.7, which is then blocked.</rdfs:comment>
<rdfs:comment>Phosphorylation is inhibited by cognate epsilon antitoxin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17488720"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21445328"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
