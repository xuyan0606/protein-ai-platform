</rdf:Description>
<rdf:Description rdf:about="3.4.23.47">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>HIV-2 retropepsin</skos:prefLabel>
<activity rdf:resource="3.4.23.47#SIPEB1B7A8F6169D195"/>
<rdfs:comment>Responsible for the post-translational processing of the human immunodeficiency virus polyprotein.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family A2.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2015912"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7929352"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.47#SIPEB1B7A8F6169D195">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Endopeptidase for which the P1 residue is preferably hydrophobic.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2015912">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
