<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E,10E)-geranylgeranyl diphosphate + H2O = (R)-nephthenol + diphosphate.</rdfs:label>
</rdf:Description>
