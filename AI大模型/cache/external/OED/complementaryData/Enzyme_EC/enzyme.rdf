</rdf:Description>
<rdf:Description rdf:about="6.2.1.48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>carnitine--CoA ligase</skos:prefLabel>
<activity rdf:resource="6.2.1.48#SIP16AA3346C4D8102E"/>
<activity rdf:resource="6.2.1.48#SIPD491A35F5E50C5A5"/>
<activity rdf:resource="6.2.1.48#SIP52354E758B3E5F70"/>
<rdfs:comment>The enzyme, originally characterized from the bacterium Escherichia coli, can catalyze the transfer of CoA to L-carnitine, crotonobetaine and gamma-butyrobetaine.</rdfs:comment>
<rdfs:comment>In vitro the enzyme also exhibits the activity of EC 2.8.3.21.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7815937"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18266698"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
