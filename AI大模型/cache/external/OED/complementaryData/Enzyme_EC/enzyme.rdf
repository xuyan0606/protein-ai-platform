<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2Z,6E)-farnesyl diphosphate + 7 isopentenyl diphosphate = (2Z,6Z,10Z,14Z,18Z,22Z,26Z,30Z,34E)-decaprenyl diphosphate + 7 diphosphate.</rdfs:label>
</rdf:Description>
