<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/6446303"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/6446303"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.73">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>diacylglycerol--sterol O-acyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.73#SIPB38924A5578164F3"/>
<rdfs:comment>Cholesterol, sitosterol, campesterol and diacylglycerol can act as acceptors.</rdfs:comment>
<rdfs:comment>Transfers a number of long-chain fatty acyl groups.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/742884"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.73#SIPB38924A5578164F3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycerol + a sterol = a 1-acyl-sn-glycerol + a sterol ester.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/742884">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/742884"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/742884"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.74">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>chalcone synthase</skos:prefLabel>
<skos:altLabel>6'-deoxychalcone synthase</skos:altLabel>
<skos:altLabel>flavonone synthase</skos:altLabel>
<skos:altLabel>naringenin-chalcone synthase</skos:altLabel>
<activity rdf:resource="2.3.1.74#SIPD06BF47660E64FF4"/>
<rdfs:comment>The enzyme catalyzes the first committed step in the biosynthesis of flavonoids.</rdfs:comment>
<rdfs:comment>It can also act on dihydro-4-coumaroyl-CoA, forming phloretin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3355160"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7436427"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28482241"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.74#SIPD06BF47660E64FF4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-coumaroyl-CoA + 2 H(+) + 3 malonyl-CoA = 2',4,4',6'-tetrahydroxychalcone + 3 CO2 + 4 CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3355160">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3355160"/>
