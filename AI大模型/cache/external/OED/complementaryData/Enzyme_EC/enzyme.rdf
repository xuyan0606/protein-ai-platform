<rdf:Description rdf:about="2.1.1.151">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-factor II C(20)-methyltransferase</skos:prefLabel>
<skos:altLabel>Cobalt-precorrin-2 C(20)-methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.151#SIP2EB487C17E23BE22"/>
<rdfs:comment>This enzyme participates in the anaerobic (early cobalt insertion) cobalamin biosynthesis pathway.</rdfs:comment>
<rdfs:comment>See EC 2.1.1.130 for the equivalent enzyme that participates in the aerobic cobalamin biosynthesis pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9778368"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
