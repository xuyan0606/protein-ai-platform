<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 L-leucyl-tRNA(Leu) = cyclo(L-leucyl-L-leucyl) + 2 H(+) + 2 tRNA(Leu).</rdfs:label>
</rdf:Description>
