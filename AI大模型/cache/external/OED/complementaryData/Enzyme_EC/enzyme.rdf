<skos:prefLabel>L-galactonolactone oxidase</skos:prefLabel>
<skos:altLabel>L-xylono-1,4-lactone oxidase</skos:altLabel>
<activity rdf:resource="1.3.3.12#SIP118B5E5A48DF343C"/>
<rdfs:comment>Acts on the 1,4-lactones of L-galactonic, D-altronic, L-fuconic, D-arabinic and D-threonic acids.</rdfs:comment>
<rdfs:comment>Not identical with EC 1.1.3.8 (cf. EC 1.3.2.3).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/6754380"/>
<rdfs:subClassOf rdf:resource="1.3.3.-"/>
<skos:broaderTransitive rdf:resource="1.3.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.3.12#SIP118B5E5A48DF343C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-galactono-1,4-lactone + O2 = H(+) + H2O2 + L-ascorbate.</rdfs:label>
</rdf:Description>
