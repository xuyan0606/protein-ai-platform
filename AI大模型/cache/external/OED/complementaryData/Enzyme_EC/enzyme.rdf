<rdf:Description rdf:about="2.1.1.289">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-7 (C(5))-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.289#SIP13EFAAB974D89466"/>
<rdfs:comment>This enzyme catalyzes the methylation at C-5 of cobalt-precorrin-7, a step in the anaerobic (early cobalt insertion) adenosylcobalamin biosynthesis pathway.</rdfs:comment>
<rdfs:comment>The equivalent activity in the aerobic adenosylcobalamin biosynthesis pathway is catalyzed by the bifunctional enzyme EC 2.1.1.132.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16198574"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23922391"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
