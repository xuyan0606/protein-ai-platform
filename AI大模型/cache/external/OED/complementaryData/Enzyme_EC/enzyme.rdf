<activity rdf:resource="1.1.1.400#SIP8F6FCA9281CBCB49"/>
<rdfs:comment>This bacterial enzyme is involved in the degradation pathways of the alkene 2-methylpropene and the fuel oxygenate methyl tert-butyl ether (MTBE), a widely occurring groundwater contaminant.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16622053"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25576605"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
