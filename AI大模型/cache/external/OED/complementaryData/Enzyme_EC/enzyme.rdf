<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-saturated fatty acid + O2 = a (2R)-2-hydroperoxy fatty acid.</rdfs:label>
</rdf:Description>
