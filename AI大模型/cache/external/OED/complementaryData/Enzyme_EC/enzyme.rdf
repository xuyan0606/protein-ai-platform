<activity rdf:resource="2.1.1.283#SIP79D8631195A8E30A"/>
<rdfs:comment>The enzyme is involved in biosynthesis of the seco-anthraquinone (+)-geodin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1444712"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
