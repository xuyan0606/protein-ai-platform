<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(R)-mandelonitrile beta-glucosyltransferase</skos:prefLabel>
<skos:altLabel>UGT85A19</skos:altLabel>
<activity rdf:resource="2.4.1.354#SIP18D03127FC6CA983"/>
<rdfs:comment>The enzyme, characterized from Prunus dulcis (almond), is involved in the biosynthesis of the cyanogenic glycosides (R)-prunasin and (R)-amygdalin.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.354#SIP18D03127FC6CA983">
