<rdf:Description rdf:about="3.4.21.121">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>Lys-Lys/Arg-Xaa endopeptidase</skos:prefLabel>
<skos:altLabel>Aeromonas extracellular serine protease</skos:altLabel>
<activity rdf:resource="3.4.21.121#SIPC1442CA5F83BABE2"/>
<rdfs:comment>The enzyme is a serine peptidase, which has been shown to cleave prothrombin and prekallikrein.</rdfs:comment>
<rdfs:comment>It hydrolyzes the complement component C5 releasing complement component C5a.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16487335"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18067862"/>
