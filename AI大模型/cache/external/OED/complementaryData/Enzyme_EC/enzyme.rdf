<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 1,2-diacyl-sn-glycero-3-phospho-L-serine + H2O = a 2-acyl-sn-glycero-3-phospho-L-serine + a fatty acid + H(+).</rdfs:label>
</rdf:Description>
