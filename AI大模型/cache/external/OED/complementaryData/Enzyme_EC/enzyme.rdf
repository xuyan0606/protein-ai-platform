<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2R,3S)-2,4',7-trihydroxyisoflavanone + S-adenosyl-L-methionine = (2R,3S)-2,7-dihydroxy-4'-methoxyisoflavanone + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
