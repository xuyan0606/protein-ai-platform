<rdf:Description rdf:about="2.7.1.235">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>lipopolysaccharide core heptose(I) kinase</skos:prefLabel>
<activity rdf:resource="2.7.1.235#SIP664E8F2BD2D08293"/>
<activity rdf:resource="2.7.1.235#SIP5E163596FC95C613"/>
<rdfs:comment>The enzyme catalyzes the phosphorylation of L-glycero-D-manno-heptose I (the first heptose added to the lipid, Hep I) in the biosynthesis of the inner core oligosaccharide of the lipopolysaccharide (endotoxin) of some Gram-negative bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11069912"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11741974"/>
<citation rdf:resource="http://purl.uniprot.org/citations/30237436"/>
<rdfs:subClassOf rdf:resource="2.7.1.-"/>
<skos:broaderTransitive rdf:resource="2.7.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.235#SIP664E8F2BD2D08293">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an L-alpha-D-Hep-(1->3)-L-alpha-D-Hep-(1->5)-[alpha-Kdo-(2->4)]-alpha-Kdo-(2->6)-lipid A + ATP = ADP + an L-alpha-D-Hep-(1->3)-4-O-phospho-L-alpha-D-Hep-(1->5)-[alpha-Kdo-(2->4)]-alpha-Kdo-(2->6)-lipid A + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.1.235#SIP5E163596FC95C613">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-alpha-D-Hep-(1->3)-L-alpha-D-Hep-(1->5)-[alpha-Kdo-(2->4)]-alpha-Kdo-(2->6)-lipid A (E. coli) = ADP + H(+) + L-alpha-D-Hep-(1->3)-4-O-phospho-L-alpha-D-Hep-(1->5)-[alpha-Kdo-(2->4)]-alpha-Kdo-(2->6)-lipid A (E. coli).</rdfs:label>
</rdf:Description>
