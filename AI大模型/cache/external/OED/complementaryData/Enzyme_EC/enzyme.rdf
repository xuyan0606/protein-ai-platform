<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N-feruloylglycine = (E)-ferulate + glycine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.72">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-benzoylarginine-4-nitroanilide amidase</skos:prefLabel>
<activity rdf:resource="3.5.1.72#SIP1506CABC0248F0D5"/>
