<skos:prefLabel>phosphopentomutase</skos:prefLabel>
<skos:altLabel>deoxyribomutase</skos:altLabel>
<skos:altLabel>deoxyribose phosphomutase</skos:altLabel>
<skos:altLabel>phosphodeoxyribomutase</skos:altLabel>
<activity rdf:resource="5.4.2.7#SIP1BC98FA92C4F8C63"/>
<activity rdf:resource="5.4.2.7#SIP2EE406D28229B815"/>
