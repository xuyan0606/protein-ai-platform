<activity rdf:resource="5.1.3.33#SIP10A59C7DE7ACFA9E"/>
<rdfs:comment>The enzyme, characterized from the bacterium Actinomyces sp.</rdfs:comment>
<rdfs:comment>Lu 9419, is involved in the biosynthesis of the antitumor agent cetoniacytone A.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19101977"/>
<rdfs:subClassOf rdf:resource="5.1.3.-"/>
<skos:broaderTransitive rdf:resource="5.1.3.-"/>
