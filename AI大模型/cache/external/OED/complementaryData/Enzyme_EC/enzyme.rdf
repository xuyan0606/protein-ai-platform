<skos:prefLabel>beta-dihydromenaquinone-9 omega-hydroxylase</skos:prefLabel>
<skos:altLabel>CYP128</skos:altLabel>
<activity rdf:resource="1.14.15.27#SIP00D82257431D3D12"/>
<rdfs:comment>The bacterial cytochrome P450 enzyme is involved in the biosynthesis of omega-sulfo-beta-dihydromenaquinone-9 by members of the Mycobacterium tuberculosis complex.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18928249"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27933784"/>
<rdfs:subClassOf rdf:resource="1.14.15.-"/>
<skos:broaderTransitive rdf:resource="1.14.15.-"/>
</rdf:Description>
