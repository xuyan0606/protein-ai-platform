<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + oxidized [electron-transfer flavoprotein] + phloretate = (E)-4-coumarate + reduced [electron-transfer flavoprotein].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.8.15#SIP76170E246804F3C0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-phenylpropanoate + H(+) + oxidized [electron-transfer flavoprotein] = (E)-cinnamate + reduced [electron-transfer flavoprotein].</rdfs:label>
</rdf:Description>
