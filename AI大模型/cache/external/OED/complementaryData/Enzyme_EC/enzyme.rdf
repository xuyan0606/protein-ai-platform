<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(2)-benzoyl-D-arginine-4-nitroanilide = 4-nitroaniline + H(+) + N(2)-benzoyl-D-arginine.</rdfs:label>
</rdf:Description>
