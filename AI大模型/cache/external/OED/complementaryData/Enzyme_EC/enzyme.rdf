</rdf:Description>
<rdf:Description rdf:about="1.7.2.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.7.99.8"/>
<skos:prefLabel>hydrazine dehydrogenase</skos:prefLabel>
<activity rdf:resource="1.7.2.8#SIPF9979C7B212BA1BE"/>
<rdfs:comment>The enzyme, which is involved in the pathway of anaerobic ammonium oxidation in anammox bacteria, has been purified from the bacterium Candidatus Kuenenia stuttgartiensis.</rdfs:comment>
<rdfs:comment>The electrons derived from hydrazine are eventually transferred to the quinone pool.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10820012"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11404106"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21964329"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23210799"/>
<rdfs:subClassOf rdf:resource="1.7.2.-"/>
<skos:broaderTransitive rdf:resource="1.7.2.-"/>
</rdf:Description>
