<rdf:Description rdf:about="3.1.1.120">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-fucono-1,5-lactonase</skos:prefLabel>
<activity rdf:resource="3.1.1.120#SIP148E48F146284A81"/>
<activity rdf:resource="3.1.1.120#SIP65FD4EC1D6A2ED5F"/>
<activity rdf:resource="3.1.1.120#SIP3BE6CD4D817418BE"/>
<activity rdf:resource="3.1.1.120#SIP2CBA2A36FF5E8719"/>
<activity rdf:resource="3.1.1.120#SIPE2B2F9CDA686B333"/>
<rdfs:comment>The enzyme, characterized from the bacterium Burkholderia multivorans, participates in an L-fucose degradation pathway.</rdfs:comment>
<rdfs:comment>The enzyme exhibits catalytic activity for the hydrolysis of several lactones, including L-fucono-1,4-lactone, D-arabinono-1,4-lactone, L-xylono-1,4-lactone, and L-galactono-1,4-lactone, but L-fucono-1,5-lactone is the best substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23214453"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.120#SIP148E48F146284A81">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-fucono-1,5-lactone = H(+) + L-fuconate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.120#SIP65FD4EC1D6A2ED5F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-fucono-1,4-lactone = H(+) + L-fuconate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.120#SIP3BE6CD4D817418BE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-xylono-1,4-lactone = H(+) + L-xylonate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.120#SIP2CBA2A36FF5E8719">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-galactono-1,4-lactone = H(+) + L-galactonate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.120#SIPE2B2F9CDA686B333">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-arabinono-1,4-lactone + H2O = D-arabinonate + H(+).</rdfs:label>
</rdf:Description>
