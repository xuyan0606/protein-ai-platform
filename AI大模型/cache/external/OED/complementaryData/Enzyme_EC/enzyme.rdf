<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + dGMP + L-aspartate = (2S)-2-amino-2'-deoxyadenylo-succinate + ADP + 2 H(+) + phosphate.</rdfs:label>
</rdf:Description>
