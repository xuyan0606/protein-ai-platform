<skos:prefLabel>glycine dehydrogenase (cytochrome)</skos:prefLabel>
<skos:altLabel>glycine-cytochrome c reductase</skos:altLabel>
<activity rdf:resource="1.4.2.1#SIPCB66848E9B5FBA4D"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5016640"/>
<rdfs:subClassOf rdf:resource="1.4.2.-"/>
<skos:broaderTransitive rdf:resource="1.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.2.1#SIPCB66848E9B5FBA4D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome c] + glycine + H2O = 2 Fe(II)-[cytochrome c] + glyoxylate + 2 H(+) + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/5016640">
