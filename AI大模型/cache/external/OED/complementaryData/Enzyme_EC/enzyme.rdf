<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,6,7,8-tetrahydromethanopterin + H(+) + N-formylmethanofuran = methanofuran + N(5)-formyl-5,6,7,8-tetrahydromethanopterin.</rdfs:label>
</rdf:Description>
