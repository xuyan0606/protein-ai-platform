<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/7805066"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/7805066"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.146">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>beta-galactofuranosidase</skos:prefLabel>
<skos:altLabel>beta-D-galactofuranosidase</skos:altLabel>
<skos:altLabel>exo-beta-D-galactofuranosidase</skos:altLabel>
<skos:altLabel>exo-beta-galactofuranosidase</skos:altLabel>
<activity rdf:resource="3.2.1.146#SIP9A74E53207C024BB"/>
<rdfs:comment>The enzyme from Helminthosporium sacchari detoxifies helminthosporoside, a bis(digalactosyl)terpene produced by this fungus, by releasing its four molecules of bound galactose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/863879"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2502527"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.146#SIP9A74E53207C024BB">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of terminal non-reducing beta-D-galactofuranosides, releasing galactose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/863879">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/863879"/>
