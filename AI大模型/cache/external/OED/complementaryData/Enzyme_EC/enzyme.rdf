<rdf:Description rdf:about="1.14.13.219">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>resorcinol 4-hydroxylase (NADPH)</skos:prefLabel>
<activity rdf:resource="1.14.13.219#SIP57CED304C583EBAE"/>
<rdfs:comment>The enzyme, characterized from the bacterium Corynebacterium glutamicum, is a single-component hydroxylase.</rdfs:comment>
<rdfs:comment>The enzyme has no activity with NADH. cf. EC 1.14.13.220 and EC 1.14.14.27.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16963551"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.219#SIP57CED304C583EBAE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADPH + O2 + resorcinol = benzene-1,2,4-triol + H2O + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16963551">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16963551"/>
