<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-dihydroorotate + a ubiquinone = a ubiquinol + orotate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.5.2#SIP0C303E1A8770AB86">
