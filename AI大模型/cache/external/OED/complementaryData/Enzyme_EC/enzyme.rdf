<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-2-benzylsuccinyl-CoA + H(+) + oxidized [electron-transfer flavoprotein] = (E)-2-benzylidenesuccinyl-CoA + reduced [electron-transfer flavoprotein].</rdfs:label>
</rdf:Description>
