<rdf:Description rdf:about="5.4.99.56">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tirucalladienol synthase</skos:prefLabel>
<activity rdf:resource="5.4.99.56#SIPC0B77D14A7CB1E1E"/>
<rdfs:comment>The product from Arabidopsis thaliana is 85% tirucalla-7,24-dien-3beta-ol with trace amounts of other triterpenoids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/19445469"/>
<rdfs:subClassOf rdf:resource="5.4.99.-"/>
<skos:broaderTransitive rdf:resource="5.4.99.-"/>
</rdf:Description>
