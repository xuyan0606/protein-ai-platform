<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/8163662"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.40">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phytepsin</skos:prefLabel>
<activity rdf:resource="3.4.23.40#SIP320FA65BE5F34BC8"/>
<rdfs:comment>Known particularly fron barley grain, but present in other plants also.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family A1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1722454"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7556174"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7763475"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8540324"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.40#SIP320FA65BE5F34BC8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Prefers hydrophobic residues Phe, Val, Ile, Leu, and Ala at P1 and P1', but also cleaves -Phe-|-Asp- and -Asp-|-Asp- bonds in 2S albumin from plant seeds.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1722454">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/1722454"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/1722454"/>
</rdf:Description>
