</rdf:Description>
<rdf:Description rdf:about="2.5.1.96">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>4,4'-diapophytoene synthase</skos:prefLabel>
<skos:altLabel>C30 carotene synthase</skos:altLabel>
<skos:altLabel>DAP synthase</skos:altLabel>
<skos:altLabel>dehydrosqualene synthase</skos:altLabel>
<activity rdf:resource="2.5.1.96#SIP40385309C3EAF9CA"/>
<rdfs:comment>Typical of Staphylococcus aureus and some other bacteria such as Heliobacillus sp.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12426357"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16020541"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16269684"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18276850"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.96#SIP40385309C3EAF9CA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 (2E,6E)-farnesyl diphosphate = 15-cis-4,4'-diapophytoene + 2 diphosphate.</rdfs:label>
</rdf:Description>
