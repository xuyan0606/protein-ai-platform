<skos:prefLabel>(+)-O-methylkolavelool synthase</skos:prefLabel>
<activity rdf:resource="2.1.1.347#SIPEA03730599A2FF49"/>
<rdfs:comment>Isolated from the bacterium Herpetosiphon aurantiacus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25694050"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
