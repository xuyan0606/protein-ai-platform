<skos:prefLabel>polyamine oxidase (propane-1,3-diamine-forming)</skos:prefLabel>
<skos:altLabel>maize PAO</skos:altLabel>
<skos:altLabel>MPAO</skos:altLabel>
<activity rdf:resource="1.5.3.14#SIP81DE898A65D1A3F2"/>
<activity rdf:resource="1.5.3.14#SIP4DCD20E7B39C165F"/>
<activity rdf:resource="1.5.3.14#SIPC0A195E8C9DE8B08"/>
<rdfs:comment>As the products of the reaction cannot be converted directly to other polyamines, this class of polyamine oxidases is considered to be involved in the terminal catabolism of polyamines.</rdfs:comment>
<rdfs:comment>Catalyzes less efficiently the oxidation of N(1)-acetylspermine and spermine.</rdfs:comment>
<rdfs:comment>Differs in specificity from EC 1.5.3.13, EC 1.5.3.15, EC 1.5.3.16 and EC 1.5.3.17.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9598979"/>
<rdfs:subClassOf rdf:resource="1.5.3.-"/>
<skos:broaderTransitive rdf:resource="1.5.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.3.14#SIP81DE898A65D1A3F2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O2 + spermidine = 4-aminobutanal + H2O2 + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.3.14#SIP4DCD20E7B39C165F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + O2 + spermine = H2O2 + N-(3-aminopropyl)-4-aminobutanal + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.3.14#SIPC0A195E8C9DE8B08">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N(1)-acetylspermine + O2 = H2O2 + N-(3-acetamidopropyl)-4-aminobutanal + propane-1,3-diamine.</rdfs:label>
</rdf:Description>
