</rdf:Description>
<rdf:Description rdf:about="1.14.19.61">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dihydrorhizobitoxine desaturase</skos:prefLabel>
<activity rdf:resource="1.14.19.61#SIPB5D65B98E2E9C9B1"/>
<rdfs:comment>The enzyme, characterized from the bacterium Bradyrhizobium elkanii, catalyzes the final step in the biosynthesis of the nodulation enhancer compound rhizobitoxine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11679318"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14711685"/>
<rdfs:subClassOf rdf:resource="1.14.19.-"/>
<skos:broaderTransitive rdf:resource="1.14.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.19.61#SIPB5D65B98E2E9C9B1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dihydrorhizobitoxine + 2 H(+) + O2 + 2 reduced [2Fe-2S]-[ferredoxin] = 2 H2O + 2 oxidized [2Fe-2S]-[ferredoxin] + rhizobitoxine.</rdfs:label>
</rdf:Description>
