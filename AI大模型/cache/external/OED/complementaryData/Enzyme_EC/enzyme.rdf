<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + NADH + O2 + thymine = (Z)-2-methylureidoacrylate + FMN + H(+) + H2O + NAD(+).</rdfs:label>
</rdf:Description>
