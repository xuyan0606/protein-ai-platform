<rdf:Description rdf:about="1.13.11.61">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>linolenate 9R-lipoxygenase</skos:prefLabel>
<skos:altLabel>(9R)-LOX</skos:altLabel>
<skos:altLabel>linoleate 9R-dioxygenase</skos:altLabel>
<activity rdf:resource="1.13.11.61#SIP6D7E7A073537765C"/>
<activity rdf:resource="1.13.11.61#SIP4B98E22C7F10D775"/>
<rdfs:comment>In cyanobacteria the enzyme is involved in oxylipin biosynthesis.</rdfs:comment>
<rdfs:comment>The enzyme also converts linoleate to (9R,10E,12Z)-9-hydroperoxyoctadeca-10,12-dienoate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18031288"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18439634"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20043865"/>
<rdfs:subClassOf rdf:resource="1.13.11.-"/>
<skos:broaderTransitive rdf:resource="1.13.11.-"/>
</rdf:Description>
