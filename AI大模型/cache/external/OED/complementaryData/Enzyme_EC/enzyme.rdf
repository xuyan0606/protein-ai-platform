<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 Fe(III)-[cytochrome c] + H2O + pseudooxynicotine = 4-oxo-4-(pyridin-3-yl)butanal + 2 Fe(II)-[cytochrome c] + 2 H(+) + methylamine.</rdfs:label>
</rdf:Description>
