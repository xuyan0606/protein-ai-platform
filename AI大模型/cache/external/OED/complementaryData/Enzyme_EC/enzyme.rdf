</rdf:Description>
<rdf:Description rdf:about="3.5.1.70#SIPD5A1307A79DAF051">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of the amide bond in aculeacin A and related neutral lipopeptide antibiotics, releasing the long-chain fatty acid side-chain.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2760018">
