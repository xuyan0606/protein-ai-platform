<rdf:Description rdf:about="2.5.1.97">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>pseudaminic acid synthase</skos:prefLabel>
<activity rdf:resource="2.5.1.97#SIPC87943A107256E61"/>
<rdfs:comment>The enzyme requires a divalent metal ion, the highest activity values are observed in the presence of Mn(2+) and CO(2+) (10 mM).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16120604"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.97#SIPC87943A107256E61">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,4-diacetamido-2,4,6-trideoxy-beta-L-altrose + H2O + phosphoenolpyruvate = phosphate + pseudaminate.</rdfs:label>
</rdf:Description>
