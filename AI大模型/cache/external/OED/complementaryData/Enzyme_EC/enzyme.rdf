<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/3228235"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/3228235"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cysteine-conjugate transaminase</skos:prefLabel>
<activity rdf:resource="2.6.1.75#SIPA1C5920C201DF459"/>
<rdfs:comment>A number of cysteine conjugates can also act.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2852419"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.75#SIPA1C5920C201DF459">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + S-(4-bromophenyl)-L-cysteine = 3-((4-bromophenyl)sulfanyl)-2-oxopropanoate + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2852419">
