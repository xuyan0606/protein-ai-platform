<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + H(+) + molybdopterin = adenylyl-molybdopterin + diphosphate.</rdfs:label>
</rdf:Description>
