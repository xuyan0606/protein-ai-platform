<rdf:Description rdf:about="2.3.1.263">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-amino-4-oxopentanoate thiolase</skos:prefLabel>
<skos:altLabel>2-amino-4-ketopentanoate thiolase</skos:altLabel>
<skos:altLabel>AKP thiolase</skos:altLabel>
<activity rdf:resource="2.3.1.263#SIP1D4FCE054565C7A4"/>
<rdfs:comment>The enzyme, characterized from the bacterium Clostridium sticklandii, is part of a degradation pathway of ornithine.</rdfs:comment>
<rdfs:comment>It is specific for acetyl-CoA and D-alanine.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4407783"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19251850"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.263#SIP1D4FCE054565C7A4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + D-alanine = (2R)-2-amino-4-oxopentanoate + CoA.</rdfs:label>
</rdf:Description>
