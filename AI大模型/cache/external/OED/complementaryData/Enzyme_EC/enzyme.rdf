<rdf:Description rdf:about="2.3.1.85">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>fatty-acid synthase system</skos:prefLabel>
<skos:altLabel>fatty-acid synthase</skos:altLabel>
<activity rdf:resource="2.3.1.85#SIP2FC87BE3D20B878A"/>
<rdfs:comment>The animal enzyme is a multifunctional protein catalyzing the reactions of EC 2.3.1.38, EC 2.3.1.39, EC 2.3.1.41, EC 1.1.1.100, EC 4.2.1.59, EC 1.3.1.39 and EC 3.1.2.14. cf. EC 2.3.1.86.</rdfs:comment>
