<skos:prefLabel>aklanonic acid methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.288#SIP7B689FE1001B1E81"/>
<rdfs:comment>The enzyme from the Gram-positive bacterium Streptomyces sp. C5 is involved in the biosynthesis of the anthracycline daunorubicin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7836284"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
