<rdf:Description rdf:about="3.2.1.177">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>alpha-D-xyloside xylohydrolase</skos:prefLabel>
<skos:altLabel>alpha-xylosidase</skos:altLabel>
<activity rdf:resource="3.2.1.177#SIP140AFBC9F49E970A"/>
<rdfs:comment>The enzyme catalyzes hydrolysis of a terminal, unsubstituted xyloside at the extreme reducing end of a xylogluco-oligosaccharide.</rdfs:comment>
<rdfs:comment>Representative alpha-xylosidases from glycoside hydrolase family 31 utilize a two-step (double-displacement) mechanism involving a covalent glycosyl-enzyme intermediate, and retain the anomeric configuration of the product.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10801892"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11402218"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11859845"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15501829"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16267099"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16631751"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21426303"/>
<rdfs:subClassOf rdf:resource="3.2.1.-"/>
<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.177#SIP140AFBC9F49E970A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of terminal, non-reducing alpha-D-xylose residues with release of alpha-D-xylose.</rdfs:label>
</rdf:Description>
