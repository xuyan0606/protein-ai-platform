<activity rdf:resource="3.1.3.89#SIP368AFD85FA937A5A"/>
<rdfs:comment>The enzyme, characterized from the bacterium Escherichia coli, shows strict specificity toward deoxyribonucleoside 5'-monophosphates and does not dephosphorylate 5'-ribonucleotides or ribonucleoside 3'-monophosphates.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15489502"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18353368"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
