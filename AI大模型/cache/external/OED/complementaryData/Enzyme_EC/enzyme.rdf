<activity rdf:resource="3.1.2.25#SIP184C95897442BD28"/>
<rdfs:comment>This is the second step in the conversion of phenylacetyl-CoA to phenylglyoxylate, the first step being carried out by EC 1.17.5.1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9575237"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10336636"/>
<rdfs:subClassOf rdf:resource="3.1.2.-"/>
<skos:broaderTransitive rdf:resource="3.1.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.2.25#SIP184C95897442BD28">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + phenylglyoxylyl-CoA = CoA + H(+) + phenylglyoxylate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9575237">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9575237"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9575237"/>
</rdf:Description>
