<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>dodecanoate + O2 + reduced [NADPH--hemoprotein reductase] = 7-hydroxydodecanoate + H(+) + H2O + oxidized [NADPH--hemoprotein reductase].</rdfs:label>
</rdf:Description>
