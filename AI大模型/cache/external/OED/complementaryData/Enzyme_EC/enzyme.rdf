<skos:altLabel>beta-apo-4'-carotenal oxygenase</skos:altLabel>
<activity rdf:resource="1.2.1.82#SIP87E6B8EC0298445F"/>
<rdfs:comment>Neurosporaxanthin is responsible for the orange color of of Neurospora.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18627463"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21749649"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.82#SIP87E6B8EC0298445F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4'-apo-beta-carotenal + H2O + NAD(+) = 2 H(+) + NADH + neurosporaxanthin.</rdfs:label>
</rdf:Description>
