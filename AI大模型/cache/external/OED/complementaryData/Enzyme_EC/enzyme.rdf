<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2,3-epoxy-2,3-dihydrobenzoyl-CoA + 2 H2O = (3Z)-6-oxohex-3-enoyl-CoA + formate + H(+).</rdfs:label>
</rdf:Description>
