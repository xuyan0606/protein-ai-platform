<skos:altLabel>polyphosphoric acid kinase</skos:altLabel>
<activity rdf:resource="2.7.4.1#SIP809D1E75C7BD076F"/>
<rdfs:comment>The enzyme is responsible for the synthesis of most of the cellular polyphosphate, using the terminal phosphate of ATP as substrate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2164013"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8962061"/>
