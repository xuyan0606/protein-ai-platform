<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a secondary aliphatic amine + H2O + O2 = a primary amine + an aldehyde + H2O2.</rdfs:label>
</rdf:Description>
