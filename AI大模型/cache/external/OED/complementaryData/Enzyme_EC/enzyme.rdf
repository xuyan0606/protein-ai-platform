</rdf:Description>
<rdf:Description rdf:about="3.5.1.113">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2'''-acetyl-6'''-hydroxyneomycin C deacetylase</skos:prefLabel>
<activity rdf:resource="3.5.1.113#SIP0E67671B84F79060"/>
<rdfs:comment>Involved in the biosynthetic pathway of aminoglycoside antibiotics of the neomycin family.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Streptomyces fradiae also catalyzes EC 3.5.1.112.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18311744"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.1.113#SIP0E67671B84F79060">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2'''-acetyl-6'''-hydroxyneomycin C + H2O = 6'''-deamino-6'''-hydroxyneomycin C + acetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18311744">
