<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + O2 + scopoletin = CO2 + fraxetin + succinate.</rdfs:label>
</rdf:Description>
