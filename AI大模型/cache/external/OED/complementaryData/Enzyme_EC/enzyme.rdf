<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>chorismatase</skos:prefLabel>
<skos:altLabel>chorismate/3,4-dihydroxycyclohexa-1,5-dienoate synthase</skos:altLabel>
<activity rdf:resource="3.3.2.13#SIP392C5D5BE3DB2A2C"/>
<rdfs:comment>The enzyme found in several bacterial species is involved in the biosynthesis of macrocyclic polyketides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21383123"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24036425"/>
<rdfs:subClassOf rdf:resource="3.3.2.-"/>
<skos:broaderTransitive rdf:resource="3.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.3.2.13#SIP392C5D5BE3DB2A2C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>chorismate + H2O = (3R,4R)-3,4-dihydroxy-3,4-dihydrobenzoate + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21383123">
