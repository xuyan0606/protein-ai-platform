<skos:broaderTransitive rdf:resource="3.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.2.1.143#SIPA707C3DF383A473F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[(1''->2')-ADP-alpha-D-ribose](n) + H2O = [(1''->2')-ADP-alpha-D-ribose](n-1) + ADP-D-ribose.</rdfs:label>
</rdf:Description>
