<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>AH2 + ATP + S-sulfanyl-L-cysteinyl-[protein] + uridine(34) in tRNA = 2-thiouridine(34) in tRNA + A + AMP + diphosphate + H(+) + L-cysteinyl-[protein].</rdfs:label>
</rdf:Description>
