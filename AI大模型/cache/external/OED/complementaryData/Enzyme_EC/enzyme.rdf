</rdf:Description>
<rdf:Description rdf:about="4.2.3.157">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(+)-isoafricanol synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.157#SIP6918B4E561202D74"/>
<rdfs:comment>(+)-Isoafricanol is a sesquiterpene alcohol.</rdfs:comment>
<rdfs:comment>Its synthesis has been shown to occur in the bacteria Streptomyces violaceusniger and S.malaysiensis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24626486"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28247907"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.157#SIP6918B4E561202D74">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl diphosphate + H2O = (+)-isoafricanol + diphosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24626486">
