<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>EDTA + 2 FMNH2 + 2 O2 = ethylenediaminediacetate + 2 FMN + 2 glyoxylate + 3 H(+) + 2 H2O.</rdfs:label>
</rdf:Description>
