<rdf:Description rdf:about="2.6.1.72#SIP3830DA6959501D86">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + D-4-hydroxyphenylglycine = 4-hydroxyphenylglyoxylate + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.73">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methionine--glyoxylate transaminase</skos:prefLabel>
<skos:altLabel>MGAT</skos:altLabel>
<activity rdf:resource="2.6.1.73#SIP1B57F0D9FC66C55C"/>
<rdfs:comment>L-Glutamate can also act as donor.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.73#SIP1B57F0D9FC66C55C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>glyoxylate + L-methionine = 4-methylsulfanyl-2-oxobutanoate + glycine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.74">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cephalosporin-C transaminase</skos:prefLabel>
<skos:altLabel>cephalosporin C aminotransferase</skos:altLabel>
<activity rdf:resource="2.6.1.74#SIPEE2EDD6CBC9E4AAE"/>
<rdfs:comment>A number of D-amino acids, including D-alanine, D-aspartate and D-methionine can also act as amino-group donors.</rdfs:comment>
<rdfs:comment>Although this enzyme acts on several free D-amino acids, it differs from EC 2.6.1.21 in that it can use cephalosporin C as an amino donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/3228235"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.74#SIPEE2EDD6CBC9E4AAE">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(7R)-7-(5-carboxy-5-oxopentanamido)deacetylcephalosporanate + D-glutamate = 2-oxoglutarate + cephalosporin C.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/3228235">
