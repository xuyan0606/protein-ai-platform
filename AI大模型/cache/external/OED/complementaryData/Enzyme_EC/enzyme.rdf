<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-O-(1Z-alkenyl)-sn-glycero-3-phosphoethanolamine + an acyl-CoA = 1-O-(1Z-alkenyl)-2-acyl-sn-glycero-3-phosphoethanolamine + CoA.</rdfs:label>
</rdf:Description>
