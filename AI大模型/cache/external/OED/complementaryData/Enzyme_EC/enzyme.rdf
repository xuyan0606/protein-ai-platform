</rdf:Description>
<rdf:Description rdf:about="4.1.1.105">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>L-tryptophan decarboxylase</skos:prefLabel>
<activity rdf:resource="4.1.1.105#SIP99E6A32163E3EDE1"/>
<rdfs:comment>The enzyme has been characterized from bacteria, plants, and fungi.</rdfs:comment>
<rdfs:comment>Unlike EC 4.1.1.28 this enzyme is specific for L-typtophan.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4036551"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4441405"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9225462"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24310513"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28763571"/>
<rdfs:subClassOf rdf:resource="4.1.1.-"/>
<skos:broaderTransitive rdf:resource="4.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.1.1.105#SIP99E6A32163E3EDE1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + L-tryptophan = CO2 + tryptamine.</rdfs:label>
</rdf:Description>
