<skos:altLabel>24-sterol C-methyltransferase</skos:altLabel>
<skos:altLabel>Delta(24)-methyltransferase</skos:altLabel>
<skos:altLabel>Delta(24)-sterol methyltransferase</skos:altLabel>
<skos:altLabel>phytosterol methyltransferase</skos:altLabel>
<skos:altLabel>S-adenosyl-4-methionine:sterol Delta(24)-methyltransferase</skos:altLabel>
