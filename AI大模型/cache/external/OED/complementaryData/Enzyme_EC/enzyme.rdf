</rdf:Description>
<rdf:Description rdf:about="2.1.1.385">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>[methyl-Co(III) methoxylated-aromatic-compound-specific corrinoid protein]--tetrahydrofolate methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.385#SIPF860D6D07455A8EA"/>
<rdfs:comment>The enzyme, found in acetogenic bacteria, participates in a pathway for the degradation of methoxylated aromatic compounds (methoxydotrophic growth).</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the transfer of a methyl group bound to the cobalt cofactor of a dedicated corrinoid protein (MtvC) to tetrahydrofolate. cf. EC 2.1.1.384.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9654069"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11344134"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18631365"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.385#SIPF860D6D07455A8EA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-5,6,7,8-tetrahydrofolate + methyl-Co(III)-[methoxylated-aromatic-compound-specific corrinoid protein] = (6S)-5-methyl-5,6,7,8-tetrahydrofolate + Co(I)-[methoxylated-aromatic-compound-specific corrinoid protein] + H(+).</rdfs:label>
</rdf:Description>
