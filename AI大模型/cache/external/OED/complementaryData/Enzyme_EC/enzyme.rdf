<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.226#SIP403643F940BCDE76">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-1-pyrroline-5-carboxylate + H(+) + H2O + malonyl-CoA = (2S,5S)-5-carboxymethylproline + CO2 + CoA.</rdfs:label>
</rdf:Description>
