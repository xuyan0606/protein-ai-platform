<rdf:Description rdf:about="2.4.1.251">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GlcA-beta-(1->2)-D-Man-alpha-(1->3)-D-Glc-beta-(1->4)-D-Glc-alpha-1-diphospho-ditrans,octacis-undecaprenol 4-beta-mannosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.251#SIP8EE65D0A096FEEA1"/>
<rdfs:comment>The enzyme is involved in the biosynthesis of the exopolysaccharide xanthan.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7683019"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9537354"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18854951"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.251#SIP8EE65D0A096FEEA1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-D-GlcA-(1->2)-alpha-D-Man-(1->3)-beta-D-Glc-(1->4)-alpha-D-Glc-di-trans,octa-cis-undecaprenyl diphosphate + GDP-alpha-D-mannose = beta-D-Man-(1->4)-beta-D-GlcA-(1->2)-alpha-D-Man-(1->3)-beta-D-Glc-(1->4)-alpha-D-Glc-di-trans,octa-cis-undecaprenyl diphosphate + GDP + H(+).</rdfs:label>
</rdf:Description>
