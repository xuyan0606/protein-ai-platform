<citation rdf:resource="http://purl.uniprot.org/citations/4351810"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8334169"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
