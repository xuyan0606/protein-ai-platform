<skos:prefLabel>UDP-N-acetylgalactosamine diphosphorylase</skos:prefLabel>
<activity rdf:resource="2.7.7.83#SIPD48A690A3FC8B2E3"/>
<rdfs:comment>The enzyme from plants and animals also has activity toward N-acetyl-alpha-D-glucosamine 1-phosphate (cf. EC 2.7.7.23).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9765219"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11707391"/>
