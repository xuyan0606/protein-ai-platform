<rdf:Description rdf:about="2.1.1.16">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>methylene-fatty-acyl-phospholipid synthase</skos:prefLabel>
<skos:altLabel>cyclopropane synthetase</skos:altLabel>
<skos:altLabel>unsaturated-phospholipid methyltransferase</skos:altLabel>
<activity rdf:resource="2.1.1.16#SIP58F1928177F9677C"/>
<rdfs:comment>The enzyme transfers a methyl group to the 10-position of a Delta(9)-olefinic acyl chain in phosphatidylglycerol, phosphatidylinositol, or, more slowly, phosphatidylethanolamine; subsequent proton transfer produces a 10-methylene group (cf. EC 2.1.1.79).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4313604"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.16#SIP58F1928177F9677C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>1-acyl-2-(9Z)-enoyl-sn-glycero-3-phospholipid + S-adenosyl-L-methionine = 1-acyl-2-(10-methylene)-acyl-sn-glycero-3-phospholipid + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
