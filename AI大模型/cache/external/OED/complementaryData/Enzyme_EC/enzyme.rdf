<rdf:Description rdf:about="1.4.3.23">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>7-chloro-L-tryptophan oxidase</skos:prefLabel>
<activity rdf:resource="1.4.3.23#SIP37B397E2773A3858"/>
<activity rdf:resource="1.4.3.23#SIPB1495A780AA95E2D"/>
<rdfs:comment>This enzyme catalyzes a step in the biosynthesis of rebeccamycin, an indolocarbazole alkaloid produced by the bacterium Lechevalieria aerocolonigenes.</rdfs:comment>
<rdfs:comment>During catalysis, the bound FAD is reoxidized at the expense of molecular oxygen, producing one molecule of hydrogen peroxide.</rdfs:comment>
<rdfs:comment>The enzyme shows significant preference for 7-chloro-L-tryptophan over L-tryptophan.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15743957"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16313168"/>
<rdfs:subClassOf rdf:resource="1.4.3.-"/>
<skos:broaderTransitive rdf:resource="1.4.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.23#SIP37B397E2773A3858">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7-chloro-L-tryptophan + O2 = 3-(7-chloroindol-3-yl)-2-iminopropanoate + H2O2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.23#SIPB1495A780AA95E2D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-tryptophan + O2 = 2-iminio-3-(indol-3-yl)propanoate + H2O2.</rdfs:label>
</rdf:Description>
