<skos:prefLabel>glycoprotein 2-beta-D-xylosyltransferase</skos:prefLabel>
<skos:altLabel>beta1,2-xylosyltransferase</skos:altLabel>
<activity rdf:resource="2.4.2.38#SIPEE69161BBEA8E4B7"/>
<rdfs:comment>Specific for N-linked oligosaccharides (N-glycans).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9395463"/>
