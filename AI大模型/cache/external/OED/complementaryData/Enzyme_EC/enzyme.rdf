</rdf:Description>
<rdf:Description rdf:about="2.1.1.351">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>nocamycin O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.351#SIP3628D32B516FFFF5"/>
<rdfs:comment>The enzyme, isolated from the bacterium Saccharothrix syringae, is involved in the biosynthesis of nocamycin I and nocamycin II.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/28818448"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.351#SIP3628D32B516FFFF5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>nocamycin E + S-adenosyl-L-methionine = nocamycin I + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/28818448">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/28818448"/>
