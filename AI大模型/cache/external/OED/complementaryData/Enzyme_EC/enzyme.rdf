<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22970855"/>
<dcterms:identifier>doi:10.1111/mmi.12038</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="3.4.19.16">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucosinolate gamma-glutamyl hydrolase</skos:prefLabel>
<activity rdf:resource="3.4.19.16#SIPC848615D077E1B42"/>
<activity rdf:resource="3.4.19.16#SIP2AAC3596093F704B"/>
<activity rdf:resource="3.4.19.16#SIP5CDC48FCE839F414"/>
<activity rdf:resource="3.4.19.16#SIP17D5F93B73A13DBF"/>
<rdfs:comment>This enzyme, characterized from the plant Arabidopsis thaliana, participates in the biosynthesis of the plant defense compounds glucosinolates and camalexin.</rdfs:comment>
<rdfs:comment>It is the only known plant enzyme capable of hydrolyzing the gamma-glutamyl residue of glutathione in the cytosol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21712415"/>
<rdfs:subClassOf rdf:resource="3.4.19.-"/>
<skos:broaderTransitive rdf:resource="3.4.19.-"/>
</rdf:Description>
