<rdf:Description rdf:about="1.3.1.115">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>3-oxocholoyl-CoA 4-desaturase</skos:prefLabel>
<skos:altLabel>3-oxo-choloyl-CoA dehydrogenase</skos:altLabel>
<activity rdf:resource="1.3.1.115#SIP6CFDE1697D7A35C1"/>
<activity rdf:resource="1.3.1.115#SIPACBDB54DD63E53BA"/>
<rdfs:comment>The enzyme, characterized from the bacterium Clostridium scindens, participates in the bile acid 7alpha-dehydroxylation pathway.</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the stereo-specific oxidation of its substrates and has no activity with the 7beta anomers. cf. EC 1.3.1.116.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18047844"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.115#SIP6CFDE1697D7A35C1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7alpha,12alpha-dihydroxy-3-oxochol-24-oyl-CoA + NAD(+) = 7alpha,12alpha-dihydroxy-3-oxochol-4-en-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.115#SIPACBDB54DD63E53BA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>7alpha-hydroxy-3-oxochol-24-oyl-CoA + NAD(+) = 7alpha-hydroxy-3-oxochol-4-en-24-oyl-CoA + H(+) + NADH.</rdfs:label>
</rdf:Description>
