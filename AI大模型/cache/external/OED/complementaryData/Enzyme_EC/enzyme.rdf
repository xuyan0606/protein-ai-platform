<citation rdf:resource="http://purl.uniprot.org/citations/8990272"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9772191"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10480865"/>
<rdfs:subClassOf rdf:resource="1.5.1.-"/>
<skos:broaderTransitive rdf:resource="1.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.1.38#SIPAD05C3AE5B78A5AC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FMNH2 + NADP(+) = FMN + 2 H(+) + NADPH.</rdfs:label>
</rdf:Description>
