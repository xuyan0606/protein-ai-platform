<rdf:Description rdf:about="1.14.14.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>resorcinol 4-hydroxylase (FADH2)</skos:prefLabel>
<activity rdf:resource="1.14.14.27#SIPCA42E60B014DBADA"/>
<rdfs:comment>The enzyme, characterized from the bacterium Rhizobium sp. strain MTP-10005, uses FADH2 as a substrate rather than a cofactor.</rdfs:comment>
<rdfs:comment>FADH2 is provided by a dedicated EC 1.5.1.36.</rdfs:comment>
<rdfs:comment>The enzyme participates in the degradation of alpha-resorcylate and resorcinol. Cf. EC 1.14.13.219 and EC 1.14.13.220.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1280"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17158677"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.27#SIPCA42E60B014DBADA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>FADH2 + O2 + resorcinol = benzene-1,2,4-triol + FAD + H(+) + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1280">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
