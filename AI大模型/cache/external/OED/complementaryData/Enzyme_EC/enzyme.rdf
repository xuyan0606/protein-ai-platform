<skos:prefLabel>2-dehydro-3,6-dideoxy-6-sulfogluconate aldolase</skos:prefLabel>
<skos:altLabel>KDSG aldolase</skos:altLabel>
<activity rdf:resource="4.1.2.58#SIP4D4604454E8DD91A"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudomonas putida SQ1, participates in a sulfoquinovose degradation pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26195800"/>
<rdfs:subClassOf rdf:resource="4.1.2.-"/>
<skos:broaderTransitive rdf:resource="4.1.2.-"/>
</rdf:Description>
