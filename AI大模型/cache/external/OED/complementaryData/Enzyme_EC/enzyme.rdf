<rdf:Description rdf:about="4.2.3.114">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>gamma-terpinene synthase</skos:prefLabel>
<activity rdf:resource="4.2.3.114#SIPF4FADDCA9A422DB4"/>
<rdfs:comment>Isolated from Thymus vulgaris (thyme), Citrus limon (lemon), Citrus unshiu (satsuma) and Origanum vulgare (oregano).</rdfs:comment>
<rdfs:comment>The reaction involves a 1,2-hydride shift.</rdfs:comment>
<rdfs:comment>The 5-pro-S hydrogen of geranyl diphosphate is lost.</rdfs:comment>
<rdfs:comment>Traces of several other monoterpenoids are formed in addition to gamma-terpinene.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1897973"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8460944"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12084056"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15630174"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20419468"/>
<rdfs:subClassOf rdf:resource="4.2.3.-"/>
<skos:broaderTransitive rdf:resource="4.2.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.3.114#SIPF4FADDCA9A422DB4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E)-geranyl diphosphate = diphosphate + gamma-terpinene.</rdfs:label>
</rdf:Description>
