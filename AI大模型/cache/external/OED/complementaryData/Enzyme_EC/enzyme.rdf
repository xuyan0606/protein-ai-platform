</rdf:Description>
<rdf:Description rdf:about="3.1.1.99">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>6-deoxy-6-sulfogluconolactonase</skos:prefLabel>
<skos:altLabel>SGL lactonase</skos:altLabel>
<activity rdf:resource="3.1.1.99#SIP5E9BDEF9694E5619"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudomonas putida SQ1, participates in a sulfoquinovose degradation pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26195800"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.99#SIP5E9BDEF9694E5619">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-deoxy-6-sulfo-D-glucono-1,5-lactone + H2O = 6-deoxy-6-sulfo-D-gluconate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/26195800">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/26195800"/>
