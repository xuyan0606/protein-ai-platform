<rdf:Description rdf:about="3.5.4.37">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>double-stranded RNA adenine deaminase</skos:prefLabel>
<skos:altLabel>double-stranded RNA adenosine deaminase</skos:altLabel>
<skos:altLabel>double-stranded RNA-specific adenosine deaminase</skos:altLabel>
<skos:altLabel>dsRNA adenosine deaminase</skos:altLabel>
<activity rdf:resource="3.5.4.37#SIPCB88B4D4CF410F0A"/>
<rdfs:comment>This eukaryotic enzyme is involved in RNA editing.</rdfs:comment>
<rdfs:comment>It destabilizes double-stranded RNA through conversion of adenosine to inosine.</rdfs:comment>
<rdfs:comment>Inositol hexakisphosphate is required for activity.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8144588"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9614652"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11421361"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16141067"/>
<rdfs:subClassOf rdf:resource="3.5.4.-"/>
<skos:broaderTransitive rdf:resource="3.5.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.5.4.37#SIPCB88B4D4CF410F0A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine in double-stranded RNA + H(+) + H2O = inosine in double-stranded RNA + NH4(+).</rdfs:label>
</rdf:Description>
