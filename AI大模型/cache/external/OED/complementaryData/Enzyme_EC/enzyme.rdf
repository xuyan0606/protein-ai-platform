<rdf:Description rdf:about="1.14.18.5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.169"/>
<skos:prefLabel>sphingolipid C4-monooxygenase</skos:prefLabel>
<skos:altLabel>sphinganine C4-monooxygenase</skos:altLabel>
<skos:altLabel>sphingolipid C4-hydroxylase</skos:altLabel>
<activity rdf:resource="1.14.18.5#SIP838CBB5B2DBF0294"/>
<activity rdf:resource="1.14.18.5#SIP83CB310B71DC9635"/>
<rdfs:comment>The enzyme, which belongs to the familiy of endoplasmic reticular cytochrome b5-dependent enzymes, is involved in the biosynthesis of sphingolipids in eukaryotes.</rdfs:comment>
<rdfs:comment>Some enzymes are bifunctional and also catalyze EC 1.14.19.17.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9368039"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9556590"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11297741"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11937514"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15063729"/>
