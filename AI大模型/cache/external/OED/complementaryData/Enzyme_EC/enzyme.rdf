<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(E)-isoeugenol + acetate + NADP(+) = (E)-coniferyl acetate + NADPH.</rdfs:label>
</rdf:Description>
