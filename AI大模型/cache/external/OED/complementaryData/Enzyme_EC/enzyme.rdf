<rdf:Description rdf:about="6.2.1.60">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>marinolic acid--CoA ligase</skos:prefLabel>
<activity rdf:resource="6.2.1.60#SIP21B6C67A8CDBA623"/>
<activity rdf:resource="6.2.1.60#SIPECE99FE818EBA64D"/>
<activity rdf:resource="6.2.1.60#SIPFE3185F880B91C11"/>
<activity rdf:resource="6.2.1.60#SIPAA10F5F2A049B44C"/>
<rdfs:comment>The enzyme, characterized from the bacterium Pseudoalteromonas sp. SANK 73390, catalyzes the CoA acylation of pseudomonic and marinolic acids, as part of the biosynthesis of thiomarinols and related compounds.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25726835"/>
<rdfs:subClassOf rdf:resource="6.2.1.-"/>
<skos:broaderTransitive rdf:resource="6.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.60#SIP21B6C67A8CDBA623">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + a marinolic acid + CoA = AMP + diphosphate + a marinoloyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.60#SIPECE99FE818EBA64D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + a pseudomonic acid + CoA = AMP + diphosphate + a pseudomonoyl-CoA.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.60#SIPFE3185F880B91C11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + CoA + marinolate C = AMP + diphosphate + marinoloyl-CoA C.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.2.1.60#SIPAA10F5F2A049B44C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + CoA + pseudomonate C = AMP + diphosphate + pseudomonoyl-CoA C.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/25726835">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
