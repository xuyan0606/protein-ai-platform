<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/10225425"/>
<dcterms:identifier>doi:10.1016/s0014-5793(99)00393-2</dcterms:identifier>
</rdf:Description>
