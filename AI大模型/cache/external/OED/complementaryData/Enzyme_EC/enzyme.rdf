<rdf:Description rdf:about="2.3.1.164">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>isopenicillin-N N-acyltransferase</skos:prefLabel>
<skos:altLabel>acyl-coenzyme A:6-aminopenicillanic-acid-acyltransferase</skos:altLabel>
<skos:altLabel>acyl-coenzyme A:isopenicillin N acyltransferase</skos:altLabel>
<skos:altLabel>isopenicillin N:acyl-CoA acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.164#SIP16514CB49AA814D0"/>
<rdfs:comment>Proceeds by a two stage mechanism via 6-aminopenicillanic acid.</rdfs:comment>
<rdfs:comment>Different from EC 3.5.1.11.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2120195"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8396910"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.164#SIP16514CB49AA814D0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + isopenicillin N + phenylacetyl-CoA = CoA + H(+) + L-2-aminoadipate + penicillin G.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2120195">
