<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-[(4R)-4-hydroxycyclohexa-1,5-dien-1-yl]-2-oxopropanoate = 3-[(1E,4R)-4-hydroxycyclohex-2-en-1-ylidene]pyruvate.</rdfs:label>
</rdf:Description>
