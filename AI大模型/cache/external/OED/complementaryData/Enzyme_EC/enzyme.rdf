<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 5'-end (N(7)-methyl 5'-triphosphoguanosine)-ribonucleoside in mRNA + H2O = a 5'-end diphospho-ribonucleoside in mRNA + 2 H(+) + N(7)-methyl-GMP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.6.1.59#SIP62988DB0F6188B01">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 5'-end (N(2),N(2),N(7)-trimethyl 5'-triphosphoguanosine)-(ribonucleoside) in mRNA + H2O = (N(2),N(2),N(7))-trimethyl-GMP + a 5'-end diphospho-ribonucleoside in mRNA + 2 H(+).</rdfs:label>
</rdf:Description>
