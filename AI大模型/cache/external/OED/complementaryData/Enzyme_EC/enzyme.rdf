<rdfs:label>H(+) + N-acetyl-alpha-D-muramate 1-phosphate + UDP = phosphate + UDP-N-acetyl-alpha-D-muramate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23831760">
