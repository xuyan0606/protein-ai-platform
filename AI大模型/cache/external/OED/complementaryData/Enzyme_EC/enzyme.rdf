<rdf:Description rdf:about="1.10.3.9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>photosystem II</skos:prefLabel>
<activity rdf:resource="1.10.3.9#SIPDDE2E7C672074F5C"/>
<activity rdf:resource="1.10.3.9#SIPADE758644915F28E"/>
<rdfs:comment>Contains chlorophyll a, beta-carotene, pheophytin, plastoquinone, a Mn4Ca cluster, heme and non-heme iron.</rdfs:comment>
<rdfs:comment>Four successive photoreactions, resulting in a storage of four positive charges, are required to oxidize two water molecules to one oxygen molecule.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/849432"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19219048"/>
<rdfs:subClassOf rdf:resource="1.10.3.-"/>
<skos:broaderTransitive rdf:resource="1.10.3.-"/>
</rdf:Description>
