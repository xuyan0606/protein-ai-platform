<rdf:Description rdf:about="2.1.1.n1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>resorcinol O-methyltransferase</skos:prefLabel>
<skos:altLabel>O-methyltransferase 12</skos:altLabel>
<activity rdf:resource="2.1.1.n1#SIP492882B76B3DFA8C"/>
<rdfs:comment>The enzyme from Dictyostelium discoideum is involed in modifying the resorcinolic back-bone of the differentiation regulating factor 4-methyl-5-pentylbenzene-1,3-diol.</rdfs:comment>
<rdfs:comment>It also shows activity toward 5-pentylbenzene-1,3-diol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18252726"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.n1#SIP492882B76B3DFA8C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>resorcinol + S-adenosyl-L-methionine = 3-methoxyphenol + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
