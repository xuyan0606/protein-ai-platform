<activity rdf:resource="2.5.1.101#SIP6874BA6AFA057E14"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18275154"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19282391"/>
