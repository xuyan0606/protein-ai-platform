<citation rdf:resource="http://purl.uniprot.org/citations/16964976"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19369258"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21188587"/>
<rdfs:subClassOf rdf:resource="1.5.3.-"/>
<skos:broaderTransitive rdf:resource="1.5.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.3.10#SIP2B80A05235665CCC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(6S)-5,6,7,8-tetrahydrofolate + N,N-dimethylglycine + O2 = (6R)-5,10-methylene-5,6,7,8-tetrahydrofolate + H2O2 + sarcosine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.5.3.10#SIP40142604337F90E0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + N,N-dimethylglycine + O2 = formaldehyde + H2O2 + sarcosine.</rdfs:label>
</rdf:Description>
