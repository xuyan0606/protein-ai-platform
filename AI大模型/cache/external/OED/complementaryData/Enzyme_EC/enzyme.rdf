<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GDP-valienol + validamine 7-phosphate = GDP + H(+) + validoxylamine A 7'-phosphate.</rdfs:label>
</rdf:Description>
