<activity rdf:resource="3.5.1.118#SIP0B194E39E6BBC5B8"/>
<rdfs:comment>The enzyme is part of the biosynthesis pathway of ergothioneine in mycobacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20420449"/>
<rdfs:subClassOf rdf:resource="3.5.1.-"/>
<skos:broaderTransitive rdf:resource="3.5.1.-"/>
</rdf:Description>
