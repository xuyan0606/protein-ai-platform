<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-reticuline + S-adenosyl-L-methionine = (R)-laudanine + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
