<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23763543"/>
</rdf:Description>
<rdf:Description rdf:about="1.21.98.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.21.3.9"/>
<replaces rdf:resource="4.3.1.26"/>
<skos:prefLabel>dichlorochromopyrrolate synthase</skos:prefLabel>
<activity rdf:resource="1.21.98.2#SIP404140C12029C0D2"/>
<activity rdf:resource="1.21.98.2#SIPF1CFBD0F027861C1"/>
<rdfs:comment>This enzyme catalyzes a step in the biosynthesis of rebeccamycin, an indolocarbazole alkaloid produced by the bacterium Lechevalieria aerocolonigenes.</rdfs:comment>
<rdfs:comment>The enzyme is a dimeric heme-protein oxidase that catalyzes the oxidative dimerization of two L-tryptophan-derived molecules to form dichlorochromopyrrolic acid, the precursor for the fused six-ring indolocarbazole scaffold of rebeccamycin.</rdfs:comment>
<rdfs:comment>In vivo the enzyme uses hydrogen peroxide, formed by the enzyme upstream in the biosynthetic pathway (EC 1.4.3.23) as the electron acceptor.</rdfs:comment>
<rdfs:comment>However, the enzyme is also able to catalyze the reaction using molecular oxygen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16313168"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16417354"/>
<citation rdf:resource="http://purl.uniprot.org/citations/25837855"/>
<rdfs:subClassOf rdf:resource="1.21.98.-"/>
<skos:broaderTransitive rdf:resource="1.21.98.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.21.98.2#SIP404140C12029C0D2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 3-(7-chloroindol-3-yl)-2-iminopropanoate + H2O2 = dichlorochromopyrrolate + H(+) + 2 H2O + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.21.98.2#SIPF1CFBD0F027861C1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 2-iminio-3-(indol-3-yl)propanoate + H2O2 = chromopyrrolate + H(+) + 2 H2O + NH4(+).</rdfs:label>
</rdf:Description>
