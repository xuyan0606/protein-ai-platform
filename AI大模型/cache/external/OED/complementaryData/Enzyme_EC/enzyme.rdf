<rdf:Description rdf:about="3.1.3.69">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glucosylglycerol 3-phosphatase</skos:prefLabel>
<activity rdf:resource="3.1.3.69#SIP1007ED80578042C1"/>
<rdfs:comment>Acts with EC 2.4.1.213 to form glucosylglycerol, an osmolyte that endows cyanobacteria with resistance to salt.</rdfs:comment>
