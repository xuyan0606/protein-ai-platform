<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a ganglioside GM3 (d18:1(4E)) + UDP-N-acetyl-alpha-D-galactosamine = a beta-D-GalNAc-(1->4)-alpha-Neu5Ac-(2->3)-beta-D-Gal-(1->4)-beta-D-Glc-(1&lt;->1)-Cer + H(+) + UDP.</rdfs:label>
</rdf:Description>
