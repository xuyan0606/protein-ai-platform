<rdf:Description rdf:about="1.2.1.75">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>malonyl CoA reductase (malonate semialdehyde-forming)</skos:prefLabel>
<skos:altLabel>malonyl CoA reductase (NADP)</skos:altLabel>
<skos:altLabel>NADP-dependent malonyl CoA reductase</skos:altLabel>
<activity rdf:resource="1.2.1.75#SIP5CB049759DEE0C33"/>
<rdfs:comment>Catalyzes the reduction of malonyl-CoA to malonate semialdehyde, a key step in the 3-hydroxypropanoate and the 3-hydroxypropanoate/4-hydroxybutyrate cycles, autotrophic CO2 fixation pathways found in some green non-sulfur phototrophic bacteria and some thermoacidophilic archaea, respectively.</rdfs:comment>
<rdfs:comment>The enzyme from Sulfolobus tokodaii has been purified, and found to contain one RNA molecule per two subunits.</rdfs:comment>
<rdfs:comment>The enzyme from Chloroflexus aurantiacus is bifunctional, and also catalyzes the next reaction in the pathway, EC 1.1.1.298.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8354269"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11948153"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17041055"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18079405"/>
<rdfs:subClassOf rdf:resource="1.2.1.-"/>
<skos:broaderTransitive rdf:resource="1.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.2.1.75#SIP5CB049759DEE0C33">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-oxopropanoate + CoA + NADP(+) = H(+) + malonyl-CoA + NADPH.</rdfs:label>
</rdf:Description>
