<rdf:Description rdf:about="1.14.14.181">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sulfoquinovose monooxygenase</skos:prefLabel>
<skos:altLabel>6-deoxy-6-sulfo-D-glucose monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.181#SIP980F05743B310303"/>
<rdfs:comment>The enzyme, characterized from the bacteria Agrobacterium fabrum and Rhizobium oryzae, is involved in a D-sulfoquinovose degradation pathway.</rdfs:comment>
<rdfs:comment>FMNH2 is provided by an associated FMN reductase (EC 1.5.1.42).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/SIPA92E437F3CD7880E"/>
<citation rdf:resource="http://purl.uniprot.org/citations/35074914"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.14.181#SIP980F05743B310303">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>6-sulfo-D-quinovose + FMNH2 + O2 = 6-dehydro-D-glucose + FMN + 2 H(+) + H2O + sulfite.</rdfs:label>
</rdf:Description>
