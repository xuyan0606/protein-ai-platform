<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 A + all-trans-zeta-carotene = 2 AH2 + all-trans-lycopene.</rdfs:label>
</rdf:Description>
