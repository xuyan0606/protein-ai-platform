<rdfs:label>(6S)-6-hydroxyhyoscyamine + 2-oxoglutarate + O2 = CO2 + H(+) + H2O + scopolamine + succinate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.20.14">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hapalindole-type alkaloid chlorinase</skos:prefLabel>
<activity rdf:resource="1.14.20.14#SIP17975FE5A5FD00B7"/>
<activity rdf:resource="1.14.20.14#SIPDB81FFFF04FA1CAB"/>
<rdfs:comment>The enzyme, characterized from hapalindole-type alkaloids-producing cyanobacteria, is a specialized iron(II)/2-oxoglutarate-dependent oxygenase that catalyzes the chlorination of its substrates in a reaction that requires oxygen, chloride ions, ferrous iron and 2-oxoglutarate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/25218740"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26749394"/>
<citation rdf:resource="http://purl.uniprot.org/citations/27027281"/>
