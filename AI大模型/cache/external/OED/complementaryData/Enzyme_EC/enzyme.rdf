<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>AH2 + cholesterol + O2 = 25-hydroxycholesterol + A + H2O.</rdfs:label>
</rdf:Description>
