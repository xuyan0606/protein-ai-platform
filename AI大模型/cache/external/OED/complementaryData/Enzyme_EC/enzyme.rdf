<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + L-lysine = CoA + H(+) + N(6)-acetyl-L-lysine.</rdfs:label>
</rdf:Description>
