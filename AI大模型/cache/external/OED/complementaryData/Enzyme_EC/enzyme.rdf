<rdf:Description rdf:about="4.2.1.126">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.2.1.n1"/>
<skos:prefLabel>N-acetylmuramic acid 6-phosphate etherase</skos:prefLabel>
<skos:altLabel>MurNAc-6-P etherase</skos:altLabel>
<activity rdf:resource="4.2.1.126#SIP5785D4B39AFD1BA9"/>
<rdfs:comment>This enzyme, along with EC 2.7.1.170, is required for the utilization of anhydro-N-acetylmuramic acid in proteobacteria.</rdfs:comment>
<rdfs:comment>The substrate is either imported from the medium or derived from the bacterium's own cell wall murein during cell wall recycling.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15901686"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15983044"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16452451"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18049859"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18837509"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
