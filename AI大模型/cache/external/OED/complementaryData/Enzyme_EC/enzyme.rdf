<dcterms:identifier>doi:10.1016/j.jmb.2007.06.063</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>coenzyme gamma-F420-2:alpha-L-glutamate ligase</skos:prefLabel>
<activity rdf:resource="6.3.2.32#SIPE357E2FF9E989501"/>
<rdfs:comment>The enzyme caps the gamma-glutamyl tail of the hydride carrier coenzyme F420.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12909715"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
<skos:broaderTransitive rdf:resource="6.3.2.-"/>
