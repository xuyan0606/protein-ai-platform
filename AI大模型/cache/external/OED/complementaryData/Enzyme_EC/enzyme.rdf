<skos:prefLabel>N-terminal methionine N(alpha)-acetyltransferase NatE</skos:prefLabel>
<activity rdf:resource="2.3.1.258#SIPA5303F19BBC315E6"/>
<activity rdf:resource="2.3.1.258#SIP6705A8324620AB14"/>
<activity rdf:resource="2.3.1.258#SIP97F9B9CA2680FE76"/>
