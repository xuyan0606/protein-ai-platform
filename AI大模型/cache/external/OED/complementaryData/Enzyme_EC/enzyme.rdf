<rdf:Description rdf:about="2.4.1.369">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>enterobactin C-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.369#SIP1C60DE623779CE9F"/>
<activity rdf:resource="2.4.1.369#SIP3C1B8DCB1EE842B0"/>
<activity rdf:resource="2.4.1.369#SIP032362EFB0E9FD02"/>
<rdfs:comment>The enzyme, found in pathogenic strains of the bacteria Escherichia coli and Salmonella enterica, catalyzes the transfer of glucosyl groups to C-5 of one, two, or three of the 2,3-hydroxybenzoyl units of the siderophore enterobactin, forming C-glucosylated derivatives known as salmochelins.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15598734"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.369#SIP1C60DE623779CE9F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>enterobactin + UDP-alpha-D-glucose = monoglucosyl-enterobactin + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.369#SIP3C1B8DCB1EE842B0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>monoglucosyl-enterobactin + UDP-alpha-D-glucose = diglucosyl-enterobactin + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.369#SIP032362EFB0E9FD02">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>diglucosyl-enterobactin + UDP-alpha-D-glucose = H(+) + triglucosyl-enterobactin + UDP.</rdfs:label>
</rdf:Description>
