<rdf:Description rdf:about="6.3.2.62#SIP7BDA02A07C550A24">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>n ATP + [beta-tubulin]-L-glutamate + n L-glutamate = [beta-tubulin]-(gamma-(poly-alpha-L-glutamyl)-L-glutamyl)-L-glutamate + n ADP + n phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.62#SIPB80DC750D567F5DF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-glutamate + L-glutamyl-[beta-tubulin] = ADP + gamma-L-glutamyl-L-glutamyl-[beta-tubulin] + H(+) + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.62#SIP545DA38C3184FCE0">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + gamma-L-glutamyl-L-glutamyl-[beta-tubulin] + L-glutamate = ADP + H(+) + L-glutamyl-gamma-L-glutamyl-L-glutamyl-[beta-tubulin] + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.62#SIPA7F363A6770F6C22">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(L-glutamyl)(n)-gamma-L-glutamyl-L-glutamyl-[beta-tubulin] + ATP + L-glutamate = (L-glutamyl)(n+1)-gamma-L-glutamyl-L-glutamyl-[beta-tubulin] + ADP + H(+) + phosphate.</rdfs:label>
</rdf:Description>
