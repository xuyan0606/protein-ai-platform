<skos:altLabel>histolysin</skos:altLabel>
<activity rdf:resource="3.4.22.35#SIP97FB6885A9392537"/>
<rdfs:comment>From the protozoan, Entamoeba histolytica.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family C1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2860002"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2898937"/>
<rdfs:subClassOf rdf:resource="3.4.22.-"/>
<skos:broaderTransitive rdf:resource="3.4.22.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.22.35#SIP97FB6885A9392537">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of proteins, including basement membrane collagen and azocasein. Preferential cleavage: Arg-Arg-|-Xaa in small molecule substrates including Z-Arg-Arg-|-NHMec.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/2860002">
