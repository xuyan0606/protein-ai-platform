<rdf:Description rdf:about="3.7.1.4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>phloretin hydrolase</skos:prefLabel>
<skos:altLabel>C-acylphenol hydrolase</skos:altLabel>
<activity rdf:resource="3.7.1.4#SIP279ED02507BF9476"/>
<rdfs:comment>Also hydrolyzes other C-acylated phenols related to phloretin.</rdfs:comment>
<rdfs:comment>Isolated from the fungus Aspergillus niger and the bacteria Pantoea agglomerans and Eubacterium ramulus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/5354935"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5441377"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15466559"/>
<rdfs:subClassOf rdf:resource="3.7.1.-"/>
<skos:broaderTransitive rdf:resource="3.7.1.-"/>
</rdf:Description>
