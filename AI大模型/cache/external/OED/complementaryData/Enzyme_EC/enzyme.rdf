<activity rdf:resource="2.7.4.29#SIP51BC34E4EE6AA92D"/>
<rdfs:comment>In vitro the enzyme can use diacylglycerol 3-diphosphate as the phosphate donor.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18047581"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20384697"/>
<rdfs:subClassOf rdf:resource="2.7.4.-"/>
