<rdf:Description rdf:about="2.3.1.283">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2'-acyl-2-O-sulfo-trehalose (hydroxy)phthioceranyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.283#SIP37C91AE4296FC7C8"/>
<rdfs:comment>This mycobacterial enzyme catalyzes the acylation of 2'-palmitoyl/stearoyl-2-O-sulfo-alpha,alpha-trehalose at the 3' position by a (hydroxy)phthioceranoyl group during the biosynthesis of mycobacterial sulfolipids.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17259623"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17592143"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.283#SIP37C91AE4296FC7C8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a (hydroxy)phthioceranyl-[(hydroxy)phthioceranic acid synthase] + 2'-palmitoyl/stearoyl-2-O-sulfo-alpha,alpha-trehalose = a 3'-(hydroxy)phthioceranyl-2'-palmitoyl/stearoyl-2-O-sulfo-alpha,alpha-trehalose + holo-[(hydroxy)phthioceranic acid synthase].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17259623">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/17259623"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/17259623"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/17592143">
