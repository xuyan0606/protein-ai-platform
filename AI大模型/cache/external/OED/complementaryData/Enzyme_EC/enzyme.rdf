<rdf:Description rdf:about="2.1.1.205">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tRNA (cytidine(32)/guanosine(34)-2'-O)-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.205#SIP322BE269828479B3"/>
<rdfs:comment>The enzyme from Saccharomyces cerevisiae catalyzes the formation of 2'-O-methylnucleotides at positions 32 and 34 of the yeast tRNA(Phe), tRNA(Trp) and, possibly, tRNA(Leu).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11927565"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
