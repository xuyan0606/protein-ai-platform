<rdf:Description rdf:about="1.3.1.106">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-6A reductase</skos:prefLabel>
<activity rdf:resource="1.3.1.106#SIP4157BDDAD64FB0E5"/>
<rdfs:comment>The enzyme, which participates in the anaerobic (early cobalt insertion) pathway of adenosylcobalamin biosynthesis, catalyzes the reduction of the double bond between C-18 and C-19 of cobalt-precorrin-6A.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Bacillus megaterium has no activity with NADPH.</rdfs:comment>
<rdfs:comment>See EC 1.3.1.54 for the corresponding enzyme that participates in the aerobic cobalamin biosynthesis pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/16243778"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23922391"/>
<rdfs:subClassOf rdf:resource="1.3.1.-"/>
<skos:broaderTransitive rdf:resource="1.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.3.1.106#SIP4157BDDAD64FB0E5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co-precorrin-6B + NAD(+) = Co-precorrin-6A + H(+) + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16243778">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16243778"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/16243778"/>
</rdf:Description>
