<rdf:Description rdf:about="3.2.1.130">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glycoprotein endo-alpha-1,2-mannosidase</skos:prefLabel>
<skos:altLabel>endo-alpha-D-mannosidase</skos:altLabel>
<activity rdf:resource="3.2.1.130#SIPFC8A099E0A52D401"/>
<rdfs:comment>The enzyme catalyzes the hydrolysis of the terminal alpha-D-glucosyl-(1->3)-D-mannosyl unit from the GlcMan9(GlcNAc)2 oligosaccharide component of N-glucosylated proteins during their processing in the Golgi apparatus.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2407194"/>
