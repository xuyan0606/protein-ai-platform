<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 formate + NAD(+) + 2 oxidized [2Fe-2S]-[ferredoxin] = 2 CO2 + H(+) + NADH + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
