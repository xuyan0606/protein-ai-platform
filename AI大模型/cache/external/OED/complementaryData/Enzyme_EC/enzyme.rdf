<skos:altLabel>phosphodiesterase</skos:altLabel>
<activity rdf:resource="3.1.4.1#SIP3051EB2027F74282"/>
<rdfs:comment>Hydrolyzes both ribonucleotides and deoxyribonucleotides.</rdfs:comment>
<rdfs:comment>Has low activity toward polynucleotides.</rdfs:comment>
<rdfs:comment>A 3'-phosphate terminus on the substrate inhibits hydrolysis.</rdfs:comment>
<rdfs:subClassOf rdf:resource="3.1.4.-"/>
<skos:broaderTransitive rdf:resource="3.1.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.4.1#SIP3051EB2027F74282">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
