<skos:prefLabel>D-dopachrome decarboxylase</skos:prefLabel>
<skos:altLabel>D-dopachrome carboxy-lyase</skos:altLabel>
<skos:altLabel>D-dopachrome tautomerase</skos:altLabel>
<skos:altLabel>D-tautomerase</skos:altLabel>
<skos:altLabel>phenylpyruvate tautomerase II</skos:altLabel>
<activity rdf:resource="4.1.1.84#SIP42E9232758BE3F70"/>
<rdfs:comment>Specific for D-dopachrome as substrate.</rdfs:comment>
<rdfs:comment>L-dopachrome, L- or D-alpha-methyldopachrome and dopaminochrome do not act as substrates (see also EC 5.3.3.12).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8267597"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9285056"/>
<citation rdf:resource="http://purl.uniprot.org/citations/9480844"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10079069"/>
