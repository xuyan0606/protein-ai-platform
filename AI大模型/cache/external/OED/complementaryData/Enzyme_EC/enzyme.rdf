<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>N(6)-[(R)-dihydrolipoyl]-L-lysyl-[protein] + NAD(+) = H(+) + N(6)-[(R)-lipoyl]-L-lysyl-[protein] + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.8.1.4#SIP12757EBD1CAF10B9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-dihydrolipoamide + NAD(+) = (R)-lipoamide + H(+) + NADH.</rdfs:label>
</rdf:Description>
