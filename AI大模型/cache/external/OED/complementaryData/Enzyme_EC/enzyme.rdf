<rdf:Description rdf:about="2.7.7.69">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GDP-L-galactose/GDP-D-glucose: hexose 1-phosphate guanylyltransferase</skos:prefLabel>
<skos:altLabel>GDP-L-galactose phosphorylase</skos:altLabel>
<activity rdf:resource="2.7.7.69#SIPDC31E34DE9573D27"/>
<activity rdf:resource="2.7.7.69#SIP303EA07783932341"/>
<activity rdf:resource="2.7.7.69#SIPF6959E753D0AD657"/>
<activity rdf:resource="2.7.7.69#SIP20272A6E0A800AFD"/>
<activity rdf:resource="2.7.7.69#SIP8FEBB2DE9A886FF6"/>
<rdfs:comment>This plant enzyme catalyzes the conversion of GDP-beta-L-galactose and GDP-alpha-D-glucose to beta-L-galactose 1-phosphate and alpha-D-glucose 1-phosphate, respectively.</rdfs:comment>
<rdfs:comment>The enzyme can use inorganic phosphate as the cosubstrate, but several hexose 1-phosphates, including alpha-D-mannose 1-phosphate, alpha-D-glucose 1-phosphate, and alpha-D-galactose 1-phosphate, are better guanylyl acceptors.</rdfs:comment>
<rdfs:comment>The enzyme's activity on GDP-beta-L-galactose is crucial for the biosynthesis of L-ascorbate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17462988"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17485667"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17877701"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17950389"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18463094"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18516687"/>
<rdfs:subClassOf rdf:resource="2.7.7.-"/>
<skos:broaderTransitive rdf:resource="2.7.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.69#SIPDC31E34DE9573D27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-mannose 1-phosphate + GDP-beta-L-galactose = beta-L-galactose 1-phosphate + GDP-alpha-D-mannose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.69#SIP303EA07783932341">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-mannose 1-phosphate + GDP-alpha-D-glucose = alpha-D-glucose 1-phosphate + GDP-alpha-D-mannose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.69#SIPF6959E753D0AD657">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GDP-beta-L-galactose + phosphate = beta-L-galactose 1-phosphate + GDP + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.69#SIP20272A6E0A800AFD">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>alpha-D-glucose 1-phosphate + GDP-beta-L-galactose = beta-L-galactose 1-phosphate + GDP-alpha-D-glucose.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.7.7.69#SIP8FEBB2DE9A886FF6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>GDP-alpha-D-glucose + phosphate = alpha-D-glucose 1-phosphate + GDP + H(+).</rdfs:label>
</rdf:Description>
