<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-hydroxycyclohexanone + A = AH2 + cyclohexane-1,3-dione.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.27">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(R)-pantolactone dehydrogenase (flavin)</skos:prefLabel>
<skos:altLabel>(R)-pantoyllactone dehydrogenase (flavin)</skos:altLabel>
<skos:altLabel>2-dehydropantolactone reductase (flavin)</skos:altLabel>
<skos:altLabel>2-dehydropantoyl-lactone reductase (flavin)</skos:altLabel>
<activity rdf:resource="1.1.99.27#SIP2F224EBB40283B4C"/>
<rdfs:comment>High specificity for (R)-pantolactone.</rdfs:comment>
<rdfs:comment>Phenazine methosulfate (PMS) can act as acceptor.</rdfs:comment>
<rdfs:comment>The enzyme has been studied in Nocardia asteroides and shown to be membrane-bound and induced by 1,2-propanediol.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1541293"/>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.1.99.27#SIP2F224EBB40283B4C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(R)-pantolactone + A = 2-dehydropantolactone + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/1541293">
