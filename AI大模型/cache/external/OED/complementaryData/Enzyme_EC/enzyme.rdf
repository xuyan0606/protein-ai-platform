<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>adenosine(2142) in 25S rRNA + S-adenosyl-L-methionine = H(+) + N(1)-methyladenosine(2142) in 25S rRNA + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23558746">
