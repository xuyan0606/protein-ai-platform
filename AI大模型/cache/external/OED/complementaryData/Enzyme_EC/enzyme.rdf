<skos:prefLabel>oleanolate 3-O-glucosyltransferase</skos:prefLabel>
<skos:altLabel>UGT73C10</skos:altLabel>
<skos:altLabel>UGT73C11</skos:altLabel>
<activity rdf:resource="2.4.1.368#SIPB3A4E084AF0439F5"/>
<rdfs:comment>The enzyme has been characterized from the saponin-producing crucifer plant Barbarea vulgaris.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23027665"/>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
