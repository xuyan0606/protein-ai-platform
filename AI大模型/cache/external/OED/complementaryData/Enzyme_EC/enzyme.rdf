<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-(omega-methylsulfanyl)alkylmalate = a 2-(omega-methylsulfanyl)alkylmaleate + H2O.</rdfs:label>
</rdf:Description>
