<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>demethylspheroidene + S-adenosyl-L-methionine = H(+) + S-adenosyl-L-homocysteine + spheroidene.</rdfs:label>
</rdf:Description>
