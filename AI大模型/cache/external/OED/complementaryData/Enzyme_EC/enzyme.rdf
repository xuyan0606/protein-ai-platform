<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="4.2.3.n14"/>
<skos:prefLabel>2-methylisoborneol synthase</skos:prefLabel>
<skos:altLabel>2-MIB cyclase</skos:altLabel>
<skos:altLabel>MIB synthase</skos:altLabel>
<activity rdf:resource="4.2.3.118#SIP5CBE011059148EDE"/>
<rdfs:comment>The product, 2-methylisoborneol, is a characteristc odiferous compound with a musty smell produced by soil microorganisms.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18492804"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18563898"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21174459"/>
