<replaces rdf:resource="1.14.14.n1"/>
<skos:prefLabel>pyrimidine monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.99.46#SIP32BF04073B7B9034"/>
<activity rdf:resource="1.14.99.46#SIPAA0E29E5A6AB3B7A"/>
<rdfs:comment>The enzyme participates in the Rut pyrimidine catabolic pathway.</rdfs:comment>
<rdfs:comment>The flavin-N(5)-oxide that is formed by the enzyme reacts spontaneously with NADH to give oxidized flavin, releasing a water molecule.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20369853"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20400551"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28661684"/>
<citation rdf:resource="http://purl.uniprot.org/citations/28784589"/>
