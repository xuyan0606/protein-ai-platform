<rdf:Description rdf:about="3.4.19.15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.4.24.88"/>
<skos:prefLabel>desampylase</skos:prefLabel>
<skos:altLabel>SAMP-protein conjugate cleaving protease</skos:altLabel>
<activity rdf:resource="3.4.19.15#SIPE8C2AB7B3C00BDAF"/>
<rdfs:comment>The enzyme, characterized from the archaeon Haloferax volcanii, specifically cleaves the ubiquitin-like small modifier proteins SAMP1 and SAMP2 from protein conjugates, hydrolyzing the isopeptide bond between a lysine residue of the target protein and the C-terminal glycine of the modifier protein. cf. EC 3.4.19.12.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family M67.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/22970855"/>
<rdfs:subClassOf rdf:resource="3.4.19.-"/>
<skos:broaderTransitive rdf:resource="3.4.19.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.19.15#SIPE8C2AB7B3C00BDAF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an N(6)-[small archaeal modifier protein]-[protein]-L-lysine + H2O = a [protein]-L-lysine + a [small archaeal modifier protein].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/22970855">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
