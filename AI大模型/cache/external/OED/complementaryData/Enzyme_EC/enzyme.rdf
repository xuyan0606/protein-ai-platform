</rdf:Description>
<rdf:Description rdf:about="5.1.3.44">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>mannose 2-epimerase</skos:prefLabel>
<activity rdf:resource="5.1.3.44#SIP5582147BAA357812"/>
<rdfs:comment>The enzyme, characterized from multiple bacterial species, catalyzes the interconversion between beta-D-glucopyranose and beta-D-mannopyranose through proton abstraction-addition at the C2 position.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/31201453"/>
<rdfs:subClassOf rdf:resource="5.1.3.-"/>
<skos:broaderTransitive rdf:resource="5.1.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="5.1.3.44#SIP5582147BAA357812">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>beta-D-mannose = beta-D-glucose.</rdfs:label>
</rdf:Description>
