<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/27396740"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/27396740"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hercynylcysteine S-oxide lyase</skos:prefLabel>
<activity rdf:resource="4.4.1.36#SIP880F6571ED85706B"/>
<rdfs:comment>The enzyme, characterized from the bacterium Mycobacterium smegmatis, cayalyzes the last step in the pathway of ergothioneine biosynthesis.</rdfs:comment>
<rdfs:comment>The enzyme forms a 2-sulfenohercynine intermediate, which is reduced to ergothioneine non-enzymically by a thiol.</rdfs:comment>
<rdfs:comment>In vitro, DTT can serve this function.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20420449"/>
<citation rdf:resource="http://purl.uniprot.org/citations/24828577"/>
<citation rdf:resource="http://purl.uniprot.org/citations/26149121"/>
<rdfs:subClassOf rdf:resource="4.4.1.-"/>
<skos:broaderTransitive rdf:resource="4.4.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.4.1.36#SIP880F6571ED85706B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>AH2 + H(+) + S-(hercyn-2-yl)-L-cysteine S-oxide = A + ergothioneine + NH4(+) + pyruvate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20420449">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
