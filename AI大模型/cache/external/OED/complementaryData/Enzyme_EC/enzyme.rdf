<rdf:Description rdf:about="2.7.4.32">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>farnesyl phosphate kinase</skos:prefLabel>
<activity rdf:resource="2.7.4.32#SIPA6E4A37F5D242785"/>
<rdfs:comment>The enzyme, found in plants and animals, is specific for CTP as phosphate donor.</rdfs:comment>
<rdfs:comment>It does not use farnesol as substrate (cf. EC 2.7.1.216).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9606952"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21395888"/>
<rdfs:subClassOf rdf:resource="2.7.4.-"/>
<skos:broaderTransitive rdf:resource="2.7.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.7.4.32#SIPA6E4A37F5D242785">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(2E,6E)-farnesyl phosphate + CTP = (2E,6E)-farnesyl diphosphate + CDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9606952">
