<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/10966643"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/10966643"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.103">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="3.4.4.17"/>
<replaces rdf:resource="3.4.23.6"/>
<replaces rdf:resource="3.4.23.27"/>
<skos:prefLabel>physarolisin</skos:prefLabel>
<skos:altLabel>Dictyostelium discoideum aspartic proteinase</skos:altLabel>
<skos:altLabel>Dictyostelium discoideum aspartic proteinase E</skos:altLabel>
<skos:altLabel>physaropepsin</skos:altLabel>
<skos:altLabel>Physarum aspartic proteinase</skos:altLabel>
<skos:altLabel>Physarum flavicomum aspartic proteinase</skos:altLabel>
<skos:altLabel>Physarum polycephalum acid proteinase</skos:altLabel>
<activity rdf:resource="3.4.21.103#SIP243D1F459870C208"/>
<rdfs:comment>From the slime mold Physarum polycephalum.</rdfs:comment>
<rdfs:comment>Is not inhibited by pepstatin, but is blocked by methyl 2-diazoacetamidohexanoate.</rdfs:comment>
<rdfs:comment>Closely similar enzymes are found in Dictyostelium discoideum and P.flavicomum.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family S53.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/12589815"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12673349"/>
<rdfs:subClassOf rdf:resource="3.4.21.-"/>
<skos:broaderTransitive rdf:resource="3.4.21.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.21.103#SIP243D1F459870C208">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Milk clotting activity. Preferential cleavage of 8-Gly-|-Ser-9 in B chain of insulin most rapidly, followed by 11-Leu-|-Val-12, 19-Cys(SO(3)H)-|-Gly and 24-Phe-|-Phe-25. No action on Ac-Phe-Tyr(I)2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/12589815">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/12589815"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/12589815"/>
</rdf:Description>
