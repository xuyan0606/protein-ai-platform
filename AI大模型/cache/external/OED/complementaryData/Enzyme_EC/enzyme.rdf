<rdf:Description rdf:about="1.14.13.231">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>tetracycline 11a-monooxygenase</skos:prefLabel>
<activity rdf:resource="1.14.13.231#SIPB68C33FCA5FFC21A"/>
<rdfs:comment>This bacterial enzyme confers resistance to all clinically relevant tetracyclines when expressed under aerobic conditions.</rdfs:comment>
<rdfs:comment>The hydroxylated products are very unstable and lead to intramolecular cyclization and non-enzymic breakdown to undefined products.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/15452119"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16128584"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21402075"/>
<rdfs:subClassOf rdf:resource="1.14.13.-"/>
<skos:broaderTransitive rdf:resource="1.14.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.231#SIPB68C33FCA5FFC21A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + NADPH + O2 + tetracycline = 11a-hydroxytetracycline + H2O + NADP(+).</rdfs:label>
</rdf:Description>
