<skos:prefLabel>bile-salt sulfotransferase</skos:prefLabel>
<skos:altLabel>BAST I</skos:altLabel>
<skos:altLabel>bile acid:3'-phosphoadenosine-5'-phosphosulfate sulfotransferase</skos:altLabel>
