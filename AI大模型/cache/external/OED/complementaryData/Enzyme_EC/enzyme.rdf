<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-ubiquitinyl-[E1 ubiquitin-activating enzyme]-L-cysteine + [acceptor protein]-N-terminal-amino acid = [E1 ubiquitin-activating enzyme]-L-cysteine + N-terminal-ubiquitinyl-[acceptor protein].</rdfs:label>
</rdf:Description>
