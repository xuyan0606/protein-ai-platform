</rdf:Description>
<rdf:Description rdf:about="2.3.1.10">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>hydrogen-sulfide S-acetyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.10#SIPBC80069677CFB05C"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.10#SIPBC80069677CFB05C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + hydrogen sulfide = CoA + thioacetate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.11">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>thioethanolamine S-acetyltransferase</skos:prefLabel>
<skos:altLabel>thioethanolamine acetyltransferase</skos:altLabel>
