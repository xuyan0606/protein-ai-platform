<skos:prefLabel>GTP cyclohydrolase IV</skos:prefLabel>
<activity rdf:resource="3.5.4.39#SIPA3B6F2ACFC853B5B"/>
<rdfs:comment>The enzyme is involved in methanopterin biosynthesis in methanogenic archaea. cf. EC 3.5.4.16, EC 3.5.4.25 and EC 3.5.4.29.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/17497938"/>
