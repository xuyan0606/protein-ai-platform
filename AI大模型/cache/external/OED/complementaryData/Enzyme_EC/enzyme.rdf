<skos:prefLabel>phosphatidylinositol dimannoside acyltransferase</skos:prefLabel>
<skos:altLabel>PIM2 acyltransferase</skos:altLabel>
<activity rdf:resource="2.3.1.265#SIP2935FA1EC52106B2"/>
<activity rdf:resource="2.3.1.265#SIP8D6C9C403EA78F32"/>
<rdfs:comment>The enzyme, found in Corynebacteriales, is involved in the biosynthesis of phosphatidyl-myo-inositol mannosides (PIMs).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24810911"/>
