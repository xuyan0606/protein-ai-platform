<activity rdf:resource="3.1.1.91#SIP319AAAC2FB377B34"/>
<rdfs:comment>This enzyme, characterized from the soil bacterium Bradyrhizobium sp. JS329, is involved in the pathway of 5-nitroanthranilate degradation.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21498645"/>
<rdfs:subClassOf rdf:resource="3.1.1.-"/>
<skos:broaderTransitive rdf:resource="3.1.1.-"/>
</rdf:Description>
