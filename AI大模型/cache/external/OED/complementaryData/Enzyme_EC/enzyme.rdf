<replaces rdf:resource="3.4.23.6"/>
<skos:prefLabel>rhodotorulapepsin</skos:prefLabel>
<skos:altLabel>Rhodotorula aspartic proteinase</skos:altLabel>
<activity rdf:resource="3.4.23.26#SIP92FED630FAE23581"/>
<rdfs:comment>From the imperfect yeast Rhodotorula glutinis.</rdfs:comment>
<rdfs:comment>Somewhat similar enzymes have been isolated from the imperfect yeast-like organism Cladosporium sp. and the imperfect fungus Paecilomyces varioti.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10290"/>
<rdfs:subClassOf rdf:resource="3.4.23.-"/>
<skos:broaderTransitive rdf:resource="3.4.23.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.23.26#SIP92FED630FAE23581">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Specificity similar to that of pepsin A. Cleaves Z-Lys-|-Ala-Ala-Ala and activates trypsinogen.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/10290">
