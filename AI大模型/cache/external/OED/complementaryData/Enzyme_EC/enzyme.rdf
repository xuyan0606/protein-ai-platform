<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-arabinitol 1-phosphate + NAD(+) = D-xylulose 5-phosphate + H(+) + NADH.</rdfs:label>
</rdf:Description>
