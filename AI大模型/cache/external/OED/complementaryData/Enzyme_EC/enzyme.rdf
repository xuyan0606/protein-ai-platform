<skos:prefLabel>5-epiaristolochene 1,3-dihydroxylase</skos:prefLabel>
<skos:altLabel>5-epi-aristolochene 1,3-dihydroxylase</skos:altLabel>
<skos:altLabel>CYP71D20</skos:altLabel>
<skos:altLabel>EAH</skos:altLabel>
<activity rdf:resource="1.14.14.149#SIP1B191FCF4002CB1B"/>
<rdfs:comment>A cytochrome P450 (heme-thiolate) protein.</rdfs:comment>
<rdfs:comment>Kinetic studies suggest that 1beta-hydroxyepiaristolochene is mainly formed first followed by hydroxylation at C-3.</rdfs:comment>
<rdfs:comment>However the reverse order via 3alpha-hydroxyepiaristolochene does occur.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11556809"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15522862"/>
<rdfs:subClassOf rdf:resource="1.14.14.-"/>
<skos:broaderTransitive rdf:resource="1.14.14.-"/>
</rdf:Description>
