<rdf:Description rdf:about="2.6.1.102">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>GDP-perosamine synthase</skos:prefLabel>
<skos:altLabel>GDP-4-keto-6-deoxy-D-mannose-4-aminotransferase</skos:altLabel>
<activity rdf:resource="2.6.1.102#SIPCCA5CA9FF4F0FD35"/>
<rdfs:comment>D-perosamine is one of several dideoxy sugars found in the O-specific polysaccharide of the lipopolysaccharide component of the outer membrane of Gram-negative bacteria.</rdfs:comment>
<rdfs:comment>The enzyme catalyzes the final step in GDP-perosamine synthesis.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11479276"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17888872"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18201574"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18795799"/>
<rdfs:subClassOf rdf:resource="2.6.1.-"/>
<skos:broaderTransitive rdf:resource="2.6.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.6.1.102#SIPCCA5CA9FF4F0FD35">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-oxoglutarate + GDP-alpha-D-perosamine = GDP-4-dehydro-alpha-D-rhamnose + L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11479276">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
