<rdf:Description rdf:about="1.5.99.15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>dihydromethanopterin reductase (acceptor)</skos:prefLabel>
<activity rdf:resource="1.5.99.15#SIP08CF7E27C3E15DAF"/>
<rdfs:comment>This archaeal enzyme catalyzes the last step in the biosynthesis of tetrahydromethanopterin, a cofactor used in methanogenesis.</rdfs:comment>
<rdfs:comment>The enzyme is characterized from the archaea Methanosarcina mazei and Methanocaldococcus jannaschii. cf. EC 1.5.1.47.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/23995635"/>
<rdfs:subClassOf rdf:resource="1.5.99.-"/>
<skos:broaderTransitive rdf:resource="1.5.99.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.5.99.15#SIP08CF7E27C3E15DAF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5,6,7,8-tetrahydromethanopterin + A = 7,8-dihydromethanopterin + AH2.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/23995635">
