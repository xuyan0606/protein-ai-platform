<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>2-oxo-3-(phosphooxy)propyl 3-oxoalkanoate synthase</skos:prefLabel>
<activity rdf:resource="2.3.1.277#SIPCC89269EEDDE97E7"/>
<rdfs:comment>The enzyme catalyzes the first committed step in the biosynthesis of gamma-butyrolactone autoregulators that control secondary metabolism and morphological development in Streptomyces bacteria.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2492509"/>
<citation rdf:resource="http://purl.uniprot.org/citations/17277085"/>
