<skos:prefLabel>cardiolipin synthase (CMP-forming)</skos:prefLabel>
<activity rdf:resource="2.7.8.41#SIP163CF6D41520DED8"/>
<rdfs:comment>The eukaryotic enzyme is involved in the biosynthesis of the mitochondrial phospholipid cardiolipin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1657995"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15811335"/>
