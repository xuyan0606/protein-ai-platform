<activity rdf:resource="1.1.99.26#SIP0F5D2E3E23779FAA"/>
<rdfs:comment>2,6-dichloroindophenol and methylene blue can act as acceptors.</rdfs:comment>
<rdfs:subClassOf rdf:resource="1.1.99.-"/>
<skos:broaderTransitive rdf:resource="1.1.99.-"/>
</rdf:Description>
