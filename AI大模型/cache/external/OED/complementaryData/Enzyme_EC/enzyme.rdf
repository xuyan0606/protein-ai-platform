<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Cleaves N-terminal beta-homoamino acids from peptides composed of 2 to 6 amino acids.</rdfs:label>
</rdf:Description>
