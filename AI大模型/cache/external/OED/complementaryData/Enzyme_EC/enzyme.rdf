<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.14.13.99"/>
<skos:prefLabel>24-hydroxycholesterol 7alpha-hydroxylase</skos:prefLabel>
<skos:altLabel>24-hydroxycholesterol 7alpha-monooxygenase</skos:altLabel>
<activity rdf:resource="1.14.14.26#SIPADADF8561F876CE9"/>
<rdfs:comment>Found in liver microsomes and in ciliary non-pigmented epithelium.</rdfs:comment>
<rdfs:comment>Specific for (24S)-cholest-5-ene-3beta,24-diol, which is formed mostly in the brain by EC 1.14.14.25.</rdfs:comment>
<rdfs:comment>The direct electron donor to the enzyme is EC 1.6.2.4.</rdfs:comment>
