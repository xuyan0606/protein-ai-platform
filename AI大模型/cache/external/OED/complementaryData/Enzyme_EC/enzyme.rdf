<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/22660767"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/22660767"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.110">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>12alpha,13alpha-dihydroxyfumitremorgin C prenyltransferase</skos:prefLabel>
<activity rdf:resource="2.5.1.110#SIP98286C072ACFDF3D"/>
<rdfs:comment>The enzyme from the fungus Aspergillus fumigatus also shows some activity with fumitremorgin C.</rdfs:comment>
<rdfs:comment>Involved in the biosynthetic pathways of several indole alkaloids such as fumitremorgins and verruculogen.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18683158"/>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.5.1.110#SIP98286C072ACFDF3D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>12alpha,13alpha-dihydroxyfumitremorgin C + dimethylallyl diphosphate = diphosphate + fumitremorgin B.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18683158">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
