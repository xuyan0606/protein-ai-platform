<skos:prefLabel>Selenotransferases</skos:prefLabel>
<rdfs:subClassOf rdf:resource="2.9.-.-"/>
<skos:broaderTransitive rdf:resource="2.9.-.-"/>
<skos:narrowerTransitive rdf:resource="2.9.1.1"/>
