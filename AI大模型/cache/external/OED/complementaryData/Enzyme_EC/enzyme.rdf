<rdf:Description rdf:about="2.4.2.43">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.4.2.n1"/>
<skos:prefLabel>lipid IVA 4-amino-4-deoxy-L-arabinosyltransferase</skos:prefLabel>
<skos:altLabel>4-amino-4-deoxy-L-arabinose lipid A transferase</skos:altLabel>
<skos:altLabel>lipid A 4-amino-4-deoxy-L-arabinosyltransferase</skos:altLabel>
<skos:altLabel>polymyxin resistance protein PmrK</skos:altLabel>
<skos:altLabel>undecaprenyl phosphate-alpha-4-amino-4-deoxy-L-arabinose arabinosyl transferase</skos:altLabel>
<skos:altLabel>undecaprenyl phosphate-alpha-L-Ara4N transferase</skos:altLabel>
<activity rdf:resource="2.4.2.43#SIP8AEB2C24E98B58A4"/>
<activity rdf:resource="2.4.2.43#SIP20C398CBA18CAA78"/>
<activity rdf:resource="2.4.2.43#SIP39F4FC25452858BA"/>
<rdfs:comment>Integral membrane protein present in the inner membrane of certain Gram negative endobacteria.</rdfs:comment>
<rdfs:comment>In strains that do not produce 3-deoxy-D-manno-octulosonic acid (Kdo), the enzyme adds a single arabinose unit to the 1-phosphate moiety of the tetra-acylated lipid A precursor, lipid IVA.</rdfs:comment>
<rdfs:comment>In the presence of a Kdo disaccharide, the enzyme primarily adds an arabinose unit to the 4-phosphate of lipid A molecules.</rdfs:comment>
<rdfs:comment>The Salmonella typhimurium enzyme can add arabinose units to both positions.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11535603"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11535604"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11535605"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16226890"/>
<citation rdf:resource="http://purl.uniprot.org/citations/19947657"/>
<rdfs:subClassOf rdf:resource="2.4.2.-"/>
<skos:broaderTransitive rdf:resource="2.4.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.43#SIP8AEB2C24E98B58A4">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-amino-4-deoxy-alpha-L-arabinopyranosyl di-trans,octa-cis-undecaprenyl phosphate + lipid IVA = lipid IIA + di-trans,octa-cis-undecaprenyl phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.43#SIP20C398CBA18CAA78">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>4-amino-4-deoxy-alpha-L-arabinopyranosyl di-trans,octa-cis-undecaprenyl phosphate + lipid A (E. coli) = beta-L-Ara4N-lipid A (E. coli) + di-trans,octa-cis-undecaprenyl phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.2.43#SIP39F4FC25452858BA">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 4-amino-4-deoxy-alpha-L-arabinopyranosyl di-trans,octa-cis-undecaprenyl phosphate + alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-lipid A (E. coli) = (beta-L-Ara4N)2-(Kdo)2-lipid A + 2 di-trans,octa-cis-undecaprenyl phosphate.</rdfs:label>
</rdf:Description>
