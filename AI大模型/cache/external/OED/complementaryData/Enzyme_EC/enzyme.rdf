<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a long-chain fatty acyl ethyl ester + H2O = a long-chain fatty acid + ethanol + H(+).</rdfs:label>
</rdf:Description>
