<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a very-long-chain (3R)-3-hydroxyacyl-CoA + NADP(+) = a very-long-chain 3-oxoacyl-CoA + H(+) + NADPH.</rdfs:label>
</rdf:Description>
