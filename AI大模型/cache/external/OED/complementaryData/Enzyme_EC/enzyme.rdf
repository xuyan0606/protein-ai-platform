<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>24-methylenesterol C-methyltransferase</skos:prefLabel>
<skos:altLabel>24-methylenelophenol C-24(1)-methyltransferase</skos:altLabel>
<skos:altLabel>SMT2</skos:altLabel>
<activity rdf:resource="2.1.1.143#SIPCA13D07737A45C36"/>
<rdfs:comment>This is the second methylation step of plant sterol biosynthesis (cf. EC 2.1.1.142).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9746350"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.143#SIPCA13D07737A45C36">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>24-methylidenelophenol + S-adenosyl-L-methionine = (Z)-24-ethylidenelophenol + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
