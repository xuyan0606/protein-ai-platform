<citation rdf:resource="http://purl.uniprot.org/citations/15213409"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15328619"/>
<rdfs:subClassOf rdf:resource="4.1.99.-"/>
<skos:broaderTransitive rdf:resource="4.1.99.-"/>
</rdf:Description>
