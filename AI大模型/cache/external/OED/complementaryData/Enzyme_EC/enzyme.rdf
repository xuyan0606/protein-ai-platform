<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cobalt-precorrin-5B (C(1))-methyltransferase</skos:prefLabel>
<skos:altLabel>cobalt-precorrin-6A synthase</skos:altLabel>
<activity rdf:resource="2.1.1.195#SIPFD04826F2B20B4B9"/>
<rdfs:comment>This enzyme catalyzes the C-1 methylation of cobalt-precorrin-5B in the anaerobic (early cobalt insertion) pathway of adenosylcobalamin biosynthesis.</rdfs:comment>
<rdfs:comment>See EC 2.1.1.152 for the C-1 methyltransferase that participates in the aerobic cobalamin biosynthesis pathway.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11007789"/>
<citation rdf:resource="http://purl.uniprot.org/citations/15741157"/>
<citation rdf:resource="http://purl.uniprot.org/citations/23922391"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.195#SIPFD04826F2B20B4B9">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Co-precorrin-5B + S-adenosyl-L-methionine = Co-precorrin-6A + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
