<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>S-adenosyl-L-methionine + uridine(44) in tRNA(Ser) = 2'-O-methyluridine(44) in tRNA(Ser) + H(+) + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
