<rdf:Description rdf:about="1.10.3.1">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>catechol oxidase</skos:prefLabel>
<skos:altLabel>diphenol oxidase</skos:altLabel>
<skos:altLabel>o-diphenolase</skos:altLabel>
<skos:altLabel>phenolase</skos:altLabel>
<skos:altLabel>polyphenol oxidase</skos:altLabel>
<skos:altLabel>tyrosinase</skos:altLabel>
<activity rdf:resource="1.10.3.1#SIP9530A08F99CB9E21"/>
<rdfs:comment>A type 3 copper protein that catalyzes exclusively the oxidation of catechols (i.e., o-diphenols) to the corresponding o-quinones.</rdfs:comment>
<rdfs:comment>The enzyme also acts on a variety of substituted catechols.</rdfs:comment>
<rdfs:comment>It is different from tyrosinase, EC 1.14.18.1, which can catalyze both the monooxygenation of monophenols and the oxidation of catechols.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4965136"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5842066"/>
<rdfs:subClassOf rdf:resource="1.10.3.-"/>
<skos:broaderTransitive rdf:resource="1.10.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.10.3.1#SIP9530A08F99CB9E21">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 catechol + O2 = 2 1,2-benzoquinone + 2 H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4965136">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
