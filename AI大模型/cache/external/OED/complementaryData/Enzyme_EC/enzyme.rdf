<rdf:Description rdf:about="2.3.2.14">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>D-alanine gamma-glutamyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.2.14#SIPE8FBC5B28B34D24C"/>
<rdfs:comment>D-phenylalanine and D-2-aminobutyrate can also act as acceptors, more slowly.</rdfs:comment>
<rdfs:comment>Also catalyzes some of the reactions of EC 2.3.2.2.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.3.2.-"/>
<skos:broaderTransitive rdf:resource="2.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.2.14#SIPE8FBC5B28B34D24C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-alanine + L-glutamine = gamma-L-glutamyl-D-alanine + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.3.2.15">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>glutathione gamma-glutamylcysteinyltransferase</skos:prefLabel>
<skos:altLabel>phytochelatin synthase</skos:altLabel>
<activity rdf:resource="2.3.2.15#SIP28C0CA1F6A4E944A"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16594069"/>
<rdfs:subClassOf rdf:resource="2.3.2.-"/>
<skos:broaderTransitive rdf:resource="2.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.2.15#SIP28C0CA1F6A4E944A">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[Glu(-Cys)](n)-Gly + glutathione + H(+) = [Glu(-Cys)](n+1)-Gly + glycine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/16594069">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/16594069"/>
