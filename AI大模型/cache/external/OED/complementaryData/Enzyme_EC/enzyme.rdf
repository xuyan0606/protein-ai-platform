<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obsolete>
<replacedBy rdf:resource="5.4.2.11"/>
