<citation rdf:resource="http://purl.uniprot.org/citations/10668504"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11156689"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11985492"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14697905"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16046623"/>
<rdfs:subClassOf rdf:resource="1.4.3.-"/>
<skos:broaderTransitive rdf:resource="1.4.3.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.21#SIPD6E62B088C8A5137">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>an aliphatic amine + H2O + O2 = an aldehyde + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.21#SIP3E9D45914F109B4D">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-phenylethylamine + H2O + O2 = 2-phenylacetaldehyde + H2O2 + NH4(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.4.3.21#SIPD7EBC3784FFA2870">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-nitrotyramine + H2O + O2 = 4-hydroxy-3-nitrophenylacetaldehyde + H2O2 + NH4(+).</rdfs:label>
