<rdf:Description rdf:about="2.4.1.120">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sinapate 1-glucosyltransferase</skos:prefLabel>
<activity rdf:resource="2.4.1.120#SIP6C8BA127EDD893F8"/>
<rdfs:comment>Some other hydroxycinnamates, including 4-coumarate, ferulate and caffeate, can also act as acceptors, more slowly.</rdfs:comment>
<rdfs:comment>Only glucose esters, not glucosides, are formed (cf. EC 2.4.1.126).</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.4.1.-"/>
<skos:broaderTransitive rdf:resource="2.4.1.-"/>
</rdf:Description>
