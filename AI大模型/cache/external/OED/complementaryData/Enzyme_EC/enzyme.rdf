<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>diphosphate + H2O + Na(+)(in) = H(+) + Na(+)(out) + 2 phosphate.</rdfs:label>
</rdf:Description>
