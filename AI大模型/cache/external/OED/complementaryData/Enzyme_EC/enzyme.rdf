<rdfs:label>2-O-sulfo-alpha,alpha-trehalose + hexadecanoyl-CoA = 2-O-sulfo-2'-O-hexadecanoyl-alpha,alpha-trehalose + CoA.</rdfs:label>
</rdf:Description>
