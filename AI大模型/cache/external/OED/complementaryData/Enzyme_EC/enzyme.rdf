<rdf:Description rdf:about="2.3.2.13">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>protein-glutamine gamma-glutamyltransferase</skos:prefLabel>
<skos:altLabel>fibrinoligase</skos:altLabel>
<skos:altLabel>glutaminylpeptide gamma-glutamyltransferase</skos:altLabel>
<skos:altLabel>polyamine transglutaminase</skos:altLabel>
<skos:altLabel>TGase</skos:altLabel>
<skos:altLabel>transglutaminase</skos:altLabel>
<activity rdf:resource="2.3.2.13#SIPF7A9B07EF081640F"/>
<rdfs:comment>The gamma-carboxymide groups of peptide-bound glutamine residues act as acyl donors, and the 6-amino-groups of protein- and peptide-bound lysine residues act as acceptors, to give intra- and inter-molecular N(6)-(5-glutamyl)lysine cross-links.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/73346"/>
<citation rdf:resource="http://purl.uniprot.org/citations/2430312"/>
<citation rdf:resource="http://purl.uniprot.org/citations/4151471"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5928192"/>
<rdfs:subClassOf rdf:resource="2.3.2.-"/>
<skos:broaderTransitive rdf:resource="2.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.2.13#SIPF7A9B07EF081640F">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-glutaminyl-[protein] + L-lysyl-[protein] = [protein]-L-lysyl-N(6)-5-L-glutamyl-[protein] + NH4(+).</rdfs:label>
</rdf:Description>
