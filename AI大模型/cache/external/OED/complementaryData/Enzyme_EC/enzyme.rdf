</rdf:Description>
<rdf:Description rdf:about="2.3.1.204">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>octanoyl-[GcvH]:protein N-octanoyltransferase</skos:prefLabel>
<activity rdf:resource="2.3.1.204#SIP07F2666644FF4C91"/>
<rdfs:comment>In the bacterium Bacillus subtilis it has been shown that the enzyme catalyzes the amidotransfer of the octanoyl moiety from [glycine cleavage system H]-N(6)-octanoyl-L-lysine (i.e. octanoyl-GcvH) to the E2 subunit (dihydrolipoamide acetyltransferase) of pyruvate dehydrogenase.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/21338420"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21338421"/>
<rdfs:subClassOf rdf:resource="2.3.1.-"/>
<skos:broaderTransitive rdf:resource="2.3.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.3.1.204#SIP07F2666644FF4C91">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>L-lysyl-[lipoyl-carrier protein] + N(6)-octanoyl-L-lysyl-[glycine-cleavage complex H protein] = L-lysyl-[glycine-cleavage complex H protein] + N(6)-octanoyl-L-lysyl-[lipoyl-carrier protein].</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/21338420">
