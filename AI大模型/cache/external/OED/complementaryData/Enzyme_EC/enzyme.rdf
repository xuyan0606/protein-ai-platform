<rdf:Description rdf:about="3.1.3.99">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>IMP-specific 5'-nucleotidase</skos:prefLabel>
<activity rdf:resource="3.1.3.99#SIP30644AA94C497059"/>
<rdfs:comment>The enzyme, isolated from the yeast Saccharomyces cerevisiae, is highly specific for inosine 5'-phosphate, and has no detectable activity with other purine and pyrimidine nucleotides.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8141771"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12735798"/>
<rdfs:subClassOf rdf:resource="3.1.3.-"/>
<skos:broaderTransitive rdf:resource="3.1.3.-"/>
</rdf:Description>
