<skos:prefLabel>dimethylallylcistransferase</skos:prefLabel>
<skos:altLabel>neryl-diphosphate synthase</skos:altLabel>
<activity rdf:resource="2.5.1.28#SIP6FAF32A2E5A22062"/>
<rdfs:comment>Will not use larger prenyl diphosphates as efficient donors.</rdfs:comment>
<rdfs:subClassOf rdf:resource="2.5.1.-"/>
<skos:broaderTransitive rdf:resource="2.5.1.-"/>
</rdf:Description>
