<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>acetyl-CoA + alpha-D-galactosamine 1-phosphate = CoA + H(+) + N-acetyl-alpha-D-galactosamine 1-phosphate.</rdfs:label>
</rdf:Description>
