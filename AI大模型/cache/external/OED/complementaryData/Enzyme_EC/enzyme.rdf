<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9546396"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.22.41">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>cathepsin F</skos:prefLabel>
<activity rdf:resource="3.4.22.41#SIP64B6FFE42CD8A23C"/>
<rdfs:comment>The enzyme is unstable at neutral pH values and is inhibited by compound E-64.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family C1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9822672"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10198209"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10318784"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10362521"/>
<rdfs:subClassOf rdf:resource="3.4.22.-"/>
<skos:broaderTransitive rdf:resource="3.4.22.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.22.41#SIP64B6FFE42CD8A23C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>The recombinant enzyme cleaves synthetic substrates with Phe and Leu (better than Val) in P2, with high specificity constant (kcat/Km) comparable to that of cathepsin L.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9822672">
