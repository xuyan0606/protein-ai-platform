<skos:broaderTransitive rdf:resource="3.1.13.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.1.13.5#SIP35D08A90895D1A3C">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Exonucleolytic cleavage that removes extra residues from the 3'-terminus of tRNA to produce 5'-mononucleotides.</rdfs:label>
</rdf:Description>
