<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a 2-all-trans-polyprenylphenol + H(+) + NADPH + O2 = a 3-(all-trans-polyprenyl)benzene-1,2-diol + H2O + NADP(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="1.14.13.240#SIP9FC99F9A7DE20948">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2-all-trans-octaprenylphenol + H(+) + NADPH + O2 = 3-(all-trans-octaprenyl)benzene-1,2-diol + H2O + NADP(+).</rdfs:label>
</rdf:Description>
