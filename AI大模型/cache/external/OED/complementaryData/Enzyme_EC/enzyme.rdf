<skos:prefLabel>acarbose 7(IV)-phosphotransferase</skos:prefLabel>
<skos:altLabel>acarbose 7-kinase</skos:altLabel>
<activity rdf:resource="2.7.1.187#SIP8C5C036CAD53C6AB"/>
<rdfs:comment>The enzyme, characterized from the bacterium Actinoplanes sp. SE50/110, is specific for acarbose.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/8784426"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8784428"/>
