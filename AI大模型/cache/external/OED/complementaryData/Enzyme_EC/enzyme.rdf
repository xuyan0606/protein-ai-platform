<rdf:Description rdf:about="3.4.24.6">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>leucolysin</skos:prefLabel>
<skos:altLabel>Leucostoma neutral proteinase</skos:altLabel>
<activity rdf:resource="3.4.24.6#SIP5D85F145FE877D48"/>
<rdfs:comment>From the venom of the western cottonmouth moccasin snake (Agkistrodon piscivorus leucostoma).</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4711816"/>
<citation rdf:resource="http://purl.uniprot.org/citations/5684005"/>
<rdfs:subClassOf rdf:resource="3.4.24.-"/>
<skos:broaderTransitive rdf:resource="3.4.24.-"/>
</rdf:Description>
<rdf:Description rdf:about="3.4.24.6#SIP5D85F145FE877D48">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Cleavage of 1-Phe-|-Val-2, 5-His-|-Leu-6, 14-Ala-|-Leu-15, 20-Gly-|-Glu-21, 23-Gly-|-Phe-24 and 24-Phe-|-Phe-25 bonds in insulin B chain as well as N-blocked dipeptides.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/4711816">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
