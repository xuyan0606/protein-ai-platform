<skos:prefLabel>4-amino-anhydrotetracycline N(4)-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.335#SIP6E4A497134FA5A29"/>
<activity rdf:resource="2.1.1.335#SIP71B496C784460840"/>
<rdfs:comment>The enzyme, characterized from the bacterium Streptomyces rimosus, participates in the biosynthesis of tetracycline antibiotics.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18422316"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
