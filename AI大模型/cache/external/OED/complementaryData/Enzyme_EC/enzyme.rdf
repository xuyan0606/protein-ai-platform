<skos:prefLabel>phosphoribosyl 1,2-cyclic phosphate 1,2-diphosphodiesterase</skos:prefLabel>
<skos:altLabel>cyclic phosphate dihydrolase</skos:altLabel>
<activity rdf:resource="3.1.4.57#SIPD151FEF92E467B33"/>
<activity rdf:resource="3.1.4.57#SIPBA4189E5C9185205"/>
<rdfs:comment>The enzyme, characterized from the bacterium Eggerthella lenta, is involed in degradation of methylphosphonate.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/24147537"/>
