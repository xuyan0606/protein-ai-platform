<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Selective cleavage after Arg-223 in complement component C2 (-Ser-Leu-Gly-Arg-|-Lys-Ile-Gln-Ile) and after Arg-76 in complement component C4 (-Gly-Leu-Gln-Arg-|-Ala-Leu-Glu-Ile).</rdfs:label>
</rdf:Description>
