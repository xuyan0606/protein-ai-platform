<replaces rdf:resource="4.2.1.n2"/>
<skos:prefLabel>very-long-chain (3R)-3-hydroxyacyl-CoA dehydratase</skos:prefLabel>
<activity rdf:resource="4.2.1.134#SIP91F30AC168BE4B83"/>
<rdfs:comment>This is the third component of the elongase, a microsomal protein complex responsible for extending palmitoyl-CoA and stearoyl-CoA (and modified forms thereof) to very-long chain acyl CoAs. cf. EC 1.1.1.330, EC 1.3.1.93 and EC 2.3.1.199.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/18272525"/>
<citation rdf:resource="http://purl.uniprot.org/citations/18799749"/>
<rdfs:subClassOf rdf:resource="4.2.1.-"/>
<skos:broaderTransitive rdf:resource="4.2.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="4.2.1.134#SIP91F30AC168BE4B83">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>a very-long-chain (3R)-3-hydroxyacyl-CoA = a very-long-chain (2E)-enoyl-CoA + H2O.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/18272525">
