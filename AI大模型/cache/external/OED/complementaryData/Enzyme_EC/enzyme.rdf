<skos:prefLabel>5-methyltetrahydropteroyltriglutamate--homocysteine S-methyltransferase</skos:prefLabel>
<skos:altLabel>cobalamin-independent methionine synthase</skos:altLabel>
<skos:altLabel>homocysteine methylase</skos:altLabel>
<skos:altLabel>methionine synthase (cobalamin-independent)</skos:altLabel>
<skos:altLabel>methyltetrahydropteroylpolyglutamate:homocysteine methyltransferase</skos:altLabel>
<skos:altLabel>tetrahydropteroylglutamate-homocysteine transmethylase</skos:altLabel>
<activity rdf:resource="2.1.1.14#SIP4A2B3275F1652BEC"/>
<activity rdf:resource="2.1.1.14#SIP1567AB001BC096D5"/>
<rdfs:comment>Requires phosphate.</rdfs:comment>
<rdfs:comment>The enzyme from Escherichia coli also requires a reducing system.</rdfs:comment>
<rdfs:comment>Unlike EC 2.1.1.13 this enzyme does not contain cobalamin.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/4904482"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7601135"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8823155"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.14#SIP4A2B3275F1652BEC">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-methyltetrahydropteroyltri-L-glutamate + L-homocysteine = L-methionine + tetrahydropteroyltri-L-glutamate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.1.1.14#SIP1567AB001BC096D5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>5-methyltetrahydropteroyltri-L-glutamate + L-selenohomocysteine = L-selenomethionine + tetrahydropteroyltri-L-glutamate.</rdfs:label>
</rdf:Description>
