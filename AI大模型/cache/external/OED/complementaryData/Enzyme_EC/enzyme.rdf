<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>emodin + S-adenosyl-L-methionine = H(+) + questin + S-adenosyl-L-homocysteine.</rdfs:label>
</rdf:Description>
