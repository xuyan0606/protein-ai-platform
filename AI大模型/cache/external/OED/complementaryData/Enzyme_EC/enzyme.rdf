<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[xanthine dehydrogenase] + glutathione disulfide = [xanthine oxidase] + 2 glutathione.</rdfs:label>
</rdf:Description>
