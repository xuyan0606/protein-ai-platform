<skos:altLabel>cathepsin X</skos:altLabel>
<activity rdf:resource="3.4.22.38#SIP63AD31762C15193D"/>
<rdfs:comment>Prominently expressed in mammalian osteoclasts, and believed to play a role in bone resorption.</rdfs:comment>
<rdfs:comment>Belongs to peptidase family C1.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/7818555"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8647860"/>
