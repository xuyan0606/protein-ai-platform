<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/23270877"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/23270877"/>
</rdf:Description>
<rdf:Description rdf:about="1.16.1.7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="1.6.99.13"/>
<skos:prefLabel>ferric-chelate reductase (NADH)</skos:prefLabel>
<skos:altLabel>ferric chelate reductase</skos:altLabel>
<skos:altLabel>iron chelate reductase</skos:altLabel>
<skos:altLabel>NADH:Fe(3+)-EDTA reductase</skos:altLabel>
<skos:altLabel>NADH:Fe(3+) oxidoreductase</skos:altLabel>
<activity rdf:resource="1.16.1.7#SIP248243E5CDF3DDF5"/>
<rdfs:comment>The enzyme catalyzes the reduction of bound ferric iron in a variety of iron chelators (siderophores), resulting in the release of ferrous iron.</rdfs:comment>
<rdfs:comment>The plant enzyme is involved in the transport of iron across plant plasma membranes.</rdfs:comment>
<rdfs:comment>The enzyme from the bacterium Paracoccus denitrificans can also reduce chromate. cf. EC 1.16.1.9 and EC 1.16.1.10.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/14728682"/>
<rdfs:subClassOf rdf:resource="1.16.1.-"/>
<skos:broaderTransitive rdf:resource="1.16.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.16.1.7#SIP248243E5CDF3DDF5">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 a Fe(II)-siderophore + H(+) + NAD(+) = 2 a Fe(III)-siderophore + NADH.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/14728682">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/14728682"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/14728682"/>
<dcterms:identifier>doi:10.1046/j.1432-1033.2003.03957.x</dcterms:identifier>
</rdf:Description>
<rdf:Description rdf:about="1.16.1.8">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="2.1.1.135"/>
<skos:prefLabel>[methionine synthase] reductase</skos:prefLabel>
<skos:altLabel>[methionine synthase]-cobalamin methyltransferase (cob(II)alamin reducing)</skos:altLabel>
<skos:altLabel>methionine synthase cob(II)alamin reductase (methylating)</skos:altLabel>
<skos:altLabel>methionine synthase reductase</skos:altLabel>
<activity rdf:resource="1.16.1.8#SIP9E7101A8497005F2"/>
<rdfs:comment>The substrate of the enzyme is the inactivated cobalt(II) form of EC 2.1.1.13.</rdfs:comment>
<rdfs:comment>Electrons are transferred from NADPH to FAD to FMN.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/9501215"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11466310"/>
<citation rdf:resource="http://purl.uniprot.org/citations/12416982"/>
<rdfs:subClassOf rdf:resource="1.16.1.-"/>
<skos:broaderTransitive rdf:resource="1.16.1.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.16.1.8#SIP9E7101A8497005F2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H(+) + 2 methylcob(III)alamin-[methionine synthase] + NADP(+) + 2 S-adenosyl-L-homocysteine = 2 cob(II)alamin-[methionine synthase] + NADPH + 2 S-adenosyl-L-methionine.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/9501215">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Citation"/>
<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/9501215"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/9501215"/>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/11466310">
