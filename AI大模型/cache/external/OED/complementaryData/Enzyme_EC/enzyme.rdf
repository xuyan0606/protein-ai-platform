<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>(S)-2,3-diaminopropanoate + H(+) + H2O = 2 NH4(+) + pyruvate.</rdfs:label>
</rdf:Description>
