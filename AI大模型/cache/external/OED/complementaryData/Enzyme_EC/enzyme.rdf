<skos:prefLabel>adenosyl-fluoride synthase</skos:prefLabel>
<skos:altLabel>fluorinase</skos:altLabel>
<activity rdf:resource="2.5.1.63#SIP7779478A0FE9EAC9"/>
<citation rdf:resource="http://purl.uniprot.org/citations/11907567"/>
<citation rdf:resource="http://purl.uniprot.org/citations/14765200"/>
