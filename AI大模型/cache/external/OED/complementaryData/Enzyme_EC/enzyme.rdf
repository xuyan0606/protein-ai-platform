<rdfs:label>2',4,4',6'-tetrahydroxychalcone + UDP-alpha-D-glucose = 2',4,4',6'-tetrahydroxychalcone 4'-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="2.4.1.286#SIP3BB4B21BC0B228FF">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2',3,4,4',6'-pentahydroxychalcone + UDP-alpha-D-glucose = 2',3,4,4',6'-pentahydroxychalcone 4'-O-beta-D-glucoside + H(+) + UDP.</rdfs:label>
</rdf:Description>
