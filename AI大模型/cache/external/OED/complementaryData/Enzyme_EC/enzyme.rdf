<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>3-methyl-2-oxobutanoate + CoA + 2 oxidized [2Fe-2S]-[ferredoxin] = 2-methylpropanoyl-CoA + CO2 + H(+) + 2 reduced [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
