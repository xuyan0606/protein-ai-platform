<rdf:Description rdf:about="2.1.1.323">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>(-)-pluviatolide 4-O-methyltransferase</skos:prefLabel>
<activity rdf:resource="2.1.1.323#SIP04D1B03580C5F16A"/>
<rdfs:comment>The enzyme, characterized from the plant Sinopodophyllum hexandrum, is involved in the biosynthetic pathway of podophyllotoxin, a non-alkaloid toxin lignan whose derivatives are important anticancer drugs.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/26359402"/>
<rdfs:subClassOf rdf:resource="2.1.1.-"/>
<skos:broaderTransitive rdf:resource="2.1.1.-"/>
</rdf:Description>
