<replaces rdf:resource="1.97.1.7"/>
<skos:prefLabel>methylarsonate reductase</skos:prefLabel>
<skos:altLabel>MMA(V) reductase</skos:altLabel>
<activity rdf:resource="1.20.4.2#SIPECC530272EE9DAB7"/>
<rdfs:comment>The product, methylarsonite, is biologically methylated by EC 2.1.1.137 to form cacodylic acid.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/10604879"/>
<rdfs:subClassOf rdf:resource="1.20.4.-"/>
<skos:broaderTransitive rdf:resource="1.20.4.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.20.4.2#SIPECC530272EE9DAB7">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>2 glutathione + H(+) + methylarsonate = glutathione disulfide + H2O + methylarsonous acid.</rdfs:label>
</rdf:Description>
