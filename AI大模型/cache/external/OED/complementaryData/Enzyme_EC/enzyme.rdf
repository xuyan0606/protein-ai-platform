<skos:exactMatch rdf:resource="http://purl.uniprot.org/pubmed/25837855"/>
<foaf:primaryTopicOf rdf:resource="https://pubmed.ncbi.nlm.nih.gov/25837855"/>
</rdf:Description>
<rdf:Description rdf:about="1.21.98.3">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>anaerobic magnesium-protoporphyrin IX monomethyl ester cyclase</skos:prefLabel>
<skos:altLabel>MPE cyclase</skos:altLabel>
<activity rdf:resource="1.21.98.3#SIPD3FEC741D9D85AE1"/>
<rdfs:comment>This radical AdoMet enzyme participates in the biosynthesis of chlorophyllide a in anaerobic bacteria, catalyzing the formation of an isocyclic ring.</rdfs:comment>
<rdfs:comment>The same transformation is achieved in aerobic organisms by the oxygen-dependent EC 1.14.13.81.</rdfs:comment>
<rdfs:comment>Some facultative phototrophic bacteria, such as Rubrivivax gelatinosus, possess both enzymes.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/2203738"/>
<citation rdf:resource="http://purl.uniprot.org/citations/10841582"/>
