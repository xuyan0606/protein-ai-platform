<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>D-xylono-1,4-lactone 5-phosphate + H2O = 5-phospho-D-xylonate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="3.1.1.104#SIP43D7D5C661348C88">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>H2O + L-arabino-1,4-lactone 5-phosphate = 5-phospho-L-arabinonate + H(+).</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/24955762">
