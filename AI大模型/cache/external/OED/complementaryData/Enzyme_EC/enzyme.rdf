<rdf:Description rdf:about="6.3.2.41">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<replaces rdf:resource="6.3.2.n6"/>
<skos:prefLabel>N-acetylaspartylglutamate synthase</skos:prefLabel>
<skos:altLabel>NAAGS</skos:altLabel>
<skos:altLabel>NAAG synthetase</skos:altLabel>
<skos:altLabel>N-acetylaspartylglutamate synthetase</skos:altLabel>
<activity rdf:resource="6.3.2.41#SIP28640320AAE9BE3B"/>
<rdfs:comment>The enzyme, found in animals, produces the neurotransmitter N-acetyl-L-aspartyl-L-glutamate.</rdfs:comment>
<rdfs:comment>One isoform also has the activity of EC 6.3.1.17, while another isoform has the activity of EC 6.3.2.42.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/20643647"/>
<citation rdf:resource="http://purl.uniprot.org/citations/20657015"/>
<citation rdf:resource="http://purl.uniprot.org/citations/21454531"/>
<rdfs:subClassOf rdf:resource="6.3.2.-"/>
<skos:broaderTransitive rdf:resource="6.3.2.-"/>
</rdf:Description>
<rdf:Description rdf:about="6.3.2.41#SIP28640320AAE9BE3B">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>ATP + L-glutamate + N-acetyl-L-aspartate = ADP + H(+) + N-acetyl-L-aspartyl-L-glutamate + phosphate.</rdfs:label>
</rdf:Description>
<rdf:Description rdf:about="http://purl.uniprot.org/citations/20643647">
