<rdf:Description rdf:about="1.1.1.289">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>sorbose reductase</skos:prefLabel>
<activity rdf:resource="1.1.1.289#SIPB1C2E481C1ECE0E9"/>
<rdfs:comment>The reaction occurs predominantly in the reverse direction.</rdfs:comment>
<rdfs:comment>This enzyme can also convert D-fructose into D-mannitol, but more slowly.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/11790761"/>
<citation rdf:resource="http://purl.uniprot.org/citations/16134116"/>
<rdfs:subClassOf rdf:resource="1.1.1.-"/>
<skos:broaderTransitive rdf:resource="1.1.1.-"/>
</rdf:Description>
