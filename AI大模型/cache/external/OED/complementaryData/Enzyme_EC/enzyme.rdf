<rdf:Description rdf:about="1.8.7.2">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Enzyme"/>
<skos:prefLabel>ferredoxin:thioredoxin reductase</skos:prefLabel>
<activity rdf:resource="1.8.7.2#SIP4D33AFFED8A86372"/>
<rdfs:comment>The enzyme contains a [4Fe-4S] cluster and internal disulfide.</rdfs:comment>
<rdfs:comment>It forms a mixed disulfide with thioredoxin on one side, and docks ferredoxin on the other side, enabling two one-electron transfers.</rdfs:comment>
<rdfs:comment>The reduced thioredoxins generated by the enzyme activate the Calvin cycle enzymes EC 3.1.3.11, EC 3.1.3.37 and EC 2.7.1.19 as well as other chloroplast enzymes by disulfide reduction.</rdfs:comment>
<citation rdf:resource="http://purl.uniprot.org/citations/1910303"/>
<citation rdf:resource="http://purl.uniprot.org/citations/7628465"/>
<citation rdf:resource="http://purl.uniprot.org/citations/8784198"/>
<rdfs:subClassOf rdf:resource="1.8.7.-"/>
<skos:broaderTransitive rdf:resource="1.8.7.-"/>
</rdf:Description>
<rdf:Description rdf:about="1.8.7.2#SIP4D33AFFED8A86372">
<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>[thioredoxin]-disulfide + 2 H(+) + 2 reduced [2Fe-2S]-[ferredoxin] = [thioredoxin]-dithiol + 2 oxidized [2Fe-2S]-[ferredoxin].</rdfs:label>
</rdf:Description>
