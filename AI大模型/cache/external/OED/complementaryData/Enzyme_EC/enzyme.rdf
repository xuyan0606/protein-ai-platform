<rdf:type rdf:resource="http://purl.uniprot.org/core/Catalytic_Activity"/>
<rdfs:label>Hydrolysis of proteins and small molecule substrates at -Asn-|-Xaa- bonds.</rdfs:label>
</rdf:Description>
