{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KWB Mutation Numbering Curation Decision",
  "type": "object",
  "required": ["record_id", "decision", "curator", "curated_at"],
  "properties": {
    "record_id": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["map_to_canonical", "keep_unresolved_weak", "reject_label"]
    },
    "canonical_uniprot_id": { "type": ["string", "null"] },
    "canonical_position": { "type": ["integer", "null"], "minimum": 1 },
    "canonical_wild_type": { "type": ["string", "null"] },
    "canonical_mutant": { "type": ["string", "null"] },
    "mapping_basis": {
      "type": "string",
      "enum": [
        "uniprot_version_alignment",
        "isoform_alignment",
        "literature_sequence_alignment",
        "author_numbering_mapping",
        "manual_expert_review",
        "unresolved"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string" },
    "curator": { "type": "string" },
    "curated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
